(fn g-nothing :void ()
  (ret))

(fn g-put :void ((md (ref (vec :str))) (s :str))
  (vec-push md s)
  (ret))

(fn g-error :void ((s :str))
  (fmt-emit 2 (str-concat "logos: guide: " (str-concat s "\n")))
  (ret))

(fn g-error-line :void ((s :str))
  (fmt-emit 2 (str-concat s "\n"))
  (ret))

(fn g-tick :str ((s :str))
  (ret (str-concat "`" (str-concat s "`"))))

(fn g-list :str ((v (ref (vec :str))))
  (letmut out :str "")
  (letmut i :i64 0)
  (while (< i (vec-len v))
    (set out (str-concat out (if (= i 0) "" ", ")))
    (set out (str-concat out (g-tick (vec-get v i))))
    (set i (+ i 1)))
  (ret out))

(fn g-cell :str ((s :str))
  (letmut out :str "")
  (letmut i :i64 0)
  (let n :i64 (str-len s))
  (while (< i n)
    (let b :i64 (cast :i64 (str-byte s i)))
    (set out (str-concat out (if (= b 124) "\\|"
                               (if (= b 10) " "
                                 (str-slice s i (+ i 1))))))
    (set i (+ i 1)))
  (ret out))

(fn g-lookup :i64 ((table (ref (vec :str))) (stride :i64) (key :str))
  (letmut i :i64 0)
  (letmut found :i64 -1)
  (while (and (= found -1)
           (< i (vec-len table)))
    (if (str-eq (vec-get table i) key)
      (set found i)
      (g-nothing))
    (set i (+ i stride)))
  (ret found))

(fn g-field :str ((table (ref (vec :str))) (stride :i64) (key :str) (offset :i64))
  (let at :i64 (g-lookup table stride key))
  (ret (if (< at 0) ""
         (vec-get table (+ at offset)))))

(fn g-digits :i64 ((s :str) (from :i64))
  (letmut i :i64 from)
  (letmut v :i64 0)
  (while (< i (str-len s))
    (set v (+ (* v 10)
             (- (cast :i64 (str-byte s i)) 48)))
    (set i (+ i 1)))
  (ret v))

(fn g-stem :str ((name :str))
  (let n :i64 (str-len name))
  (ret (if (and (> n 6)
             (str-eq (str-slice name (- n 6) n) ".logos"))
         (str-slice name 0 (- n 6)) name)))

(fn g-rstrip :str ((s :str))
  (letmut n :i64 (str-len s))
  (while (and (> n 0)
           (= (cast :i64 (str-byte s (- n 1))) 10))
    (set n (- n 1)))
  (ret (str-slice s 0 n)))

(fn g-join :str ((lines (ref (vec :str))))
  (letmut out :str "")
  (letmut i :i64 0)
  (while (< i (vec-len lines))
    (set out (str-concat out (vec-get lines i)))
    (if (< (+ i 1)
          (vec-len lines))
      (set out (str-concat out "\n"))
      (g-nothing))
    (set i (+ i 1)))
  (ret out))

(fn g-prim-kind :str ((name :str))
  (let b0 :i64 (cast :i64 (str-byte name 0)))
  (ret (if (or (= b0 105)
             (= b0 117)) "integer"
         (if (= b0 102) "float"
           (if (str-eq name "bool") "boolean"
             (if (str-eq name "str") "string"
               (if (str-eq name "void") "unit"
                 (if (or (str-eq name "thread")
                       (or (str-eq name "mutex")
                         (str-eq name "run"))) "handle" "primitive"))))))))

(fn g-prim-bits :i64 ((name :str))
  (ret (g-digits name 1)))

(fn g-prim-signed :bool ((name :str))
  (ret (= (cast :i64 (str-byte name 0)) 105)))

(fn g-prim-meaning :str ((name :str))
  (let kind :str (g-prim-kind name))
  (ret (if (str-eq kind "integer")
         (str-concat (if (g-prim-signed name) "a signed " "an unsigned ")
           (str-concat (str-from-i64 (g-prim-bits name)) "-bit integer"))
         (if (str-eq kind "float")
           (str-concat "an IEEE " (str-concat (str-from-i64 (g-prim-bits name)) "-bit floating-point number"))
           (if (str-eq kind "boolean") "`true` or `false`"
             (if (str-eq kind "string") "a UTF-8 byte string: a pointer and a byte length"
               (if (str-eq kind "unit") "no value; the type of a statement form"
                 (if (str-eq name "thread") "a spawned thread handle"
                   (if (str-eq name "mutex") "a lock handle, always `(shared :mutex)` when made"
                     (if (str-eq name "run") "a child process handle, made only by `(run prog args)`" "a primitive type"))))))))))

(fn g-scalar-add :str ((out :str) (name :str))
  (ret (str-concat out (str-concat (if (str-eq out "") "" ", ")
                         (str-concat ":" name)))))

(fn g-scalars :str ((prims (ref (vec :str))))
  (letmut out :str "")
  (letmut i :i64 0)
  (while (< i (vec-len prims))
    (let kind :str (g-prim-kind (vec-get prims i)))
    (if (or (str-eq kind "integer")
          (or (str-eq kind "float")
            (or (str-eq kind "boolean")
              (str-eq kind "string"))))
      (set out (g-scalar-add out (vec-get prims i)))
      (g-nothing))
    (set i (+ i 1)))
  (ret out))

(fn g-operators :void ((out (ref (vec :str))) (scalars :str))
  (vec-push out "+")
  (vec-push out "2+")
  (vec-push out "add numbers of one type")
  (vec-push out "-")
  (vec-push out "2+")
  (vec-push out "subtract numbers of one type")
  (vec-push out "*")
  (vec-push out "2+")
  (vec-push out "multiply numbers of one type")
  (vec-push out "/")
  (vec-push out "2+")
  (vec-push out "divide numbers of one type")
  (vec-push out "%")
  (vec-push out "2+")
  (vec-push out "integer remainder; floats are E0100")
  (g-op-ordered out)
  (g-op-equality out scalars)
  (g-op-rest out)
  (ret))

(fn g-op-ordered :void ((out (ref (vec :str))))
  (vec-push out "<")
  (vec-push out "2")
  (vec-push out "ordered compare, yielding `:bool`")
  (vec-push out "<=")
  (vec-push out "2")
  (vec-push out "ordered compare, yielding `:bool`")
  (vec-push out ">")
  (vec-push out "2")
  (vec-push out "ordered compare, yielding `:bool`")
  (vec-push out ">=")
  (vec-push out "2")
  (vec-push out "ordered compare, yielding `:bool`")
  (ret))

(fn g-op-equality :void ((out (ref (vec :str))) (scalars :str))
  (let meaning :str (str-concat "equality over " (str-concat scalars "; `:str` compares bytes")))
  (vec-push out "=")
  (vec-push out "2")
  (vec-push out meaning)
  (vec-push out "!=")
  (vec-push out "2")
  (vec-push out meaning)
  (ret))

(fn g-op-rest :void ((out (ref (vec :str))))
  (vec-push out "shl")
  (vec-push out "2")
  (vec-push out "shift left")
  (vec-push out "shr")
  (vec-push out "2")
  (vec-push out "arithmetic shift right")
  (vec-push out "shr-u")
  (vec-push out "2")
  (vec-push out "logical shift right")
  (vec-push out "and")
  (vec-push out "2")
  (vec-push out "short-circuit `:bool` operator")
  (vec-push out "or")
  (vec-push out "2")
  (vec-push out "short-circuit `:bool` operator")
  (vec-push out "not")
  (vec-push out "1")
  (vec-push out "`:bool` negation")
  (ret))

(fn g-copy3 :void ((out (ref (vec :str))) (from (ref (vec :str))) (i :i64))
  (vec-push out (vec-get from i))
  (vec-push out (vec-get from (+ i 1)))
  (vec-push out (vec-get from (+ i 2)))
  (ret))

(fn g-add-type-form :void ((out (ref (vec :str))) (docs (ref (vec :str))) (arity (ref (vec :str))) (meaning (ref (vec :str))) (name :str))
  (vec-push out name)
  (vec-push out (g-field arity 2 name 1))
  (vec-push out (g-field meaning 2 name 1))
  (ret))

(fn g-forms :void ((out (ref (vec :str))) (docs (ref (vec :str))) (arity (ref (vec :str))) (meaning (ref (vec :str))) (forms (ref (vec :str))))
  (letmut i :i64 0)
  (while (< i (vec-len docs))
    (g-copy3 out docs i)
    (set i (+ i 3)))
  (letmut t :i64 0)
  (while (< t (vec-len forms))
    (let name :str (vec-get forms t))
    (if (< (g-lookup docs 3 name) 0)
      (g-add-type-form out docs arity meaning name)
      (g-nothing))
    (set t (+ t 1)))
  (ret))

(fn guide-consistent :i64 ()
  (letmut arity
    (vec :str)
    (make (vec :str)))
  (g-type-arity arity)
  (letmut meaning
    (vec :str)
    (make (vec :str)))
  (g-type-meaning meaning)
  (letmut forms
    (vec :str)
    (make (vec :str)))
  (type-forms forms)
  (letmut i :i64 0)
  (letmut bad :i64 0)
  (while (< i (vec-len forms))
    (if (< (g-lookup arity 2 (vec-get forms i)) 0)
      (set bad 1)
      (g-nothing))
    (if (< (g-lookup meaning 2 (vec-get forms i)) 0)
      (set bad 1)
      (g-nothing))
    (set i (+ i 1)))
  (if (not (= (vec-len arity)
             (* 2 (vec-len forms))))
    (set bad 1)
    (g-nothing))
  (if (not (= (vec-len meaning)
             (* 2 (vec-len forms))))
    (set bad 1)
    (g-nothing))
  (if (= bad 1)
    (g-error "the type-form documentation is out of date with types.FORMS")
    (g-nothing))
  (vec-free arity)
  (vec-free meaning)
  (vec-free forms)
  (ret bad))

(fn g-row-at :str ((cells (ref (vec :str))) (start :i64) (count :i64) (dash :bool))
  (letmut out :str "|")
  (letmut i :i64 0)
  (while (< i count)
    (set out (str-concat out (str-concat " " (str-concat (if dash "---" (g-cell (vec-get cells (+ start i)))) " |"))))
    (set i (+ i 1)))
  (ret out))

(fn g-table :void ((md (ref (vec :str))) (headers (ref (vec :str))) (rows (ref (vec :str))) (cols :i64))
  (g-put md (g-row-at headers 0 cols false))
  (g-put md (g-row-at headers 0 cols true))
  (letmut i :i64 0)
  (while (< i (vec-len rows))
    (g-put md (g-row-at rows i cols false))
    (set i (+ i cols)))
  (ret))

(fn g-rule-rows :void ((rows (ref (vec :str))) (rules (ref (vec :str))))
  (letmut i :i64 0)
  (while (< i (vec-len rules))
    (vec-push rows (str-from-i64 (+ 1 (/ i 2))))
    (vec-push rows (vec-get rules i))
    (vec-push rows (vec-get rules (+ i 1)))
    (set i (+ i 2)))
  (ret))

(fn g-form-rows :void ((rows (ref (vec :str))) (forms (ref (vec :str))))
  (letmut i :i64 0)
  (while (< i (vec-len forms))
    (vec-push rows (g-tick (vec-get forms i)))
    (vec-push rows (vec-get forms (+ i 1)))
    (vec-push rows (vec-get forms (+ i 2)))
    (set i (+ i 3)))
  (ret))

(fn g-type-rows :void ((rows (ref (vec :str))) (prims (ref (vec :str))))
  (letmut i :i64 0)
  (while (< i (vec-len prims))
    (let name :str (vec-get prims i))
    (vec-push rows (g-tick (str-concat ":" name)))
    (vec-push rows (g-prim-kind name))
    (vec-push rows (g-prim-meaning name))
    (set i (+ i 1)))
  (ret))

(fn g-op-rows :void ((rows (ref (vec :str))) (ops (ref (vec :str))))
  (letmut i :i64 0)
  (while (< i (vec-len ops))
    (vec-push rows (g-tick (vec-get ops i)))
    (vec-push rows (vec-get ops (+ i 1)))
    (vec-push rows (vec-get ops (+ i 2)))
    (set i (+ i 3)))
  (ret))

(fn g-builtin-rows :void ((rows (ref (vec :str))))
  (vec-push rows (g-tick "print"))
  (vec-push rows "print a value to stdout with no newline")
  (vec-push rows (g-tick "println"))
  (vec-push rows "print a value to stdout followed by a newline")
  (ret))

(fn g-code-rows :void ((rows (ref (vec :str))) (codes (ref (vec :str))))
  (letmut i :i64 0)
  (while (< i (vec-len codes))
    (vec-push rows (g-tick (vec-get codes i)))
    (vec-push rows (vec-get codes (+ i 1)))
    (set i (+ i 2)))
  (ret))

(fn g-headers3 :void ((out (ref (vec :str))) (a :str) (b :str) (c :str))
  (vec-push out a)
  (vec-push out b)
  (vec-push out c)
  (ret))

(fn g-headers2 :void ((out (ref (vec :str))) (a :str) (b :str))
  (vec-push out a)
  (vec-push out b)
  (ret))

(type g-chapter-data (struct (source :str) (out :str) (code :i64) (failed :bool)))

(fn g-error-v :void ((s :str))
  (g-error s)
  (ret))

(fn g-write-failed :str ()
  (g-error-v "cannot write build/.guide-chapter.logos")
  (ret ""))

(fn g-chapter-error :bool ((s :str))
  (g-error s)
  (ret true))

(fn g-expect-has-out :i64 ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (test :i64))
  (ret (get (h-expect-values nodes ntexts test) has-out)))

(fn g-expect-out :str ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (test :i64))
  (ret (get (h-expect-values nodes ntexts test) out)))

(fn g-expect-code :i64 ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (test :i64))
  (let ex h-expect (h-expect-values nodes ntexts test))
  (ret (if (= (get ex has-code) 0) 0
         (get ex code))))

(fn g-mkdir :void ((dir :str))
  (let _ :i64 (mkdirs dir))
  (ret))

(fn g-close :void ((fd :i64))
  (let _ :i32 (close fd))
  (ret))

(fn g-unlink :void ((path :str))
  (let _ :i32 (unlink path))
  (ret))

(fn g-render :str ((nodes (ref (vec node))) (ntexts (ref (vec :str))))
  (g-mkdir "build")
  (let fd :i64 (rt_create "build/.guide-chapter.logos"))
  (if (< fd 0)
    (ret (g-write-failed))
    (g-nothing))
  (fmt fd nodes ntexts)
  (g-close fd)
  (let text :str (read-file "build/.guide-chapter.logos"))
  (g-unlink "build/.guide-chapter.logos")
  (ret text))

(fn g-chapter-tree :bool ((name :str) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lns (ref (vec :i64))) (cols (ref (vec :i64))) (nodes (ref (vec node))) (ntexts (ref (vec :str))))
  (let te tree-error (tree-parse kinds texts lns cols nodes ntexts))
  (ret (if (tree-ok te) false
         (if (g-chapter-error (str-concat name (str-concat ": E0001: " (get te msg)))) true false))))

(fn g-loaded g-chapter-data ((name :str) (path :str))
  (let src :str (read-file path))
  (letmut kinds
    (vec :i64)
    (make (vec :i64)))
  (letmut texts
    (vec :str)
    (make (vec :str)))
  (letmut lns
    (vec :i64)
    (make (vec :i64)))
  (letmut cols
    (vec :i64)
    (make (vec :i64)))
  (letmut nodes
    (vec node)
    (make (vec node)))
  (letmut ntexts
    (vec :str)
    (make (vec :str)))
  (letmut failed :bool false)
  (letmut source :str "")
  (letmut out :str "")
  (letmut code :i64 0)
  (let le lex-error (lex src kinds texts lns cols))
  (if (lex-ok le)
    (g-nothing)
    (set failed (g-chapter-error (str-concat name (str-concat ": E0006: " (get le msg))))))
  (if failed
    (g-nothing)
    (set failed (g-chapter-tree name kinds texts lns cols nodes ntexts)))
  (letmut test :i64 -1)
  (if failed
    (g-nothing)
    (set test (h-child-find nodes ntexts 0 "test")))
  (if (and (not failed)
        (< test 0))
    (set failed (g-chapter-error (str-concat name ": no (test ...) node")))
    (g-nothing))
  (if (and (not failed)
        (= (g-expect-has-out nodes ntexts test) 0))
    (set failed (g-chapter-error (str-concat name ": the test needs an (expect (out ...))")))
    (g-nothing))
  (if failed
    (g-nothing)
    (set out (g-expect-out nodes ntexts test)))
  (if failed
    (g-nothing)
    (set code (g-expect-code nodes ntexts test)))
  (if failed
    (g-nothing)
    (set source (g-render nodes ntexts)))
  (if (and (not failed)
        (str-eq source ""))
    (set failed true)
    (g-nothing))
  (vec-free kinds)
  (vec-free texts)
  (vec-free lns)
  (vec-free cols)
  (vec-free nodes)
  (vec-free ntexts)
  (ret (make g-chapter-data source out code failed)))

(fn g-chapter :i64 ((md (ref (vec :str))) (titles (ref (vec :str))) (name :str) (index :i64))
  (let stem :str (g-stem name))
  (let at :i64 (g-lookup titles 2 stem))
  (if (< at 0)
    (g-error-v (str-concat name ": no chapter title in CHAPTER_TITLES"))
    (g-nothing))
  (if (< at 0)
    (ret -1)
    (g-nothing))
  (let data g-chapter-data (g-loaded name (str-concat "docs/manual/" name)))
  (if (get data failed)
    (ret -1)
    (g-nothing))
  (g-put md (str-concat "### " (str-concat (str-from-i64 (+ index 1))
                                 (str-concat ". " (vec-get titles (+ at 1))))))
  (g-put md "")
  (g-put md "```logos")
  (g-put md (g-rstrip (get data source)))
  (g-put md "```")
  (g-put md "")
  (g-put md (str-concat "Expected stdout, exit " (str-concat (str-from-i64 (get data code)) ":")))
  (g-put md "")
  (g-put md "```text")
  (g-put md (g-rstrip (get data out)))
  (g-put md "```")
  (g-put md "")
  (ret (+ index 1)))

(fn g-chapters :i64 ((md (ref (vec :str))) (titles (ref (vec :str))))
  (letmut names
    (vec :str)
    (read-dir "docs/manual"))
  (h-sort names)
  (letmut status :i64 0)
  (letmut count :i64 0)
  (letmut i :i64 0)
  (while (< i (vec-len names))
    (let name :str (vec-get names i))
    (if (and (= status 0)
          (h-logos-name name))
      (set count (g-chapter md titles name count))
      (g-nothing))
    (if (< count 0)
      (set status 1)
      (g-nothing))
    (set i (+ i 1)))
  (vec-free names)
  (ret status))

(fn g-chapter-count :i64 ()
  (letmut names
    (vec :str)
    (read-dir "docs/manual"))
  (letmut n :i64 0)
  (letmut i :i64 0)
  (while (< i (vec-len names))
    (if (h-logos-name (vec-get names i))
      (set n (+ n 1))
      (g-nothing))
    (set i (+ i 1)))
  (vec-free names)
  (ret n))

(fn g-rules-list :void ((md (ref (vec :str))) (rules (ref (vec :str))))
  (letmut i :i64 0)
  (while (< i (vec-len rules))
    (g-put md (str-concat (str-from-i64 (+ 1 (/ i 2)))
                (str-concat ". " (vec-get rules i))))
    (set i (+ i 2)))
  (ret))

(fn g-cheat :void ((md (ref (vec :str))) (rules (ref (vec :str))) (chapters :i64))
  (g-put md "# Logos: the generated manual")
  (g-put md "")
  (g-put md "A prefix-form language for AI readers, compiled by `logosc` to native x86_64 Linux binaries. Generated from the compiler's tables and `docs/manual/*.logos`; do not edit.")
  (g-put md "")
  (g-put md "## Cheat sheet")
  (g-put md "")
  (g-put md "A program is one file and one module: `(mod name)`, then `(fn name :ret ((p :type) ...) body...)` definitions, `(type ...)` declarations, and `(test name (expect (out \"...\") (code 0)) body...)` cases.")
  (g-put md "")
  (g-put md "```logos")
  (g-put md "(mod hello)")
  (g-put md "")
  (g-put md "(fn add :i64 ((a :i64) (b :i64))")
  (g-put md "  (ret (+ a b)))")
  (g-put md "")
  (g-put md "(test add")
  (g-put md "  (expect (out \"3\\n\") (code 0))")
  (g-put md "  (println (add 1 2)))")
  (g-put md "```")
  (g-put md "")
  (g-put md "The ten rules that decide whether code compiles:")
  (g-put md "")
  (g-rules-list md rules)
  (g-put md "")
  (g-put md "Machine-readable: `logosc guide --json` prints the manifest (forms, types, operators, builtins, reserved, codes, categories). `logosc guide --check` proves this file matches the compiler.")
  (g-put md "")
  (g-put md "## Manual")
  (g-put md "")
  (g-put md (str-concat (str-from-i64 chapters) " chapters in learning order. Each is a complete module; its `(test ...)` node declares the output shown, and `python3 -m logos test docs/manual` runs every one at `-O0` and `-O2`."))
  (g-put md "")
  (ret))

(fn g-reference :void ((md (ref (vec :str))) (rules (ref (vec :str))) (forms (ref (vec :str))) (prims (ref (vec :str))) (codes (ref (vec :str))) (resforms (ref (vec :str))) (prefixes (ref (vec :str))) (variants (ref (vec :str))) (cats (ref (vec :str))))
  (letmut ops
    (vec :str)
    (make (vec :str)))
  (g-operators ops (g-scalars prims))
  (g-put md "## Reference")
  (g-put md "")
  (g-put md "### The ten rules, and where the compiler enforces them")
  (g-put md "")
  (letmut rows
    (vec :str)
    (make (vec :str)))
  (letmut hdr
    (vec :str)
    (make (vec :str)))
  (g-rule-rows rows rules)
  (g-headers3 hdr "#" "Rule" "Enforced by")
  (g-table md hdr rows 3)
  (vec-free rows)
  (vec-free hdr)
  (g-put md "")
  (g-put md "### Forms")
  (g-put md "")
  (letmut rows2
    (vec :str)
    (make (vec :str)))
  (letmut hdr2
    (vec :str)
    (make (vec :str)))
  (g-form-rows rows2 forms)
  (g-headers3 hdr2 "Form" "Arity" "Meaning")
  (g-table md hdr2 rows2 3)
  (vec-free rows2)
  (vec-free hdr2)
  (g-put md "")
  (g-put md "### Primitive types")
  (g-put md "")
  (letmut rows3
    (vec :str)
    (make (vec :str)))
  (letmut hdr3
    (vec :str)
    (make (vec :str)))
  (g-type-rows rows3 prims)
  (g-headers3 hdr3 "Type" "Kind" "Meaning")
  (g-table md hdr3 rows3 3)
  (vec-free rows3)
  (vec-free hdr3)
  (g-put md "")
  (g-put md "### Operators")
  (g-put md "")
  (letmut rows4
    (vec :str)
    (make (vec :str)))
  (letmut hdr4
    (vec :str)
    (make (vec :str)))
  (g-op-rows rows4 ops)
  (g-headers3 hdr4 "Operator" "Arity" "Meaning")
  (g-table md hdr4 rows4 3)
  (vec-free rows4)
  (vec-free hdr4)
  (vec-free ops)
  (g-put md "")
  (g-put md "### Builtins")
  (g-put md "")
  (letmut rows5
    (vec :str)
    (make (vec :str)))
  (letmut hdr5
    (vec :str)
    (make (vec :str)))
  (g-builtin-rows rows5)
  (g-headers2 hdr5 "Builtin" "Meaning")
  (g-table md hdr5 rows5 2)
  (vec-free rows5)
  (vec-free hdr5)
  (g-put md "")
  (g-put md "### Reserved names")
  (g-put md "")
  (g-put md (str-concat "A definition may not take a name a form already spells (E0003). The reserved forms are: " (str-concat (g-list resforms) ".")))
  (g-put md "")
  (g-put md (str-concat "Reserved form prefixes: " (str-concat (g-list prefixes)
                                                     (str-concat ". Reserved enum variant names: " (str-concat (g-list variants) ".")))))
  (g-put md "")
  (g-put md "An `extern fn` may declare an `rt_` symbol — the runtime owns that definition — while a `fn` definition of one is still E0003.")
  (g-put md "")
  (g-put md "### Diagnostic codes")
  (g-put md "")
  (letmut rows6
    (vec :str)
    (make (vec :str)))
  (letmut hdr6
    (vec :str)
    (make (vec :str)))
  (g-code-rows rows6 codes)
  (g-headers2 hdr6 "Code" "Meaning")
  (g-table md hdr6 rows6 2)
  (vec-free rows6)
  (vec-free hdr6)
  (g-put md "")
  (g-put md "Runtime panic codes: `R0001` division by zero, `R0002` double free, `R0003` failed runtime check, `R0004` free of an unknown address, `R0005` thread operation failed, `R0006` a program could not be started, `R0007` a file could not be read. `R0002` and `R0004` are runtime names only: nothing in the compiler emits them.")
  (g-put md "")
  (g-put md "### Test categories")
  (g-put md "")
  (g-put md (str-concat "`logosc test --only <category>` runs one: " (str-concat (g-list cats) ".")))
  (g-put md "")
  (ret))

(fn guide-markdown :str ()
  (letmut codes
    (vec :str)
    (make (vec :str)))
  (g-codes codes)
  (letmut docs
    (vec :str)
    (make (vec :str)))
  (g-form-docs docs)
  (letmut tarity
    (vec :str)
    (make (vec :str)))
  (g-type-arity tarity)
  (letmut tmeaning
    (vec :str)
    (make (vec :str)))
  (g-type-meaning tmeaning)
  (letmut rules
    (vec :str)
    (make (vec :str)))
  (g-rules rules)
  (letmut titles
    (vec :str)
    (make (vec :str)))
  (g-titles titles)
  (letmut prims
    (vec :str)
    (make (vec :str)))
  (type-primitives prims)
  (letmut tforms
    (vec :str)
    (make (vec :str)))
  (type-forms tforms)
  (letmut forms
    (vec :str)
    (make (vec :str)))
  (g-forms forms docs tarity tmeaning tforms)
  (letmut resforms
    (vec :str)
    (make (vec :str)))
  (g-reserved-forms resforms)
  (h-sort resforms)
  (letmut prefixes
    (vec :str)
    (make (vec :str)))
  (g-reserved-prefixes prefixes)
  (letmut variants
    (vec :str)
    (make (vec :str)))
  (g-reserved-variants variants)
  (letmut cats
    (vec :str)
    (make (vec :str)))
  (h-categories cats)
  (letmut md
    (vec :str)
    (make (vec :str)))
  (letmut status :i64 0)
  (g-cheat md rules (g-chapter-count))
  (set status (g-chapters md titles))
  (if (= status 0)
    (g-reference md rules forms prims codes resforms prefixes variants cats)
    (g-nothing))
  (letmut text :str "")
  (if (= status 0)
    (set text (g-join md))
    (g-nothing))
  (vec-free codes)
  (vec-free docs)
  (vec-free tarity)
  (vec-free tmeaning)
  (vec-free rules)
  (vec-free titles)
  (vec-free prims)
  (vec-free tforms)
  (vec-free forms)
  (vec-free resforms)
  (vec-free prefixes)
  (vec-free variants)
  (vec-free cats)
  (vec-free md)
  (ret text))

(fn g-hex1 :str ((v :i64))
  (ret (if (< v 10)
         (str-from-i64 v)
         (str-slice "abcdef"
           (- v 10)
           (- v 9)))))

(fn g-u-escape :str ((b :i64))
  (ret (str-concat "\\u00" (str-concat (g-hex1 (/ b 16))
                             (g-hex1 (- b (* 16 (/ b 16))))))))

(fn g-json-str :str ((s :str))
  (letmut out :str "\"")
  (letmut i :i64 0)
  (let n :i64 (str-len s))
  (while (< i n)
    (let b :i64 (cast :i64 (str-byte s i)))
    (set out (str-concat out (if (= b 34) "\\\""
                               (if (= b 92) "\\\\"
                                 (if (= b 10) "\\n"
                                   (if (= b 9) "\\t"
                                     (if (= b 13) "\\r"
                                       (if (= b 8) "\\b"
                                         (if (= b 12) "\\f"
                                           (if (< b 32)
                                             (g-u-escape b)
                                             (if (>= b 127)
                                               (g-u-escape b)
                                               (str-slice s i (+ i 1)))))))))))))
    (set i (+ i 1)))
  (ret (str-concat out "\"")))

(fn g-jline :str ((indent :str) (key :str) (value :str) (comma :i64))
  (ret (str-concat indent (str-concat (g-json-str key)
                            (str-concat ": " (str-concat value (if (= comma 1) "," "")))))))

(fn g-jtail :str ((last :i64))
  (ret (if (= last 1) "    }" "    },")))

(fn g-jarray :void ((ls (ref (vec :str))) (v (ref (vec :str))) (indent :str))
  (letmut i :i64 0)
  (while (< i (vec-len v))
    (vec-push ls (str-concat indent (str-concat (g-json-str (vec-get v i))
                                      (if (< (+ i 1)
                                            (vec-len v)) "," ""))))
    (set i (+ i 1)))
  (ret))

(fn g-jform :void ((ls (ref (vec :str))) (forms (ref (vec :str))) (i :i64) (last :i64))
  (vec-push ls "    {")
  (vec-push ls (g-jline "      " "name" (g-json-str (vec-get forms i)) 1))
  (vec-push ls (g-jline "      " "arity" (g-json-str (vec-get forms (+ i 1))) 1))
  (vec-push ls (g-jline "      " "meaning" (g-json-str (vec-get forms (+ i 2))) 0))
  (vec-push ls (g-jtail last))
  (ret))

(fn g-jtype-int :void ((ls (ref (vec :str))) (name :str) (last :i64))
  (vec-push ls (g-jline "      " "bits" (str-from-i64 (g-prim-bits name)) 1))
  (vec-push ls (g-jline "      " "signed" (if (g-prim-signed name) "true" "false") 1))
  (vec-push ls (g-jline "      " "meaning" (g-json-str (g-prim-meaning name)) 0))
  (vec-push ls (g-jtail last))
  (ret))

(fn g-jtype-float :void ((ls (ref (vec :str))) (name :str) (last :i64))
  (vec-push ls (g-jline "      " "bits" (str-from-i64 (g-prim-bits name)) 1))
  (vec-push ls (g-jline "      " "meaning" (g-json-str (g-prim-meaning name)) 0))
  (vec-push ls (g-jtail last))
  (ret))

(fn g-jtype-plain :void ((ls (ref (vec :str))) (name :str) (last :i64))
  (vec-push ls (g-jline "      " "meaning" (g-json-str (g-prim-meaning name)) 0))
  (vec-push ls (g-jtail last))
  (ret))

(fn g-jtype :void ((ls (ref (vec :str))) (name :str) (last :i64))
  (let kind :str (g-prim-kind name))
  (vec-push ls "    {")
  (vec-push ls (g-jline "      " "name" (g-json-str (str-concat ":" name)) 1))
  (vec-push ls (g-jline "      " "kind" (g-json-str kind) 1))
  (if (str-eq kind "integer")
    (g-jtype-int ls name last)
    (if (str-eq kind "float")
      (g-jtype-float ls name last)
      (g-jtype-plain ls name last)))
  (ret))

(fn g-jop :void ((ls (ref (vec :str))) (ops (ref (vec :str))) (i :i64) (last :i64))
  (vec-push ls "    {")
  (vec-push ls (g-jline "      " "symbol" (g-json-str (vec-get ops i)) 1))
  (vec-push ls (g-jline "      " "arity" (g-json-str (vec-get ops (+ i 1))) 1))
  (vec-push ls (g-jline "      " "meaning" (g-json-str (vec-get ops (+ i 2))) 0))
  (vec-push ls (g-jtail last))
  (ret))

(fn g-jcode :void ((ls (ref (vec :str))) (codes (ref (vec :str))) (i :i64) (last :i64))
  (vec-push ls (str-concat "    " (str-concat (g-json-str (vec-get codes i))
                                    (str-concat ": " (str-concat (g-json-str (vec-get codes (+ i 1)))
                                                       (if (= last 1) "" ","))))))
  (ret))

(fn guide-manifest :str ()
  (letmut docs
    (vec :str)
    (make (vec :str)))
  (g-form-docs docs)
  (letmut tarity
    (vec :str)
    (make (vec :str)))
  (g-type-arity tarity)
  (letmut tmeaning
    (vec :str)
    (make (vec :str)))
  (g-type-meaning tmeaning)
  (letmut prims
    (vec :str)
    (make (vec :str)))
  (type-primitives prims)
  (letmut tforms
    (vec :str)
    (make (vec :str)))
  (type-forms tforms)
  (letmut forms
    (vec :str)
    (make (vec :str)))
  (g-forms forms docs tarity tmeaning tforms)
  (letmut ops
    (vec :str)
    (make (vec :str)))
  (g-operators ops (g-scalars prims))
  (letmut resforms
    (vec :str)
    (make (vec :str)))
  (g-reserved-forms resforms)
  (h-sort resforms)
  (letmut prefixes
    (vec :str)
    (make (vec :str)))
  (g-reserved-prefixes prefixes)
  (letmut variants
    (vec :str)
    (make (vec :str)))
  (g-reserved-variants variants)
  (letmut codes
    (vec :str)
    (make (vec :str)))
  (g-codes codes)
  (letmut cats
    (vec :str)
    (make (vec :str)))
  (h-categories cats)
  (letmut ls
    (vec :str)
    (make (vec :str)))
  (vec-push ls "{")
  (vec-push ls "  \"forms\": [")
  (letmut i :i64 0)
  (while (< i (vec-len forms))
    (g-jform ls forms i (if (< (+ i 3)
                              (vec-len forms)) 0 1))
    (set i (+ i 3)))
  (vec-push ls "  ],")
  (vec-push ls "  \"types\": [")
  (set i 0)
  (while (< i (vec-len prims))
    (g-jtype ls
      (vec-get prims i)
      (if (< (+ i 1)
            (vec-len prims)) 0 1))
    (set i (+ i 1)))
  (vec-push ls "  ],")
  (vec-push ls "  \"operators\": [")
  (set i 0)
  (while (< i (vec-len ops))
    (g-jop ls ops i (if (< (+ i 3)
                          (vec-len ops)) 0 1))
    (set i (+ i 3)))
  (vec-push ls "  ],")
  (vec-push ls "  \"builtins\": [")
  (vec-push ls "    {")
  (vec-push ls "      \"name\": \"print\",")
  (vec-push ls "      \"meaning\": \"print a value to stdout with no newline\"")
  (vec-push ls "    },")
  (vec-push ls "    {")
  (vec-push ls "      \"name\": \"println\",")
  (vec-push ls "      \"meaning\": \"print a value to stdout followed by a newline\"")
  (vec-push ls "    }")
  (vec-push ls "  ],")
  (vec-push ls "  \"reserved\": {")
  (vec-push ls "    \"forms\": [")
  (g-jarray ls resforms "      ")
  (vec-push ls "    ],")
  (vec-push ls "    \"prefixes\": [")
  (g-jarray ls prefixes "      ")
  (vec-push ls "    ],")
  (vec-push ls "    \"variants\": [")
  (g-jarray ls variants "      ")
  (vec-push ls "    ]")
  (vec-push ls "  },")
  (vec-push ls "  \"codes\": {")
  (set i 0)
  (while (< i (vec-len codes))
    (g-jcode ls codes i (if (< (+ i 2)
                              (vec-len codes)) 0 1))
    (set i (+ i 2)))
  (vec-push ls "  },")
  (vec-push ls "  \"categories\": [")
  (g-jarray ls cats "    ")
  (vec-push ls "  ]")
  (vec-push ls "}")
  (let text :str (g-join ls))
  (vec-free docs)
  (vec-free tarity)
  (vec-free tmeaning)
  (vec-free prims)
  (vec-free tforms)
  (vec-free forms)
  (vec-free ops)
  (vec-free resforms)
  (vec-free prefixes)
  (vec-free variants)
  (vec-free codes)
  (vec-free cats)
  (vec-free ls)
  (ret text))

(fn g-split-push :void ((s :str) (start :i64) (end :i64) (out (ref (vec :str))))
  (vec-push out (str-slice s start end))
  (ret))

(fn g-split :void ((s :str) (out (ref (vec :str))))
  (letmut start :i64 0)
  (letmut i :i64 0)
  (let n :i64 (str-len s))
  (while (< i n)
    (if (= (cast :i64 (str-byte s i)) 10)
      (g-split-push s start i out)
      (g-nothing))
    (if (= (cast :i64 (str-byte s i)) 10)
      (set start (+ i 1))
      (g-nothing))
    (set i (+ i 1)))
  (if (< start n)
    (g-split-push s start n out)
    (g-nothing))
  (ret))

(fn g-counts :str ((added :i64) (removed :i64))
  (ret (str-concat "docs/LOGOS.md is stale: " (str-concat (str-from-i64 added)
                                                (str-concat " line(s) to add, " (str-concat (str-from-i64 removed) " line(s) to remove; run `logosc guide > docs/LOGOS.md`"))))))

(fn g-report-lines :void ((lines (ref (vec :str))))
  (letmut k :i64 0)
  (while (and (< k (vec-len lines))
           (< k 14))
    (g-error-line (vec-get lines k))
    (set k (+ k 1)))
  (ret))

(fn g-stale :i64 ((actual (ref (vec :str))) (expected (ref (vec :str))))
  (let an :i64 (vec-len actual))
  (let en :i64 (vec-len expected))
  (if (> (* an en) 4000000)
    (ret (g-stale-rough actual expected))
    (g-nothing))
  (letmut dp
    (vec :i64)
    (make (vec :i64)))
  (g-zeros dp (* (+ an 1)
                (+ en 1)))
  (g-dp actual expected dp (+ en 1))
  (letmut lines
    (vec :str)
    (make (vec :str)))
  (letmut totals
    (vec :i64)
    (make (vec :i64)))
  (vec-push totals 0)
  (vec-push totals 0)
  (g-diff-lines actual expected dp (+ en 1) lines totals)
  (g-error-line (g-counts (vec-get totals 1)
                  (vec-get totals 0)))
  (g-error-line "--- docs/LOGOS.md (committed)")
  (g-error-line "+++ generated")
  (g-report-lines lines)
  (vec-free dp)
  (vec-free lines)
  (vec-free totals)
  (ret 1))

(fn g-stale-rough :i64 ((actual (ref (vec :str))) (expected (ref (vec :str))))
  (let an :i64 (vec-len actual))
  (let en :i64 (vec-len expected))
  (letmut p :i64 0)
  (while (and (< p an)
           (and (< p en)
             (str-eq (vec-get actual p)
               (vec-get expected p))))
    (set p (+ p 1)))
  (letmut q :i64 0)
  (while (and (< (+ p q) an)
           (and (< (+ p q) en)
             (str-eq (vec-get actual (- an (+ q 1)))
               (vec-get expected (- en (+ q 1))))))
    (set q (+ q 1)))
  (let removed :i64 (- (- an p) q))
  (let added :i64 (- (- en p) q))
  (g-error-line (g-counts added removed))
  (g-error-line "--- docs/LOGOS.md (committed)")
  (g-error-line "+++ generated")
  (g-error-line (g-hunk-header (+ p 1)
                  (+ p 1) removed added))
  (letmut shown :i64 0)
  (letmut j :i64 0)
  (while (and (< j removed)
           (< shown 13))
    (g-error-line (str-concat "-" (vec-get actual (+ p j))))
    (set shown (+ shown 1))
    (set j (+ j 1)))
  (letmut k :i64 0)
  (while (and (< k added)
           (< shown 13))
    (g-error-line (str-concat "+" (vec-get expected (+ p k))))
    (set shown (+ shown 1))
    (set k (+ k 1)))
  (ret 1))

(fn guide-check :i64 ()
  (let text :str (guide-markdown))
  (if (str-eq text "")
    (ret 1)
    (g-nothing))
  (if (not (h-file-exists "docs/LOGOS.md"))
    (g-error-v "docs/LOGOS.md is missing; run `logosc guide > docs/LOGOS.md`")
    (g-nothing))
  (if (not (h-file-exists "docs/LOGOS.md"))
    (ret 1)
    (g-nothing))
  (let actual :str (read-file "docs/LOGOS.md"))
  (if (str-eq actual text)
    (fmt-emit 1 "guide: docs/LOGOS.md is current\n")
    (g-nothing))
  (if (str-eq actual text)
    (ret 0)
    (g-nothing))
  (letmut got
    (vec :str)
    (make (vec :str)))
  (letmut want
    (vec :str)
    (make (vec :str)))
  (g-split actual got)
  (g-split text want)
  (let status :i64 (g-stale got want))
  (vec-free got)
  (vec-free want)
  (ret status))

(fn g-max :i64 ((x :i64) (y :i64))
  (ret (if (> x y) x y)))

(fn g-zeros :void ((v (ref (vec :i64))) (n :i64))
  (letmut k :i64 0)
  (while (< k n)
    (vec-push v 0)
    (set k (+ k 1)))
  (ret))

(fn g-range :str ((start :i64) (count :i64))
  (ret (if (= count 1)
         (str-from-i64 start)
         (str-concat (str-from-i64 start)
           (str-concat "," (str-from-i64 count))))))

(fn g-hunk-header :str ((s1 :i64) (s2 :i64) (removed :i64) (added :i64))
  (ret (str-concat "@@ -" (str-concat (g-range s1 removed)
                            (str-concat " +" (str-concat (g-range s2 added) " @@"))))))

(fn g-dp-value :i64 ((a (ref (vec :str))) (b (ref (vec :str))) (dp (ref (vec :i64))) (w :i64) (i :i64) (j :i64))
  (let an :i64 (vec-len a))
  (let bn :i64 (vec-len b))
  (if (or (= i an)
        (= j bn))
    (ret 0)
    (g-nothing))
  (if (str-eq (vec-get a i)
        (vec-get b j))
    (ret (+ 1 (vec-get dp (+ (* (+ i 1) w)
                            (+ j 1)))))
    (g-nothing))
  (ret (g-max (vec-get dp (+ (* (+ i 1) w) j))
         (vec-get dp (+ (* i w)
                       (+ j 1))))))

(fn g-dp :void ((a (ref (vec :str))) (b (ref (vec :str))) (dp (ref (vec :i64))) (w :i64))
  (letmut i :i64 (vec-len a))
  (while (>= i 0)
    (letmut j :i64 (vec-len b))
    (while (>= j 0)
      (vec-set dp
        (+ (* i w) j)
        (g-dp-value a b dp w i j))
      (set j (- j 1)))
    (set i (- i 1)))
  (ret))

(fn g-step :i64 ((a (ref (vec :str))) (b (ref (vec :str))) (dp (ref (vec :i64))) (w :i64) (i :i64) (j :i64))
  (let an :i64 (vec-len a))
  (let bn :i64 (vec-len b))
  (if (and (< i an)
        (and (< j bn)
          (str-eq (vec-get a i)
            (vec-get b j))))
    (ret 0)
    (g-nothing))
  (if (= j bn)
    (ret 2)
    (g-nothing))
  (if (= i an)
    (ret 1)
    (g-nothing))
  (ret (if (> (vec-get dp (+ (* i w)
                            (+ j 1)))
             (vec-get dp (+ (* (+ i 1) w) j))) 1 2)))

(fn g-diff-open :void ((out (ref (vec :str))) (st (ref (vec :i64))))
  (if (not (= (vec-get st 4) -1))
    (ret)
    (g-nothing))
  (vec-set st 4 (vec-len out))
  (vec-push out "")
  (vec-set st 5 (vec-get st 2))
  (vec-set st 6 (vec-get st 3))
  (ret))

(fn g-diff-step :void ((a (ref (vec :str))) (b (ref (vec :str))) (dp (ref (vec :i64))) (w :i64) (out (ref (vec :str))) (st (ref (vec :i64))))
  (let i :i64 (vec-get st 0))
  (let j :i64 (vec-get st 1))
  (let s :i64 (g-step a b dp w i j))
  (if (= s 0)
    (g-diff-close out st)
    (g-nothing))
  (if (= s 1)
    (g-diff-open out st)
    (g-nothing))
  (if (= s 1)
    (vec-push out (str-concat "+" (vec-get b j)))
    (g-nothing))
  (if (= s 1)
    (vec-set st 8 (+ (vec-get st 8) 1))
    (g-nothing))
  (if (= s 1)
    (vec-set st 10 (+ (vec-get st 10) 1))
    (g-nothing))
  (if (= s 2)
    (g-diff-open out st)
    (g-nothing))
  (if (= s 2)
    (vec-push out (str-concat "-" (vec-get a i)))
    (g-nothing))
  (if (= s 2)
    (vec-set st 7 (+ (vec-get st 7) 1))
    (g-nothing))
  (if (= s 2)
    (vec-set st 9 (+ (vec-get st 9) 1))
    (g-nothing))
  (if (= s 1)
    (vec-set st 1 (+ j 1))
    (g-nothing))
  (if (= s 1)
    (vec-set st 3 (+ (vec-get st 3) 1))
    (g-nothing))
  (if (= s 2)
    (vec-set st 0 (+ i 1))
    (g-nothing))
  (if (= s 2)
    (vec-set st 2 (+ (vec-get st 2) 1))
    (g-nothing))
  (if (= s 0)
    (vec-set st 0 (+ i 1))
    (g-nothing))
  (if (= s 0)
    (vec-set st 2 (+ (vec-get st 2) 1))
    (g-nothing))
  (if (= s 0)
    (vec-set st 1 (+ j 1))
    (g-nothing))
  (if (= s 0)
    (vec-set st 3 (+ (vec-get st 3) 1))
    (g-nothing))
  (ret))

(fn g-diff-close :void ((out (ref (vec :str))) (st (ref (vec :i64))))
  (if (>= (vec-get st 4) 0)
    (vec-set out
      (vec-get st 4)
      (g-hunk-header (vec-get st 5)
        (vec-get st 6)
        (vec-get st 7)
        (vec-get st 8)))
    (g-nothing))
  (vec-set st 4 -1)
  (vec-set st 7 0)
  (vec-set st 8 0)
  (ret))

(fn g-diff-lines :void ((a (ref (vec :str))) (b (ref (vec :str))) (dp (ref (vec :i64))) (w :i64) (out (ref (vec :str))) (totals (ref (vec :i64))))
  (letmut st
    (vec :i64)
    (make (vec :i64)))
  (vec-push st 0)
  (vec-push st 0)
  (vec-push st 1)
  (vec-push st 1)
  (vec-push st -1)
  (vec-push st 0)
  (vec-push st 0)
  (vec-push st 0)
  (vec-push st 0)
  (vec-push st 0)
  (vec-push st 0)
  (while (or (< (vec-get st 0)
               (vec-len a))
           (< (vec-get st 1)
             (vec-len b)))
    (g-diff-step a b dp w out st))
  (g-diff-close out st)
  (vec-set totals 0 (vec-get st 9))
  (vec-set totals 1 (vec-get st 10))
  (vec-free st)
  (ret))
