  (vec-push out "E0102")
  (vec-push out "wrong arity")
  (vec-push out "E0103")
  (vec-push out "unknown function")
  (vec-push out "E0104")
  (vec-push out "not mutable")
  (vec-push out "E0105")
  (vec-push out "missing return")
  (vec-push out "E0106")
  (vec-push out "integer literal out of range")
  (vec-push out "E0107")
  (vec-push out "unused binding")
  (vec-push out "E0108")
  (vec-push out "the entry point is not callable")
  (vec-push out "E0200")
  (vec-push out "unknown field")
  (vec-push out "E0201")
  (vec-push out "field type mismatch")
  (vec-push out "E0300")
  (vec-push out "use after move")
  (vec-push out "E0301")
  (vec-push out "free of a non-owning pointer")
  (vec-push out "E0302")
  (vec-push out "move out of an immutable binding")
  (vec-push out "E0303")
  (vec-push out "move of a binding declared outside a loop")
  (vec-push out "E0304")
  (vec-push out "ref argument is not a mutable binding")
  (vec-push out "E0305")
  (vec-push out "ref escapes the call")
  (vec-push out "E0400")
  (vec-push out "index type mismatch")
  (vec-push out "E0401")
  (vec-push out "string not a str")
  (vec-push out "E0402")
  (vec-push out "vector value not copyable")
