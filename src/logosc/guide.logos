  (ret))

(fn g-form-docs :void ((out (ref (vec :str))))
  (vec-push out "mod")
  (vec-push out "1")
  (vec-push out "`(mod name)` names the module; one per file")
  (vec-push out "use")
  (vec-push out "1")
  (vec-push out "`(use name)` imports `name.logos` beside this file")
  (vec-push out "fn")
