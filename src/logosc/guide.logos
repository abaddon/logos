(fn g-type-meaning :void ((out (ref (vec :str))))
  (vec-push out "arr")
  (vec-push out "`(arr T n)` a fixed array of n values of T")
  (vec-push out "vec")
  (vec-push out "`(vec T)` a growable array owned by a three-word descriptor")
  (vec-push out "ptr")
  (vec-push out "`(ptr T)` a raw pointer to T")
  (vec-push out "own")
  (vec-push out "`(own T)` an owning pointer, released by `free`")
  (vec-push out "ref")
  (vec-push out "`(ref (vec T))` a non-owning reference to a caller's mutable vector")
  (vec-push out "fn")
  (vec-push out "`(fn (T...) R)` a plain function value")
  (vec-push out "fn*")
  (vec-push out "`(fn* (T...) R)` a capturing closure, confined to its frame")
  (vec-push out "res")
  (vec-push out "`(res T E)` an ok T or an error E; must be handled")
  (vec-push out "opt")
  (vec-push out "`(opt T)` some T or none")
  (vec-push out "shared")
  (vec-push out "`(shared T)` state two threads may touch; required at a boundary")
  (vec-push out "chan")
  (vec-push out "`(chan T)` a blocking channel of T")
  (vec-push out "atomic")
  (vec-push out "`(atomic T)` an atomic cell of T")
  (ret))

(fn g-rules :void ((out (ref (vec :str))))
  (vec-push out "One canonical spelling for every construct.")
  (vec-push out "`logos.fmt` gives every node one printed shape, the parser accepts no aliases, and an unknown head is E0002.")
  (vec-push out "No implicit conversion; `(cast T e)` is the only one.")
  (vec-push out "`types.compatible` requires the same type exactly, so a mixed width or kind is E0100. `cast` converts numbers only.")
  (vec-push out "A binding is block-scoped: function body, if branch, while body, match arm.")
  (vec-push out "`_Env.block()` pushes one scope per block; a name declared inside is gone at the closing parenthesis.")
  (vec-push out "A vector or owner-containing value moves; it is never copied.")
  (vec-push out "`_move_only` and `_consume`: binding it or passing it moves it, and a second use is E0300 or E0402.")
  (vec-push out "A value cannot be read out of a place when it owns memory.")
  (vec-push out "A struct field, an array or vector element and a dereference of an owning type are E0300/E0402 (`_OWNER_PLACE`, `_VEC_PLACE`).")
  (vec-push out "A release inside a loop is refused for a binding declared outside it.")
  (vec-push out "E0303 `LOOP_MOVE`: the body is checked once, so a second pass would read a slot the first emptied.")
  (vec-push out "A capturing closure cannot cross a call boundary.")
  (vec-push out "E0502 `CLOSURE_ESCAPE`: its environment is a slot in the creating frame, and `(fn* ...)` is not `(fn ...)`.")
  (vec-push out "A result must be handled: matched, tried, returned or passed on.")
  (vec-push out "E0602 `UNHANDLED_RESULT` at the binding whose `(res T E)` is dropped in statement position.")
  (vec-push out "Shared state must carry `(shared ...)`.")
  (vec-push out "E0700 `SHARED_MARKER` at the declaration and at the thread boundary, checked through aggregates.")
  (vec-push out "A form the checker accepts, the backend can emit.")
  (vec-push out "Every checker branch has a lowerer branch; a form the backend cannot emit is a compiler bug, never a runtime surprise.")
  (ret))

