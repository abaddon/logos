(mod resolve)

(use lex)

(use tree)

(use map)

(type resolve-error (struct (failed :bool) (code :i64) (path :str) (file :str) (line :i64) (col :i64) (message :str)))

(type resolve-def (struct (name :str) (path :str) (own :i64) (kind :i64)))

(type resolve-mod (struct (name :str) (file :str) (start :i64) (end :i64)))

(fn resolve-pass resolve-error ()
  (ret (make resolve-error false 0 "" "" 0 0 "")))

(fn resolve-located resolve-error ((code :i64) (path :str) (file :str) (line :i64) (col :i64) (message :str))
  (ret (make resolve-error true code path file line col message)))

(fn resolve-fail resolve-error ((code :i64) (path :str) (message :str))
  (ret (resolve-located code path "" 0 0 message)))

(fn resolve-ok :bool ((e resolve-error))
  (ret (not (get e failed))))

(fn resolve-code :str ((code :i64))
  (ret (str-concat "E000" (str-from-i64 code))))

(fn resolve-nothing :void ()
  (ret))

(fn resolve-def-key :str ((slot :i64) (name :str))
  (ret (str-concat (str-concat "d" (str-from-i64 slot))
         (str-concat "\0" name))))

(fn resolve-test-key :str ((slot :i64) (name :str))
  (ret (str-concat (str-concat "t" (str-from-i64 slot))
         (str-concat "\0" name))))

(fn resolve-mod-key :str ((name :str))
  (ret (str-concat "m\0" name)))

(fn resolve-imported-key :str ((slot :i64) (name :str))
  (ret (str-concat (str-concat "i" (str-from-i64 slot))
         (str-concat "\0" name))))

(fn resolve-head :str ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (id :i64))
  (let text :i64 (get (vec-get nodes id) text))
  (ret (if (= text -1) ""
         (vec-get ntexts text))))

(fn resolve-mod-form :i64 ((nodes (ref (vec node))) (ntexts (ref (vec :str))))
  (letmut c :i64 (get (vec-get nodes 0) first))
  (letmut found :i64 -1)
  (while (and (= found -1)
           (not (= c -1)))
    (set found (if (str-eq (resolve-head nodes ntexts c) "mod") c found))
    (set c (get (vec-get nodes c) next)))
  (ret found))

(fn resolve-dir :str ((path :str))
  (let n :i64 (str-len path))
  (letmut i :i64 (- n 1))
  (letmut at :i64 -1)
  (while (and (= at -1)
           (>= i 0))
    (set at (if (= (cast :i64 (str-byte path i)) 47) i at))
    (set i (- i 1)))
  (ret (if (= at -1) ""
         (if (= at 0) "/"
           (str-slice path 0 at)))))

(fn resolve-sibling :str ((dir :str) (name :str))
  (ret (str-concat (if (str-eq dir "") ""
                     (if (str-eq dir "/") "/"
                       (str-concat dir "/")))
         (str-concat name ".logos"))))

(fn resolve-stdlib :str ((name :str))
  (ret (resolve-sibling "src/std" name)))

(fn resolve-key :str ((dir :str) (name :str))
  (ret (str-concat dir (str-concat "\0" name))))

(fn resolve-asked-key :str ((dir :str) (name :str))
  (ret (str-concat "a\0" (resolve-key dir name))))

(fn resolve-exists :bool ((path :str))
  (letmut argv
    (vec :str)
    (make (vec :str)))
  (vec-push argv "-f")
  (vec-push argv path)
  (let r :run (run "test" argv))
  (ret (= (run-status r) 0)))

(fn resolve-active :i64 ((active (ref (vec :str))) (depth :i64) (name :str))
  (letmut i :i64 0)
  (letmut found :i64 -1)
  (while (and (= found -1)
           (< i depth))
    (set found (if (str-eq (vec-get active i) name) i found))
    (set i (+ i 1)))
  (ret found))

(fn resolve-cycle :str ((active (ref (vec :str))) (depth :i64) (from :i64) (name :str))
  (letmut out :str (vec-get active from))
  (letmut i :i64 (+ from 1))
  (while (< i depth)
    (set out (str-concat (str-concat out " -> ")
               (vec-get active i)))
    (set i (+ i 1)))
  (ret (str-concat (str-concat out " -> ") name)))

(fn resolve-mod-find :i64 ((keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))) (name :str))
  (ret (map-get keys vals slots (resolve-mod-key name))))

(fn resolve-mod-file :str ((mods (ref (vec resolve-mod))) (at :i64))
  (ret (get (vec-get mods at) file)))

(fn resolve-mod-set-file :void ((mods (ref (vec resolve-mod))) (at :i64) (file :str))
  (letmut m resolve-mod (vec-get mods at))
  (set-field m file file)
  (vec-set mods at m))

(fn resolve-def-find :i64 ((keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))) (slot :i64) (name :str))
  (ret (map-get keys vals slots (resolve-def-key slot name))))

(fn resolve-def-path :str ((defs (ref (vec resolve-def))) (at :i64))
  (ret (get (vec-get defs at) path)))

(fn resolve-def-put :void ((keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))) (defs (ref (vec resolve-def))) (slot :i64) (name :str) (path :str) (own :i64) (kind :i64))
  (map-put keys vals slots
    (resolve-def-key slot name)
    (vec-len defs))
  (vec-push defs (make resolve-def name path own kind)))

(fn resolve-duplicate resolve-error ((name :str) (first :str) (second :str) (path :str))
  (let short :str (str-concat "duplicate definition '" (str-concat name "'")))
  (ret (if (and (not (str-eq first ""))
             (and (not (str-eq second ""))
               (not (str-eq first second))))
         (resolve-fail 3 path (str-concat short (str-concat ": " (str-concat first (str-concat " and " second)))))
         (resolve-fail 3 path short))))

(fn resolve-second resolve-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (id :i64))
  (let name :i64 (get (vec-get nodes id) name))
  (let path :str (tree-path nodes ntexts 0 id))
  (ret (if (= name -1)
         (resolve-fail 2 path "mod needs a name")
         (resolve-fail 3 path (str-concat "duplicate module '" (str-concat (vec-get ntexts name) "'"))))))

(fn resolve-record resolve-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (id :i64) (slot :i64) (defs (ref (vec resolve-def))) (keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))) (missing :str) (kind :i64))
  (let name :i64 (get (vec-get nodes id) name))
  (let path :str (tree-path nodes ntexts 0 id))
  (ret (if (= name -1)
         (resolve-fail 2 path missing)
         (resolve-record-name nodes ntexts id slot defs keys vals slots path (vec-get ntexts name) kind))))

(fn resolve-record-name resolve-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (id :i64) (slot :i64) (defs (ref (vec resolve-def))) (keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))) (path :str) (name :str) (kind :i64))
  (let at :i64 (resolve-def-find keys vals slots slot name))
  (ret (if (not (= at -1))
         (resolve-duplicate name (resolve-def-path defs at) path path)
         (resolve-record-add keys vals slots defs slot name path kind))))

(fn resolve-record-add resolve-error ((keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))) (defs (ref (vec resolve-def))) (slot :i64) (name :str) (path :str) (kind :i64))
  (resolve-def-put keys vals slots defs slot name path 1 kind)
  (ret (resolve-pass)))

(fn resolve-test-record resolve-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (id :i64) (slot :i64) (test-paths (ref (vec :str))) (keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))))
  (let name :i64 (get (vec-get nodes id) name))
  (let path :str (tree-path nodes ntexts 0 id))
  (ret (if (= name -1)
         (resolve-fail 2 path "test needs a name")
         (resolve-test-store nodes ntexts id slot test-paths keys vals slots path (vec-get ntexts name)))))

(fn resolve-test-store resolve-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (id :i64) (slot :i64) (test-paths (ref (vec :str))) (keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))) (path :str) (name :str))
  (let at :i64 (map-get keys vals slots (resolve-test-key slot name)))
  (ret (if (not (= at -1))
         (resolve-duplicate name (vec-get test-paths at) path path)
         (resolve-test-add slot test-paths keys vals slots name path))))

(fn resolve-test-add resolve-error ((slot :i64) (test-paths (ref (vec :str))) (keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))) (name :str) (path :str))
  (map-put keys vals slots
    (resolve-test-key slot name)
    (vec-len test-paths))
  (vec-push test-paths path)
  (ret (resolve-pass)))

(fn resolve-form resolve-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (id :i64) (kind :str) (slot :i64) (defs (ref (vec resolve-def))) (test-paths (ref (vec :str))) (keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))))
  (ret (if (str-eq kind "fn")
         (resolve-record nodes ntexts id slot defs keys vals slots "fn needs a name" 1)
         (if (str-eq kind "type")
           (resolve-record nodes ntexts id slot defs keys vals slots "type needs a name" 0)
           (if (str-eq kind "extern")
             (resolve-record nodes ntexts id slot defs keys vals slots "extern needs (extern fn name :ret ((p :type) ...))" 2)
             (if (str-eq kind "test")
               (resolve-test-record nodes ntexts id slot test-paths keys vals slots)
               (resolve-fail 2
                 (tree-path nodes ntexts 0 id)
                 (str-concat "unknown node '" (str-concat kind "'")))))))))

(fn resolve-finish :void ((all (ref (vec resolve-def))) (mods (ref (vec resolve-mod))) (slot :i64) (defs (ref (vec resolve-def))))
  (letmut m resolve-mod (vec-get mods slot))
  (set-field m start (vec-len all))
  (vec-set mods slot m)
  (letmut i :i64 0)
  (while (< i (vec-len defs))
    (if (= (get (vec-get defs i) own) 1)
      (resolve-def-append all defs i)
      (resolve-nothing))
    (set i (+ i 1)))
  (set m (vec-get mods slot))
  (set-field m end (vec-len all))
  (vec-set mods slot m))

(fn resolve-def-append :void ((all (ref (vec resolve-def))) (defs (ref (vec resolve-def))) (i :i64))
  (let d resolve-def (vec-get defs i))
  (vec-push all (make resolve-def
                  (get d name)
                  (get d path) 1
                  (get d kind))))

(fn resolve-one resolve-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (form :i64) (file :str) (slot :i64) (id :i64) (defs (ref (vec resolve-def))) (test-paths (ref (vec :str))) (all (ref (vec resolve-def))) (mods (ref (vec resolve-mod))) (active (ref (vec :str))) (depth (ref (vec :i64))) (keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))))
  (let kind :str (resolve-head nodes ntexts id))
  (ret (if (= id form)
         (resolve-pass)
         (if (str-eq kind "mod")
           (resolve-second nodes ntexts id)
           (if (str-eq kind "use")
             (resolve-import nodes ntexts id file slot defs all mods active depth keys vals slots)
             (if (str-eq kind "expect-error")
               (resolve-pass)
               (resolve-form nodes ntexts id kind slot defs test-paths keys vals slots)))))))

(fn resolve-build resolve-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (form :i64) (file :str) (slot :i64) (all (ref (vec resolve-def))) (mods (ref (vec resolve-mod))) (active (ref (vec :str))) (depth (ref (vec :i64))) (keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))))
  (letmut defs
    (vec resolve-def)
    (make (vec resolve-def)))
  (letmut test-paths
    (vec :str)
    (make (vec :str)))
  (letmut err resolve-error (resolve-pass))
  (letmut c :i64 (get (vec-get nodes 0) first))
  (while (and (resolve-ok err)
           (not (= c -1)))
    (set err (resolve-one nodes ntexts form file slot c defs test-paths all mods active depth keys vals slots))
    (set c (get (vec-get nodes c) next)))
  (if (resolve-ok err)
    (resolve-finish all mods slot defs)
    (resolve-nothing))
  (vec-free defs)
  (vec-free test-paths)
  (ret err))

(fn resolve-merge-one resolve-error ((use-path :str) (ask-slot :i64) (d resolve-def) (defs (ref (vec resolve-def))) (keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))))
  (let name :str (get d name))
  (let path :str (get d path))
  (let at :i64 (resolve-def-find keys vals slots ask-slot name))
  (ret (if (not (= at -1))
         (resolve-duplicate name (resolve-def-path defs at) path use-path)
         (resolve-merge-add ask-slot defs keys vals slots d))))

(fn resolve-merge-add resolve-error ((ask-slot :i64) (defs (ref (vec resolve-def))) (keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))) (d resolve-def))
  (resolve-def-put keys vals slots defs ask-slot
    (get d name)
    (get d path) 0
    (get d kind))
  (ret (resolve-pass)))

(fn resolve-merge-kind resolve-error ((use-path :str) (ask-slot :i64) (kind :i64) (s :i64) (e :i64) (all (ref (vec resolve-def))) (defs (ref (vec resolve-def))) (keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))))
  (letmut i :i64 s)
  (letmut err resolve-error (resolve-pass))
  (while (and (resolve-ok err)
           (< i e))
    (let d resolve-def (vec-get all i))
    (if (= (get d kind) kind)
      (set err (resolve-merge-one use-path ask-slot d defs keys vals slots))
      (resolve-nothing))
    (set i (+ i 1)))
  (ret err))

(fn resolve-merge resolve-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (use-path :str) (name :str) (ask-slot :i64) (slot :i64) (defs (ref (vec resolve-def))) (all (ref (vec resolve-def))) (mods (ref (vec resolve-mod))) (keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))))
  (let s :i64 (get (vec-get mods slot) start))
  (let e :i64 (get (vec-get mods slot) end))
  (letmut err resolve-error (resolve-merge-kind use-path ask-slot 0 s e all defs keys vals slots))
  (set err (if (resolve-ok err)
             (resolve-merge-kind use-path ask-slot 1 s e all defs keys vals slots) err))
  (set err (if (resolve-ok err)
             (resolve-merge-kind use-path ask-slot 2 s e all defs keys vals slots) err))
  (if (resolve-ok err)
    (map-put keys vals slots (resolve-imported-key ask-slot name) 1)
    (resolve-nothing))
  (ret err))

(fn resolve-import-merge resolve-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (use-path :str) (name :str) (ask-slot :i64) (slot :i64) (defs (ref (vec resolve-def))) (all (ref (vec resolve-def))) (mods (ref (vec resolve-mod))) (keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))))
  (ret (resolve-merge nodes ntexts use-path name ask-slot slot defs all mods keys vals slots)))

(fn resolve-import-cached resolve-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (use-path :str) (name :str) (ask-slot :i64) (key :str) (slot :i64) (defs (ref (vec resolve-def))) (all (ref (vec resolve-def))) (mods (ref (vec resolve-mod))) (keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))))
  (map-put keys vals slots key slot)
  (ret (resolve-import-merge nodes ntexts use-path name ask-slot slot defs all mods keys vals slots)))

(fn resolve-import-read resolve-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (file :str) (name :str) (use-path :str) (ask-slot :i64) (found :str) (key :str) (defs (ref (vec resolve-def))) (all (ref (vec resolve-def))) (mods (ref (vec resolve-mod))) (active (ref (vec :str))) (depth (ref (vec :i64))) (keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))))
  (let slot :i64 (vec-len mods))
  (let err resolve-error (resolve-load found name use-path all mods active depth keys vals slots))
  (ret (if (resolve-ok err)
         (resolve-import-cached nodes ntexts use-path name ask-slot key slot defs all mods keys vals slots) err)))

(fn resolve-import-load resolve-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (file :str) (name :str) (use-path :str) (ask-slot :i64) (key :str) (defs (ref (vec resolve-def))) (all (ref (vec resolve-def))) (mods (ref (vec resolve-mod))) (active (ref (vec :str))) (depth (ref (vec :i64))) (keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))))
  (let sibling :str (resolve-sibling (resolve-dir file) name))
  (let found :str (if (resolve-exists sibling) sibling
                    (resolve-stdlib name)))
  (ret (if (not (resolve-exists found))
         (resolve-fail 5 use-path (str-concat "unknown module '" (str-concat name "'")))
         (resolve-import-read nodes ntexts file name use-path ask-slot found key defs all mods active depth keys vals slots))))

(fn resolve-import-cache resolve-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (file :str) (name :str) (use-path :str) (ask-slot :i64) (defs (ref (vec resolve-def))) (all (ref (vec resolve-def))) (mods (ref (vec resolve-mod))) (active (ref (vec :str))) (depth (ref (vec :i64))) (keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))))
  (let key :str (resolve-asked-key (resolve-dir file) name))
  (let at :i64 (map-get keys vals slots key))
  (ret (if (not (= at -1))
         (resolve-import-merge nodes ntexts use-path name ask-slot at defs all mods keys vals slots)
         (resolve-import-load nodes ntexts file name use-path ask-slot key defs all mods active depth keys vals slots))))

(fn resolve-import-active resolve-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (file :str) (name :str) (use-path :str) (ask-slot :i64) (defs (ref (vec resolve-def))) (all (ref (vec resolve-def))) (mods (ref (vec resolve-mod))) (active (ref (vec :str))) (depth (ref (vec :i64))) (keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))))
  (let at :i64 (resolve-active active (vec-get depth 0) name))
  (ret (if (not (= at -1))
         (resolve-fail 4 use-path (str-concat "circular import: " (resolve-cycle active (vec-get depth 0) at name)))
         (resolve-import-cache nodes ntexts file name use-path ask-slot defs all mods active depth keys vals slots))))

(fn resolve-import-args resolve-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (file :str) (name :str) (use-path :str) (ask-slot :i64) (defs (ref (vec resolve-def))) (all (ref (vec resolve-def))) (mods (ref (vec resolve-mod))) (active (ref (vec :str))) (depth (ref (vec :i64))) (keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))))
  (ret (if (map-has keys slots (resolve-imported-key ask-slot name))
         (resolve-pass)
         (resolve-import-active nodes ntexts file name use-path ask-slot defs all mods active depth keys vals slots))))

(fn resolve-import resolve-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (use-id :i64) (file :str) (ask-slot :i64) (defs (ref (vec resolve-def))) (all (ref (vec resolve-def))) (mods (ref (vec resolve-mod))) (active (ref (vec :str))) (depth (ref (vec :i64))) (keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))))
  (let arg :i64 (get (vec-get nodes use-id) first))
  (let bad :bool (or (= arg -1)
                   (or (not (= (get (vec-get nodes arg) next) -1))
                     (not (= (get (vec-get nodes arg) tok) 2)))))
  (ret (if bad
         (resolve-fail 2 (tree-path nodes ntexts 0 use-id) "use takes one module name")
         (resolve-import-args nodes ntexts file
           (vec-get ntexts (get (vec-get nodes arg) text))
           (tree-path nodes ntexts 0 use-id) ask-slot defs all mods active depth keys vals slots))))

(fn resolve-treed resolve-error ((path :str) (expected :str) (origin :str) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))) (nodes (ref (vec node))) (ntexts (ref (vec :str))) (all (ref (vec resolve-def))) (mods (ref (vec resolve-mod))) (active (ref (vec :str))) (depth (ref (vec :i64))) (keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))))
  (let terr tree-error (tree-parse kinds texts lines cols nodes ntexts))
  (ret (if (tree-ok terr)
         (resolve-module nodes ntexts path expected origin all mods active depth keys vals slots)
         (resolve-located 1
           (get terr path) path
           (get terr line)
           (get terr col)
           (get terr msg)))))

(fn resolve-load resolve-error ((path :str) (expected :str) (origin :str) (all (ref (vec resolve-def))) (mods (ref (vec resolve-mod))) (active (ref (vec :str))) (depth (ref (vec :i64))) (keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))))
  (let src :str (read-file path))
  (letmut kinds
    (vec :i64)
    (make (vec :i64)))
  (letmut texts
    (vec :str)
    (make (vec :str)))
  (letmut lines
    (vec :i64)
    (make (vec :i64)))
  (letmut cols
    (vec :i64)
    (make (vec :i64)))
  (letmut nodes
    (vec node)
    (make (vec node)))
  (letmut ntexts
    (vec :str)
    (make (vec :str)))
  (let lexed lex-error (lex src kinds texts lines cols))
  (letmut err resolve-error (resolve-pass))
  (if (lex-ok lexed)
    (set err (resolve-treed path expected origin kinds texts lines cols nodes ntexts all mods active depth keys vals slots))
    (set err (resolve-located 6 "" path
               (get lexed line)
               (get lexed col)
               (get lexed msg))))
  (vec-free kinds)
  (vec-free texts)
  (vec-free lines)
  (vec-free cols)
  (vec-free nodes)
  (vec-free ntexts)
  (ret err))

(fn resolve-open resolve-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (file :str) (form :i64) (declared :str) (at :i64) (all (ref (vec resolve-def))) (mods (ref (vec resolve-mod))) (active (ref (vec :str))) (depth (ref (vec :i64))) (keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))))
  (if (and (not (= at -1))
        (str-eq (resolve-mod-file mods at) ""))
    (resolve-mod-set-file mods at file)
    (resolve-nothing))
  (vec-push mods (make resolve-mod declared file 0 0))
  (let slot :i64 (- (vec-len mods) 1))
  (map-put keys vals slots (resolve-mod-key declared) slot)
  (if (< (vec-get depth 0)
        (vec-len active))
    (vec-set active (vec-get depth 0) declared)
    (vec-push active declared))
  (vec-set depth 0 (+ (vec-get depth 0) 1))
  (let err resolve-error (resolve-build nodes ntexts form file slot all mods active depth keys vals slots))
  (vec-set depth 0 (- (vec-get depth 0) 1))
  (ret err))

(fn resolve-claim resolve-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (file :str) (form :i64) (declared :str) (all (ref (vec resolve-def))) (mods (ref (vec resolve-mod))) (active (ref (vec :str))) (depth (ref (vec :i64))) (keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))))
  (let at :i64 (resolve-mod-find keys vals slots declared))
  (let first :str (if (= at -1) ""
                    (resolve-mod-file mods at)))
  (ret (if (and (not (= at -1))
             (and (not (str-eq first ""))
               (not (str-eq first file))))
         (resolve-fail 3
           (tree-path nodes ntexts 0 form)
           (str-concat "duplicate module '" (str-concat declared (str-concat "': " (str-concat first (str-concat " and " file))))))
         (resolve-open nodes ntexts file form declared at all mods active depth keys vals slots))))

(fn resolve-match resolve-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (file :str) (expected :str) (origin :str) (form :i64) (declared :str) (all (ref (vec resolve-def))) (mods (ref (vec resolve-mod))) (active (ref (vec :str))) (depth (ref (vec :i64))) (keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))))
  (ret (if (and (not (str-eq expected ""))
             (not (str-eq declared expected)))
         (resolve-fail 5 origin (str-concat "module '" (str-concat expected (str-concat "' declares itself '" (str-concat declared "'")))))
         (resolve-claim nodes ntexts file form declared all mods active depth keys vals slots))))

(fn resolve-named resolve-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (file :str) (expected :str) (origin :str) (form :i64) (name :i64) (all (ref (vec resolve-def))) (mods (ref (vec resolve-mod))) (active (ref (vec :str))) (depth (ref (vec :i64))) (keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))))
  (ret (if (= name -1)
         (resolve-fail 2 (tree-path nodes ntexts 0 form) "mod needs a name")
         (resolve-match nodes ntexts file expected origin form (vec-get ntexts name) all mods active depth keys vals slots))))

(fn resolve-module resolve-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (file :str) (expected :str) (origin :str) (all (ref (vec resolve-def))) (mods (ref (vec resolve-mod))) (active (ref (vec :str))) (depth (ref (vec :i64))) (keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))))
  (let form :i64 (resolve-mod-form nodes ntexts))
  (ret (if (= form -1)
         (if (str-eq expected "")
           (resolve-fail 2 "" "missing (mod ...) form")
           (resolve-fail 2 origin (str-concat "module '" (str-concat expected "' has no (mod ...) form"))))
         (resolve-named nodes ntexts file expected origin form (get (vec-get nodes form) name) all mods active depth keys vals slots))))

(fn resolve-check resolve-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (path :str) (all (ref (vec resolve-def))) (mods (ref (vec resolve-mod))) (active (ref (vec :str))) (depth (ref (vec :i64))) (keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))))
  (ret (resolve-module nodes ntexts path "" "" all mods active depth keys vals slots)))

(fn resolve-set resolve-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (path :str) (all (ref (vec resolve-def))) (mods (ref (vec resolve-mod))))
  (letmut active
    (vec :str)
    (make (vec :str)))
  (letmut depth
    (vec :i64)
    (make (vec :i64)))
  (vec-push depth 0)
  (letmut keys
    (vec :str)
    (make (vec :str)))
  (letmut vals
    (vec :i64)
    (make (vec :i64)))
  (letmut slots
    (vec :i64)
    (make (vec :i64)))
  (map-init slots 8)
  (letmut err resolve-error (resolve-check nodes ntexts path all mods active depth keys vals slots))
  (vec-free active)
  (vec-free depth)
  (vec-free keys)
  (vec-free vals)
  (vec-free slots)
  (ret err))

(fn resolve-file resolve-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (path :str))
  (letmut all
    (vec resolve-def)
    (make (vec resolve-def)))
  (letmut mods
    (vec resolve-mod)
    (make (vec resolve-mod)))
  (letmut err resolve-error (resolve-set nodes ntexts path all mods))
  (vec-free all)
  (vec-free mods)
  (ret err))
