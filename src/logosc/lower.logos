    (ret (lo-value mtriple mqual snames sbase scount sftys enames ewords gnames gdata dnames dsig dcnt dret sigtys fnames fsyms fint fret fbase fcnt fparam fpc pnames ptys blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals tags tnames elem extra pbase powner tpnames tptypes pchild pvname nod ntx tnk tnv tnl fnk fnv fnl enk env enl vnk vnv vni vnp bindn bindt binds binda plan planty st loopx looph esc cl berr insn ivd ivn ivt ivb ivc curn curt last expected)))
  (ret ""))

(fn lo-match :str ((mtriple (ref (vec :str))) (mqual (ref (vec :i64))) (snames (ref (vec :str))) (sbase (ref (vec :i64))) (scount (ref (vec :i64))) (sftys (ref (vec :i64))) (enames (ref (vec :str))) (ewords (ref (vec :i64))) (gnames (ref (vec :str))) (gdata (ref (vec :str))) (dnames (ref (vec :str))) (dsig (ref (vec :i64))) (dcnt (ref (vec :i64))) (dret (ref (vec :i64))) (sigtys (ref (vec :i64))) (fnames (ref (vec :str))) (fsyms (ref (vec :str))) (fint (ref (vec :i64))) (fret (ref (vec :i64))) (fbase (ref (vec :i64))) (fcnt (ref (vec :i64))) (fparam (ref (vec :i64))) (fpc (ref (vec :i64))) (pnames (ref (vec :str))) (ptys (ref (vec :i64))) (blabels (ref (vec :str))) (bbase (ref (vec :i64))) (bcnt (ref (vec :i64))) (bterm (ref (vec :i64))) (bty (ref (vec :i64))) (bhas (ref (vec :i64))) (bv1 (ref (vec :str))) (bv2 (ref (vec :str))) (bv3 (ref (vec :str))) (ops (ref (vec :i64))) (dests (ref (vec :str))) (sa (ref (vec :str))) (sb (ref (vec :str))) (sc (ref (vec :str))) (sd (ref (vec :str))) (t1 (ref (vec :i64))) (t2 (ref (vec :i64))) (t3 (ref (vec :i64))) (n1 (ref (vec :i64))) (sst (ref (vec :i64))) (scn (ref (vec :i64))) (tst (ref (vec :i64))) (tcn (ref (vec :i64))) (svals (ref (vec :str))) (tvals (ref (vec :i64))) (tags (ref (vec :i64))) (tnames (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (tpnames (ref (vec :str))) (tptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (nod (ref (vec node))) (ntx (ref (vec :str))) (tnk (ref (vec :str))) (tnv (ref (vec :i64))) (tnl (ref (vec :i64))) (fnk (ref (vec :str))) (fnv (ref (vec :i64))) (fnl (ref (vec :i64))) (enk (ref (vec :str))) (env (ref (vec :i64))) (enl (ref (vec :i64))) (vnk (ref (vec :str))) (vnv (ref (vec :i64))) (vni (ref (vec :i64))) (vnp (ref (vec :i64))) (bindn (ref (vec :str))) (bindt (ref (vec :i64))) (binds (ref (vec :str))) (binda (ref (vec :i64))) (plan (ref (vec :str))) (planty (ref (vec :i64))) (st (ref (vec :i64))) (loopx (ref (vec :str))) (looph (ref (vec :str))) (esc (ref (vec :str))) (cl (ref (vec :str))) (berr (ref (vec lower-error))) (insn (ref (vec :str))) (ivd (ref (vec :i64))) (ivn (ref (vec :str))) (ivt (ref (vec :i64))) (ivb (ref (vec :i64))) (ivc (ref (vec :i64))) (curn (ref (vec :str))) (curt (ref (vec :i64))) (node :i64) (expected :i64))
  (let scrut :i64 (lo-child nod ntx node 1))
  (let stype :i64 (lo-type-item mtriple mqual snames sbase scount sftys enames ewords gnames gdata dnames dsig dcnt dret sigtys fnames fsyms fint fret fbase fcnt fparam fpc pnames ptys blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals tags tnames elem extra pbase powner tpnames tptypes pchild pvname nod ntx tnk tnv tnl fnk fnv fnl enk env enl vnk vnv vni vnp bindn bindt binds binda plan planty st loopx looph esc cl berr insn ivd ivn ivt ivb ivc curn curt scrut))
  (let value :str (lo-value mtriple mqual snames sbase scount sftys enames ewords gnames gdata dnames dsig dcnt dret sigtys fnames fsyms fint fret fbase fcnt fparam fpc pnames ptys blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals tags tnames elem extra pbase powner tpnames tptypes pchild pvname nod ntx tnk tnv tnl fnk fnv fnl enk env enl vnk vnv vni vnp bindn bindt binds binda plan planty st loopx looph esc cl berr insn ivd ivn ivt ivb ivc curn curt scrut stype))
  (let isenum :bool (= (vec-get tags stype)
                      (type-tag-enum)))
  (let isres :bool (= (vec-get tags stype)
                     (type-tag-res)))
  (let isopt :bool (= (vec-get tags stype)
                     (type-tag-opt)))
  (let istag :bool (or isenum (or isres isopt)))
  (if (not (or istag (lo-int? tags tnames stype)))
    (ret (lo-not-yet-str nod ntx berr node "match"))
    (lo-nothing))
  (let i32ty :i64 (lo-prim tags tnames elem extra pbase powner "i32"))
  (let boolty :i64 (lo-prim tags tnames elem extra pbase powner "bool"))
  (letmut tagval :str value)
  (letmut memory :str "")
  (if istag
    (set tagval (lo-temp st))
    (lo-nothing))
  (if istag
    (lo-w-extract ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals cl st tagval stype value (if isenum i32ty boolty) 0)
    (lo-nothing))
  (if isenum
    (set memory (lo-slot plan planty st stype ""))
    (lo-nothing))
  (if isenum
    (lo-w-store ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals cl st stype value memory)
    (lo-nothing))
  (let mt :i64 (if (>= expected 0) expected
                 (lo-match-type mtriple mqual snames sbase scount sftys enames ewords gnames gdata dnames dsig dcnt dret sigtys fnames fsyms fint fret fbase fcnt fparam fpc pnames ptys blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals tags tnames elem extra pbase powner tpnames tptypes pchild pvname nod ntx tnk tnv tnl fnk fnv fnl enk env enl vnk vnv vni vnp bindn bindt binds binda plan planty st loopx looph esc cl berr insn ivd ivn ivt ivb ivc curn curt node)))
  (let ty :i64 (if (>= mt 0) mt expected))
  (let void :bool (or (< ty 0)
                    (lo-void? tags tnames ty)))
  (letmut slot :str "")
  (if void
    (lo-nothing)
    (set slot (lo-slot plan planty st ty "")))
  (let wild :bool (lo-has-wildcard nod ntx node))
  (let lbl :i64 (lo-label st))
  (let tag :str (str-concat "match" (str-from-i64 lbl)))
  (let join :str (str-concat tag ".join"))
  (let none :str (str-concat tag ".none"))
  (lo-w-br blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals cl st (str-concat tag ".test0"))
  (letmut c :i64 (lo-child nod ntx node 2))
  (letmut index :i64 0)
  (while (>= c 0)
    (let armh :str (lo-head nod ntx c))
    (let p :i64 (lo-child nod ntx c 0))
    (let pn :i64 (if (< p 0) c p))
    (let pat :str (if (> (str-len armh) 0) armh
                    (lo-head nod ntx p)))
    (let test :str (str-concat tag (str-concat ".test" (str-from-i64 index))))
    (let body :str (str-concat tag (str-concat ".body" (str-from-i64 index))))
    (lo-w-block blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals cl st test)
    (let iswild :bool (if (> (str-len armh) 0)
                        (str-eq armh "_")
                        (and (lo-atom? nod p)
                          (str-eq (lo-atom nod ntx p) "_"))))
    (if iswild
      (lo-w-br blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals cl st body)
      (lo-nothing))
    (let nextc :i64 (get (vec-get nod c) next))
    (let following :str (if (>= nextc 0)
                          (str-concat tag (str-concat ".test" (str-from-i64 (+ index 1))))
                          (if (or wild (not istag))
                            (if wild join none) join)))
    (letmut testv :str "")
    (if (and (not iswild) isenum)
      (set testv (lo-enum-test mtriple mqual snames sbase scount sftys enames ewords gnames gdata dnames dsig dcnt dret sigtys fnames fsyms fint fret fbase fcnt fparam fpc pnames ptys blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals tags tnames elem extra pbase powner tpnames tptypes pchild pvname nod ntx tnk tnv tnl fnk fnv fnl enk env enl vnk vnv vni vnp bindn bindt binds binda plan planty st loopx looph esc cl berr insn ivd ivn ivt ivb ivc curn curt pn pat stype tagval))
      (lo-nothing))
    (if (and (not iswild)
          (not istag))
      (set testv (lo-int-test mtriple mqual snames sbase scount sftys enames ewords gnames gdata dnames dsig dcnt dret sigtys fnames fsyms fint fret fbase fcnt fparam fpc pnames ptys blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals tags tnames elem extra pbase powner tpnames tptypes pchild pvname nod ntx tnk tnv tnl fnk fnv fnl enk env enl vnk vnv vni vnp bindn bindt binds binda plan planty st loopx looph esc cl berr insn ivd ivn ivt ivb ivc curn curt pn stype tagval))
      (lo-nothing))
    (if (and (not iswild)
          (or isres isopt))
      (set testv (lo-tag-test mtriple mqual snames sbase scount sftys enames ewords gnames gdata dnames dsig dcnt dret sigtys fnames fsyms fint fret fbase fcnt fparam fpc pnames ptys blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals tags tnames elem extra pbase powner tpnames tptypes pchild pvname nod ntx tnk tnv tnl fnk fnv fnl enk env enl vnk vnv vni vnp bindn bindt binds binda plan planty st loopx looph esc cl berr insn ivd ivn ivt ivb ivc curn curt pn stype tagval))
      (lo-nothing))
    (if (not iswild)
      (lo-w-cbr blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals cl st testv body following)
      (lo-nothing))
    (set index (+ index 1))
    (set c nextc))
  (if (and (not istag)
        (not wild))
    (lo-w-block blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals cl st none)
    (lo-nothing))
  (if (and (not istag)
        (not wild))
    (lo-panic mtriple mqual snames sbase scount sftys enames ewords gnames gdata dnames dsig dcnt dret sigtys fnames fsyms fint fret fbase fcnt fparam fpc pnames ptys blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals tags tnames elem extra pbase powner tpnames tptypes pchild pvname nod ntx tnk tnv tnl fnk fnv fnl enk env enl vnk vnv vni vnp bindn bindt binds binda plan planty st loopx looph esc cl berr insn ivd ivn ivt ivb ivc curn curt node "R0003" "no match arm matched")
    (lo-nothing))
  (letmut c2 :i64 (lo-child nod ntx node 2))
  (letmut idx2 :i64 0)
  (letmut fell :bool false)
  (while (>= c2 0)
    (let body :str (str-concat tag (str-concat ".body" (str-from-i64 idx2))))
    (lo-w-block blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals cl st body)
    (let base :i64 (vec-len bindn))
    (let p :i64 (lo-child nod ntx c2 0))
    (let pname :i64 (lo-child nod ntx p 1))
    (if (and isenum (and (>= pname 0)
                      (not (str-eq (lo-atom nod ntx pname) "_"))))
      (lo-arm-bind mtriple mqual snames sbase scount sftys enames ewords gnames gdata dnames dsig dcnt dret sigtys fnames fsyms fint fret fbase fcnt fparam fpc pnames ptys blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals tags tnames elem extra pbase powner tpnames tptypes pchild pvname nod ntx tnk tnv tnl fnk fnv fnl enk env enl vnk vnv vni vnp bindn bindt binds binda plan planty st loopx looph esc cl berr insn ivd ivn ivt ivb ivc curn curt p pname stype memory)
      (lo-nothing))
    (if (and istag (not isenum))
      (lo-tag-bind mtriple mqual snames sbase scount sftys enames ewords gnames gdata dnames dsig dcnt dret sigtys fnames fsyms fint fret fbase fcnt fparam fpc pnames ptys blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals tags tnames elem extra pbase powner tpnames tptypes pchild pvname nod ntx tnk tnv tnl fnk fnv fnl enk env enl vnk vnv vni vnp bindn bindt binds binda plan planty st loopx looph esc cl berr insn ivd ivn ivt ivb ivc curn curt p stype value)
      (lo-nothing))
    (let arm :str (lo-arm mtriple mqual snames sbase scount sftys enames ewords gnames gdata dnames dsig dcnt dret sigtys fnames fsyms fint fret fbase fcnt fparam fpc pnames ptys blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals tags tnames elem extra pbase powner tpnames tptypes pchild pvname nod ntx tnk tnv tnl fnk fnv fnl enk env enl vnk vnv vni vnp bindn bindt binds binda plan planty st loopx looph esc cl berr insn ivd ivn ivt ivb ivc curn curt c2 void expected))
    (if (and (not void)
          (not (str-eq arm "")))
      (lo-w-store ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals cl st ty arm slot)
      (lo-nothing))
    (lo-close-scope binda base)
    (if (lo-closed st)
      (lo-nothing)
      (set fell true))
    (if (lo-closed st)
      (lo-nothing)
      (lo-w-br blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals cl st join))
    (set idx2 (+ idx2 1))
    (set c2 (get (vec-get nod c2) next)))
  (lo-w-block blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals cl st join)
  (if fell
    (lo-nothing)
    (lo-w-unreachable blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals cl st))
  (if (or void (< ty 0))
    (ret "")
    (lo-nothing))
  (let dest :str (lo-temp st))
  (lo-w-load ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals cl st dest ty slot)
  (ret dest))

