(mod lower)

(use tree)

(use lex)

(use types)

(use ir)

(use emit)

(use map)

(extern fn rt_parse_f64 :f64 ((s :str)))

(type lower-error (struct (failed :bool) (code :i64) (path :str) (message :str)))

(fn lower-pass lower-error ()
  (ret (make lower-error false 0 "" "")))

(fn lower-fail lower-error ((code :i64) (path :str) (message :str))
  (ret (make lower-error true code path message)))

(fn lower-ok :bool ((e lower-error))
  (ret (not (get e failed))))

(fn lower-code :str ((n :i64))
  (ret (type-code n)))

(fn lo-nothing :void ()
  (ret))

(fn lo-bad :bool ((berr (ref (vec lower-error))))
  (ret (if (= (vec-len berr) 0) false
         (get (vec-get berr 0) failed))))

(fn lo-fail lower-error ((berr (ref (vec lower-error))) (code :i64) (path :str) (message :str))
  (if (lo-bad berr)
    (ret (vec-get berr 0))
    (lo-nothing))
  (let e lower-error (make lower-error true code path message))
  (vec-set berr 0 e)
  (ret e))

(fn lo-path :str ((nod (ref (vec node))) (ntx (ref (vec :str))) (id :i64))
  (ret (if (or (< id 0)
             (not (= (get (vec-get nod id) tok) -1))) ""
         (tree-path nod ntx 0 id))))

(fn lo-fail-at lower-error ((nod (ref (vec node))) (ntx (ref (vec :str))) (berr (ref (vec lower-error))) (id :i64) (code :i64) (message :str))
  (ret (lo-fail berr code (lo-path nod ntx id) message)))

(fn lo-atom? :bool ((nod (ref (vec node))) (id :i64))
  (ret (and (>= id 0)
         (= (get (vec-get nod id) tok) 2))))

(fn lo-atom :str ((nod (ref (vec node))) (ntx (ref (vec :str))) (id :i64))
  (ret (if (lo-atom? nod id)
         (vec-get ntx (get (vec-get nod id) text)) "")))

(fn lo-lit-text :str ((nod (ref (vec node))) (ntx (ref (vec :str))) (id :i64))
  (let t :i64 (if (< id 0) -1
                (get (vec-get nod id) text)))
  (ret (if (< t 0) ""
         (vec-get ntx t))))

(fn lo-number? :bool ((nod (ref (vec node))) (id :i64))
  (ret (and (>= id 0)
         (= (get (vec-get nod id) tok) 4))))

(fn lo-string? :bool ((nod (ref (vec node))) (id :i64))
  (ret (and (>= id 0)
         (= (get (vec-get nod id) tok) 3))))

(fn lo-form? :bool ((nod (ref (vec node))) (id :i64))
  (ret (and (>= id 0)
         (= (get (vec-get nod id) tok) -1))))

(fn lo-child :i64 ((nod (ref (vec node))) (ntx (ref (vec :str))) (id :i64) (k :i64))
  (if (< id 0)
    (ret -1)
    (lo-nothing))
  (let tx :i64 (get (vec-get nod id) text))
  (let nm :i64 (get (vec-get nod id) name))
  (letmut idx :i64 k)
  (if (>= tx 0)
    (if (= nm -1)
      (if (= k 0)
        (ret -1)
        (set idx (- k 1)))
      (if (str-eq (vec-get ntx tx) "extern")
        (if (< k 3)
          (ret -1)
          (set idx (- k 3)))
        (if (< k 2)
          (ret -1)
          (set idx (- k 2)))))
    (lo-nothing))
  (letmut c :i64 (get (vec-get nod id) first))
  (letmut i :i64 0)
  (while (and (< i idx)
           (>= c 0))
    (set c (get (vec-get nod c) next))
    (set i (+ i 1)))
  (ret c))

(fn lo-count :i64 ((nod (ref (vec node))) (ntx (ref (vec :str))) (id :i64))
  (let tx :i64 (if (< id 0) -1
                 (get (vec-get nod id) text)))
  (let nm :i64 (if (< id 0) -1
                 (get (vec-get nod id) name)))
  (letmut c :i64 (if (< id 0) -1
                   (get (vec-get nod id) first)))
  (letmut n :i64 0)
  (while (>= c 0)
    (set c (get (vec-get nod c) next))
    (set n (+ n 1)))
  (ret (if (< tx 0) n
         (if (= nm -1)
           (+ n 1)
           (if (str-eq (vec-get ntx tx) "extern")
             (+ n 3)
             (+ n 2))))))

(fn lo-name :str ((nod (ref (vec node))) (ntx (ref (vec :str))) (id :i64))
  (let nm :i64 (if (< id 0) -1
                 (get (vec-get nod id) name)))
  (ret (if (< nm 0) ""
         (vec-get ntx nm))))

(fn lo-head :str ((nod (ref (vec node))) (ntx (ref (vec :str))) (id :i64))
  (let t :i64 (if (< id 0) -1
                (get (vec-get nod id) text)))
  (ret (if (< t 0) ""
         (vec-get ntx t))))

(fn lo-typed? :bool ((s :str))
  (ret (and (> (str-len s) 0)
         (= (str-byte s 0) 58))))

(fn lo-marker? :bool ((nod (ref (vec node))) (ntx (ref (vec :str))) (id :i64))
  (ret (and (lo-atom? nod id)
         (str-eq (lo-atom nod ntx id) ":"))))

(fn lo-type-form? :bool ((h :str))
  (ret (or (str-eq h "ptr")
         (or (str-eq h "own")
           (or (str-eq h "arr")
             (or (str-eq h "vec")
               (or (str-eq h "ref")
                 (or (str-eq h "res")
                   (or (str-eq h "opt")
                     (or (str-eq h "fn")
                       (or (str-eq h "fn*")
                         (or (str-eq h "shared")
                           (or (str-eq h "chan")
                             (str-eq h "atomic"))))))))))))))

(fn lo-arith-head? :bool ((h :str))
  (ret (or (str-eq h "+")
         (or (str-eq h "-")
           (or (str-eq h "*")
             (or (str-eq h "/")
               (str-eq h "%")))))))

(fn lo-shift-head? :bool ((h :str))
  (ret (or (str-eq h "shl")
         (or (str-eq h "shr")
           (str-eq h "shr-u")))))

(fn lo-cmp-head? :bool ((h :str))
  (ret (or (str-eq h "=")
         (or (str-eq h "!=")
           (or (str-eq h "<")
             (or (str-eq h "<=")
               (or (str-eq h ">")
                 (str-eq h ">="))))))))

(fn lo-norm-int :str ((s :str))
  (letmut i :i64 0)
  (letmut neg :bool false)
  (if (and (> (str-len s) 0)
        (= (str-byte s 0) 45))
    (set neg true)
    (lo-nothing))
  (if (and (> (str-len s) 0)
        (= (str-byte s 0) 43))
    (set i 1)
    (lo-nothing))
  (if neg
    (set i 1)
    (lo-nothing))
  (while (and (< i (- (str-len s) 1))
           (= (str-byte s i) 48))
    (set i (+ i 1)))
  (let body :str (str-slice s i (str-len s)))
  (if (and neg (not (str-eq body "0")))
    (ret (str-concat "-" body))
    (lo-nothing))
  (ret body))

(fn lo-float-lit? :bool ((s :str))
  (letmut i :i64 0)
  (letmut found :bool false)
  (while (< i (str-len s))
    (let b :i64 (cast :i64 (str-byte s i)))
    (if (or (= b 46)
          (or (= b 101)
            (= b 69)))
      (set found true)
      (lo-nothing))
    (set i (+ i 1)))
  (ret found))

(fn lo-hexdigit :str ((d :i64))
  (ret (str-slice "0123456789ABCDEF" d (+ d 1))))

(fn lo-hex16 :str ((n :i64))
  (letmut u :u64 (cast :u64 n))
  (letmut s :str "")
  (letmut i :i64 15)
  (while (>= i 0)
    (let d :u64 (% (/ u (cast :u64 (shl 1 (* i 4)))) 16))
    (set s (str-concat s (lo-hexdigit (cast :i64 d))))
    (set i (- i 1)))
  (ret (str-concat "0x" s)))

(fn lo-pow2 :f64 ((n :i64))
  (letmut v :f64 1.0)
  (letmut i :i64 0)
  (while (< i n)
    (set v (* v 2.0))
    (set i (+ i 1)))
  (ret v))

(fn lo-int-range-f :f64 ((tnames (ref (vec :str))) (ty :i64) (high :bool))
  (let w :i64 (lo-width tnames ty))
  (if high
    (ret (if (lo-unsigned? tnames ty)
           (lo-pow2 w)
           (lo-pow2 (- w 1))))
    (lo-nothing))
  (ret (if (lo-unsigned? tnames ty) 0.0
         (- 0.0 (lo-pow2 (- w 1))))))

(fn lo-float-at :str ((tnames (ref (vec :str))) (ty :i64) (v :f64))
  (if (str-eq (vec-get tnames ty) "f32")
    (ret (lo-hex16 (f64-bits (cast :f64 (cast :f32 v)))))
    (lo-nothing))
  (ret (lo-hex16 (f64-bits v))))

(fn lo-float-value :f64 ((s :str))
  (ret (rt_parse_f64 s)))

(fn lo-float-text :str ((s :str))
  (ret (lo-hex16 (f64-bits (lo-float-value s)))))

(fn lo-float-text-single :str ((s :str))
  (ret (lo-hex16 (f64-bits (cast :f64 (cast :f32 (lo-float-value s)))))))

(fn lo-prim :i64 ((tags (ref (vec :i64))) (tnames (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (name :str))
  (ret (type-prim tags tnames elem extra pbase powner name)))

(fn lo-ptr :i64 ((tags (ref (vec :i64))) (tnames (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (child :i64))
  (ret (type-ptr tags tnames elem extra pbase powner child)))

(fn lo-ptr-of :i64 ((tags (ref (vec :i64))) (tnames (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (ty :i64))
  (ret (lo-ptr tags tnames elem extra pbase powner (vec-get elem ty))))

(fn lo-own :i64 ((tags (ref (vec :i64))) (tnames (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (child :i64))
  (ret (type-own tags tnames elem extra pbase powner child)))

(fn lo-prim? :bool ((tags (ref (vec :i64))) (tnames (ref (vec :str))) (ty :i64) (name :str))
  (ret (and (>= ty 0)
         (and (= (vec-get tags ty) 0)
           (str-eq (vec-get tnames ty) name)))))

(fn lo-void? :bool ((tags (ref (vec :i64))) (tnames (ref (vec :str))) (ty :i64))
  (ret (lo-prim? tags tnames ty "void")))

(fn lo-int? :bool ((tags (ref (vec :i64))) (tnames (ref (vec :str))) (ty :i64))
  (ret (and (>= ty 0)
         (if (not (= (vec-get tags ty) 0)) false
           (if (str-eq (vec-get tnames ty) "i8") true
             (if (str-eq (vec-get tnames ty) "i16") true
               (if (str-eq (vec-get tnames ty) "i32") true
                 (if (str-eq (vec-get tnames ty) "i64") true
                   (if (str-eq (vec-get tnames ty) "u8") true
                     (if (str-eq (vec-get tnames ty) "u16") true
                       (if (str-eq (vec-get tnames ty) "u32") true
                         (str-eq (vec-get tnames ty) "u64"))))))))))))

(fn lo-float-ty? :bool ((tags (ref (vec :i64))) (tnames (ref (vec :str))) (ty :i64))
  (ret (and (>= ty 0)
         (if (not (= (vec-get tags ty) 0)) false
           (if (str-eq (vec-get tnames ty) "f32") true
             (str-eq (vec-get tnames ty) "f64"))))))

(fn lo-unsigned? :bool ((tnames (ref (vec :str))) (ty :i64))
  (let n :str (vec-get tnames ty))
  (ret (and (> (str-len n) 0)
         (= (str-byte n 0) 117))))

(fn lo-width :i64 ((tnames (ref (vec :str))) (ty :i64))
  (let n :str (vec-get tnames ty))
  (ret (if (str-eq n "i8") 8
         (if (str-eq n "u8") 8
           (if (str-eq n "i16") 16
             (if (str-eq n "u16") 16
               (if (str-eq n "i32") 32
                 (if (str-eq n "u32") 32
                   (if (str-eq n "bool") 1
                     (if (str-eq n "f32") 32
                       (if (str-eq n "f64") 64 64)))))))))))

(fn lo-int-min :str ((tnames (ref (vec :str))) (ty :i64))
  (let n :str (vec-get tnames ty))
  (ret (if (str-eq n "i8") "-128"
         (if (str-eq n "i16") "-32768"
           (if (str-eq n "i32") "-2147483648" "-9223372036854775808")))))

(fn lo-max :i64 ((a :i64) (b :i64))
  (ret (if (> a b) a b)))

(fn lo-size :i64 ((tags (ref (vec :i64))) (tnames (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pchild (ref (vec :i64))) (ty :i64))
  (let tag :i64 (vec-get tags ty))
  (if (= tag 0)
    (ret (if (str-eq (vec-get tnames ty) "i8") 1
           (if (str-eq (vec-get tnames ty) "u8") 1
             (if (str-eq (vec-get tnames ty) "bool") 1
               (if (str-eq (vec-get tnames ty) "i16") 2
                 (if (str-eq (vec-get tnames ty) "u16") 2
                   (if (str-eq (vec-get tnames ty) "i32") 4
                     (if (str-eq (vec-get tnames ty) "u32") 4
                       (if (str-eq (vec-get tnames ty) "f32") 4
                         (if (str-eq (vec-get tnames ty) "void") 0
                           (if (str-eq (vec-get tnames ty) "str") 16 8)))))))))))
    (lo-nothing))
  (if (= tag 3)
    (ret (* (vec-get extra ty)
           (lo-size tags tnames elem extra pbase pchild (vec-get elem ty))))
    (lo-nothing))
  (if (= tag 12)
    (ret (lo-size-struct tags tnames elem extra pbase pchild ty))
    (lo-nothing))
  (if (= tag 13)
    (ret (+ 8 (* 8 (lo-enum-words tags tnames elem extra pbase pchild ty))))
    (lo-nothing))
  (if (= tag 4)
    (ret 24)
    (lo-nothing))
  (ret 8))

(fn lo-pad :i64 ((n :i64) (a :i64))
  (letmut unit :i64 a)
  (if (< unit 1)
    (set unit 1)
    (lo-nothing))
  (ret (* (/ (+ n (- unit 1)) unit) unit)))

(fn lo-align-of :i64 ((tags (ref (vec :i64))) (tnames (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pchild (ref (vec :i64))) (ty :i64))
  (let tag :i64 (vec-get tags ty))
  (if (= tag 0)
    (ret (lo-prim-align (vec-get tnames ty)
           (lo-size tags tnames elem extra pbase pchild ty)))
    (lo-nothing))
  (if (= tag 12)
    (ret (lo-align-fields tags tnames elem extra pbase pchild ty))
    (lo-nothing))
  (if (= tag 13)
    (ret 8)
    (lo-nothing))
  (if (= tag 4)
    (ret 8)
    (lo-nothing))
  (if (or (= tag 3)
        (or (= tag 9)
          (= tag 14)))
    (ret (lo-align-of tags tnames elem extra pbase pchild (vec-get elem ty)))
    (lo-nothing))
  (if (= tag 6)
    (ret (lo-max 1 (lo-max (lo-align-of tags tnames elem extra pbase pchild (vec-get elem ty))
                     (lo-align-of tags tnames elem extra pbase pchild (vec-get extra ty)))))
    (lo-nothing))
  (if (= tag 7)
    (ret (lo-max 1 (lo-align-of tags tnames elem extra pbase pchild (vec-get elem ty))))
    (lo-nothing))
  (ret 8))

(fn lo-align-fields :i64 ((tags (ref (vec :i64))) (tnames (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pchild (ref (vec :i64))) (ty :i64))
  (let base :i64 (vec-get pbase ty))
  (let count :i64 (vec-get extra ty))
  (letmut best :i64 1)
  (letmut k :i64 0)
  (while (< k count)
    (set best (lo-max best (lo-align-of tags tnames elem extra pbase pchild (vec-get pchild (+ base k)))))
    (set k (+ k 1)))
  (ret best))

(fn lo-vec-has :bool ((v (ref (vec :i64))) (x :i64))
  (letmut i :i64 0)
  (letmut found :bool false)
  (while (and (< i (vec-len v))
           (not found))
    (if (= (vec-get v i) x)
      (set found true)
      (lo-nothing))
    (set i (+ i 1)))
  (ret found))

(fn lo-reaches :bool ((tags (ref (vec :i64))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pchild (ref (vec :i64))) (ty :i64) (target :i64) (seen (ref (vec :i64))))
  (if (< ty 0)
    (ret false)
    (lo-nothing))
  (if (= ty target)
    (ret true)
    (lo-nothing))
  (if (lo-vec-has seen ty)
    (ret false)
    (lo-nothing))
  (vec-push seen ty)
  (let tag :i64 (vec-get tags ty))
  (if (or (= tag 12)
        (= tag 13))
    (ret (lo-reaches-fields tags elem extra pbase pchild ty target seen))
    (lo-nothing))
  (if (or (= tag 3)
        (or (= tag 9)
          (= tag 14)))
    (ret (lo-reaches tags elem extra pbase pchild (vec-get elem ty) target seen))
    (lo-nothing))
  (if (= tag 6)
    (ret (or (lo-reaches tags elem extra pbase pchild (vec-get elem ty) target seen)
           (lo-reaches tags elem extra pbase pchild (vec-get extra ty) target seen)))
    (lo-nothing))
  (if (= tag 7)
    (ret (lo-reaches tags elem extra pbase pchild (vec-get elem ty) target seen))
    (lo-nothing))
  (ret false))

(fn lo-reaches-fields :bool ((tags (ref (vec :i64))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pchild (ref (vec :i64))) (ty :i64) (target :i64) (seen (ref (vec :i64))))
  (let base :i64 (vec-get pbase ty))
  (let count :i64 (vec-get extra ty))
  (letmut hit :bool false)
  (letmut k :i64 0)
  (while (and (< k count)
           (not hit))
    (if (lo-reaches tags elem extra pbase pchild (vec-get pchild (+ base k)) target seen)
      (set hit true)
      (lo-nothing))
    (set k (+ k 1)))
  (ret hit))

(fn lo-var-reach :bool ((tags (ref (vec :i64))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pchild (ref (vec :i64))) (tptypes (ref (vec :i64))) (ty :i64) (seen (ref (vec :i64))))
  (if (< ty 0)
    (ret false)
    (lo-nothing))
  (let tag :i64 (vec-get tags ty))
  (if (= tag 14)
    (ret true)
    (lo-nothing))
  (if (lo-vec-has seen ty)
    (ret false)
    (lo-nothing))
  (vec-push seen ty)
  (if (= tag 6)
    (ret (or (lo-var-reach tags elem extra pbase pchild tptypes (vec-get elem ty) seen)
           (lo-var-reach tags elem extra pbase pchild tptypes (vec-get extra ty) seen)))
    (lo-nothing))
  (if (= tag 8)
    (ret (lo-var-fn tags elem extra pbase pchild tptypes ty seen))
    (lo-nothing))
  (if (or (= tag 1)
        (or (= tag 2)
          (or (= tag 3)
            (or (= tag 4)
              (or (= tag 5)
                (or (= tag 7)
                  (or (= tag 9)
                    (or (= tag 10)
                      (= tag 11)))))))))
    (ret (lo-var-reach tags elem extra pbase pchild tptypes (vec-get elem ty) seen))
    (lo-nothing))
  (ret false))

(fn lo-var-fn :bool ((tags (ref (vec :i64))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pchild (ref (vec :i64))) (tptypes (ref (vec :i64))) (ty :i64) (seen (ref (vec :i64))))
  (letmut hit :bool (lo-var-reach tags elem extra pbase pchild tptypes (vec-get elem ty) seen))
  (let arity :i64 (vec-get extra ty))
  (letmut i :i64 0)
  (while (and (< i arity)
           (not hit))
    (if (lo-var-reach tags elem extra pbase pchild tptypes (vec-get tptypes (+ (vec-get pbase ty) i)) seen)
      (set hit true)
      (lo-nothing))
    (set i (+ i 1)))
  (ret hit))

(fn lo-sig-var :bool ((tags (ref (vec :i64))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pchild (ref (vec :i64))) (tptypes (ref (vec :i64))) (sig :i64) (seen (ref (vec :i64))))
  (if (lo-var-reach tags elem extra pbase pchild tptypes (vec-get elem sig) seen)
    (ret true)
    (lo-nothing))
  (let arity :i64 (vec-get extra sig))
  (letmut hit :bool false)
  (letmut i :i64 0)
  (while (and (< i arity)
           (not hit))
    (if (lo-var-reach tags elem extra pbase pchild tptypes (vec-get tptypes (+ (vec-get pbase sig) i)) seen)
      (set hit true)
      (lo-nothing))
    (set i (+ i 1)))
  (ret hit))

(fn lo-size-struct :i64 ((tags (ref (vec :i64))) (tnames (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pchild (ref (vec :i64))) (ty :i64))
  (let base :i64 (vec-get pbase ty))
  (let count :i64 (vec-get extra ty))
  (letmut total :i64 0)
  (letmut best :i64 1)
  (letmut k :i64 0)
  (while (< k count)
    (let fty :i64 (vec-get pchild (+ base k)))
    (let fa :i64 (lo-align-of tags tnames elem extra pbase pchild fty))
    (set total (lo-pad total fa))
    (set total (+ total (lo-size tags tnames elem extra pbase pchild fty)))
    (set best (lo-max best fa))
    (set k (+ k 1)))
  (ret (lo-pad total best)))

(fn lo-enum-words :i64 ((tags (ref (vec :i64))) (tnames (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pchild (ref (vec :i64))) (ty :i64))
  (let base :i64 (vec-get pbase ty))
  (let count :i64 (vec-get extra ty))
  (letmut best :i64 0)
  (letmut k :i64 0)
  (while (< k count)
    (let p :i64 (vec-get pchild (+ base k)))
    (if (>= p 0)
      (set best (lo-max best (lo-size tags tnames elem extra pbase pchild p)))
      (lo-nothing))
    (set k (+ k 1)))
  (ret (/ (+ best 7) 8)))

(fn lo-named :i64 ((tnk (ref (vec :str))) (tnv (ref (vec :i64))) (tnl (ref (vec :i64))) (name :str))
  (ret (map-get tnk tnv tnl name)))

(fn lo-fn-key :str ((mod :str) (name :str))
  (ret (str-concat mod (str-concat "\0" name))))

(fn lo-fn-id :i64 ((fnk (ref (vec :str))) (fnv (ref (vec :i64))) (fnl (ref (vec :i64))) (nod (ref (vec node))) (ntx (ref (vec :str))) (cl (ref (vec :str))) (name :str))
  (let own :i64 (map-get fnk fnv fnl (lo-fn-key (vec-get cl 1) name)))
  (if (>= own 0)
    (ret own)
    (lo-nothing))
  (letmut u :i64 (lo-child nod ntx 0 0))
  (letmut found :i64 -1)
  (while (and (>= u 0)
           (= found -1))
    (if (str-eq (lo-head nod ntx u) "use")
      (set found (map-get fnk fnv fnl (lo-fn-key (lo-atom nod ntx (lo-child nod ntx u 1)) name)))
      (lo-nothing))
    (set u (get (vec-get nod u) next)))
  (ret found))

(fn lo-ext-id :i64 ((enk (ref (vec :str))) (env (ref (vec :i64))) (enl (ref (vec :i64))) (name :str))
  (ret (map-get enk env enl name)))

(fn lo-sig-param :i64 ((tptypes (ref (vec :i64))) (pbase (ref (vec :i64))) (sig :i64) (i :i64))
  (ret (type-param-type tptypes pbase sig i)))

(fn lo-field-index :i64 ((pbase (ref (vec :i64))) (extra (ref (vec :i64))) (pvname (ref (vec :str))) (ty :i64) (name :str))
  (let base :i64 (vec-get pbase ty))
  (let count :i64 (vec-get extra ty))
  (letmut k :i64 0)
  (letmut found :i64 -1)
  (while (< k count)
    (if (str-eq (vec-get pvname (+ base k)) name)
      (set found k)
      (lo-nothing))
    (set k (+ k 1)))
  (ret found))

(fn lo-field-type :i64 ((pbase (ref (vec :i64))) (pchild (ref (vec :i64))) (ty :i64) (index :i64))
  (ret (vec-get pchild (+ (vec-get pbase ty) index))))

(fn lo-variant-find :i64 ((vnk (ref (vec :str))) (vnv (ref (vec :i64))) (name :str) (enum :i64))
  (letmut i :i64 0)
  (letmut found :i64 -1)
  (while (< i (vec-len vnk))
    (if (and (str-eq (vec-get vnk i) name)
          (= (vec-get vnv i) enum))
      (set found i)
      (lo-nothing))
    (set i (+ i 1)))
  (ret found))

(fn lo-variant-any :i64 ((vnk (ref (vec :str))) (name :str))
  (letmut i :i64 0)
  (letmut found :i64 -1)
  (while (< i (vec-len vnk))
    (if (str-eq (vec-get vnk i) name)
      (set found i)
      (lo-nothing))
    (set i (+ i 1)))
  (ret found))

(fn lo-intern :str ((gnames (ref (vec :str))) (gdata (ref (vec :str))) (st (ref (vec :i64))) (data :str))
  (if (= (vec-get st 4) 1)
    (ret "")
    (lo-nothing))
  (letmut i :i64 0)
  (letmut found :i64 -1)
  (while (< i (vec-len gdata))
    (if (str-eq (vec-get gdata i) data)
      (set found i)
      (lo-nothing))
    (set i (+ i 1)))
  (if (>= found 0)
    (ret (vec-get gnames found))
    (lo-nothing))
  (vec-push gnames (str-concat ".str" (str-from-i64 (vec-len gnames))))
  (vec-push gdata data)
  (ret (vec-get gnames (- (vec-len gnames) 1))))

(fn lo-cstring :str ((gnames (ref (vec :str))) (gdata (ref (vec :str))) (st (ref (vec :i64))) (data :str))
  (ret (lo-intern gnames gdata st (str-concat data "\0"))))

(fn lo-lookup :i64 ((bindn (ref (vec :str))) (binda (ref (vec :i64))) (name :str))
  (letmut i :i64 (- (vec-len bindn) 1))
  (letmut found :i64 -1)
  (while (and (>= i 0)
           (= found -1))
    (if (and (= (vec-get binda i) 1)
          (str-eq (vec-get bindn i) name))
      (set found i)
      (lo-nothing))
    (set i (- i 1)))
  (ret found))

(fn lo-bind-row :void ((bindn (ref (vec :str))) (bindt (ref (vec :i64))) (binds (ref (vec :str))) (binda (ref (vec :i64))) (name :str) (ty :i64) (slot :str))
  (vec-push bindn name)
  (vec-push bindt ty)
  (vec-push binds slot)
  (vec-push binda 1)
  (ret))

(fn lo-ref-slot :str ((nod (ref (vec node))) (ntx (ref (vec :str))) (tags (ref (vec :i64))) (bindn (ref (vec :str))) (bindt (ref (vec :i64))) (binds (ref (vec :str))) (binda (ref (vec :i64))) (arg :i64) (pty :i64))
  (letmut found :str "")
  (letmut b :i64 -1)
  (if (and (lo-atom? nod arg)
        (= (vec-get tags pty) 5))
    (set b (lo-lookup bindn binda (lo-atom nod ntx arg)))
    (lo-nothing))
  (if (and (>= b 0)
        (not (= (vec-get tags (vec-get bindt b)) 5)))
    (set found (vec-get binds b))
    (lo-nothing))
  (ret found))

(fn lo-close-scope :void ((binda (ref (vec :i64))) (base :i64))
  (letmut i :i64 base)
  (while (< i (vec-len binda))
    (vec-set binda i 0)
    (set i (+ i 1)))
  (ret))

(fn lo-temp :str ((st (ref (vec :i64))))
  (let n :i64 (+ (vec-get st 0) 1))
  (vec-set st 0 n)
  (ret (str-concat "%t" (str-from-i64 n))))

(fn lo-binding :str ((st (ref (vec :i64))))
  (let n :i64 (vec-get st 1))
  (vec-set st 1 (+ n 1))
  (ret (str-concat "%v." (str-from-i64 n))))

(fn lo-slot-dry :str ((plan (ref (vec :str))) (planty (ref (vec :i64))) (st (ref (vec :i64))) (ty :i64) (owner :str))
  (letmut name :str owner)
  (if (str-eq name "")
    (set name (lo-binding st))
    (lo-nothing))
  (let addr :str (str-concat name ".addr"))
  (vec-push plan addr)
  (vec-push planty ty)
  (ret addr))

(fn lo-slot :str ((plan (ref (vec :str))) (planty (ref (vec :i64))) (st (ref (vec :i64))) (ty :i64) (owner :str))
  (if (= (vec-get st 4) 1)
    (ret (lo-slot-dry plan planty st ty owner))
    (lo-nothing))
  (let i :i64 (vec-get st 3))
  (vec-set st 3 (+ i 1))
  (ret (vec-get plan i)))

(fn lo-closed :bool ((st (ref (vec :i64))))
  (ret (= (vec-get st 7) 1)))

(fn lo-label :i64 ((st (ref (vec :i64))))
  (let n :i64 (+ (vec-get st 2) 1))
  (vec-set st 2 n)
  (ret n))

(fn lo-fail-str :str ((nod (ref (vec node))) (ntx (ref (vec :str))) (berr (ref (vec lower-error))) (id :i64) (code :i64) (message :str))
  (let _ lower-error (lo-fail-at nod ntx berr id code message))
  (ret ""))

(fn lo-fail-void :void ((nod (ref (vec node))) (ntx (ref (vec :str))) (berr (ref (vec lower-error))) (id :i64) (code :i64) (message :str))
  (let _ lower-error (lo-fail-at nod ntx berr id code message))
  (ret))

(fn lo-not-yet-str :str ((nod (ref (vec node))) (ntx (ref (vec :str))) (berr (ref (vec lower-error))) (id :i64) (h :str))
  (let _ lower-error (lo-fail-at nod ntx berr id 2 (str-concat "'" (str-concat h "' is not lowered by this backend yet"))))
  (ret ""))

(fn lo-not-yet lower-error ((nod (ref (vec node))) (ntx (ref (vec :str))) (berr (ref (vec lower-error))) (id :i64) (h :str))
  (ret (lo-fail-at nod ntx berr id 2 (str-concat "'" (str-concat h "' is not lowered by this backend yet")))))

(fn lo-not-yet-type :i64 ((nod (ref (vec node))) (ntx (ref (vec :str))) (berr (ref (vec lower-error))) (id :i64) (h :str))
  (let _ lower-error (lo-not-yet nod ntx berr id h))
  (ret -1))

(fn lo-parse lower-error ((nod (ref (vec node))) (ntx (ref (vec :str))) (tnk (ref (vec :str))) (tnv (ref (vec :i64))) (tags (ref (vec :i64))) (tnames (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (tpnames (ref (vec :str))) (tptypes (ref (vec :i64))) (berr (ref (vec lower-error))) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (id :i64) (out (ref (vec :i64))))
  (if (lo-bad berr)
    (ret (vec-get berr 0))
    (lo-nothing))
  (letmut parsed
    (vec :i64)
    (make (vec :i64)))
  (vec-push parsed -1)
  (let terr type-error (type-under nod ntx tnk tnv tags tnames elem extra pbase powner tpnames tptypes id "" parsed))
  (if (not (type-ok terr))
    (ret (lo-fail berr
           (get terr code)
           (if (str-eq (get terr path) "")
             (lo-path nod ntx id)
             (get terr path))
           (get terr message)))
    (lo-nothing))
  (vec-set out 0 (type-substitute tags tnames elem extra pbase powner tpnames tptypes bnames btypes (vec-get parsed 0)))
  (vec-free parsed)
  (ret (lower-pass)))

(fn lo-parse-id :i64 ((nod (ref (vec node))) (ntx (ref (vec :str))) (tnk (ref (vec :str))) (tnv (ref (vec :i64))) (tags (ref (vec :i64))) (tnames (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (tpnames (ref (vec :str))) (tptypes (ref (vec :i64))) (berr (ref (vec lower-error))) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (id :i64))
  (letmut out
    (vec :i64)
    (make (vec :i64)))
  (vec-push out -1)
  (let e lower-error (lo-parse nod ntx tnk tnv tags tnames elem extra pbase powner tpnames tptypes berr bnames btypes id out))
  (let answer :i64 (if (lower-ok e)
                     (vec-get out 0) -1))
  (vec-free out)
  (ret answer))

(fn lo-one-type1 :void ((nod (ref (vec node))) (ntx (ref (vec :str))) (mname :str) (qual :i64) (tnk (ref (vec :str))) (tnv (ref (vec :i64))) (tnl (ref (vec :i64))) (tags (ref (vec :i64))) (tnames (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pchild (ref (vec :i64))) (berr (ref (vec lower-error))) (f :i64))
  (let name :str (lo-name nod ntx f))
  (let spelled :str (if (= qual 1)
                      (str-concat mname (str-concat "." name)) name))
  (let body :i64 (lo-child nod ntx f 2))
  (let kind :str (lo-head nod ntx body))
  (let base :i64 (vec-len pchild))
  (letmut id :i64 -1)
  (if (str-eq kind "struct")
    (set id (type-struct tags tnames elem extra pbase powner spelled mname base 0))
    (if (str-eq kind "enum")
      (set id (type-enum tags tnames elem extra pbase powner spelled mname base 0))
      (let _ lower-error (lo-fail-at nod ntx berr f 2 "a type body must be a struct or an enum"))))
  (if (>= id 0)
    (map-put tnk tnv tnl name id)
    (lo-nothing))
  (ret))

(fn lo-scan-types1 :void ((nod (ref (vec node))) (ntx (ref (vec :str))) (root :i64) (mqual (ref (vec :i64))) (tnk (ref (vec :str))) (tnv (ref (vec :i64))) (tnl (ref (vec :i64))) (tags (ref (vec :i64))) (tnames (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pchild (ref (vec :i64))) (berr (ref (vec lower-error))))
  (let mname :str (lo-mod-name nod ntx root))
  (let qual :i64 (vec-get mqual 0))
  (letmut f :i64 (lo-child nod ntx root 0))
  (while (and (>= f 0)
           (not (lo-bad berr)))
    (if (str-eq (lo-head nod ntx f) "type")
      (lo-one-type1 nod ntx mname qual tnk tnv tnl tags tnames elem extra pbase powner pchild berr f)
      (lo-nothing))
    (set f (get (vec-get nod f) next)))
  (ret))

(fn lo-struct-body :void ((nod (ref (vec node))) (ntx (ref (vec :str))) (tnk (ref (vec :str))) (tnv (ref (vec :i64))) (tags (ref (vec :i64))) (tnames (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (tpnames (ref (vec :str))) (tptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (berr (ref (vec lower-error))) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (id :i64) (body :i64))
  (let base :i64 (vec-len pchild))
  (vec-set pbase id base)
  (letmut c :i64 (lo-child nod ntx body 1))
  (while (and (>= c 0)
           (not (lo-bad berr)))
    (let fname :str (lo-head nod ntx c))
    (letmut tid :i64 (lo-child nod ntx c 1))
    (if (lo-marker? nod ntx tid)
      (set tid (lo-child nod ntx c 2))
      (lo-nothing))
    (let ty :i64 (lo-parse-id nod ntx tnk tnv tags tnames elem extra pbase powner tpnames tptypes berr bnames btypes tid))
    (if (>= ty 0)
      (vec-push pvname fname)
      (lo-nothing))
    (if (>= ty 0)
      (vec-push pchild ty)
      (lo-nothing))
    (set c (get (vec-get nod c) next)))
  (vec-set extra id (- (vec-len pchild) base))
  (if (lo-bad berr)
    (ret)
    (lo-nothing))
  (let past :i64 (+ base (vec-get extra id)))
  (letmut seen
    (vec :i64)
    (make (vec :i64)))
  (letmut q :i64 base)
  (while (and (< q past)
           (not (lo-bad berr)))
    (if (lo-reaches tags elem extra pbase pchild (vec-get pchild q) id seen)
      (let _ lower-error (lo-fail-at nod ntx berr body 2 (str-concat "struct '" (str-concat (vec-get tnames id) "' contains itself by value"))))
      (lo-nothing))
    (set q (+ q 1)))
  (vec-free seen)
  (ret))

(fn lo-enum-body :void ((nod (ref (vec node))) (ntx (ref (vec :str))) (tnk (ref (vec :str))) (tnv (ref (vec :i64))) (tags (ref (vec :i64))) (tnames (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (tpnames (ref (vec :str))) (tptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (vnk (ref (vec :str))) (vnv (ref (vec :i64))) (vni (ref (vec :i64))) (vnp (ref (vec :i64))) (berr (ref (vec lower-error))) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (id :i64) (body :i64) (enames (ref (vec :str))) (ewords (ref (vec :i64))))
  (let base :i64 (vec-len pchild))
  (vec-set pbase id base)
  (letmut c :i64 (lo-child nod ntx body 1))
  (letmut index :i64 0)
  (while (and (>= c 0)
           (not (lo-bad berr)))
    (let vname :str (lo-head nod ntx c))
    (let tchild :i64 (lo-child nod ntx c 1))
    (letmut payload :i64 -1)
    (if (>= tchild 0)
      (set payload (lo-parse-id nod ntx tnk tnv tags tnames elem extra pbase powner tpnames tptypes berr bnames btypes tchild))
      (lo-nothing))
    (vec-push pvname vname)
    (vec-push pchild payload)
    (vec-push vnk vname)
    (vec-push vnv id)
    (vec-push vni index)
    (vec-push vnp payload)
    (set index (+ index 1))
    (set c (get (vec-get nod c) next)))
  (vec-set extra id (- (vec-len pchild) base))
  (if (lo-bad berr)
    (ret)
    (lo-nothing))
  (ir-enum enames ewords
    (vec-get tnames id)
    (lo-enum-words tags tnames elem extra pbase pchild id))
  (let base2 :i64 (vec-get pbase id))
  (let past2 :i64 (+ base2 (vec-get extra id)))
  (letmut seen
    (vec :i64)
    (make (vec :i64)))
  (letmut q :i64 base2)
  (while (and (< q past2)
           (not (lo-bad berr)))
    (if (and (>= (vec-get pchild q) 0)
          (lo-reaches tags elem extra pbase pchild (vec-get pchild q) id seen))
      (let _ lower-error (lo-fail-at nod ntx berr body 2 (str-concat "enum '" (str-concat (vec-get tnames id) "' contains itself by value"))))
      (lo-nothing))
    (set q (+ q 1)))
  (vec-free seen)
  (ret))

(fn lo-one-type2 :void ((nod (ref (vec node))) (ntx (ref (vec :str))) (tnk (ref (vec :str))) (tnv (ref (vec :i64))) (tnl (ref (vec :i64))) (tags (ref (vec :i64))) (tnames (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (tpnames (ref (vec :str))) (tptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (vnk (ref (vec :str))) (vnv (ref (vec :i64))) (vni (ref (vec :i64))) (vnp (ref (vec :i64))) (enames (ref (vec :str))) (ewords (ref (vec :i64))) (berr (ref (vec lower-error))) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (f :i64))
  (let name :str (lo-name nod ntx f))
  (let id :i64 (lo-named tnk tnv tnl name))
  (let body :i64 (lo-child nod ntx f 2))
  (if (>= id 0)
    (if (str-eq (lo-head nod ntx body) "struct")
      (lo-struct-body nod ntx tnk tnv tags tnames elem extra pbase powner tpnames tptypes pchild pvname berr bnames btypes id body)
      (if (str-eq (lo-head nod ntx body) "enum")
        (lo-enum-body nod ntx tnk tnv tags tnames elem extra pbase powner tpnames tptypes pchild pvname vnk vnv vni vnp berr bnames btypes id body enames ewords)
        (lo-nothing)))
    (lo-nothing))
  (ret))

(fn lo-scan-types2 :void ((nod (ref (vec node))) (ntx (ref (vec :str))) (root :i64) (tnk (ref (vec :str))) (tnv (ref (vec :i64))) (tnl (ref (vec :i64))) (tags (ref (vec :i64))) (tnames (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (tpnames (ref (vec :str))) (tptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (vnk (ref (vec :str))) (vnv (ref (vec :i64))) (vni (ref (vec :i64))) (vnp (ref (vec :i64))) (enames (ref (vec :str))) (ewords (ref (vec :i64))) (berr (ref (vec lower-error))) (bnames (ref (vec :str))) (btypes (ref (vec :i64))))
  (letmut f :i64 (lo-child nod ntx root 0))
  (while (and (>= f 0)
           (not (lo-bad berr)))
    (if (str-eq (lo-head nod ntx f) "type")
      (lo-one-type2 nod ntx tnk tnv tnl tags tnames elem extra pbase powner tpnames tptypes pchild pvname vnk vnv vni vnp enames ewords berr bnames btypes f)
      (lo-nothing))
    (set f (get (vec-get nod f) next)))
  (ret))

(fn lo-sig-one lower-error ((nod (ref (vec node))) (ntx (ref (vec :str))) (mname :str) (tnk (ref (vec :str))) (tnv (ref (vec :i64))) (fnk (ref (vec :str))) (fnv (ref (vec :i64))) (fnl (ref (vec :i64))) (enk (ref (vec :str))) (env (ref (vec :i64))) (enl (ref (vec :i64))) (tags (ref (vec :i64))) (tnames (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (tpnames (ref (vec :str))) (tptypes (ref (vec :i64))) (berr (ref (vec lower-error))) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (f :i64) (extern :i64) (out (ref (vec :i64))))
  (let name :str (lo-name nod ntx f))
  (letmut r :i64 (if (= extern 1) 3 2))
  (if (lo-marker? nod ntx (lo-child nod ntx f r))
    (set r (+ r 1))
    (lo-nothing))
  (let retn :i64 (lo-child nod ntx f r))
  (let e0 lower-error (lo-parse nod ntx tnk tnv tags tnames elem extra pbase powner tpnames tptypes berr bnames btypes retn out))
  (if (not (lower-ok e0))
    (ret e0)
    (lo-nothing))
  (let ret :i64 (vec-get out 0))
  (let params :i64 (lo-child nod ntx f (+ r 1)))
  (letmut ptyps
    (vec :i64)
    (make (vec :i64)))
  (letmut c :i64 (if (< params 0) -1
                   (get (vec-get nod params) first)))
  (letmut arity :i64 0)
  (while (>= c 0)
    (letmut tchild :i64 (lo-child nod ntx c 1))
    (if (lo-marker? nod ntx tchild)
      (set tchild (lo-child nod ntx c 2))
      (lo-nothing))
    (let ty :i64 (lo-parse-id nod ntx tnk tnv tags tnames elem extra pbase powner tpnames tptypes berr bnames btypes tchild))
    (if (>= ty 0)
      (vec-push ptyps ty)
      (lo-nothing))
    (set arity (+ arity 1))
    (set c (get (vec-get nod c) next)))
  (let start :i64 (type-param-start tptypes))
  (letmut k :i64 0)
  (while (< k (vec-len ptyps))
    (type-param tpnames tptypes "" (vec-get ptyps k))
    (set k (+ k 1)))
  (vec-free ptyps)
  (let sig :i64 (type-fn tags tnames elem extra pbase powner "fn" ret arity start))
  (vec-set powner sig mname)
  (vec-set out 0 sig)
  (if (= extern 1)
    (map-put enk env enl name sig)
    (map-put fnk fnv fnl (lo-fn-key mname name) sig))
  (ret (lower-pass)))

(fn lo-scan-sigs :void ((nod (ref (vec node))) (ntx (ref (vec :str))) (root :i64) (tnk (ref (vec :str))) (tnv (ref (vec :i64))) (fnk (ref (vec :str))) (fnv (ref (vec :i64))) (fnl (ref (vec :i64))) (enk (ref (vec :str))) (env (ref (vec :i64))) (enl (ref (vec :i64))) (tags (ref (vec :i64))) (tnames (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (tpnames (ref (vec :str))) (tptypes (ref (vec :i64))) (berr (ref (vec lower-error))) (bnames (ref (vec :str))) (btypes (ref (vec :i64))))
  (let mname :str (lo-mod-name nod ntx root))
  (letmut f :i64 (lo-child nod ntx root 0))
  (letmut out
    (vec :i64)
    (make (vec :i64)))
  (vec-push out -1)
  (while (and (>= f 0)
           (not (lo-bad berr)))
    (let h :str (lo-head nod ntx f))
    (if (str-eq h "fn")
      (let _ lower-error (lo-sig-one nod ntx mname tnk tnv fnk fnv fnl enk env enl tags tnames elem extra pbase powner tpnames tptypes berr bnames btypes f 0 out))
      (lo-nothing))
    (if (str-eq h "extern")
      (let _ lower-error (lo-sig-one nod ntx mname tnk tnv fnk fnv fnl enk env enl tags tnames elem extra pbase powner tpnames tptypes berr bnames btypes f 1 out))
      (lo-nothing))
    (if (str-eq h "test")
      (lo-scan-test-sigs nod ntx mname tnk tnv fnk fnv fnl enk env enl tags tnames elem extra pbase powner tpnames tptypes berr bnames btypes f out)
      (lo-nothing))
    (set f (get (vec-get nod f) next)))
  (vec-free out)
  (ret))

(fn lo-scan-test-sigs :void ((nod (ref (vec node))) (ntx (ref (vec :str))) (mname :str) (tnk (ref (vec :str))) (tnv (ref (vec :i64))) (fnk (ref (vec :str))) (fnv (ref (vec :i64))) (fnl (ref (vec :i64))) (enk (ref (vec :str))) (env (ref (vec :i64))) (enl (ref (vec :i64))) (tags (ref (vec :i64))) (tnames (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (tpnames (ref (vec :str))) (tptypes (ref (vec :i64))) (berr (ref (vec lower-error))) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (test :i64) (out (ref (vec :i64))))
  (letmut k :i64 2)
  (letmut c :i64 (lo-child nod ntx test k))
  (while (and (>= c 0)
           (not (lo-bad berr)))
    (if (str-eq (lo-head nod ntx c) "fn")
      (let _ lower-error (lo-sig-one nod ntx mname tnk tnv fnk fnv fnl enk env enl tags tnames elem extra pbase powner tpnames tptypes berr bnames btypes c 0 out))
      (lo-nothing))
    (set k (+ k 1))
    (set c (lo-child nod ntx test k)))
  (ret))

