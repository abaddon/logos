  (let dest :str (lo-temp st))
  (lo-w-load ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals cl st dest ty slot)
  (ret dest))

(fn lo-has-wildcard :bool ((nod (ref (vec node))) (ntx (ref (vec :str))) (node :i64))
  (letmut c :i64 (lo-child nod ntx node 2))
  (letmut found :bool false)
  (while (>= c 0)
    (let p :i64 (lo-child nod ntx c 0))
    (if (or (str-eq (lo-head nod ntx c) "_")
          (and (lo-atom? nod p)
            (str-eq (lo-atom nod ntx p) "_")))
      (set found true)
      (lo-nothing))
    (set c (get (vec-get nod c) next)))
  (ret found))

