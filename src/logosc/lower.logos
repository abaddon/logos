    (set c (get (vec-get nod c) next)))
  (if (>= found 0)
    (ret found)
    (lo-nothing))
  (if (>= expected 0)
    (ret expected)
    (lo-nothing))
  (ret (lo-prim tags tnames elem extra pbase powner (if isfloat "f64" "i64"))))

