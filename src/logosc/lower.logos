(fn lo-touch :void ((suse (ref (vec :i64))) (seen (ref (vec :i64))) (tags (ref (vec :i64))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pchild (ref (vec :i64))) (tptypes (ref (vec :i64))) (ty :i64))
  (if (< ty 0)
    (ret)
    (lo-nothing))
  (let tag :i64 (vec-get tags ty))
  (if (or (= tag 0)
        (= tag 14))
    (ret)
    (lo-nothing))
  (if (and (or (= tag 12)
             (= tag 13))
        (lo-vec-has suse ty))
    (ret)
    (lo-nothing))
  (if (and (or (= tag 12)
             (= tag 13))
        (lo-vec-has seen ty))
    (ret)
    (lo-nothing))
  (if (or (= tag 12)
        (= tag 13))
    (vec-push seen ty)
    (lo-nothing))
  (if (or (= tag 12)
        (= tag 13))
    (lo-touch-fields suse seen tags elem extra pbase pchild tptypes ty)
    (lo-nothing))
  (if (= tag 12)
    (vec-push suse ty)
    (lo-nothing))
  (if (= tag 6)
    (lo-touch-res suse seen tags elem extra pbase pchild tptypes ty)
    (lo-nothing))
  (if (= tag 8)
    (lo-touch-fn suse seen tags elem extra pbase pchild tptypes ty)
    (lo-nothing))
  (if (and (< tag 12)
        (and (not (= tag 6))
          (not (= tag 8))))
    (lo-touch suse seen tags elem extra pbase pchild tptypes (vec-get elem ty))
    (lo-nothing))
  (ret))

(fn lo-touch-fields :void ((suse (ref (vec :i64))) (seen (ref (vec :i64))) (tags (ref (vec :i64))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pchild (ref (vec :i64))) (tptypes (ref (vec :i64))) (ty :i64))
  (let base :i64 (vec-get pbase ty))
  (let count :i64 (vec-get extra ty))
  (letmut k :i64 0)
  (while (< k count)
    (lo-touch suse seen tags elem extra pbase pchild tptypes (vec-get pchild (+ base k)))
    (set k (+ k 1)))
  (ret))

(fn lo-touch-res :void ((suse (ref (vec :i64))) (seen (ref (vec :i64))) (tags (ref (vec :i64))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pchild (ref (vec :i64))) (tptypes (ref (vec :i64))) (ty :i64))
  (lo-touch suse seen tags elem extra pbase pchild tptypes (vec-get elem ty))
  (lo-touch suse seen tags elem extra pbase pchild tptypes (vec-get extra ty))
  (ret))

(fn lo-touch-fn :void ((suse (ref (vec :i64))) (seen (ref (vec :i64))) (tags (ref (vec :i64))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pchild (ref (vec :i64))) (tptypes (ref (vec :i64))) (ty :i64))
  (let base :i64 (vec-get pbase ty))
  (let count :i64 (vec-get extra ty))
  (letmut k :i64 0)
  (while (< k count)
    (lo-touch suse seen tags elem extra pbase pchild tptypes (vec-get tptypes (+ base k)))
    (set k (+ k 1)))
  (lo-touch suse seen tags elem extra pbase pchild tptypes (vec-get elem ty))
  (ret))

(fn lo-first-use :void ((suse (ref (vec :i64))) (seen (ref (vec :i64))) (tags (ref (vec :i64))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pchild (ref (vec :i64))) (tptypes (ref (vec :i64))) (fret (ref (vec :i64))) (fbase (ref (vec :i64))) (fcnt (ref (vec :i64))) (fparam (ref (vec :i64))) (fpc (ref (vec :i64))) (ptys (ref (vec :i64))) (bbase (ref (vec :i64))) (bcnt (ref (vec :i64))) (ops (ref (vec :i64))) (t1 (ref (vec :i64))) (t2 (ref (vec :i64))))
  (letmut f :i64 0)
  (while (< f (vec-len fret))
    (lo-touch suse seen tags elem extra pbase pchild tptypes (vec-get fret f))
    (letmut p :i64 0)
    (while (< p (vec-get fpc f))
      (lo-touch suse seen tags elem extra pbase pchild tptypes (vec-get ptys (+ (vec-get fparam f) p)))
      (set p (+ p 1)))
    (letmut b :i64 0)
    (while (< b (vec-get fcnt f))
      (let bi :i64 (+ (vec-get fbase f) b))
      (letmut i :i64 (vec-get bbase bi))
      (let stop :i64 (+ i (vec-get bcnt bi)))
      (while (< i stop)
        (lo-touch suse seen tags elem extra pbase pchild tptypes (vec-get t1 i))
        (lo-touch suse seen tags elem extra pbase pchild tptypes (vec-get t2 i))
        (set i (+ i 1)))
      (set b (+ b 1)))
    (set f (+ f 1)))
  (ret))

(fn lo-refill :void ((nod (ref (vec node))) (mnod (ref (vec node))) (start :i64) (end :i64))
  (vec-free nod)
  (letmut i :i64 start)
  (while (< i end)
    (vec-push nod (vec-get mnod i))
    (set i (+ i 1)))
  (ret))

(fn lo-refill-texts :void ((ntx (ref (vec :str))) (mntx (ref (vec :str))) (start :i64) (end :i64))
  (vec-free ntx)
  (letmut i :i64 start)
  (while (< i end)
    (vec-push ntx (vec-get mntx i))
    (set i (+ i 1)))
  (ret))

(fn lo-rows :void ((suse (ref (vec :i64))) (tnames (ref (vec :str))) (pbase (ref (vec :i64))) (extra (ref (vec :i64))) (pchild (ref (vec :i64))) (snames (ref (vec :str))) (sbase (ref (vec :i64))) (scount (ref (vec :i64))) (sftys (ref (vec :i64))))
  (letmut i :i64 0)
  (while (< i (vec-len suse))
    (let id :i64 (vec-get suse i))
    (let base :i64 (vec-len sftys))
    (let count :i64 (vec-get extra id))
    (ir-struct snames sbase scount (vec-get tnames id) base count)
    (letmut k :i64 0)
    (while (< k count)
      (vec-push sftys (vec-get pchild (+ (vec-get pbase id) k)))
      (set k (+ k 1)))
    (set i (+ i 1)))
  (ret))

(fn lo-inst-find :i64 ((insn (ref (vec :str))) (name :str))
  (letmut i :i64 0)
  (letmut found :i64 -1)
  (while (and (= found -1)
           (< i (vec-len insn)))
    (if (str-eq (vec-get insn i) name)
      (set found i)
      (lo-nothing))
    (set i (+ i 1)))
  (ret found))

(fn lo-fn-node :i64 ((nod (ref (vec node))) (ntx (ref (vec :str))) (name :str))
  (letmut c :i64 (lo-child nod ntx 0 0))
  (letmut found :i64 -1)
  (while (and (= found -1)
           (>= c 0))
    (if (and (str-eq (lo-head nod ntx c) "fn")
          (str-eq (lo-name nod ntx c) name))
      (set found c)
      (lo-nothing))
    (set c (get (vec-get nod c) next)))
  (ret found))

(fn lo-inst-add :i64 ((insn (ref (vec :str))) (ivd (ref (vec :i64))) (ivn (ref (vec :str))) (ivt (ref (vec :i64))) (ivb (ref (vec :i64))) (ivc (ref (vec :i64))) (target :str) (node :i64) (bn (ref (vec :str))) (bt (ref (vec :i64))))
  (let at :i64 (lo-inst-find insn target))
  (if (>= at 0)
    (ret at)
    (lo-nothing))
  (vec-push insn target)
  (vec-push ivd node)
  (vec-push ivb (vec-len ivn))
  (vec-push ivc (vec-len bn))
  (letmut i :i64 0)
  (while (< i (vec-len bn))
    (vec-push ivn (vec-get bn i))
    (vec-push ivt (vec-get bt i))
    (set i (+ i 1)))
  (ret (- (vec-len insn) 1)))

(fn lo-bind-var :bool ((tags (ref (vec :i64))) (names (ref (vec :str))) (powner (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (ptypes (ref (vec :i64))) (var :str) (act :i64) (bn (ref (vec :str))) (bt (ref (vec :i64))))
  (let at :i64 (type-bound bn bt var -1))
  (if (>= at 0)
    (ret (type-compatible tags names powner elem extra pbase ptypes at act))
    (lo-nothing))
  (vec-push bn var)
  (vec-push bt act)
  (ret true))

(fn lo-unify :bool ((tags (ref (vec :i64))) (names (ref (vec :str))) (powner (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (ptypes (ref (vec :i64))) (pat :i64) (act :i64) (bn (ref (vec :str))) (bt (ref (vec :i64))))
  (if (or (< pat 0)
        (< act 0))
    (ret false)
    (lo-nothing))
  (let ptag :i64 (vec-get tags pat))
  (if (= ptag (type-tag-var))
    (ret (lo-bind-var tags names powner elem extra pbase ptypes (vec-get names pat) act bn bt))
    (lo-nothing))
  (if (not (type-has-var tags names elem extra pbase ptypes pat))
    (ret (type-compatible tags names powner elem extra pbase ptypes pat act))
    (lo-nothing))
  (if (= ptag (type-tag-fn))
    (ret (lo-unify-fn tags names powner elem extra pbase ptypes pat act bn bt))
    (lo-nothing))
  (if (= ptag (type-tag-res))
    (ret (and (= (vec-get tags act) ptag)
           (and (lo-unify tags names powner elem extra pbase ptypes
                  (vec-get elem pat)
                  (vec-get elem act) bn bt)
             (lo-unify tags names powner elem extra pbase ptypes
               (vec-get extra pat)
               (vec-get extra act) bn bt))))
    (lo-nothing))
  (if (= ptag (type-tag-arr))
    (ret (and (= (vec-get tags act) ptag)
           (and (= (vec-get extra pat)
                  (vec-get extra act))
             (lo-unify tags names powner elem extra pbase ptypes
               (vec-get elem pat)
               (vec-get elem act) bn bt))))
    (lo-nothing))
  (ret (and (type-unary-tag? tags pat)
         (and (= (vec-get tags act) ptag)
           (lo-unify tags names powner elem extra pbase ptypes
             (vec-get elem pat)
             (vec-get elem act) bn bt)))))

(fn lo-unify-fn :bool ((tags (ref (vec :i64))) (names (ref (vec :str))) (powner (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (ptypes (ref (vec :i64))) (pat :i64) (act :i64) (bn (ref (vec :str))) (bt (ref (vec :i64))))
  (if (not (= (vec-get tags act)
             (type-tag-fn)))
    (ret false)
    (lo-nothing))
  (if (not (str-eq (vec-get names pat)
             (vec-get names act)))
    (ret false)
    (lo-nothing))
  (if (not (= (vec-get extra pat)
             (vec-get extra act)))
    (ret false)
    (lo-nothing))
  (letmut i :i64 0)
  (letmut ok :bool true)
  (while (and ok (< i (vec-get extra pat)))
    (set ok (lo-unify tags names powner elem extra pbase ptypes
              (type-param-type ptypes pbase pat i)
              (type-param-type ptypes pbase act i) bn bt))
    (set i (+ i 1)))
  (if ok
    (set ok (lo-unify tags names powner elem extra pbase ptypes
              (vec-get elem pat)
              (vec-get elem act) bn bt))
    (lo-nothing))
  (ret ok))

(fn lo-var-order :void ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (ptypes (ref (vec :i64))) (sig :i64) (out (ref (vec :str))))
  (type-variables tags names elem extra pbase ptypes (vec-get elem sig) out)
  (letmut i :i64 0)
  (while (< i (vec-get extra sig))
    (type-variables tags names elem extra pbase ptypes (type-param-type ptypes pbase sig i) out)
    (set i (+ i 1)))
  (ret))

(fn lo-inst-target :str ((mtriple (ref (vec :str))) (mqual (ref (vec :i64))) (snames (ref (vec :str))) (sbase (ref (vec :i64))) (scount (ref (vec :i64))) (sftys (ref (vec :i64))) (enames (ref (vec :str))) (ewords (ref (vec :i64))) (gnames (ref (vec :str))) (gdata (ref (vec :str))) (dnames (ref (vec :str))) (dsig (ref (vec :i64))) (dcnt (ref (vec :i64))) (dret (ref (vec :i64))) (sigtys (ref (vec :i64))) (fnames (ref (vec :str))) (fsyms (ref (vec :str))) (fint (ref (vec :i64))) (fret (ref (vec :i64))) (fbase (ref (vec :i64))) (fcnt (ref (vec :i64))) (fparam (ref (vec :i64))) (fpc (ref (vec :i64))) (pnames (ref (vec :str))) (ptys (ref (vec :i64))) (blabels (ref (vec :str))) (bbase (ref (vec :i64))) (bcnt (ref (vec :i64))) (bterm (ref (vec :i64))) (bty (ref (vec :i64))) (bhas (ref (vec :i64))) (bv1 (ref (vec :str))) (bv2 (ref (vec :str))) (bv3 (ref (vec :str))) (ops (ref (vec :i64))) (dests (ref (vec :str))) (sa (ref (vec :str))) (sb (ref (vec :str))) (sc (ref (vec :str))) (sd (ref (vec :str))) (t1 (ref (vec :i64))) (t2 (ref (vec :i64))) (t3 (ref (vec :i64))) (n1 (ref (vec :i64))) (sst (ref (vec :i64))) (scn (ref (vec :i64))) (tst (ref (vec :i64))) (tcn (ref (vec :i64))) (svals (ref (vec :str))) (tvals (ref (vec :i64))) (tags (ref (vec :i64))) (tnames (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (tpnames (ref (vec :str))) (tptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (nod (ref (vec node))) (ntx (ref (vec :str))) (tnk (ref (vec :str))) (tnv (ref (vec :i64))) (tnl (ref (vec :i64))) (fnk (ref (vec :str))) (fnv (ref (vec :i64))) (fnl (ref (vec :i64))) (enk (ref (vec :str))) (env (ref (vec :i64))) (enl (ref (vec :i64))) (vnk (ref (vec :str))) (vnv (ref (vec :i64))) (vni (ref (vec :i64))) (vnp (ref (vec :i64))) (bindn (ref (vec :str))) (bindt (ref (vec :i64))) (binds (ref (vec :str))) (binda (ref (vec :i64))) (plan (ref (vec :str))) (planty (ref (vec :i64))) (st (ref (vec :i64))) (loopx (ref (vec :str))) (looph (ref (vec :str))) (esc (ref (vec :str))) (cl (ref (vec :str))) (berr (ref (vec lower-error))) (insn (ref (vec :str))) (ivd (ref (vec :i64))) (ivn (ref (vec :str))) (ivt (ref (vec :i64))) (ivb (ref (vec :i64))) (ivc (ref (vec :i64))) (curn (ref (vec :str))) (curt (ref (vec :i64))) (sig :i64) (name :str) (where :i64) (bn (ref (vec :str))) (bt (ref (vec :i64))))
  (letmut order
    (vec :str)
    (make (vec :str)))
  (lo-var-order tags tnames elem extra pbase tptypes sig order)
  (letmut i :i64 0)
  (while (and (< i (vec-len order))
           (not (lo-bad berr)))
    (if (< (type-bound bn bt (vec-get order i) -1) 0)
      (let _ lower-error (lo-fail-at nod ntx berr where 501 (str-concat "type variable " (str-concat (vec-get order i)
                                                                                           (str-concat " of '" (str-concat name "' is not bound by this call"))))))
      (lo-nothing))
    (set i (+ i 1)))
  (letmut s :str name)
  (letmut one
    (vec :str)
    (make (vec :str)))
  (vec-push one "")
  (set i 0)
  (while (and (< i (vec-len order))
           (not (lo-bad berr)))
    (vec-set one 0 "")
    (let terr type-error (type-mangle tags tnames elem extra pbase tptypes
                           (type-bound bn bt (vec-get order i) -1)
                           (lo-path nod ntx where) one))
    (if (type-ok terr)
      (set s (str-concat s (str-concat "$" (vec-get one 0))))
      (let _ lower-error (lo-fail-at nod ntx berr where
                           (get terr code)
                           (get terr message))))
    (set i (+ i 1)))
  (vec-free order)
  (vec-free one)
  (ret s))

(fn lo-inst-call lower-error ((mtriple (ref (vec :str))) (mqual (ref (vec :i64))) (snames (ref (vec :str))) (sbase (ref (vec :i64))) (scount (ref (vec :i64))) (sftys (ref (vec :i64))) (enames (ref (vec :str))) (ewords (ref (vec :i64))) (gnames (ref (vec :str))) (gdata (ref (vec :str))) (dnames (ref (vec :str))) (dsig (ref (vec :i64))) (dcnt (ref (vec :i64))) (dret (ref (vec :i64))) (sigtys (ref (vec :i64))) (fnames (ref (vec :str))) (fsyms (ref (vec :str))) (fint (ref (vec :i64))) (fret (ref (vec :i64))) (fbase (ref (vec :i64))) (fcnt (ref (vec :i64))) (fparam (ref (vec :i64))) (fpc (ref (vec :i64))) (pnames (ref (vec :str))) (ptys (ref (vec :i64))) (blabels (ref (vec :str))) (bbase (ref (vec :i64))) (bcnt (ref (vec :i64))) (bterm (ref (vec :i64))) (bty (ref (vec :i64))) (bhas (ref (vec :i64))) (bv1 (ref (vec :str))) (bv2 (ref (vec :str))) (bv3 (ref (vec :str))) (ops (ref (vec :i64))) (dests (ref (vec :str))) (sa (ref (vec :str))) (sb (ref (vec :str))) (sc (ref (vec :str))) (sd (ref (vec :str))) (t1 (ref (vec :i64))) (t2 (ref (vec :i64))) (t3 (ref (vec :i64))) (n1 (ref (vec :i64))) (sst (ref (vec :i64))) (scn (ref (vec :i64))) (tst (ref (vec :i64))) (tcn (ref (vec :i64))) (svals (ref (vec :str))) (tvals (ref (vec :i64))) (tags (ref (vec :i64))) (tnames (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (tpnames (ref (vec :str))) (tptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (nod (ref (vec node))) (ntx (ref (vec :str))) (tnk (ref (vec :str))) (tnv (ref (vec :i64))) (tnl (ref (vec :i64))) (fnk (ref (vec :str))) (fnv (ref (vec :i64))) (fnl (ref (vec :i64))) (enk (ref (vec :str))) (env (ref (vec :i64))) (enl (ref (vec :i64))) (vnk (ref (vec :str))) (vnv (ref (vec :i64))) (vni (ref (vec :i64))) (vnp (ref (vec :i64))) (bindn (ref (vec :str))) (bindt (ref (vec :i64))) (binds (ref (vec :str))) (binda (ref (vec :i64))) (plan (ref (vec :str))) (planty (ref (vec :i64))) (st (ref (vec :i64))) (loopx (ref (vec :str))) (looph (ref (vec :str))) (esc (ref (vec :str))) (cl (ref (vec :str))) (berr (ref (vec lower-error))) (insn (ref (vec :str))) (ivd (ref (vec :i64))) (ivn (ref (vec :str))) (ivt (ref (vec :i64))) (ivb (ref (vec :i64))) (ivc (ref (vec :i64))) (curn (ref (vec :str))) (curt (ref (vec :i64))) (node :i64) (name :str) (sig :i64) (gbn (ref (vec :str))) (gbt (ref (vec :i64))) (out (ref (vec :i64))))
  (let arity :i64 (vec-get extra sig))
  (letmut i :i64 0)
  (while (and (< i arity)
           (not (lo-bad berr)))
    (let arg :i64 (lo-child nod ntx node (+ i 1)))
    (let act :i64 (lo-node-type mtriple mqual snames sbase scount sftys enames ewords gnames gdata dnames dsig dcnt dret sigtys fnames fsyms fint fret fbase fcnt fparam fpc pnames ptys blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals tags tnames elem extra pbase powner tpnames tptypes pchild pvname nod ntx tnk tnv tnl fnk fnv fnl enk env enl vnk vnv vni vnp bindn bindt binds binda plan planty st loopx looph esc cl berr insn ivd ivn ivt ivb ivc curn curt arg -2))
    (if (< act 0)
      (let _ lower-error (lo-fail-at nod ntx berr node 501 (str-concat "cannot instantiate '" (str-concat name "': an argument has no type this backend knows"))))
      (if (not (lo-unify tags tnames powner elem extra pbase tptypes (lo-sig-param tptypes pbase sig i) act gbn gbt))
        (let _ lower-error (lo-fail-at nod ntx berr arg 100 (str-concat "argument " (str-concat (str-from-i64 (+ i 1))
                                                                                      (str-concat " of '" (str-concat name "' does not fit its parameter"))))))
        (lo-nothing)))
    (set i (+ i 1)))
