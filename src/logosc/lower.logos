(fn lo-term-set :void ((blabels (ref (vec :str))) (bbase (ref (vec :i64))) (bcnt (ref (vec :i64))) (bterm (ref (vec :i64))) (bty (ref (vec :i64))) (bhas (ref (vec :i64))) (bv1 (ref (vec :str))) (bv2 (ref (vec :str))) (bv3 (ref (vec :str))) (ops (ref (vec :i64))) (cl (ref (vec :str))) (term :i64) (ty :i64) (has :i64) (v1 :str) (v2 :str) (v3 :str))
  (let label :str (vec-get cl 0))
  (letmut i :i64 (- (vec-len bterm) 1))
  (letmut found :i64 -1)
  (while (and (>= i 0)
           (= found -1))
    (if (and (str-eq (vec-get blabels i) label)
          (= (vec-get bterm i) 0))
      (set found i)
      (lo-nothing))
    (set i (- i 1)))
  (if (< found 0)
    (set found (- (vec-len bterm) 1))
    (lo-nothing))
  (vec-set bcnt found (- (vec-len ops)
                        (vec-get bbase found)))
  (vec-set bterm found term)
  (vec-set bty found ty)
  (vec-set bhas found has)
  (vec-set bv1 found v1)
  (vec-set bv2 found v2)
  (vec-set bv3 found v3)
  (ret))

