  (letmut c :i64 start)
  (letmut isfloat :bool false)
  (letmut found :i64 -1)
  (while (and (>= c 0)
           (= found -1))
    (if (lo-number? nod c)
      (if (lo-float-lit? (lo-lit-text nod ntx c))
        (set isfloat true)
        (lo-nothing))
      (if (lo-string? nod c)
        (set found (lo-prim tags tnames elem extra pbase powner "str"))
        (if (lo-atom? nod c)
          (set found (lo-atom-node-type mtriple mqual snames sbase scount sftys enames ewords gnames gdata dnames dsig dcnt dret sigtys fnames fsyms fint fret fbase fcnt fparam fpc pnames ptys blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals tags tnames elem extra pbase powner tpnames tptypes pchild pvname nod ntx tnk tnv tnl fnk fnv fnl enk env enl vnk vnv vni vnp bindn bindt binds binda plan planty st loopx looph esc cl berr insn ivd ivn ivt ivb ivc curn curt c))
