 :i64))) (loopx (ref (vec :str))) (looph (ref (vec :str))) (esc (ref (vec :str))) (cl (ref (vec :str))) (berr (ref (vec lower-error))) (insn (ref (vec :str))) (ivd (ref (vec :i64))) (ivn (ref (vec :str))) (ivt (ref (vec :i64))) (ivb (ref (vec :i64))) (ivc (ref (vec :i64))) (curn (ref (vec :str))) (curt (ref (vec :i64))) (base :i64))
  (letmut i :i64 base)
  (while (and (< i (vec-len insn))
           (not (lo-bad berr)))
    (let node :i64 (vec-get ivd i))
    (let name :str (vec-get insn i))
    (let fname :str (lo-name nod ntx node))
    (let b :i64 (vec-get ivb i))
    (let n :i64 (vec-get ivc i))
    (letmut c :i64 0)
    (while (< c (vec-len curn))
      (vec-set curn c "")
      (vec-set curt c -1)
      (set c (+ c 1)))
    (letmut k :i64 0)
    (while (< k n)
      (vec-push curn (vec-get ivn (+ b k)))
      (vec-push curt (vec-get ivt (+ b k)))
      (set k (+ k 1)))
    (let sig :i64 (map-get fnk fnv fnl (lo-fn-key (vec-get cl 1) fname)))
    (letmut csig :i64 -1)
    (if (< sig 0)
      (let _ lower-error (lo-fail-at nod ntx berr node 103 (str-concat "no signature for '" (str-concat fname "'"))))
      (set csig (lo-inst-sig tags tnames elem extra pbase powner tpnames tptypes sig curn curt)))
    (if (and (>= csig 0)
          (not (lo-bad berr)))
      (lo-fn mtriple mqual snames sbase scount sftys enames ewords gnames gdata dnames dsig dcnt dret sigtys fnames fsyms fint fret fbase fcnt fparam fpc pnames ptys blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals tags tnames elem extra pbase powner tpnames tptypes pchild pvname nod ntx tnk tnv tnl fnk fnv fnl enk env enl vnk vnv vni vnp bindn bindt binds binda plan planty st loopx looph esc cl berr insn ivd ivn ivt ivb ivc curn curt node name csig)
      (lo-nothing))
    (set i (+ i 1)))
  (ret))

(fn lo-fnv-find :i64 ((cl (ref (vec :str))) (target :str))
  (letmut i :i64 4)
  (letmut found :i64 -1)
  (while (and (< (+ i 1)
                (vec-len cl))
           (= found -1))
    (if (str-eq (vec-get cl i) target)
      (set found (+ i 1))
      (lo-nothing))
    (set i (+ i 2)))
  (ret found))

(fn lo-fn-pair :str ((tags (ref (vec :i64))) (tnames (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (ops (ref (vec :i64))) (dests (ref (vec :str))) (sa (ref (vec :str))) (sb (ref (vec :str))) (sc (ref (vec :str))) (sd (ref (vec :str))) (t1 (ref (vec :i64))) (t2 (ref (vec :i64))) (t3 (ref (vec :i64))) (n1 (ref (vec :i64))) (sst (ref (vec :i64))) (scn (ref (vec :i64))) (tst (ref (vec :i64))) (tcn (ref (vec :i64))) (svals (ref (vec :str))) (tvals (ref (vec :i64))) (cl (ref (vec :str))) (st (ref (vec :i64))) (fnty :i64) (env :str) (code :str))
