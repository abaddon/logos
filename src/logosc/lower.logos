  (let u8 :i64 (lo-prim tags tnames elem extra pbase powner "u8"))
  (let rawty :i64 (lo-ptr tags tnames elem extra pbase powner u8))
  (let pty :i64 (lo-ptr tags tnames elem extra pbase powner i64ty))
  (let argc :i64 (lo-count nod ntx node))
  (if (or (< argc 3)
        (> argc 4))
    (ret (lo-fail-str nod ntx berr node 100 "'run' takes a program, an argument vector, and an optional budget"))
    (lo-nothing))
  (let atom :i64 (lo-child nod ntx node 2))
  (if (not (lo-atom? nod atom))
    (ret (lo-fail-str nod ntx berr node 100 "'run' needs the name of its argument vector"))
