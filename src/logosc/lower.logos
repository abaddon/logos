(fn lo-site-save :i64 ((st (ref (vec :i64))) (out (ref (vec :i64))))
  (let k :i64 (vec-get st 13))
  (letmut i :i64 (vec-get st 14))
  (vec-push out k)
  (while (< i (vec-len st))
    (vec-push out (vec-get st i))
    (set i (+ i 1)))
  (ret k))

(fn lo-site-restore :void ((st (ref (vec :i64))) (saved (ref (vec :i64))))
  (if (< (vec-len saved) 1)
    (ret)
    (lo-nothing))
  (let base :i64 (vec-len st))
  (letmut i :i64 1)
  (while (< i (vec-len saved))
    (vec-push st (vec-get saved i))
    (set i (+ i 1)))
  (vec-set st 14 base)
  (vec-set st 13 (vec-get saved 0))
  (ret))

(fn lo-entry-row :i64 ((fsyms (ref (vec :str))))
  (letmut i :i64 0)
  (letmut found :i64 -1)
  (while (and (< i (vec-len fsyms))
           (= found -1))
    (if (str-eq (vec-get fsyms i) "main")
      (set found i)
      (lo-nothing))
    (set i (+ i 1)))
  (ret found))

(fn lo-test-find :i64 ((nod (ref (vec node))) (ntx (ref (vec :str))) (name :str))
  (letmut c :i64 (lo-child nod ntx 0 0))
  (letmut found :i64 -1)
  (while (and (>= c 0)
           (= found -1))
    (if (and (= (get (vec-get nod c) tok) -1)
          (and (str-eq (lo-head nod ntx c) "test")
            (str-eq (lo-name nod ntx c) name)))
      (set found c)
      (lo-nothing))
    (set c (get (vec-get nod c) next)))
  (ret found))

