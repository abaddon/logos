(fn lo-pred :str ((h :str) (float :bool))
  (if float
    (ret (if (str-eq h "=") "oeq"
           (if (str-eq h "!=") "une"
             (if (str-eq h "<") "olt"
               (if (str-eq h "<=") "ole"
                 (if (str-eq h ">") "ogt" "oge"))))))
    (lo-nothing))
  (ret (if (str-eq h "=") "eq"
         (if (str-eq h "!=") "ne"
           (if (str-eq h "<") "slt"
             (if (str-eq h "<=") "sle"
               (if (str-eq h ">") "sgt" "sge")))))))

(fn lo-unsigned-pred :str ((p :str) (tnames (ref (vec :str))) (ty :i64))
  (if (and (lo-unsigned? tnames ty)
        (> (str-len p) 0))
    (if (= (str-byte p 0) 115)
      (ret (str-concat "u" (str-slice p 1 (str-len p))))
      (lo-nothing))
    (lo-nothing))
  (ret p))

