(fn lo-fn-name :str ((key :str))
  (letmut i :i64 0)
  (let n :i64 (str-len key))
  (while (and (< i n)
           (not (= (str-byte key i) 0)))
    (set i (+ i 1)))
  (ret (str-slice key (+ i 1) n)))

(fn lo-fn-slot :i64 ((fnk (ref (vec :str))) (fnv (ref (vec :i64))) (fnl (ref (vec :i64))) (nod (ref (vec node))) (ntx (ref (vec :str))) (cl (ref (vec :str))) (name :str))
  (letmut idx :i64 (map-find fnk fnl (lo-fn-key (vec-get cl 1) name)))
  (letmut u :i64 (if (< idx 0)
                   (lo-child nod ntx 0 0) -1))
  (while (and (>= u 0)
           (< idx 0))
    (if (str-eq (lo-head nod ntx u) "use")
      (set idx (map-find fnk fnl (lo-fn-key (lo-atom nod ntx (lo-child nod ntx u 1)) name)))
      (lo-nothing))
    (set u (get (vec-get nod u) next)))
  (ret (if (< idx 0) -1
         (- (vec-get fnl idx) 1))))

(fn lo-sig-fields :void ((fields (ref (vec :i64))) (pbase (ref (vec :i64))) (tptypes (ref (vec :i64))) (sig :i64) (arity :i64))
  (letmut k :i64 0)
  (while (< k arity)
    (vec-push fields (lo-sig-param tptypes pbase sig k))
    (set k (+ k 1)))
  (ret))

(fn lo-rec-fields :void ((ops (ref (vec :i64))) (tcn (ref (vec :i64))) (tvals (ref (vec :i64))) (fields (ref (vec :i64))))
  (letmut k :i64 0)
  (while (< k (vec-len fields))
    (ir-rec-field ops tcn tvals (vec-get fields k))
    (set k (+ k 1)))
  (ret))

(fn lo-w-rec :void ((ops (ref (vec :i64))) (dests (ref (vec :str))) (sa (ref (vec :str))) (sb (ref (vec :str))) (sc (ref (vec :str))) (sd (ref (vec :str))) (t1 (ref (vec :i64))) (t2 (ref (vec :i64))) (t3 (ref (vec :i64))) (n1 (ref (vec :i64))) (sst (ref (vec :i64))) (scn (ref (vec :i64))) (tst (ref (vec :i64))) (tcn (ref (vec :i64))) (svals (ref (vec :str))) (tvals (ref (vec :i64))) (st (ref (vec :i64))) (fields (ref (vec :i64))) (dest :str) (from :i64) (value :str))
  (if (= (vec-get st 4) 0)
    (ir-bitcastrec ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals dest from value)
    (lo-nothing))
  (if (= (vec-get st 4) 0)
    (lo-rec-fields ops tcn tvals fields)
    (lo-nothing))
  (ret))

(fn lo-w-geprec :void ((ops (ref (vec :i64))) (dests (ref (vec :str))) (sa (ref (vec :str))) (sb (ref (vec :str))) (sc (ref (vec :str))) (sd (ref (vec :str))) (t1 (ref (vec :i64))) (t2 (ref (vec :i64))) (t3 (ref (vec :i64))) (n1 (ref (vec :i64))) (sst (ref (vec :i64))) (scn (ref (vec :i64))) (tst (ref (vec :i64))) (tcn (ref (vec :i64))) (svals (ref (vec :str))) (tvals (ref (vec :i64))) (st (ref (vec :i64))) (fields (ref (vec :i64))) (dest :str) (base :str) (index :i64))
  (if (= (vec-get st 4) 0)
    (ir-geprec ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals dest base index)
    (lo-nothing))
  (if (= (vec-get st 4) 0)
    (lo-rec-fields ops tcn tvals fields)
    (lo-nothing))
  (ret))

(fn lo-fn-rotate :void ((fnames (ref (vec :str))) (fsyms (ref (vec :str))) (fint (ref (vec :i64))) (fret (ref (vec :i64))) (fbase (ref (vec :i64))) (fcnt (ref (vec :i64))) (fparam (ref (vec :i64))) (fpc (ref (vec :i64))) (fid :i64) (k :i64))
  (if (or (<= k 0)
        (>= (+ fid k)
          (vec-len fnames)))
    (ret)
    (lo-nothing))
  (let n0 :str (vec-get fnames fid))
  (let n1 :str (vec-get fsyms fid))
  (let n2 :i64 (vec-get fint fid))
  (let n3 :i64 (vec-get fret fid))
  (let n4 :i64 (vec-get fbase fid))
  (let n5 :i64 (vec-get fcnt fid))
  (let n6 :i64 (vec-get fparam fid))
  (let n7 :i64 (vec-get fpc fid))
  (letmut j :i64 fid)
  (while (< j (+ fid k))
    (vec-set fnames j (vec-get fnames (+ j 1)))
    (vec-set fsyms j (vec-get fsyms (+ j 1)))
    (vec-set fint j (vec-get fint (+ j 1)))
    (vec-set fret j (vec-get fret (+ j 1)))
    (vec-set fbase j (vec-get fbase (+ j 1)))
    (vec-set fcnt j (vec-get fcnt (+ j 1)))
    (vec-set fparam j (vec-get fparam (+ j 1)))
    (vec-set fpc j (vec-get fpc (+ j 1)))
    (set j (+ j 1)))
  (vec-set fnames (+ fid k) n0)
  (vec-set fsyms (+ fid k) n1)
  (vec-set fint (+ fid k) n2)
  (vec-set fret (+ fid k) n3)
  (vec-set fbase (+ fid k) n4)
  (vec-set fcnt (+ fid k) n5)
  (vec-set fparam (+ fid k) n6)
  (vec-set fpc (+ fid k) n7)
  (ret))

(fn lo-spawn :str ((mtriple (ref (vec :str))) (mqual (ref (vec :i64))) (snames (ref (vec :str))) (sbase (ref (vec :i64))) (scount (ref (vec :i64))) (sftys (ref (vec :i64))) (enames (ref (vec :str))) (ewords (ref (vec :i64))) (gnames (ref (vec :str))) (gdata (ref (vec :str))) (dnames (ref (vec :str))) (dsig (ref (vec :i64))) (dcnt (ref (vec :i64))) (dret (ref (vec :i64))) (sigtys (ref (vec :i64))) (fnames (ref (vec :str))) (fsyms (ref (vec :str))) (fint (ref (vec :i64))) (fret (ref (vec :i64))) (fbase (ref (vec :i64))) (fcnt (ref (vec :i64))) (fparam (ref (vec :i64))) (fpc (ref (vec :i64))) (pnames (ref (vec :str))) (ptys (ref (vec :i64))) (blabels (ref (vec :str))) (bbase (ref (vec :i64))) (bcnt (ref (vec :i64))) (bterm (ref (vec :i64))) (bty (ref (vec :i64))) (bhas (ref (vec :i64))) (bv1 (ref (vec :str))) (bv2 (ref (vec :str))) (bv3 (ref (vec :str))) (ops (ref (vec :i64))) (dests (ref (vec :str))) (sa (ref (vec :str))) (sb (ref (vec :str))) (sc (ref (vec :str))) (sd (ref (vec :str))) (t1 (ref (vec :i64))) (t2 (ref (vec :i64))) (t3 (ref (vec :i64))) (n1 (ref (vec :i64))) (sst (ref (vec :i64))) (scn (ref (vec :i64))) (tst (ref (vec :i64))) (tcn (ref (vec :i64))) (svals (ref (vec :str))) (tvals (ref (vec :i64))) (tags (ref (vec :i64))) (tnames (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (tpnames (ref (vec :str))) (tptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (nod (ref (vec node))) (ntx (ref (vec :str))) (tnk (ref (vec :str))) (tnv (ref (vec :i64))) (tnl (ref (vec :i64))) (fnk (ref (vec :str))) (fnv (ref (vec :i64))) (fnl (ref (vec :i64))) (enk (ref (vec :str))) (env (ref (vec :i64))) (enl (ref (vec :i64))) (vnk (ref (vec :str))) (vnv (ref (vec :i64))) (vni (ref (vec :i64))) (vnp (ref (vec :i64))) (bindn (ref (vec :str))) (bindt (ref (vec :i64))) (binds (ref (vec :str))) (binda (ref (vec :i64))) (plan (ref (vec :str))) (planty (ref (vec :i64))) (st (ref (vec :i64))) (loopx (ref (vec :str))) (looph (ref (vec :str))) (esc (ref (vec :str))) (cl (ref (vec :str))) (berr (ref (vec lower-error))) (insn (ref (vec :str))) (ivd (ref (vec :i64))) (ivn (ref (vec :str))) (ivt (ref (vec :i64))) (ivb (ref (vec :i64))) (ivc (ref (vec :i64))) (curn (ref (vec :str))) (curt (ref (vec :i64))) (node :i64))
  (if (lo-bad berr)
    (ret "")
    (lo-nothing))
  (let target :i64 (lo-child nod ntx node 1))
  (if (or (< target 0)
        (not (lo-atom? nod target)))
    (ret (lo-fail-str nod ntx berr node 103 "spawn needs the name of a module function"))
    (lo-nothing))
  (let name :str (lo-atom nod ntx target))
  (let slot :i64 (lo-fn-slot fnk fnv fnl nod ntx cl name))
  (if (< slot 0)
    (ret (lo-fail-str nod ntx berr node 103 (str-concat "cannot start '" (str-concat name (str-concat "': no lowered definition in module '" (str-concat (vec-get cl 1) "'"))))))
    (lo-nothing))
  (let sig :i64 (vec-get fnv slot))
  (let arity :i64 (vec-get extra sig))
  (if (not (= (- (lo-count nod ntx node) 2) arity))
    (ret (lo-fail-str nod ntx berr node 102 (str-concat "'" (str-concat name (str-concat "' takes " (str-concat (str-from-i64 arity)
                                                                                                      (str-concat " arguments, got " (str-from-i64 (- (lo-count nod ntx node) 2)))))))))
    (lo-nothing))
  (letmut fields
    (vec :i64)
    (make (vec :i64)))
  (lo-sig-fields fields pbase tptypes sig arity)
  (let u8 :i64 (lo-prim tags tnames elem extra pbase powner "u8"))
  (let rawty :i64 (lo-ptr tags tnames elem extra pbase powner u8))
  (letmut values
    (vec :str)
    (make (vec :str)))
  (letmut i :i64 0)
  (while (< i arity)
    (vec-push values (lo-value mtriple mqual snames sbase scount sftys enames ewords gnames gdata dnames dsig dcnt dret sigtys fnames fsyms fint fret fbase fcnt fparam fpc pnames ptys blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals tags tnames elem extra pbase powner tpnames tptypes pchild pvname nod ntx tnk tnv tnl fnk fnv fnl enk env enl vnk vnv vni vnp bindn bindt binds binda plan planty st loopx looph esc cl berr insn ivd ivn ivt ivb ivc curn curt (lo-child nod ntx node (+ i 2)) -2))
    (set i (+ i 1)))
  (let size :i64 (lo-fields-size mtriple mqual snames sbase scount sftys enames ewords gnames gdata dnames dsig dcnt dret sigtys fnames fsyms fint fret fbase fcnt fparam fpc pnames ptys blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals tags tnames elem extra pbase powner tpnames tptypes pchild pvname nod ntx tnk tnv tnl fnk fnv fnl enk env enl vnk vnv vni vnp bindn bindt binds binda plan planty st loopx looph esc cl berr insn ivd ivn ivt ivb ivc curn curt fields))
  (let whole :i64 (lo-fields-align mtriple mqual snames sbase scount sftys enames ewords gnames gdata dnames dsig dcnt dret sigtys fnames fsyms fint fret fbase fcnt fparam fpc pnames ptys blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals tags tnames elem extra pbase powner tpnames tptypes pchild pvname nod ntx tnk tnv tnl fnk fnv fnl enk env enl vnk vnv vni vnp bindn bindt binds binda plan planty st loopx looph esc cl berr insn ivd ivn ivt ivb ivc curn curt fields))
  (let gpath :str (lo-cstring gnames gdata st (lo-path nod ntx node)))
  (let pathv :str (lo-temp st))
  (lo-w-gaddr ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals cl st pathv gpath)
  (letmut ps
    (vec :i64)
    (make (vec :i64)))
  (vec-push ps (lo-prim tags tnames elem extra pbase powner "i64"))
  (vec-push ps (lo-prim tags tnames elem extra pbase powner "i64"))
  (vec-push ps rawty)
  (lo-declare dnames dsig dcnt dret sigtys st "rt_alloc" ps rawty)
  (vec-free ps)
  (let raw :str (lo-temp st))
  (lo-w-call ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals cl st raw "rt_alloc")
  (lo-w-arg ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals cl st (str-from-i64 size))
  (lo-w-arg ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals cl st (str-from-i64 whole))
  (lo-w-arg ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals cl st pathv)
  (letmut base :str "")
  (if (> arity 0)
    (set base (lo-temp st))
    (lo-nothing))
  (if (> arity 0)
    (lo-w-rec ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals st fields base rawty raw)
    (lo-nothing))
  (letmut j :i64 0)
  (while (< j arity)
    (let addr :str (lo-temp st))
    (lo-w-geprec ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals st fields addr base j)
    (lo-w-store ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals cl st
      (vec-get fields j)
      (vec-get values j) addr)
    (set j (+ j 1)))
  (vec-free values)
  (vec-free fields)
  (letmut nm :str "")
  (if (= (vec-get st 4) 0)
    (set nm (lo-gensym mtriple mqual snames sbase scount sftys enames ewords gnames gdata dnames dsig dcnt dret sigtys fnames fsyms fint fret fbase fcnt fparam fpc pnames ptys blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals tags tnames elem extra pbase powner tpnames tptypes pchild pvname nod ntx tnk tnv tnl fnk fnv fnl enk env enl vnk vnv vni vnp bindn bindt binds binda plan planty st loopx looph esc cl berr insn ivd ivn ivt ivb ivc curn curt "$spawn"))
    (lo-nothing))
  (letmut sites
    (vec :i64)
    (make (vec :i64)))
  (if (= (vec-get st 4) 0)
    (lo-queue-site st 0 (vec-get st 12) slot sites)
    (lo-nothing))
  (vec-free sites)
  (let symbol :str (if (= (vec-get st 4) 0)
                     (str-concat "lg." (str-concat (vec-get cl 1)
                                         (str-concat "." nm))) ""))
  (let code :str (lo-temp st))
  (if (= (vec-get st 4) 0)
    (ir-faddr ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals code symbol)
    (lo-nothing))
  (letmut ps2
    (vec :i64)
    (make (vec :i64)))
  (vec-push ps2 rawty)
  (vec-push ps2 rawty)
  (vec-push ps2 rawty)
  (lo-declare dnames dsig dcnt dret sigtys st "rt_thread_new" ps2 rawty)
  (vec-free ps2)
  (let handle :str (lo-temp st))
  (lo-w-call ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals cl st handle "rt_thread_new")
  (lo-w-arg ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals cl st pathv)
  (lo-w-arg ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals cl st code)
  (lo-w-arg ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals cl st raw)
  (ret handle))

(fn lo-spawn-thunk :i64 ((mtriple (ref (vec :str))) (mqual (ref (vec :i64))) (snames (ref (vec :str))) (sbase (ref (vec :i64))) (scount (ref (vec :i64))) (sftys (ref (vec :i64))) (enames (ref (vec :str))) (ewords (ref (vec :i64))) (gnames (ref (vec :str))) (gdata (ref (vec :str))) (dnames (ref (vec :str))) (dsig (ref (vec :i64))) (dcnt (ref (vec :i64))) (dret (ref (vec :i64))) (sigtys (ref (vec :i64))) (fnames (ref (vec :str))) (fsyms (ref (vec :str))) (fint (ref (vec :i64))) (fret (ref (vec :i64))) (fbase (ref (vec :i64))) (fcnt (ref (vec :i64))) (fparam (ref (vec :i64))) (fpc (ref (vec :i64))) (pnames (ref (vec :str))) (ptys (ref (vec :i64))) (blabels (ref (vec :str))) (bbase (ref (vec :i64))) (bcnt (ref (vec :i64))) (bterm (ref (vec :i64))) (bty (ref (vec :i64))) (bhas (ref (vec :i64))) (bv1 (ref (vec :str))) (bv2 (ref (vec :str))) (bv3 (ref (vec :str))) (ops (ref (vec :i64))) (dests (ref (vec :str))) (sa (ref (vec :str))) (sb (ref (vec :str))) (sc (ref (vec :str))) (sd (ref (vec :str))) (t1 (ref (vec :i64))) (t2 (ref (vec :i64))) (t3 (ref (vec :i64))) (n1 (ref (vec :i64))) (sst (ref (vec :i64))) (scn (ref (vec :i64))) (tst (ref (vec :i64))) (tcn (ref (vec :i64))) (svals (ref (vec :str))) (tvals (ref (vec :i64))) (tags (ref (vec :i64))) (tnames (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (tpnames (ref (vec :str))) (tptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (nod (ref (vec node))) (ntx (ref (vec :str))) (tnk (ref (vec :str))) (tnv (ref (vec :i64))) (tnl (ref (vec :i64))) (fnk (ref (vec :str))) (fnv (ref (vec :i64))) (fnl (ref (vec :i64))) (enk (ref (vec :str))) (env (ref (vec :i64))) (enl (ref (vec :i64))) (vnk (ref (vec :str))) (vnv (ref (vec :i64))) (vni (ref (vec :i64))) (vnp (ref (vec :i64))) (bindn (ref (vec :str))) (bindt (ref (vec :i64))) (binds (ref (vec :str))) (binda (ref (vec :i64))) (plan (ref (vec :str))) (planty (ref (vec :i64))) (st (ref (vec :i64))) (loopx (ref (vec :str))) (looph (ref (vec :str))) (esc (ref (vec :str))) (cl (ref (vec :str))) (berr (ref (vec lower-error))) (insn (ref (vec :str))) (ivd (ref (vec :i64))) (ivn (ref (vec :str))) (ivt (ref (vec :i64))) (ivb (ref (vec :i64))) (ivc (ref (vec :i64))) (curn (ref (vec :str))) (curt (ref (vec :i64))) (n :i64) (slot :i64))
  (let name :str (str-concat "$spawn$" (str-from-i64 n)))
  (let symbol :str (str-concat "lg." (str-concat (vec-get cl 1)
                                       (str-concat "." name))))
  (let u8 :i64 (lo-prim tags tnames elem extra pbase powner "u8"))
  (let rawty :i64 (lo-ptr tags tnames elem extra pbase powner u8))
  (let sig :i64 (vec-get fnv slot))
  (let arity :i64 (vec-get extra sig))
  (let target :str (lo-fn-name (vec-get fnk slot)))
  (let callee :str (if (str-eq target "main") "main"
                     (str-concat "lg." (str-concat (type-owner powner sig)
                                         (str-concat "." target)))))
  (let s0 :i64 (vec-get st 0))
  (let s1 :i64 (vec-get st 1))
  (let s2 :i64 (vec-get st 2))
  (let s7 :i64 (vec-get st 7))
  (let old :str (vec-get cl 0))
  (vec-set st 0 0)
  (vec-set st 1 0)
  (vec-set st 2 0)
  (vec-set st 4 0)
  (vec-set st 7 0)
  (letmut fields
    (vec :i64)
    (make (vec :i64)))
  (lo-sig-fields fields pbase tptypes sig arity)
  (let tfid :i64 (ir-fn fnames fsyms fint fret fbase fcnt fparam fpc blabels pnames name symbol true rawty))
  (ir-param pnames ptys "env" rawty)
  (lo-w-block blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals cl st "entry")
  (letmut loads
    (vec :str)
    (make (vec :str)))
  (letmut base :str "")
  (if (> arity 0)
    (set base (lo-temp st))
    (lo-nothing))
  (if (> arity 0)
    (lo-w-rec ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals st fields base rawty "%env")
    (lo-nothing))
  (letmut j :i64 0)
  (while (< j arity)
    (let addr :str (lo-temp st))
    (lo-w-geprec ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals st fields addr base j)
    (let v :str (lo-temp st))
    (lo-w-load ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals cl st v (vec-get fields j) addr)
    (vec-push loads v)
    (set j (+ j 1)))
  (lo-w-call ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals cl st "" callee)
  (letmut m :i64 0)
  (while (< m arity)
    (lo-w-arg ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals cl st (vec-get loads m))
    (set m (+ m 1)))
  (vec-free loads)
  (vec-free fields)
  (lo-w-ret blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals cl st rawty "null")
  (ir-fn-end fbase fcnt fparam fpc blabels pnames tfid)
  (vec-set st 0 s0)
  (vec-set st 1 s1)
  (vec-set st 2 s2)
  (vec-set st 7 s7)
  (vec-set cl 0 old)
  (ret tfid))

(fn lo-str-has :bool ((v (ref (vec :str))) (s :str))
  (letmut i :i64 0)
  (letmut found :bool false)
  (while (and (< i (vec-len v))
           (not found))
    (if (str-eq (vec-get v i) s)
      (set found true)
      (lo-nothing))
    (set i (+ i 1)))
  (ret found))

(fn lo-close-bound :void ((v (ref (vec :str))) (base :i64))
  (letmut i :i64 base)
  (while (< i (vec-len v))
    (vec-set v i "")
    (set i (+ i 1)))
  (ret))

(fn lo-cap-name :void ((bindn (ref (vec :str))) (binda (ref (vec :i64))) (bound (ref (vec :str))) (hits (ref (vec :i64))) (name :str))
  (if (lo-str-has bound name)
    (ret)
    (lo-nothing))
  (let b :i64 (lo-lookup bindn binda name))
  (if (< b 0)
    (ret)
    (lo-nothing))
  (if (lo-vec-has hits b)
    (ret)
    (lo-nothing))
  (vec-push hits b)
  (ret))

