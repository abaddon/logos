(fn lo-arith-op :i64 ((h :str) (float :bool))
  (if float
    (ret (if (str-eq h "+")
           (ir-op-fadd)
           (if (str-eq h "-")
             (ir-op-fsub)
             (if (str-eq h "*")
               (ir-op-fmul)
               (ir-op-fdiv)))))
    (lo-nothing))
  (ret (if (str-eq h "+")
         (ir-op-add)
         (if (str-eq h "-")
           (ir-op-sub)
           (ir-op-mul)))))

