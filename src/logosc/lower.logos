  (vec-set out 1 (type-substitute tags tnames elem extra pbase powner tpnames tptypes gbn gbt (vec-get elem sig)))
  (ret (lower-pass)))

(fn lo-inst-sig :i64 ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (tpnames (ref (vec :str))) (tptypes (ref (vec :i64))) (sig :i64) (bn (ref (vec :str))) (bt (ref (vec :i64))))
  (letmut pn
    (vec :str)
    (make (vec :str)))
  (letmut pt
    (vec :i64)
    (make (vec :i64)))
  (letmut i :i64 0)
  (while (< i (vec-get extra sig))
    (vec-push pn (type-param-name tpnames pbase sig i))
    (vec-push pt (type-substitute tags names elem extra pbase powner tpnames tptypes bn bt (type-param-type tptypes pbase sig i)))
    (set i (+ i 1)))
  (let start :i64 (type-param-start tptypes))
  (type-params-append tpnames tptypes pn pt)
  (let ret :i64 (type-substitute tags names elem extra pbase powner tpnames tptypes bn bt (vec-get elem sig)))
  (let id :i64 (type-fn tags names elem extra pbase powner
                 (vec-get names sig) ret
                 (vec-len pt) start))
  (vec-free pn)
  (vec-free pt)
  (ret id))

