(fn lo-escaped? :bool ((esc (ref (vec :str))) (base :i64) (label :str))
  (letmut i :i64 base)
  (letmut found :bool false)
  (while (< i (vec-len esc))
    (if (str-eq (vec-get esc i) label)
      (set found true)
      (lo-nothing))
    (set i (+ i 1)))
  (ret found))

