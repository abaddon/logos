  (let b :i64 (lo-lookup bindn binda (lo-atom nod ntx atom)))
  (if (< b 0)
    (ret (lo-fail-str nod ntx berr node 5 (str-concat "unknown name '" (str-concat (lo-atom nod ntx atom) "'"))))
    (lo-nothing))
  (let held :i64 (vec-get bindt b))
  (let slot :str (vec-get binds b))
  (letmut ok :bool false)
  (if (= (vec-get tags held)
        (type-tag-vec))
    (if (= (vec-get tags (vec-get elem held))
          (type-tag-prim))
      (if (str-eq (vec-get tnames (vec-get elem held)) "str")
        (set ok true)
        (lo-nothing))
      (lo-nothing))
    (lo-nothing))
