(mod check)

(use tree)

(use lex)

(use types)

(use resolve)

(use map)

(type check-error (struct (failed :bool) (code :i64) (path :str) (message :str)))

(type check-mod (struct (name :str) (file :str) (own-s :i64) (own-e :i64) (vis-s :i64) (vis-e :i64) (state :i64)))

(type check-entry (struct (name :str) (ty :i64) (kind :i64) (owner :str) (var-s :i64) (var-n :i64)))

(fn check-pass check-error ()
  (ret (make check-error false 0 "" "")))

(fn check-fail check-error ((code :i64) (path :str) (message :str))
  (ret (make check-error true code path message)))

(fn check-ok :bool ((e check-error))
  (ret (not (get e failed))))

(fn check-code :str ((n :i64))
  (ret (type-code n)))

(fn check-nothing :void ()
  (ret))

(fn check-head :str ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (id :i64))
  (let text :i64 (get (vec-get nodes id) text))
  (ret (if (= text -1) ""
         (vec-get ntexts text))))

(fn check-node-path :str ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (id :i64))
  (ret (if (or (= id -1)
             (not (= (get (vec-get nodes id) tok) -1))) ""
         (tree-path nodes ntexts 0 id))))

(fn check-fail-at check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (id :i64) (code :i64) (message :str))
  (ret (check-fail code (check-node-path nodes ntexts id) message)))

(fn check-atom-text :str ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (id :i64))
  (ret (if (= id -1) ""
         (if (not (= (get (vec-get nodes id) tok) 2)) ""
           (vec-get ntexts (get (vec-get nodes id) text))))))

(fn check-is-marker :bool ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (id :i64))
  (ret (and (not (= id -1))
         (and (= (get (vec-get nodes id) tok) 2)
           (str-eq (check-atom-text nodes ntexts id) ":")))))

(fn check-child :i64 ((nodes (ref (vec node))) (id :i64) (k :i64))
  (letmut c :i64 (get (vec-get nodes id) first))
  (letmut i :i64 0)
  (while (and (< i k)
           (not (= c -1)))
    (set c (get (vec-get nodes c) next))
    (set i (+ i 1)))
  (ret c))

(fn check-count :i64 ((nodes (ref (vec node))) (id :i64))
  (letmut c :i64 (get (vec-get nodes id) first))
  (letmut n :i64 0)
  (while (not (= c -1))
    (set n (+ n 1))
    (set c (get (vec-get nodes c) next)))
  (ret n))

(fn check-named? :bool ((s :str))
  (ret (and (> (str-len s) 0)
         (not (= (cast :i64 (str-byte s 0)) 58)))))

(fn check-name-of :i64 ((nodes (ref (vec node))) (id :i64))
  (ret (get (vec-get nodes id) name)))

(fn check-name-text :str ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (id :i64))
  (let n :i64 (check-name-of nodes id))
  (ret (if (= n -1) ""
         (vec-get ntexts n))))

(fn check-in :bool ((items (ref (vec :str))) (s :str))
  (letmut i :i64 0)
  (letmut found :bool false)
  (while (< i (vec-len items))
    (set found (or found (str-eq (vec-get items i) s)))
    (set i (+ i 1)))
  (ret found))

(fn check-has-prefix :bool ((s :str) (prefix :str))
  (let n :i64 (str-len prefix))
  (ret (if (> n (str-len s)) false
         (check-has-prefix-at s prefix n))))

(fn check-has-prefix-at :bool ((s :str) (prefix :str) (n :i64))
  (letmut i :i64 0)
  (letmut same :bool true)
  (while (< i n)
    (set same (and same (= (str-byte s i)
                          (str-byte prefix i))))
    (set i (+ i 1)))
  (ret same))

(fn check-reserved-name :bool ((name :str))
  (if (str-eq name "if")
    (ret true)
    (check-nothing))
  (if (str-eq name "while")
    (ret true)
    (check-nothing))
  (if (str-eq name "match")
    (ret true)
    (check-nothing))
  (if (str-eq name "let")
    (ret true)
    (check-nothing))
  (if (str-eq name "letmut")
    (ret true)
    (check-nothing))
  (if (str-eq name "set")
    (ret true)
    (check-nothing))
  (if (str-eq name "ret")
    (ret true)
    (check-nothing))
  (if (str-eq name "make")
    (ret true)
    (check-nothing))
  (if (str-eq name "get")
    (ret true)
    (check-nothing))
  (if (str-eq name "set-field")
    (ret true)
    (check-nothing))
  (if (str-eq name "alloc")
    (ret true)
    (check-nothing))
  (if (str-eq name "free")
    (ret true)
    (check-nothing))
  (if (str-eq name "ptr")
    (ret true)
    (check-nothing))
  (if (str-eq name "deref")
    (ret true)
    (check-nothing))
  (if (str-eq name "set-deref")
    (ret true)
    (check-nothing))
  (if (str-eq name "ptr-add")
    (ret true)
    (check-nothing))
  (if (str-eq name "print")
    (ret true)
    (check-nothing))
  (if (str-eq name "println")
    (ret true)
    (check-nothing))
  (if (str-eq name "spawn")
    (ret true)
    (check-nothing))
  (if (str-eq name "join")
    (ret true)
    (check-nothing))
  (if (str-eq name "lock")
    (ret true)
    (check-nothing))
  (if (str-eq name "unlock")
    (ret true)
    (check-nothing))
  (if (str-eq name "send")
    (ret true)
    (check-nothing))
  (if (str-eq name "recv")
    (ret true)
    (check-nothing))
  (if (str-eq name "ok")
    (ret true)
    (check-nothing))
  (if (str-eq name "err")
    (ret true)
    (check-nothing))
  (if (str-eq name "some")
    (ret true)
    (check-nothing))
  (if (str-eq name "none")
    (ret true)
    (check-nothing))
  (if (str-eq name "try")
    (ret true)
    (check-nothing))
  (if (str-eq name "break")
    (ret true)
    (check-nothing))
  (if (str-eq name "continue")
    (ret true)
    (check-nothing))
  (if (str-eq name "cast")
    (ret true)
    (check-nothing))
  (if (str-eq name "shl")
    (ret true)
    (check-nothing))
  (if (str-eq name "shr")
    (ret true)
    (check-nothing))
  (if (str-eq name "shr-u")
    (ret true)
    (check-nothing))
  (if (str-eq name "and")
    (ret true)
    (check-nothing))
  (if (str-eq name "or")
    (ret true)
    (check-nothing))
  (if (str-eq name "not")
    (ret true)
    (check-nothing))
  (if (str-eq name "read-file")
    (ret true)
    (check-nothing))
  (if (str-eq name "args")
    (ret true)
    (check-nothing))
  (if (str-eq name "f64-bits")
    (ret true)
    (check-nothing))
  (if (str-eq name "run")
    (ret true)
    (check-nothing))
  (if (str-eq name "run-status")
    (ret true)
    (check-nothing))
  (if (str-eq name "run-out")
    (ret true)
    (check-nothing))
  (if (str-eq name "run-err")
    (ret true)
    (check-nothing))
  (if (str-eq name "atomic")
    (ret true)
    (check-nothing))
  (if (check-has-prefix name "vec-")
    (ret true)
    (check-nothing))
  (if (check-has-prefix name "str-")
    (ret true)
    (check-nothing))
  (if (check-has-prefix name "arr-")
    (ret true)
    (check-nothing))
  (ret (check-has-prefix name "atomic-")))

(fn check-reserved-variant :bool ((name :str))
  (if (str-eq name "ok")
    (ret true)
    (check-nothing))
  (if (str-eq name "err")
    (ret true)
    (check-nothing))
  (if (str-eq name "some")
    (ret true)
    (check-nothing))
  (if (str-eq name "none")
    (ret true)
    (check-nothing))
  (if (str-eq name "try")
    (ret true)
    (check-nothing))
  (if (str-eq name "print")
    (ret true)
    (check-nothing))
  (if (str-eq name "println")
    (ret true)
    (check-nothing))
  (if (str-eq name "spawn")
    (ret true)
    (check-nothing))
  (if (str-eq name "join")
    (ret true)
    (check-nothing))
  (if (str-eq name "mutex")
    (ret true)
    (check-nothing))
  (if (str-eq name "lock")
    (ret true)
    (check-nothing))
  (if (str-eq name "unlock")
    (ret true)
    (check-nothing))
  (if (str-eq name "chan")
    (ret true)
    (check-nothing))
  (if (str-eq name "send")
    (ret true)
    (check-nothing))
  (if (str-eq name "recv")
    (ret true)
    (check-nothing))
  (if (str-eq name "atomic")
    (ret true)
    (check-nothing))
  (if (str-eq name "atomic-add")
    (ret true)
    (check-nothing))
  (if (str-eq name "atomic-load")
    (ret true)
    (check-nothing))
  (ret (str-eq name "atomic-store")))

(fn check-bound :i64 ((bnames (ref (vec :str))) (btypes (ref (vec :i64))) (name :str))
  (letmut i :i64 0)
  (letmut found :i64 -1)
  (while (and (= found -1)
           (< i (vec-len bnames)))
    (set found (if (str-eq (vec-get bnames i) name)
                 (vec-get btypes i) found))
    (set i (+ i 1)))
  (ret found))

(fn check-is-void :bool ((tags (ref (vec :i64))) (names (ref (vec :str))) (ty :i64))
  (ret (and (= (type-tag tags ty)
              (type-tag-prim))
         (str-eq (type-name names ty) "void"))))

(fn check-in-ids :bool ((seen (ref (vec :i64))) (id :i64))
  (letmut i :i64 0)
  (letmut found :bool false)
  (while (< i (vec-len seen))
    (set found (or found (= (vec-get seen i) id)))
    (set i (+ i 1)))
  (ret found))

(fn check-push-id :void ((seen (ref (vec :i64))) (id :i64))
  (vec-push seen id)
  (ret))

(fn check-pop-id :void ((seen (ref (vec :i64))))
  (let n :i64 (- (vec-len seen) 1))
  (if (> n -1)
    (vec-set seen n -1)
    (check-nothing))
  (ret))

(fn check-holds-owner :bool ((tags (ref (vec :i64))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pchild (ref (vec :i64))) (ty :i64) (seen (ref (vec :i64))))
  (let tag :i64 (type-tag tags ty))
  (if (= tag (type-tag-own))
    (ret true)
    (check-nothing))
  (if (or (= tag (type-tag-arr))
        (or (= tag (type-tag-opt))
          (= tag (type-tag-vec))))
    (ret (check-holds-owner tags elem extra pbase pchild (vec-get elem ty) seen))
    (check-nothing))
  (if (= tag (type-tag-res))
    (ret (or (check-holds-owner tags elem extra pbase pchild (vec-get elem ty) seen)
           (check-holds-owner tags elem extra pbase pchild (vec-get extra ty) seen)))
    (check-nothing))
  (if (= tag (type-tag-struct))
    (ret (check-aggregate-owner tags elem extra pbase pchild ty seen))
    (check-nothing))
  (if (= tag (type-tag-enum))
    (ret (check-aggregate-owner tags elem extra pbase pchild ty seen))
    (check-nothing))
  (ret false))

(fn check-aggregate-owner :bool ((tags (ref (vec :i64))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pchild (ref (vec :i64))) (ty :i64) (seen (ref (vec :i64))))
  (if (check-in-ids seen ty)
    (ret false)
    (check-nothing))
  (check-push-id seen ty)
  (letmut i :i64 0)
  (letmut found :bool false)
  (while (and (not found)
           (< i (vec-get extra ty)))
    (set found (check-holds-owner tags elem extra pbase pchild (vec-get pchild (+ (vec-get pbase ty) i)) seen))
    (set i (+ i 1)))
  (check-pop-id seen)
  (ret found))

(fn check-holds-vector :bool ((tags (ref (vec :i64))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pchild (ref (vec :i64))) (ty :i64) (seen (ref (vec :i64))))
  (let tag :i64 (type-tag tags ty))
  (if (= tag (type-tag-vec))
    (ret true)
    (check-nothing))
  (if (= tag (type-tag-arr))
    (ret (check-holds-vector tags elem extra pbase pchild (vec-get elem ty) seen))
    (check-nothing))
  (if (= tag (type-tag-struct))
    (ret (check-aggregate-vector tags elem extra pbase pchild ty seen))
    (check-nothing))
  (if (= tag (type-tag-enum))
    (ret (check-aggregate-vector tags elem extra pbase pchild ty seen))
    (check-nothing))
  (ret false))

(fn check-aggregate-vector :bool ((tags (ref (vec :i64))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pchild (ref (vec :i64))) (ty :i64) (seen (ref (vec :i64))))
  (if (check-in-ids seen ty)
    (ret false)
    (check-nothing))
  (check-push-id seen ty)
  (letmut i :i64 0)
  (letmut found :bool false)
  (while (and (not found)
           (< i (vec-get extra ty)))
    (set found (check-holds-vector tags elem extra pbase pchild (vec-get pchild (+ (vec-get pbase ty) i)) seen))
    (set i (+ i 1)))
  (check-pop-id seen)
  (ret found))

(fn check-stored-result :bool ((tags (ref (vec :i64))) (elem (ref (vec :i64))) (ty :i64))
  (let tag :i64 (type-tag tags ty))
  (if (= tag (type-tag-res))
    (ret true)
    (check-nothing))
  (if (or (= tag (type-tag-arr))
        (or (= tag (type-tag-vec))
          (= tag (type-tag-opt))))
    (ret (check-stored-result tags elem (vec-get elem ty)))
    (check-nothing))
  (ret false))

(fn check-escapes :bool ((tags (ref (vec :i64))) (names (ref (vec :str))) (ty :i64))
  (ret (and (= (type-tag tags ty)
              (type-tag-fn))
         (str-eq (type-name names ty) "fn*"))))

(fn check-holds-ref :bool ((tags (ref (vec :i64))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pchild (ref (vec :i64))) (ty :i64) (seen (ref (vec :i64))))
  (let tag :i64 (type-tag tags ty))
  (if (= tag (type-tag-ref))
    (ret true)
    (check-nothing))
  (if (or (= tag (type-tag-arr))
        (or (= tag (type-tag-vec))
          (= tag (type-tag-opt))))
    (ret (check-holds-ref tags elem extra pbase pchild (vec-get elem ty) seen))
    (check-nothing))
  (if (= tag (type-tag-res))
    (ret (or (check-holds-ref tags elem extra pbase pchild (vec-get elem ty) seen)
           (check-holds-ref tags elem extra pbase pchild (vec-get extra ty) seen)))
    (check-nothing))
  (if (or (= tag (type-tag-struct))
        (= tag (type-tag-enum)))
    (ret (check-aggregate-ref tags elem extra pbase pchild ty seen))
    (check-nothing))
  (ret false))

(fn check-aggregate-ref :bool ((tags (ref (vec :i64))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pchild (ref (vec :i64))) (ty :i64) (seen (ref (vec :i64))))
  (if (check-in-ids seen ty)
    (ret false)
    (check-nothing))
  (check-push-id seen ty)
  (letmut i :i64 0)
  (letmut found :bool false)
  (while (and (not found)
           (< i (vec-get extra ty)))
    (let payload :i64 (vec-get pchild (+ (vec-get pbase ty) i)))
    (set found (if (= payload -1) false
                 (check-holds-ref tags elem extra pbase pchild payload seen)))
    (set i (+ i 1)))
  (check-pop-id seen)
  (ret found))

(fn check-c-prim :bool ((name :str))
  (if (str-eq name "i8")
    (ret true)
    (check-nothing))
  (if (str-eq name "i16")
    (ret true)
    (check-nothing))
  (if (str-eq name "i32")
    (ret true)
    (check-nothing))
  (if (str-eq name "i64")
    (ret true)
    (check-nothing))
  (if (str-eq name "u8")
    (ret true)
    (check-nothing))
  (if (str-eq name "u16")
    (ret true)
    (check-nothing))
  (if (str-eq name "u32")
    (ret true)
    (check-nothing))
  (if (str-eq name "u64")
    (ret true)
    (check-nothing))
  (if (str-eq name "f32")
    (ret true)
    (check-nothing))
  (if (str-eq name "f64")
    (ret true)
    (check-nothing))
  (if (str-eq name "bool")
    (ret true)
    (check-nothing))
  (ret (str-eq name "str")))

(fn check-crosses :bool ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pchild (ref (vec :i64))) (ty :i64) (seen (ref (vec :i64))))
  (let tag :i64 (type-tag tags ty))
  (if (= tag (type-tag-prim))
    (ret (check-c-prim (type-name names ty)))
    (check-nothing))
  (if (or (= tag (type-tag-ptr))
        (= tag (type-tag-shared)))
    (ret (check-crosses tags names elem extra pbase pchild (vec-get elem ty) seen))
    (check-nothing))
  (if (= tag (type-tag-struct))
    (ret (check-crosses-struct tags names elem extra pbase pchild ty seen))
    (check-nothing))
  (ret false))

(fn check-crosses-struct :bool ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pchild (ref (vec :i64))) (ty :i64) (seen (ref (vec :i64))))
  (if (check-in-ids seen ty)
    (ret false)
    (check-nothing))
  (check-push-id seen ty)
  (letmut i :i64 0)
  (letmut ok :bool true)
  (while (and ok (< i (vec-get extra ty)))
    (set ok (check-crosses tags names elem extra pbase pchild (vec-get pchild (+ (vec-get pbase ty) i)) seen))
    (set i (+ i 1)))
  (check-pop-id seen)
  (ret ok))

(fn check-shareable :bool ((tags (ref (vec :i64))) (names (ref (vec :str))) (ty :i64))
  (let tag :i64 (type-tag tags ty))
  (if (= tag (type-tag-ptr))
    (ret true)
    (check-nothing))
  (if (or (= tag (type-tag-chan))
        (= tag (type-tag-atomic)))
    (ret true)
    (check-nothing))
  (ret (and (= tag (type-tag-prim))
         (or (str-eq (type-name names ty) "mutex")
           (str-eq (type-name names ty) "thread")))))

(fn check-shared-state :bool ((tags (ref (vec :i64))) (names (ref (vec :str))) (ty :i64))
  (let tag :i64 (type-tag tags ty))
  (if (or (= tag (type-tag-chan))
        (= tag (type-tag-atomic)))
    (ret true)
    (check-nothing))
  (ret (and (= tag (type-tag-prim))
         (or (str-eq (type-name names ty) "mutex")
           (str-eq (type-name names ty) "thread")))))

(fn check-unmarked-share :bool ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pchild (ref (vec :i64))) (ty :i64) (seen (ref (vec :i64))))
  (let tag :i64 (type-tag tags ty))
  (if (= tag (type-tag-shared))
    (ret false)
    (check-nothing))
  (if (or (= tag (type-tag-ptr))
        (or (= tag (type-tag-chan))
          (= tag (type-tag-atomic))))
    (ret true)
    (check-nothing))
  (if (= tag (type-tag-prim))
    (ret (or (str-eq (type-name names ty) "mutex")
           (str-eq (type-name names ty) "thread")))
    (check-nothing))
  (if (or (= tag (type-tag-arr))
        (or (= tag (type-tag-vec))
          (= tag (type-tag-opt))))
    (ret (check-unmarked-share tags names elem extra pbase pchild (vec-get elem ty) seen))
    (check-nothing))
  (if (= tag (type-tag-res))
    (ret (or (check-unmarked-share tags names elem extra pbase pchild (vec-get elem ty) seen)
           (check-unmarked-share tags names elem extra pbase pchild (vec-get extra ty) seen)))
    (check-nothing))
  (if (or (= tag (type-tag-struct))
        (= tag (type-tag-enum)))
    (ret (check-aggregate-share tags names elem extra pbase pchild ty seen))
    (check-nothing))
  (ret false))

(fn check-aggregate-share :bool ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pchild (ref (vec :i64))) (ty :i64) (seen (ref (vec :i64))))
  (if (check-in-ids seen ty)
    (ret false)
    (check-nothing))
  (check-push-id seen ty)
  (letmut i :i64 0)
  (letmut found :bool false)
  (while (and (not found)
           (< i (vec-get extra ty)))
    (let payload :i64 (vec-get pchild (+ (vec-get pbase ty) i)))
    (set found (if (= payload -1) false
                 (check-unmarked-share tags names elem extra pbase pchild payload seen)))
    (set i (+ i 1)))
  (check-pop-id seen)
  (ret found))

(fn check-channel-element check-error ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pchild (ref (vec :i64))) (ty :i64) (path :str))
  (letmut seen1
    (vec :i64)
    (make (vec :i64)))
  (let holds-ref :bool (check-holds-ref tags elem extra pbase pchild ty seen1))
  (vec-free seen1)
  (if holds-ref
    (ret (check-fail 305 path "a ref cannot escape the call: a channel cannot carry it"))
    (check-nothing))
  (if (check-is-void tags names ty)
    (ret (check-fail 100 path "a channel cannot carry :void"))
    (check-nothing))
  (letmut seen2
    (vec :i64)
    (make (vec :i64)))
  (let owns :bool (check-holds-owner tags elem extra pbase pchild ty seen2))
  (vec-free seen2)
  (if owns
    (ret (check-fail 2 path "a channel cannot carry a value that owns memory"))
    (check-nothing))
  (letmut seen3
    (vec :i64)
    (make (vec :i64)))
  (let vectors :bool (check-holds-vector tags elem extra pbase pchild ty seen3))
  (vec-free seen3)
  (if vectors
    (ret (check-fail 2 path "a channel cannot carry a vector: its buffer has no copy"))
    (check-nothing))
  (if (check-stored-result tags elem ty)
    (ret (check-fail 2 path "a channel cannot carry a result"))
    (check-nothing))
  (if (check-escapes tags names ty)
    (ret (check-fail 502 path "a closure that captures cannot leave its function"))
    (check-nothing))
  (ret (check-pass)))

(fn check-resolve check-error ((dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (ty :i64) (where :str) (strict :i64) (shared :i64) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (out (ref (vec :i64))))
  (let tag :i64 (type-tag tags ty))
  (if (= tag (type-tag-var))
    (ret (check-resolve-var names bnames btypes ty where strict out))
    (check-nothing))
  (if (= tag (type-tag-prim))
    (ret (check-resolve-prim names ty where shared out))
    (check-nothing))
  (if (or (= tag (type-tag-struct))
        (= tag (type-tag-enum)))
    (ret (check-resolve-named tags names dnames dids ty where out))
    (check-nothing))
  (if (= tag (type-tag-ptr))
    (ret (check-resolve-unary dnames dids tags names elem extra pbase powner pnames ptypes pchild ty where strict bnames btypes out 1))
    (check-nothing))
  (if (= tag (type-tag-own))
    (ret (check-resolve-own dnames dids tags names elem extra pbase powner pnames ptypes pchild ty where strict bnames btypes out))
    (check-nothing))
  (if (= tag (type-tag-opt))
    (ret (check-resolve-opt dnames dids tags names elem extra pbase powner pnames ptypes pchild ty where strict bnames btypes out))
    (check-nothing))
  (if (= tag (type-tag-shared))
    (ret (check-resolve-shared dnames dids tags names elem extra pbase powner pnames ptypes pchild ty where strict bnames btypes out))
    (check-nothing))
  (if (or (= tag (type-tag-chan))
        (= tag (type-tag-atomic)))
    (ret (check-resolve-handle dnames dids tags names elem extra pbase powner pnames ptypes pchild ty where strict shared bnames btypes out))
    (check-nothing))
  (if (= tag (type-tag-vec))
    (ret (check-resolve-vec dnames dids tags names elem extra pbase powner pnames ptypes pchild ty where strict bnames btypes out))
    (check-nothing))
  (if (= tag (type-tag-ref))
    (ret (check-resolve-ref dnames dids tags names elem extra pbase powner pnames ptypes pchild ty where strict bnames btypes out))
    (check-nothing))
  (if (= tag (type-tag-res))
    (ret (check-resolve-res dnames dids tags names elem extra pbase powner pnames ptypes pchild ty where strict bnames btypes out))
    (check-nothing))
  (if (= tag (type-tag-fn))
    (ret (check-resolve-fn dnames dids tags names elem extra pbase powner pnames ptypes pchild ty where strict bnames btypes out))
    (check-nothing))
  (ret (check-resolve-arr dnames dids tags names elem extra pbase powner pnames ptypes pchild ty where strict bnames btypes out)))

(fn check-resolve-var check-error ((names (ref (vec :str))) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (ty :i64) (where :str) (strict :i64) (out (ref (vec :i64))))
  (let name :str (type-name names ty))
  (let bound :i64 (if (= strict 0) -1
                    (check-bound bnames btypes name)))
  (ret (if (= strict 0)
         (check-store out ty)
         (if (= bound -1)
           (check-fail 501 where (str-concat "type variable " (str-concat name " is not bound here")))
           (check-store out bound)))))

(fn check-store check-error ((out (ref (vec :i64))) (ty :i64))
  (vec-set out 0 ty)
  (ret (check-pass)))

(fn check-resolve-prim check-error ((names (ref (vec :str))) (ty :i64) (where :str) (shared :i64) (out (ref (vec :i64))))
  (ret (if (and (= shared 0)
             (str-eq (type-name names ty) "mutex"))
         (check-fail 700 where "shared state must be marked '(shared ...)'")
         (check-store out ty))))

(fn check-resolve-named check-error ((tags (ref (vec :i64))) (names (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (ty :i64) (where :str) (out (ref (vec :i64))))
  (let name :str (type-name names ty))
  (letmut i :i64 0)
  (letmut found :i64 -1)
  (while (and (= found -1)
           (< i (vec-len dnames)))
    (set found (if (str-eq (vec-get dnames i) name)
                 (vec-get dids i) found))
    (set i (+ i 1)))
  (ret (if (= found -1)
         (check-fail 101 where (str-concat "unknown type '" (str-concat name "'")))
         (check-store out found))))

(fn check-resolve-unary check-error ((dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (ty :i64) (where :str) (strict :i64) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (out (ref (vec :i64))) (newtag :i64))
  (letmut inner
    (vec :i64)
    (make (vec :i64)))
  (vec-push inner -1)
  (letmut err check-error (check-resolve dnames dids tags names elem extra pbase powner pnames ptypes pchild (vec-get elem ty) where strict 0 bnames btypes inner))
  (if (not (check-ok err))
    (ret (check-free-one inner err))
    (check-nothing))
  (let child :i64 (vec-get inner 0))
  (vec-free inner)
  (vec-set out 0 (type-add tags names elem extra pbase powner newtag "" child -1 -1))
  (ret (check-pass)))

(fn check-free-one check-error ((one (ref (vec :i64))) (e check-error))
  (vec-free one)
  (ret e))

(fn check-free-two check-error ((a (ref (vec :i64))) (b (ref (vec :i64))) (e check-error))
  (vec-free a)
  (vec-free b)
  (ret e))

(fn check-resolve-own check-error ((dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (ty :i64) (where :str) (strict :i64) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (out (ref (vec :i64))))
  (letmut inner
    (vec :i64)
    (make (vec :i64)))
  (vec-push inner -1)
  (letmut err check-error (check-resolve dnames dids tags names elem extra pbase powner pnames ptypes pchild (vec-get elem ty) where strict 0 bnames btypes inner))
  (if (not (check-ok err))
    (ret (check-free-one inner err))
    (check-nothing))
  (let child :i64 (vec-get inner 0))
  (vec-free inner)
  (letmut seen
    (vec :i64)
    (make (vec :i64)))
  (let owns :bool (check-holds-owner tags elem extra pbase pchild child seen))
  (vec-free seen)
  (if owns
    (ret (check-fail 2 where "an owner cannot hold another owner yet"))
    (check-nothing))
  (vec-set out 0 (type-own tags names elem extra pbase powner child))
  (ret (check-pass)))

(fn check-resolve-opt check-error ((dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (ty :i64) (where :str) (strict :i64) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (out (ref (vec :i64))))
  (letmut inner
    (vec :i64)
    (make (vec :i64)))
  (vec-push inner -1)
  (letmut err check-error (check-resolve dnames dids tags names elem extra pbase powner pnames ptypes pchild (vec-get elem ty) where strict 0 bnames btypes inner))
  (if (not (check-ok err))
    (ret (check-free-one inner err))
    (check-nothing))
  (let child :i64 (vec-get inner 0))
  (vec-free inner)
  (letmut seen1
    (vec :i64)
    (make (vec :i64)))
  (let vectors :bool (check-holds-vector tags elem extra pbase pchild child seen1))
  (vec-free seen1)
  (if vectors
    (ret (check-fail 2 where "a vector cannot be inside an optional yet"))
    (check-nothing))
  (if (check-stored-result tags elem child)
    (ret (check-fail 2 where "a result cannot be inside an optional yet"))
    (check-nothing))
  (vec-set out 0 (type-opt tags names elem extra pbase powner child))
  (ret (check-pass)))

(fn check-resolve-shared check-error ((dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (ty :i64) (where :str) (strict :i64) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (out (ref (vec :i64))))
  (letmut inner
    (vec :i64)
    (make (vec :i64)))
  (vec-push inner -1)
  (letmut err check-error (check-resolve dnames dids tags names elem extra pbase powner pnames ptypes pchild (vec-get elem ty) where strict 1 bnames btypes inner))
  (if (not (check-ok err))
    (ret (check-free-one inner err))
    (check-nothing))
  (let child :i64 (vec-get inner 0))
  (vec-free inner)
  (if (not (check-shareable tags names child))
    (ret (check-fail 2 where "only a pointer, a mutex, a channel or an atomic can be shared"))
    (check-nothing))
  (vec-set out 0 (type-shared tags names elem extra pbase powner child))
  (ret (check-pass)))

(fn check-resolve-handle check-error ((dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (ty :i64) (where :str) (strict :i64) (shared :i64) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (out (ref (vec :i64))))
  (if (= shared 0)
    (ret (check-fail 700 where "shared state must be marked '(shared ...)'"))
    (check-nothing))
  (letmut inner
    (vec :i64)
    (make (vec :i64)))
  (vec-push inner -1)
  (letmut err check-error (check-resolve dnames dids tags names elem extra pbase powner pnames ptypes pchild (vec-get elem ty) where strict 1 bnames btypes inner))
  (if (not (check-ok err))
    (ret (check-free-one inner err))
    (check-nothing))
  (let child :i64 (vec-get inner 0))
  (vec-free inner)
  (let tag :i64 (type-tag tags ty))
  (if (= tag (type-tag-chan))
    (ret (check-handle-chan tags names elem extra pbase powner pchild ty child where out))
    (ret (check-handle-atomic tags names elem ptypes extra pbase powner ty child where out))))

(fn check-handle-chan check-error ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pchild (ref (vec :i64))) (ty :i64) (child :i64) (where :str) (out (ref (vec :i64))))
  (let e check-error (check-channel-element tags names elem extra pbase pchild child where))
  (ret (if (not (check-ok e)) e
         (check-store out (type-chan tags names elem extra pbase powner child)))))

(fn check-handle-atomic check-error ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (ptypes (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (ty :i64) (child :i64) (where :str) (out (ref (vec :i64))))
  (if (not (and (= (type-tag tags child)
                  (type-tag-prim))
             (or (str-eq (type-name names child) "i64")
               (str-eq (type-name names child) "u64"))))
    (ret (check-fail 100 where (str-concat "an atomic needs :i64 or :u64, found " (type-text tags names elem extra pbase ptypes child))))
    (check-nothing))
  (ret (check-store out (type-atomic tags names elem extra pbase powner child))))

(fn check-resolve-vec check-error ((dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (ty :i64) (where :str) (strict :i64) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (out (ref (vec :i64))))
  (letmut inner
    (vec :i64)
    (make (vec :i64)))
  (vec-push inner -1)
  (letmut err check-error (check-resolve dnames dids tags names elem extra pbase powner pnames ptypes pchild (vec-get elem ty) where strict 0 bnames btypes inner))
  (if (not (check-ok err))
    (ret (check-free-one inner err))
    (check-nothing))
  (let child :i64 (vec-get inner 0))
  (vec-free inner)
  (letmut seen
    (vec :i64)
    (make (vec :i64)))
  (let owns :bool (check-holds-owner tags elem extra pbase pchild child seen))
  (vec-free seen)
  (if owns
    (ret (check-fail 2 where "a container of owners is not supported yet"))
    (check-nothing))
  (if (check-stored-result tags elem child)
    (ret (check-fail 2 where "a result cannot be a vector element yet"))
    (check-nothing))
  (vec-set out 0 (type-vec tags names elem extra pbase powner child))
  (ret (check-pass)))

(fn check-resolve-ref check-error ((dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (ty :i64) (where :str) (strict :i64) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (out (ref (vec :i64))))
  (letmut inner
    (vec :i64)
    (make (vec :i64)))
  (vec-push inner -1)
  (letmut err check-error (check-resolve dnames dids tags names elem extra pbase powner pnames ptypes pchild (vec-get elem ty) where strict 0 bnames btypes inner))
  (if (not (check-ok err))
    (ret (check-free-one inner err))
    (check-nothing))
  (let child :i64 (vec-get inner 0))
  (vec-free inner)
  (if (not (= (type-tag tags child)
             (type-tag-vec)))
    (ret (check-fail 100 where "a ref may name a vector only"))
    (check-nothing))
  (vec-set out 0 (type-ref tags names elem extra pbase powner child))
  (ret (check-pass)))

(fn check-resolve-res check-error ((dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (ty :i64) (where :str) (strict :i64) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (out (ref (vec :i64))))
  (letmut inner
    (vec :i64)
    (make (vec :i64)))
  (vec-push inner -1)
  (letmut err check-error (check-resolve dnames dids tags names elem extra pbase powner pnames ptypes pchild (vec-get elem ty) where strict 0 bnames btypes inner))
  (if (not (check-ok err))
    (ret (check-free-one inner err))
    (check-nothing))
  (let ok-id :i64 (vec-get inner 0))
  (vec-set inner 0 -1)
  (set err (check-resolve dnames dids tags names elem extra pbase powner pnames ptypes pchild (vec-get extra ty) where strict 0 bnames btypes inner))
  (if (not (check-ok err))
    (ret (check-free-one inner err))
    (check-nothing))
  (let err-id :i64 (vec-get inner 0))
  (vec-free inner)
  (if (not (= (type-tag tags err-id)
             (type-tag-enum)))
    (ret (check-fail 100 where (str-concat "the error type of a result must be a declared enum, found " (type-text tags names elem extra pbase ptypes err-id))))
    (check-nothing))
  (letmut seen1
    (vec :i64)
    (make (vec :i64)))
  (let vectors :bool (check-holds-vector tags elem extra pbase pchild ok-id seen1))
  (vec-free seen1)
  (if vectors
    (ret (check-fail 2 where "a vector cannot be inside a result yet"))
    (check-nothing))
  (if (check-stored-result tags elem ok-id)
    (ret (check-fail 2 where "a result cannot be inside a result yet"))
    (check-nothing))
  (vec-set out 0 (type-res tags names elem extra pbase powner ok-id err-id))
  (ret (check-pass)))

(fn check-resolve-fn check-error ((dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (ty :i64) (where :str) (strict :i64) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (out (ref (vec :i64))))
  (letmut ttypes
    (vec :i64)
    (make (vec :i64)))
  (letmut err check-error (check-pass))
  (letmut i :i64 0)
  (while (and (check-ok err)
           (< i (vec-get extra ty)))
    (letmut inner
      (vec :i64)
      (make (vec :i64)))
    (vec-push inner -1)
    (set err (check-resolve dnames dids tags names elem extra pbase powner pnames ptypes pchild (type-param-type ptypes pbase ty i) where strict 0 bnames btypes inner))
    (if (check-ok err)
      (vec-push ttypes (vec-get inner 0))
      (check-nothing))
    (vec-free inner)
    (set i (+ i 1)))
  (if (not (check-ok err))
    (ret (check-free-one ttypes err))
    (check-nothing))
  (letmut one
    (vec :i64)
    (make (vec :i64)))
  (vec-push one -1)
  (set err (check-resolve dnames dids tags names elem extra pbase powner pnames ptypes pchild (vec-get elem ty) where strict 0 bnames btypes one))
  (if (not (check-ok err))
    (ret (check-free-two ttypes one err))
    (check-nothing))
  (let ret-id :i64 (vec-get one 0))
  (let start :i64 (type-param-start ptypes))
  (letmut j :i64 0)
  (while (< j (vec-len ttypes))
    (type-param pnames ptypes "" (vec-get ttypes j))
    (set j (+ j 1)))
  (vec-set out 0 (type-fn tags names elem extra pbase powner
                   (type-name names ty) ret-id
                   (vec-len ttypes) start))
  (vec-free one)
  (vec-free ttypes)
  (ret (check-pass)))

(fn check-resolve-arr check-error ((dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (ty :i64) (where :str) (strict :i64) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (out (ref (vec :i64))))
  (letmut inner
    (vec :i64)
    (make (vec :i64)))
  (vec-push inner -1)
  (letmut err check-error (check-resolve dnames dids tags names elem extra pbase powner pnames ptypes pchild (vec-get elem ty) where strict 0 bnames btypes inner))
  (if (not (check-ok err))
    (ret (check-free-one inner err))
    (check-nothing))
  (let child :i64 (vec-get inner 0))
  (vec-free inner)
  (letmut seen1
    (vec :i64)
    (make (vec :i64)))
  (let owns :bool (check-holds-owner tags elem extra pbase pchild child seen1))
  (vec-free seen1)
  (if owns
    (ret (check-fail 2 where "a container of owners is not supported yet"))
    (check-nothing))
  (letmut seen2
    (vec :i64)
    (make (vec :i64)))
  (let vectors :bool (check-holds-vector tags elem extra pbase pchild child seen2))
  (vec-free seen2)
  (if vectors
    (ret (check-fail 2 where "vector array elements are not supported yet"))
    (check-nothing))
  (if (check-stored-result tags elem child)
    (ret (check-fail 2 where "a result cannot be an array element yet"))
    (check-nothing))
  (vec-set out 0 (type-arr tags names elem extra pbase powner child (vec-get extra ty)))
  (ret (check-pass)))

(fn check-type check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (id :i64) (fallback :i64) (strict :i64) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (out (ref (vec :i64))))
  (letmut parsed
    (vec :i64)
    (make (vec :i64)))
  (vec-push parsed -1)
  (let terr type-error (type-under nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes id "" parsed))
  (if (not (type-ok terr))
    (ret (check-free-one parsed (check-fail (get terr code)
                                  (check-where nodes ntexts (get terr path) id fallback)
                                  (get terr message))))
    (check-nothing))
  (let ty :i64 (vec-get parsed 0))
  (vec-free parsed)
  (letmut err check-error (check-resolve dnames dids tags names elem extra pbase powner pnames ptypes pchild ty "" strict 0 bnames btypes out))
  (ret (if (check-ok err) err
         (check-fail (get err code)
           (check-where nodes ntexts (get err path) id fallback)
           (get err message)))))

(fn check-type-parse check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (id :i64) (fallback :i64) (out (ref (vec :i64))))
  (letmut parsed
    (vec :i64)
    (make (vec :i64)))
  (vec-push parsed -1)
  (let terr type-error (type-under nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes id "" parsed))
  (if (not (type-ok terr))
    (ret (check-free-one parsed (check-fail (get terr code)
                                  (check-where nodes ntexts (get terr path) id fallback)
                                  (get terr message))))
    (check-nothing))
  (vec-set out 0 (vec-get parsed 0))
  (vec-free parsed)
  (ret (check-pass)))

(fn check-where :str ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (got :str) (id :i64) (fallback :i64))
  (letmut where :str got)
  (if (str-eq where "")
    (set where (check-node-path nodes ntexts id))
    (check-nothing))
  (if (str-eq where "")
    (set where (check-node-path nodes ntexts fallback))
    (check-nothing))
  (ret where))

(fn check-fn-shape check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (node :i64) (out (ref (vec :i64))))
  (if (= (check-count nodes node) 0)
    (ret (check-fail-at nodes ntexts node 2 "fn needs a return type and a parameter list"))
    (check-nothing))
  (letmut c0 :i64 (get (vec-get nodes node) first))
  (letmut ret-child :i64 c0)
  (letmut rest :i64 (if (= c0 -1) -1
                      (get (vec-get nodes c0) next)))
  (if (check-is-marker nodes ntexts c0)
    (if (= rest -1)
      (ret (check-fail-at nodes ntexts node 101 "expected a type after ':'"))
      (check-nothing))
    (check-nothing))
  (if (check-is-marker nodes ntexts c0)
    (set ret-child rest)
    (check-nothing))
  (if (check-is-marker nodes ntexts c0)
    (set rest (if (= rest -1) -1
                (get (vec-get nodes rest) next)))
    (check-nothing))
  (letmut ebn
    (vec :str)
    (make (vec :str)))
  (letmut ebt
    (vec :i64)
    (make (vec :i64)))
  (letmut one
    (vec :i64)
    (make (vec :i64)))
  (vec-push one -1)
  (letmut err check-error (check-type nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild ret-child node 0 ebn ebt one))
  (if (not (check-ok err))
    (ret (check-free-three ebn ebt one err))
    (check-nothing))
  (let ret-id :i64 (vec-get one 0))
  (if (= rest -1)
    (ret (check-free-three ebn ebt one (check-fail-at nodes ntexts node 2 "fn needs a parameter list")))
    (check-nothing))
  (if (not (= (get (vec-get nodes rest) tok) -1))
    (ret (check-free-three ebn ebt one (check-fail-at nodes ntexts node 2 "fn needs a parameter list")))
    (check-nothing))
  (let params :i64 rest)
  (if (not (= (get (vec-get nodes params) text) -1))
    (ret (check-free-three ebn ebt one (check-fail-at nodes ntexts node 2 "a parameter must be (name type)")))
    (check-nothing))
  (letmut tnames
    (vec :str)
    (make (vec :str)))
  (letmut ttypes
    (vec :i64)
    (make (vec :i64)))
  (letmut c :i64 (get (vec-get nodes params) first))
  (while (and (check-ok err)
           (not (= c -1)))
    (set err (check-param nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild c node ebn ebt tnames ttypes))
    (set c (if (= c -1) -1
             (get (vec-get nodes c) next))))
  (if (not (check-ok err))
    (ret (check-free-five ebn ebt one tnames ttypes err))
    (check-nothing))
  (let start :i64 (type-param-start ptypes))
  (letmut j :i64 0)
  (while (< j (vec-len ttypes))
    (type-param pnames ptypes "" (vec-get ttypes j))
    (set j (+ j 1)))
  (let id :i64 (type-fn tags names elem extra pbase powner "fn" ret-id (vec-len ttypes) start))
  (vec-set out 0 ret-id)
  (vec-set out 1 (vec-len ttypes))
  (vec-set out 2 (if (= params -1) -1
                   (get (vec-get nodes params) next)))
  (vec-set out 3 id)
  (vec-set out 4 params)
  (ret (check-free-five ebn ebt one tnames ttypes (check-pass))))

(fn check-free-three check-error ((a (ref (vec :str))) (b (ref (vec :i64))) (c (ref (vec :i64))) (e check-error))
  (vec-free a)
  (vec-free b)
  (vec-free c)
  (ret e))

(fn check-free-five check-error ((a (ref (vec :str))) (b (ref (vec :i64))) (c (ref (vec :i64))) (d (ref (vec :str))) (f (ref (vec :i64))) (e check-error))
  (vec-free a)
  (vec-free b)
  (vec-free c)
  (vec-free d)
  (vec-free f)
  (ret e))

(fn check-param check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (param :i64) (fallback :i64) (ebn (ref (vec :str))) (ebt (ref (vec :i64))) (tnames (ref (vec :str))) (ttypes (ref (vec :i64))))
  (if (not (= (get (vec-get nodes param) tok) -1))
    (ret (check-fail-at nodes ntexts fallback 2 "a parameter must be (name type)"))
    (check-nothing))
  (let n :i64 (check-count nodes param))
  (if (= n 0)
    (ret (check-fail-at nodes ntexts param 2 "a parameter must be (name type)"))
    (check-nothing))
  (let name-item :i64 (+ param 1))
  (let name :str (check-atom-text nodes ntexts name-item))
  (if (not (check-named? name))
    (ret (check-fail-at nodes ntexts param 2 "a parameter needs a name"))
    (check-nothing))
  (let c1 :i64 (get (vec-get nodes param) first))
  (letmut titem :i64 -1)
  (if (= n 1)
    (set titem c1)
    (check-nothing))
  (if (= n 2)
    (if (check-is-marker nodes ntexts c1)
      (set titem (if (= c1 -1) -1
                   (get (vec-get nodes c1) next)))
      (check-nothing))
    (check-nothing))
  (if (> n 2)
    (ret (check-fail-at nodes ntexts param 2 "a parameter must be (name type)"))
    (check-nothing))
  (if (= n 2)
    (if (not (check-is-marker nodes ntexts c1))
      (ret (check-fail-at nodes ntexts param 2 "a parameter must be (name type)"))
      (check-nothing))
    (check-nothing))
  (if (check-in tnames name)
    (ret (check-fail-at nodes ntexts param 3 (str-concat "duplicate definition '" (str-concat name "'"))))
    (check-nothing))
  (letmut one
    (vec :i64)
    (make (vec :i64)))
  (vec-push one -1)
  (letmut err check-error (check-type nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild titem param 0 ebn ebt one))
  (if (not (check-ok err))
    (ret (check-free-one one err))
    (check-nothing))
  (let ty :i64 (vec-get one 0))
  (vec-free one)
  (if (check-is-void tags names ty)
    (ret (check-fail-at nodes ntexts param 100 (str-concat "parameter '" (str-concat name "' cannot be :void"))))
    (check-nothing))
  (vec-push tnames name)
  (vec-push ttypes ty)
  (ret (check-pass)))

(fn check-signature check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (node :i64) (fvname (ref (vec :str))) (out (ref (vec :i64))))
  (let name :str (check-name-text nodes ntexts node))
  (if (not (check-named? name))
    (ret (check-fail-at nodes ntexts node 2 "fn needs a name"))
    (check-nothing))
  (if (check-reserved-name name)
    (ret (check-fail-at nodes ntexts node 3 "reserved form name"))
    (check-nothing))
  (letmut shape
    (vec :i64)
    (make (vec :i64)))
  (vec-push shape -1)
  (vec-push shape -1)
  (vec-push shape -1)
  (vec-push shape -1)
  (vec-push shape -1)
  (letmut err check-error (check-fn-shape nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild node shape))
  (if (not (check-ok err))
    (ret (check-free-one shape err))
    (check-nothing))
  (letmut vars
    (vec :str)
    (make (vec :str)))
  (type-variables tags names elem extra pbase ptypes (vec-get shape 0) vars)
  (letmut i :i64 0)
  (while (< i (vec-get shape 1))
    (type-variables tags names elem extra pbase ptypes (type-param-type ptypes pbase (vec-get shape 3) i) vars)
    (set i (+ i 1)))
  (letmut err2 check-error (check-pass))
  (if (and (> (vec-len vars) 0)
        (str-eq name "main"))
    (set err2 (check-fail-at nodes ntexts node 101 "main cannot have type variables: nothing fixes them"))
    (check-nothing))
  (if (not (check-ok err2))
    (ret (check-free-two-str-ids vars shape err2))
    (check-nothing))
  (let base :i64 (vec-len fvname))
  (set i 0)
  (while (< i (vec-len vars))
    (vec-push fvname (vec-get vars i))
    (set i (+ i 1)))
  (vec-set out 0 (vec-get shape 3))
  (vec-set out 1 (if (> (vec-len vars) 0) base -1))
  (vec-set out 2 (vec-len vars))
  (vec-free vars)
  (vec-free shape)
  (ret (check-pass)))

(fn check-free-two-str-ids check-error ((a (ref (vec :str))) (b (ref (vec :i64))) (e check-error))
  (vec-free a)
  (vec-free b)
  (ret e))

(fn check-extern-signature check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (node :i64) (out (ref (vec :i64))))
  (let name :str (check-name-text nodes ntexts node))
  (if (not (check-named? name))
    (ret (check-fail-at nodes ntexts node 2 "extern needs a name"))
    (check-nothing))
  (if (check-reserved-name name)
    (ret (check-fail-at nodes ntexts node 3 "reserved form name"))
    (check-nothing))
  (letmut shape
    (vec :i64)
    (make (vec :i64)))
  (vec-push shape -1)
  (vec-push shape -1)
  (vec-push shape -1)
  (vec-push shape -1)
  (vec-push shape -1)
  (letmut err check-error (check-fn-shape nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild node shape))
  (if (not (check-ok err))
    (ret (check-free-one shape err))
    (check-nothing))
  (letmut vars
    (vec :str)
    (make (vec :str)))
  (type-variables tags names elem extra pbase ptypes (vec-get shape 0) vars)
  (letmut i :i64 0)
  (while (< i (vec-get shape 1))
    (type-variables tags names elem extra pbase ptypes (type-param-type ptypes pbase (vec-get shape 3) i) vars)
    (set i (+ i 1)))
  (if (> (vec-len vars) 0)
    (ret (check-free-two-str-ids vars shape (check-fail-at nodes ntexts node 101 "an extern function cannot have type variables")))
    (check-nothing))
  (vec-free vars)
  (let ret-id :i64 (vec-get shape 0))
  (letmut seen
    (vec :i64)
    (make (vec :i64)))
  (let crosses :bool (check-crosses tags names elem extra pbase pchild ret-id seen))
  (vec-free seen)
  (if (not crosses)
    (if (check-is-void tags names ret-id)
      (check-nothing)
      (ret (check-free-one shape (check-fail 2 (check-return-path nodes ntexts node) "type does not cross the C boundary"))))
    (check-nothing))
  (let base :i64 (vec-get pbase (vec-get shape 3)))
  (set i 0)
  (while (< i (vec-get shape 1))
    (set err (check-param-path nodes ntexts shape i base tags names elem extra pbase pchild ptypes))
    (if (not (check-ok err))
      (ret (check-free-one shape err))
      (check-nothing))
    (set i (+ i 1)))
  (vec-set out 0 (vec-get shape 3))
  (vec-set out 1 -1)
  (vec-set out 2 0)
  (vec-free shape)
  (ret (check-pass)))

(fn check-return-path :str ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (node :i64))
  (letmut c :i64 (get (vec-get nodes node) first))
  (if (check-is-marker nodes ntexts c)
    (set c (if (= c -1) -1
             (get (vec-get nodes c) next)))
    (check-nothing))
  (ret (if (and (not (= c -1))
             (= (get (vec-get nodes c) tok) -1))
         (tree-path nodes ntexts 0 c)
         (check-node-path nodes ntexts node))))

(fn check-param-path check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (shape (ref (vec :i64))) (i :i64) (base :i64) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pchild (ref (vec :i64))) (ptypes (ref (vec :i64))))
  (let param :i64 (check-child nodes (vec-get shape 4) i))
  (let ty :i64 (vec-get ptypes (+ base i)))
  (letmut seen
    (vec :i64)
    (make (vec :i64)))
  (let crosses :bool (check-crosses tags names elem extra pbase pchild ty seen))
  (vec-free seen)
  (ret (if crosses
         (check-pass)
         (check-fail-at nodes ntexts param 2 "type does not cross the C boundary"))))

(fn check-struct-shape check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (body :i64) (sid :i64))
  (letmut fnames
    (vec :str)
    (make (vec :str)))
  (letmut ftypes
    (vec :i64)
    (make (vec :i64)))
  (letmut ebn
    (vec :str)
    (make (vec :str)))
  (letmut ebt
    (vec :i64)
    (make (vec :i64)))
  (letmut c :i64 (get (vec-get nodes body) first))
  (letmut err check-error (check-pass))
  (while (and (check-ok err)
           (not (= c -1)))
    (set err (check-field nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname c body ebn ebt fnames ftypes))
    (set c (if (= c -1) -1
             (get (vec-get nodes c) next))))
  (if (not (check-ok err))
    (ret (check-free-four fnames ftypes ebn ebt err))
    (check-nothing))
  (let start :i64 (type-field-start pchild))
  (letmut i :i64 0)
  (while (< i (vec-len ftypes))
    (vec-push pchild (vec-get ftypes i))
    (vec-push pvname (vec-get fnames i))
    (set i (+ i 1)))
  (vec-set pbase sid (if (= (vec-len ftypes) 0) -1 start))
  (vec-set extra sid (vec-len ftypes))
  (ret (check-free-four fnames ftypes ebn ebt (check-pass))))

(fn check-free-four check-error ((a (ref (vec :str))) (b (ref (vec :i64))) (c (ref (vec :str))) (d (ref (vec :i64))) (e check-error))
  (vec-free a)
  (vec-free b)
  (vec-free c)
  (vec-free d)
  (ret e))

(fn check-field check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (field :i64) (body :i64) (ebn (ref (vec :str))) (ebt (ref (vec :i64))) (fnames (ref (vec :str))) (ftypes (ref (vec :i64))))
  (if (not (= (get (vec-get nodes field) tok) -1))
    (ret (check-fail 2 (check-type-path nodes ntexts field body) "a struct field must be (name type)"))
    (check-nothing))
  (let n :i64 (check-count nodes field))
  (let c1 :i64 (get (vec-get nodes field) first))
  (letmut titem :i64 -1)
  (if (> n 2)
    (ret (check-fail-at nodes ntexts field 2 "a struct field must be (name type)"))
    (check-nothing))
  (if (= n 0)
    (ret (check-fail-at nodes ntexts field 2 "a struct field must be (name type)"))
    (check-nothing))
  (if (= n 2)
    (if (not (check-is-marker nodes ntexts c1))
      (ret (check-fail-at nodes ntexts field 2 "a struct field must be (name type)"))
      (check-nothing))
    (check-nothing))
  (if (= n 1)
    (set titem c1)
    (check-nothing))
  (if (= n 2)
    (set titem (if (= c1 -1) -1
                 (get (vec-get nodes c1) next)))
    (check-nothing))
  (let name-item :i64 (+ field 1))
  (let name :str (check-atom-text nodes ntexts name-item))
  (if (not (check-named? name))
    (ret (check-fail-at nodes ntexts field 2 "a field needs a name"))
    (check-nothing))
  (if (check-in fnames name)
    (ret (check-fail-at nodes ntexts field 3 (str-concat "duplicate field '" (str-concat name "'"))))
    (check-nothing))
  (letmut one
    (vec :i64)
    (make (vec :i64)))
  (vec-push one -1)
  (letmut err check-error (check-type nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild titem field 1 ebn ebt one))
  (if (not (check-ok err))
    (ret (check-free-one one err))
    (check-nothing))
  (let ty :i64 (vec-get one 0))
  (vec-free one)
  (set err (check-field-rules tags names elem extra pbase pchild ty))
  (if (not (check-ok err))
    (ret (check-fail (get err code)
           (check-type-path nodes ntexts field body)
           (get err message)))
    (check-nothing))
  (vec-push fnames name)
  (vec-push ftypes ty)
  (ret (check-pass)))

(fn check-field-rules check-error ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pchild (ref (vec :i64))) (ty :i64))
  (letmut seen1
    (vec :i64)
    (make (vec :i64)))
  (let owns :bool (check-holds-owner tags elem extra pbase pchild ty seen1))
  (vec-free seen1)
  (if owns
    (ret (check-fail 2 "" "owning fields are not supported yet"))
    (check-nothing))
  (letmut seen2
    (vec :i64)
    (make (vec :i64)))
  (let vectors :bool (check-holds-vector tags elem extra pbase pchild ty seen2))
  (vec-free seen2)
  (if vectors
    (ret (check-fail 2 "" "vector fields are not supported yet"))
    (check-nothing))
  (if (check-stored-result tags elem ty)
    (ret (check-fail 2 "" "result fields are not supported yet"))
    (check-nothing))
  (ret (check-pass)))

(fn check-enum-shape check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (body :i64) (eid :i64))
  (if (= (get (vec-get nodes body) first) -1)
    (ret (check-fail-at nodes ntexts body 2 "an enum needs at least one variant"))
    (check-nothing))
  (letmut vnames
    (vec :str)
    (make (vec :str)))
  (letmut vtypes
    (vec :i64)
    (make (vec :i64)))
  (letmut ebn
    (vec :str)
    (make (vec :str)))
  (letmut ebt
    (vec :i64)
    (make (vec :i64)))
  (letmut c :i64 (get (vec-get nodes body) first))
  (letmut err check-error (check-pass))
  (while (and (check-ok err)
           (not (= c -1)))
    (set err (check-variant nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname c body ebn ebt vnames vtypes))
    (set c (if (= c -1) -1
             (get (vec-get nodes c) next))))
  (if (not (check-ok err))
    (ret (check-free-four vnames vtypes ebn ebt err))
    (check-nothing))
  (let start :i64 (vec-len pchild))
  (letmut i :i64 0)
  (while (< i (vec-len vtypes))
    (vec-push pchild (vec-get vtypes i))
    (vec-push pvname (vec-get vnames i))
    (set i (+ i 1)))
  (vec-set pbase eid (if (= (vec-len vtypes) 0) -1 start))
  (vec-set extra eid (vec-len vtypes))
  (ret (check-free-four vnames vtypes ebn ebt (check-pass))))

(fn check-variant check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (variant :i64) (body :i64) (ebn (ref (vec :str))) (ebt (ref (vec :i64))) (vnames (ref (vec :str))) (vtypes (ref (vec :i64))))
  (if (not (= (get (vec-get nodes variant) tok) -1))
    (ret (check-fail-at nodes ntexts body 2 "an enum variant must be (name) or (name type)"))
    (check-nothing))
  (let n :i64 (check-count nodes variant))
  (let name-item :i64 (+ variant 1))
  (let name :str (check-atom-text nodes ntexts name-item))
  (if (not (check-named? name))
    (ret (check-fail-at nodes ntexts variant 2 "a variant needs a name"))
    (check-nothing))
  (if (check-reserved-variant name)
    (ret (check-fail-at nodes ntexts variant 3 (str-concat "variant '" (str-concat name "' is reserved by the compiler"))))
    (check-nothing))
  (if (check-in vnames name)
    (ret (check-fail-at nodes ntexts variant 3 (str-concat "duplicate variant '" (str-concat name "'"))))
    (check-nothing))
  (if (= n 0)
    (ret (check-variant-add vnames vtypes name -1))
    (check-nothing))
  (let c1 :i64 (get (vec-get nodes variant) first))
  (letmut titem :i64 -1)
  (if (= n 1)
    (set titem c1)
    (check-nothing))
  (if (= n 2)
    (if (check-is-marker nodes ntexts c1)
      (set titem (if (= c1 -1) -1
                   (get (vec-get nodes c1) next)))
      (check-nothing))
    (check-nothing))
  (if (> n 2)
    (ret (check-fail-at nodes ntexts variant 2 "an enum variant must be (name) or (name type)"))
    (check-nothing))
  (if (= n 2)
    (if (not (check-is-marker nodes ntexts c1))
      (ret (check-fail-at nodes ntexts variant 2 "an enum variant must be (name) or (name type)"))
      (check-nothing))
    (check-nothing))
  (letmut one
    (vec :i64)
    (make (vec :i64)))
  (vec-push one -1)
  (letmut err check-error (check-type nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild titem variant 1 ebn ebt one))
  (if (not (check-ok err))
    (ret (check-free-one one err))
    (check-nothing))
  (let ty :i64 (vec-get one 0))
  (vec-free one)
  (if (check-is-void tags names ty)
    (ret (check-fail-at nodes ntexts variant 100 (str-concat "variant '" (str-concat name "' cannot hold :void"))))
    (check-nothing))
  (letmut seen1
    (vec :i64)
    (make (vec :i64)))
  (let vectors :bool (check-holds-vector tags elem extra pbase pchild ty seen1))
  (vec-free seen1)
  (if vectors
    (ret (check-fail-at nodes ntexts variant 2 "vector payloads are not supported yet"))
    (check-nothing))
  (letmut seen2
    (vec :i64)
    (make (vec :i64)))
  (let owns :bool (check-holds-owner tags elem extra pbase pchild ty seen2))
  (vec-free seen2)
  (if owns
    (ret (check-fail 2 (check-type-path nodes ntexts titem variant) "owning enum payloads are not supported yet"))
    (check-nothing))
  (if (check-stored-result tags elem ty)
    (ret (check-fail-at nodes ntexts variant 2 "result payloads are not supported yet"))
    (check-nothing))
  (ret (check-variant-add vnames vtypes name ty)))

(fn check-type-path :str ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (id :i64) (fallback :i64))
  (let at :str (check-node-path nodes ntexts id))
  (ret (if (str-eq at "")
         (check-node-path nodes ntexts fallback) at)))

(fn check-variant-add check-error ((vnames (ref (vec :str))) (vtypes (ref (vec :i64))) (name :str) (ty :i64))
  (vec-push vnames name)
  (vec-push vtypes ty)
  (ret (check-pass)))

(fn check-reaches :bool ((tags (ref (vec :i64))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pchild (ref (vec :i64))) (target :i64) (ty :i64) (seen (ref (vec :i64))))
  (let tag :i64 (type-tag tags ty))
  (if (and (= tag (type-tag-enum))
        (= ty target))
    (ret true)
    (check-nothing))
  (if (or (= tag (type-tag-enum))
        (= tag (type-tag-struct)))
    (ret (check-reaches-aggregate tags elem extra pbase pchild target ty seen))
    (check-nothing))
  (if (or (= tag (type-tag-arr))
        (= tag (type-tag-opt)))
    (ret (check-reaches tags elem extra pbase pchild target (vec-get elem ty) seen))
    (check-nothing))
  (if (= tag (type-tag-res))
    (ret (or (check-reaches tags elem extra pbase pchild target (vec-get elem ty) seen)
           (check-reaches tags elem extra pbase pchild target (vec-get extra ty) seen)))
    (check-nothing))
  (ret false))

(fn check-reaches-aggregate :bool ((tags (ref (vec :i64))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pchild (ref (vec :i64))) (target :i64) (ty :i64) (seen (ref (vec :i64))))
  (if (check-in-ids seen ty)
    (ret false)
    (check-nothing))
  (check-push-id seen ty)
  (letmut i :i64 0)
  (letmut found :bool false)
  (while (and (not found)
           (< i (vec-get extra ty)))
    (let payload :i64 (vec-get pchild (+ (vec-get pbase ty) i)))
    (set found (if (= payload -1) false
                 (check-reaches tags elem extra pbase pchild target payload seen)))
    (set i (+ i 1)))
  (check-pop-id seen)
  (ret found))

(fn check-enum-self :bool ((tags (ref (vec :i64))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pchild (ref (vec :i64))) (target :i64))
  (letmut seen
    (vec :i64)
    (make (vec :i64)))
  (check-push-id seen target)
  (letmut i :i64 0)
  (letmut found :bool false)
  (while (and (not found)
           (< i (vec-get extra target)))
    (let payload :i64 (vec-get pchild (+ (vec-get pbase target) i)))
    (set found (if (= payload -1) false
                 (check-reaches tags elem extra pbase pchild target payload seen)))
    (set i (+ i 1)))
  (vec-free seen)
  (ret found))

(fn check-mod-find :i64 ((mods (ref (vec check-mod))) (name :str))
  (letmut i :i64 0)
  (letmut found :i64 -1)
  (while (and (= found -1)
           (< i (vec-len mods)))
    (set found (if (str-eq (get (vec-get mods i) name) name) i found))
    (set i (+ i 1)))
  (ret found))

(fn check-mod-state :i64 ((mods (ref (vec check-mod))) (slot :i64))
  (ret (get (vec-get mods slot) state)))

(fn check-mod-open :void ((mods (ref (vec check-mod))) (slot :i64) (state :i64))
  (letmut m check-mod (vec-get mods slot))
  (set-field m state state)
  (vec-set mods slot m))

(fn check-mod-close :void ((mods (ref (vec check-mod))) (slot :i64) (own-s :i64) (own-e :i64) (vis-s :i64) (vis-e :i64))
  (letmut m check-mod (vec-get mods slot))
  (set-field m own-s own-s)
  (set-field m own-e own-e)
  (set-field m vis-s vis-s)
  (set-field m vis-e vis-e)
  (set-field m state 2)
  (vec-set mods slot m))

(fn check-mod-name :str ((mods (ref (vec check-mod))) (slot :i64))
  (ret (get (vec-get mods slot) name)))

(fn check-mod-file :str ((mods (ref (vec check-mod))) (slot :i64))
  (ret (get (vec-get mods slot) file)))

(fn check-entry-add :i64 ((ents (ref (vec check-entry))) (name :str) (ty :i64) (kind :i64) (owner :str) (var-s :i64) (var-n :i64))
  (vec-push ents (make check-entry name ty kind owner var-s var-n))
  (ret (- (vec-len ents) 1)))

(fn check-mod-own-end :i64 ((mods (ref (vec check-mod))) (slot :i64))
  (ret (get (vec-get mods slot) own-e)))

(fn check-mod-vis-end :i64 ((mods (ref (vec check-mod))) (slot :i64))
  (ret (get (vec-get mods slot) vis-e)))

(fn check-load-tree check-error ((path :str) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))) (nodes (ref (vec node))) (ntexts (ref (vec :str))))
  (let src :str (read-file path))
  (let le lex-error (lex src kinds texts lines cols))
  (if (not (lex-ok le))
    (ret (check-fail 6 path (get le msg)))
    (check-nothing))
  (let te tree-error (tree-parse kinds texts lines cols nodes ntexts))
  (ret (if (tree-ok te)
         (check-pass)
         (check-fail 1 path (get te msg)))))

(fn check-main-path :str ((nodes (ref (vec node))) (ntexts (ref (vec :str))))
  (letmut c :i64 (get (vec-get nodes 0) first))
  (letmut found :str "")
  (while (not (= c -1))
    (if (and (str-eq found "")
          (and (= (get (vec-get nodes c) tok) -1)
            (str-eq (check-head nodes ntexts c) "fn")))
      (if (str-eq (check-name-text nodes ntexts c) "main")
        (set found (check-node-path nodes ntexts c))
        (check-nothing))
      (check-nothing))
    (set c (get (vec-get nodes c) next)))
  (ret found))

(fn check-mains check-error ((mods (ref (vec check-mod))) (rnodes (ref (vec node))) (rntexts (ref (vec :str))))
  (letmut first :str "")
  (letmut i :i64 0)
  (letmut err check-error (check-pass))
  (letmut out
    (vec :str)
    (make (vec :str)))
  (vec-push out "")
  (while (and (check-ok err)
           (< i (vec-len mods)))
    (letmut path :str "")
    (if (= i 0)
      (set path (check-main-path rnodes rntexts))
      (set err (check-main-load mods i out)))
    (if (and (check-ok err)
          (not (= i 0)))
      (set path (vec-get out 0))
      (check-nothing))
    (if (str-eq path "")
      (check-nothing)
      (if (str-eq first "")
        (set first path)
        (set err (check-fail 3 path (str-concat "duplicate definition 'main': " (str-concat first (str-concat " and " path)))))))
    (set i (+ i 1)))
  (vec-free out)
  (ret err))

(fn check-main-load check-error ((mods (ref (vec check-mod))) (slot :i64) (out (ref (vec :str))))
  (letmut kinds
    (vec :i64)
    (make (vec :i64)))
  (letmut texts
    (vec :str)
    (make (vec :str)))
  (letmut lines
    (vec :i64)
    (make (vec :i64)))
  (letmut cols
    (vec :i64)
    (make (vec :i64)))
  (letmut nodes
    (vec node)
    (make (vec node)))
  (letmut ntexts
    (vec :str)
    (make (vec :str)))
  (letmut e check-error (check-load-tree (check-mod-file mods slot) kinds texts lines cols nodes ntexts))
  (if (check-ok e)
    (vec-set out 0 (check-main-path nodes ntexts))
    (vec-set out 0 ""))
  (vec-free kinds)
  (vec-free texts)
  (vec-free lines)
  (vec-free cols)
  (vec-free nodes)
  (vec-free ntexts)
  (ret e))

(fn check-declared check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (node :i64) (owner :str) (out (ref (vec :i64))))
  (let name :str (check-name-text nodes ntexts node))
  (if (not (check-named? name))
    (ret (check-fail-at nodes ntexts node 2 "type needs a name"))
    (check-nothing))
  (let body :i64 (get (vec-get nodes node) first))
  (if (or (= body -1)
        (not (= (get (vec-get nodes body) tok) -1)))
    (ret (check-fail-at nodes ntexts node 2 (str-concat "type '" (str-concat name "' needs a struct or enum body"))))
    (check-nothing))
  (let kind :str (check-head nodes ntexts body))
  (if (str-eq kind "struct")
    (ret (check-store out (type-struct tags names elem extra pbase powner name owner -1 0)))
    (check-nothing))
  (if (str-eq kind "enum")
    (ret (check-store out (type-enum tags names elem extra pbase powner name owner -1 0)))
    (check-nothing))
  (ret (check-fail 2
         (check-node-path nodes ntexts body)
         (str-concat "unknown type body '" (str-concat kind "'")))))

(fn check-type-names :void ((ents (ref (vec check-entry))) (vindex (ref (vec :i64))) (vis-s :i64) (vis-e :i64) (dnames (ref (vec :str))) (dids (ref (vec :i64))))
  (letmut i :i64 vis-s)
  (while (< i vis-e)
    (let e check-entry (vec-get ents (vec-get vindex i)))
    (if (= (get e kind) 0)
      (check-type-names-add dnames dids
        (get e name)
        (get e ty))
      (check-nothing))
    (set i (+ i 1)))
  (ret))

(fn check-type-names-add :void ((dnames (ref (vec :str))) (dids (ref (vec :i64))) (name :str) (ty :i64))
  (vec-push dnames name)
  (vec-push dids ty)
  (ret))

(fn check-module-tree check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (ents (ref (vec check-entry))) (vindex (ref (vec :i64))) (fvname (ref (vec :str))) (mods (ref (vec check-mod))) (slot :i64))
  (letmut imported
    (vec :i64)
    (make (vec :i64)))
  (letmut err check-error (check-imports nodes ntexts tags names elem extra pbase powner pnames ptypes pchild pvname ents vindex fvname mods slot imported))
  (if (not (check-ok err))
    (ret (check-free-one imported err))
    (check-nothing))
  (let vis-start :i64 (vec-len vindex))
  (let own-start :i64 (vec-len ents))
  (let type-start :i64 (vec-len ents))
  (check-import-ranges mods imported vindex)
  (vec-free imported)
  (letmut c :i64 (get (vec-get nodes 0) first))
  (while (and (check-ok err)
           (not (= c -1)))
    (if (and (= (get (vec-get nodes c) tok) -1)
          (str-eq (check-head nodes ntexts c) "type"))
      (set err (check-module-type nodes ntexts tags names elem extra pbase powner ents vindex mods slot c))
      (check-nothing))
    (set c (if (= c -1) -1
             (get (vec-get nodes c) next))))
  (if (not (check-ok err))
    (ret err)
    (check-nothing))
  (set c (get (vec-get nodes 0) first))
  (while (and (check-ok err)
           (not (= c -1)))
    (if (and (= (get (vec-get nodes c) tok) -1)
          (str-eq (check-head nodes ntexts c) "type"))
      (set err (check-module-reserved nodes ntexts c))
      (check-nothing))
    (set c (if (= c -1) -1
             (get (vec-get nodes c) next))))
  (if (not (check-ok err))
    (ret err)
    (check-nothing))
  (letmut dnames
    (vec :str)
    (make (vec :str)))
  (letmut dids
    (vec :i64)
    (make (vec :i64)))
  (check-type-names ents vindex vis-start (vec-len vindex) dnames dids)
  (set err (check-module-bodies nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname ents type-start))
  (if (not (check-ok err))
    (ret (check-free-two-str-ids dnames dids err))
    (check-nothing))
  (set err (check-module-selves nodes ntexts tags elem extra pbase pchild ents type-start))
  (if (not (check-ok err))
    (ret (check-free-two-str-ids dnames dids err))
    (check-nothing))
  (letmut fps
    (vec :i64)
    (make (vec :i64)))
  (set err (check-module-fns nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild ents vindex fvname mods slot fps))
  (if (not (check-ok err))
    (ret (check-free-three dnames dids fps err))
    (check-nothing))
  (set err (check-module-externs nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild ents vindex fvname mods slot))
  (if (not (check-ok err))
    (ret (check-free-three dnames dids fps err))
    (check-nothing))
  (set err (check-module-fn-bodies nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname fps))
  (if (not (check-ok err))
    (ret (check-free-three dnames dids fps err))
    (check-nothing))
  (vec-free dnames)
  (vec-free dids)
  (vec-free fps)
  (check-mod-close mods slot own-start
    (vec-len ents) vis-start
    (vec-len vindex))
  (ret (check-pass)))

(fn check-imports check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (ents (ref (vec check-entry))) (vindex (ref (vec :i64))) (fvname (ref (vec :str))) (mods (ref (vec check-mod))) (slot :i64) (imported (ref (vec :i64))))
  (letmut c :i64 (get (vec-get nodes 0) first))
  (letmut err check-error (check-pass))
  (while (and (check-ok err)
           (not (= c -1)))
    (if (and (= (get (vec-get nodes c) tok) -1)
          (str-eq (check-head nodes ntexts c) "use"))
      (set err (check-import-one nodes ntexts tags names elem extra pbase powner pnames ptypes pchild pvname ents vindex fvname mods slot c imported))
      (check-nothing))
    (set c (if (= c -1) -1
             (get (vec-get nodes c) next))))
  (ret err))

(fn check-import-one check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (ents (ref (vec check-entry))) (vindex (ref (vec :i64))) (fvname (ref (vec :str))) (mods (ref (vec check-mod))) (slot :i64) (c :i64) (imported (ref (vec :i64))))
  (let arg :i64 (get (vec-get nodes c) first))
  (let name :str (check-atom-text nodes ntexts arg))
  (let j :i64 (check-mod-find mods name))
  (if (= j -1)
    (ret (check-pass))
    (check-nothing))
  (if (check-in-ids imported j)
    (ret (check-pass))
    (check-nothing))
  (vec-push imported j)
  (letmut err check-error (check-module mods ents vindex fvname tags names elem extra pbase powner pnames ptypes pchild pvname nodes ntexts j))
  (ret (if (check-ok err)
         (check-pass) err)))

(fn check-import-ranges :void ((mods (ref (vec check-mod))) (imported (ref (vec :i64))) (vindex (ref (vec :i64))))
  (letmut i :i64 0)
  (while (< i (vec-len imported))
    (let j :i64 (vec-get imported i))
    (let s :i64 (get (vec-get mods j) own-s))
    (let e :i64 (get (vec-get mods j) own-e))
    (letmut k :i64 s)
    (while (< k e)
      (vec-push vindex k)
      (set k (+ k 1)))
    (set i (+ i 1)))
  (ret))

(fn check-module-type check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (ents (ref (vec check-entry))) (vindex (ref (vec :i64))) (mods (ref (vec check-mod))) (slot :i64) (c :i64))
  (letmut one
    (vec :i64)
    (make (vec :i64)))
  (vec-push one -1)
  (let err check-error (check-declared nodes ntexts tags names elem extra pbase powner c (check-mod-name mods slot) one))
  (if (not (check-ok err))
    (ret (check-free-one one err))
    (check-nothing))
  (let idx :i64 (check-entry-add ents
                  (check-name-text nodes ntexts c)
                  (vec-get one 0) 0
                  (check-mod-name mods slot) -1 0))
  (vec-push vindex idx)
  (vec-free one)
  (ret (check-pass)))

(fn check-module-reserved check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (c :i64))
  (let name :str (check-name-text nodes ntexts c))
  (ret (if (check-reserved-name name)
         (check-fail 3 (check-node-path nodes ntexts c) "reserved form name")
         (check-pass))))

(fn check-module-bodies check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (ents (ref (vec check-entry))) (type-start :i64))
  (letmut c :i64 (get (vec-get nodes 0) first))
  (letmut err check-error (check-pass))
  (letmut i :i64 0)
  (while (and (check-ok err)
           (not (= c -1)))
    (let is-type :bool (and (= (get (vec-get nodes c) tok) -1)
                         (str-eq (check-head nodes ntexts c) "type")))
    (if is-type
      (set err (check-body-one nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname ents type-start i c))
      (check-nothing))
    (if is-type
      (set i (+ i 1))
      (check-nothing))
    (set c (if (= c -1) -1
             (get (vec-get nodes c) next))))
  (ret err))

(fn check-body-one check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (ents (ref (vec check-entry))) (type-start :i64) (i :i64) (c :i64))
  (let body :i64 (get (vec-get nodes c) first))
  (let sid :i64 (get (vec-get ents (+ type-start i)) ty))
  (let kind :str (check-head nodes ntexts body))
  (ret (if (str-eq kind "struct")
         (check-struct-shape nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname body sid)
         (check-enum-shape nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname body sid))))

(fn check-module-selves check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (tags (ref (vec :i64))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pchild (ref (vec :i64))) (ents (ref (vec check-entry))) (type-start :i64))
  (letmut c :i64 (get (vec-get nodes 0) first))
  (letmut err check-error (check-pass))
  (letmut i :i64 0)
  (while (and (check-ok err)
           (not (= c -1)))
    (let is-type :bool (and (= (get (vec-get nodes c) tok) -1)
                         (str-eq (check-head nodes ntexts c) "type")))
    (if is-type
      (set err (check-self-one nodes ntexts tags elem extra pbase pchild ents type-start i c))
      (check-nothing))
    (if is-type
      (set i (+ i 1))
      (check-nothing))
    (set c (if (= c -1) -1
             (get (vec-get nodes c) next))))
  (ret err))

(fn check-self-one check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (tags (ref (vec :i64))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pchild (ref (vec :i64))) (ents (ref (vec check-entry))) (type-start :i64) (i :i64) (c :i64))
  (let body :i64 (get (vec-get nodes c) first))
  (let sid :i64 (get (vec-get ents (+ type-start i)) ty))
  (let is-enum :bool (str-eq (check-head nodes ntexts body) "enum"))
  (let self :bool (if is-enum (check-enum-self tags elem extra pbase pchild sid) false))
  (ret (if self
         (check-fail 2
           (check-node-path nodes ntexts c)
           (str-concat "enum '" (str-concat (check-name-text nodes ntexts c) "' contains itself")))
         (check-pass))))

(fn check-module-fns check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (ents (ref (vec check-entry))) (vindex (ref (vec :i64))) (fvname (ref (vec :str))) (mods (ref (vec check-mod))) (slot :i64) (fps (ref (vec :i64))))
  (letmut c :i64 (get (vec-get nodes 0) first))
  (letmut err check-error (check-pass))
  (letmut out
    (vec :i64)
    (make (vec :i64)))
  (vec-push out -1)
  (vec-push out -1)
  (vec-push out -1)
  (while (and (check-ok err)
           (not (= c -1)))
    (if (and (= (get (vec-get nodes c) tok) -1)
          (str-eq (check-head nodes ntexts c) "fn"))
      (set err (check-fn-one nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild ents vindex fvname mods slot c out fps))
      (check-nothing))
    (set c (if (= c -1) -1
             (get (vec-get nodes c) next))))
  (vec-free out)
  (ret err))

(fn check-fn-one check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (ents (ref (vec check-entry))) (vindex (ref (vec :i64))) (fvname (ref (vec :str))) (mods (ref (vec check-mod))) (slot :i64) (c :i64) (out (ref (vec :i64))) (fps (ref (vec :i64))))
  (let name :str (check-name-text nodes ntexts c))
  (if (check-has-prefix name "rt_")
    (ret (check-fail 3 (check-node-path nodes ntexts c) "rt_ names are reserved"))
    (check-nothing))
  (let err check-error (check-signature nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild c fvname out))
  (if (not (check-ok err))
    (ret err)
    (check-nothing))
  (let idx :i64 (check-entry-add ents name
                  (vec-get out 0) 1
                  (check-mod-name mods slot)
                  (vec-get out 1)
                  (vec-get out 2)))
  (vec-push vindex idx)
  (if (and (= slot 0)
        (= (vec-get out 2) 0))
    (check-fps-add fps c (vec-get out 0))
    (check-nothing))
  (ret (check-pass)))

(fn check-fps-add :void ((fps (ref (vec :i64))) (c :i64) (fnty :i64))
  (vec-push fps c)
  (vec-push fps fnty)
  (ret))

(fn check-module-fn-bodies check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (fps (ref (vec :i64))))
  (letmut i :i64 0)
  (letmut err check-error (check-pass))
  (while (and (check-ok err)
           (< i (vec-len fps)))
    (let c :i64 (vec-get fps i))
    (set err (check-body-fn nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname c
               (vec-get fps (+ i 1))
               (check-name-text nodes ntexts c)))
    (set i (+ i 2)))
  (ret err))

(fn check-module-externs check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (ents (ref (vec check-entry))) (vindex (ref (vec :i64))) (fvname (ref (vec :str))) (mods (ref (vec check-mod))) (slot :i64))
  (letmut c :i64 (get (vec-get nodes 0) first))
  (letmut err check-error (check-pass))
  (letmut out
    (vec :i64)
    (make (vec :i64)))
  (vec-push out -1)
  (vec-push out -1)
  (vec-push out -1)
  (while (and (check-ok err)
           (not (= c -1)))
    (if (and (= (get (vec-get nodes c) tok) -1)
          (str-eq (check-head nodes ntexts c) "extern"))
      (set err (check-extern-one nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild ents vindex mods slot c out))
      (check-nothing))
    (set c (if (= c -1) -1
             (get (vec-get nodes c) next))))
  (vec-free out)
  (ret err))

(fn check-extern-one check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (ents (ref (vec check-entry))) (vindex (ref (vec :i64))) (mods (ref (vec check-mod))) (slot :i64) (c :i64) (out (ref (vec :i64))))
  (let err check-error (check-extern-signature nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild c out))
  (if (not (check-ok err))
    (ret err)
    (check-nothing))
  (let idx :i64 (check-entry-add ents
                  (check-name-text nodes ntexts c)
                  (vec-get out 0) 2
                  (check-mod-name mods slot) -1 0))
  (vec-push vindex idx)
  (ret (check-pass)))

(fn check-module check-error ((mods (ref (vec check-mod))) (ents (ref (vec check-entry))) (vindex (ref (vec :i64))) (fvname (ref (vec :str))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (rnodes (ref (vec node))) (rntexts (ref (vec :str))) (slot :i64))
  (let state :i64 (check-mod-state mods slot))
  (if (= state 2)
    (ret (check-pass))
    (check-nothing))
  (if (= state 1)
    (ret (check-pass))
    (check-nothing))
  (check-mod-open mods slot 1)
  (if (= slot 0)
    (ret (check-module-tree rnodes rntexts tags names elem extra pbase powner pnames ptypes pchild pvname ents vindex fvname mods slot))
    (ret (check-module-load mods ents vindex fvname tags names elem extra pbase powner pnames ptypes pchild pvname rnodes rntexts slot))))

(fn check-module-load check-error ((mods (ref (vec check-mod))) (ents (ref (vec check-entry))) (vindex (ref (vec :i64))) (fvname (ref (vec :str))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (rnodes (ref (vec node))) (rntexts (ref (vec :str))) (slot :i64))
  (letmut kinds
    (vec :i64)
    (make (vec :i64)))
  (letmut texts
    (vec :str)
    (make (vec :str)))
  (letmut lines
    (vec :i64)
    (make (vec :i64)))
  (letmut cols
    (vec :i64)
    (make (vec :i64)))
  (letmut nodes
    (vec node)
    (make (vec node)))
  (letmut ntexts
    (vec :str)
    (make (vec :str)))
  (letmut err check-error (check-load-tree (check-mod-file mods slot) kinds texts lines cols nodes ntexts))
  (if (check-ok err)
    (set err (check-module-tree nodes ntexts tags names elem extra pbase powner pnames ptypes pchild pvname ents vindex fvname mods slot))
    (check-nothing))
  (vec-free kinds)
  (vec-free texts)
  (vec-free lines)
  (vec-free cols)
  (vec-free nodes)
  (vec-free ntexts)
  (ret err))

(fn check-file check-error ((mods (ref (vec resolve-mod))) (nodes (ref (vec node))) (ntexts (ref (vec :str))))
  (letmut cmods
    (vec check-mod)
    (make (vec check-mod)))
  (letmut m :i64 0)
  (while (< m (vec-len mods))
    (let rm resolve-mod (vec-get mods m))
    (vec-push cmods (make check-mod
                      (get rm name)
                      (get rm file) -1 -1 -1 -1 0))
    (set m (+ m 1)))
  (letmut tags
    (vec :i64)
    (make (vec :i64)))
  (letmut names
    (vec :str)
    (make (vec :str)))
  (letmut elem
    (vec :i64)
    (make (vec :i64)))
  (letmut extra
    (vec :i64)
    (make (vec :i64)))
  (letmut pbase
    (vec :i64)
    (make (vec :i64)))
  (letmut powner
    (vec :str)
    (make (vec :str)))
  (letmut pnames
    (vec :str)
    (make (vec :str)))
  (letmut ptypes
    (vec :i64)
    (make (vec :i64)))
  (letmut pchild
    (vec :i64)
    (make (vec :i64)))
  (letmut pvname
    (vec :str)
    (make (vec :str)))
  (letmut ents
    (vec check-entry)
    (make (vec check-entry)))
  (letmut vindex
    (vec :i64)
    (make (vec :i64)))
  (letmut fvname
    (vec :str)
    (make (vec :str)))
  (letmut err check-error (check-mains cmods nodes ntexts))
  (letmut i :i64 0)
  (while (and (check-ok err)
           (< i (vec-len cmods)))
    (set err (check-module cmods ents vindex fvname tags names elem extra pbase powner pnames ptypes pchild pvname nodes ntexts i))
    (set i (+ i 1)))
  (vec-free cmods)
  (vec-free tags)
  (vec-free names)
  (vec-free elem)
  (vec-free extra)
  (vec-free pbase)
  (vec-free powner)
  (vec-free pnames)
  (vec-free ptypes)
  (vec-free pchild)
  (vec-free pvname)
  (vec-free ents)
  (vec-free vindex)
  (vec-free fvname)
  (ret err))

(fn check-instance-max :i64 ()
  (ret 256))

(fn check-instance-name check-error ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (ptypes (ref (vec :i64))) (name :str) (args (ref (vec :i64))) (where :str) (out (ref (vec :str))))
  (letmut s :str name)
  (letmut i :i64 0)
  (letmut err check-error (check-pass))
  (while (and (check-ok err)
           (< i (vec-len args)))
    (letmut one
      (vec :str)
      (make (vec :str)))
    (vec-push one "")
    (let terr type-error (type-mangle tags names elem extra pbase ptypes (vec-get args i) where one))
    (if (type-ok terr)
      (set s (str-concat s (str-concat "$" (vec-get one 0))))
      (set err (check-fail (get terr code)
                 (get terr path)
                 (get terr message))))
    (vec-free one)
    (set i (+ i 1)))
  (if (check-ok err)
    (vec-set out 0 s)
    (check-nothing))
  (ret err))

(fn check-instance-add check-error ((keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))) (names (ref (vec :str))) (target :str) (where :str) (out (ref (vec :i64))))
  (let at :i64 (map-get keys vals slots target))
  (if (not (= at -1))
    (ret (check-store out at))
    (check-nothing))
  (if (>= (vec-len names)
        (check-instance-max))
    (ret (check-fail 500 where "more than 256 instantiations of generic functions"))
    (check-nothing))
  (map-put keys vals slots target (vec-len names))
  (vec-push names target)
  (ret (check-store out (- (vec-len names) 1))))

(fn check-instantiate check-error ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (ptypes (ref (vec :i64))) (name :str) (args (ref (vec :i64))) (where :str) (keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))) (instances (ref (vec :str))) (out (ref (vec :str))))
  (letmut one
    (vec :str)
    (make (vec :str)))
  (vec-push one "")
  (letmut err check-error (check-instance-name tags names elem extra pbase ptypes name args where one))
  (letmut idx
    (vec :i64)
    (make (vec :i64)))
  (vec-push idx -1)
  (if (check-ok err)
    (set err (check-instance-add keys vals slots instances (vec-get one 0) where idx))
    (check-nothing))
  (if (check-ok err)
    (vec-set out 0 (vec-get one 0))
    (check-nothing))
  (vec-free one)
  (vec-free idx)
  (ret err))

(fn check-visible-owner :str ((ents (ref (vec check-entry))) (vindex (ref (vec :i64))) (vis-s :i64) (vis-e :i64) (name :str) (kind :i64))
  (letmut i :i64 vis-s)
  (letmut found :str "")
  (while (and (str-eq found "")
           (< i vis-e))
    (let e check-entry (vec-get ents (vec-get vindex i)))
    (if (and (str-eq (get e name) name)
          (or (= kind -1)
            (= (get e kind) kind)))
      (set found (get e owner))
      (check-nothing))
    (set i (+ i 1)))
  (ret found))

(fn check-in-build :bool ((mods (ref (vec check-mod))) (owner :str))
  (letmut i :i64 0)
  (letmut found :bool false)
  (while (and (not found)
           (< i (vec-len mods)))
    (set found (str-eq (get (vec-get mods i) name) owner))
    (set i (+ i 1)))
  (ret found))

(fn body-unknown :i64 ()
  (ret -2))

(fn body-store check-error ((out (ref (vec :i64))) (ty :i64))
  (vec-set out 0 ty)
  (ret (check-pass)))

(fn body-text :str ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (id :i64))
  (let t :i64 (if (< id 0) -1
                (get (vec-get nodes id) text)))
  (ret (if (= t -1) ""
         (vec-get ntexts t))))

(fn body-at :i64 ((nodes (ref (vec node))) (item :i64) (owner :i64))
  (ret (if (and (>= item 0)
             (= (get (vec-get nodes item) tok) -1)) item owner)))

(fn body-literal? :bool ((nodes (ref (vec node))) (id :i64))
  (ret (and (>= id 0)
         (= (get (vec-get nodes id) tok) 4))))

(fn body-atom? :bool ((nodes (ref (vec node))) (id :i64))
  (ret (and (>= id 0)
         (= (get (vec-get nodes id) tok) 2))))

(fn body-int-name :bool ((s :str))
  (if (str-eq s "i8")
    (ret true)
    (check-nothing))
  (if (str-eq s "i16")
    (ret true)
    (check-nothing))
  (if (str-eq s "i32")
    (ret true)
    (check-nothing))
  (if (str-eq s "i64")
    (ret true)
    (check-nothing))
  (if (str-eq s "u8")
    (ret true)
    (check-nothing))
  (if (str-eq s "u16")
    (ret true)
    (check-nothing))
  (if (str-eq s "u32")
    (ret true)
    (check-nothing))
  (ret (str-eq s "u64")))

(fn body-float-name :bool ((s :str))
  (if (str-eq s "f32")
    (ret true)
    (check-nothing))
  (ret (str-eq s "f64")))

(fn body-number-name :bool ((s :str))
  (ret (or (body-int-name s)
         (body-float-name s))))

(fn body-scalar-name :bool ((s :str))
  (if (body-number-name s)
    (ret true)
    (check-nothing))
  (ret (or (str-eq s "bool")
         (str-eq s "str"))))

(fn body-prim-name :str ((tags (ref (vec :i64))) (names (ref (vec :str))) (ty :i64))
  (ret (if (and (>= ty 0)
             (= (vec-get tags ty)
               (type-tag-prim)))
         (vec-get names ty) "")))

(fn body-prim-ty :i64 ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (name :str))
  (ret (type-prim tags names elem extra pbase powner name)))

(fn body-int-ty? :bool ((tags (ref (vec :i64))) (names (ref (vec :str))) (ty :i64))
  (ret (and (>= ty 0)
         (body-int-name (body-prim-name tags names ty)))))

(fn body-float-ty? :bool ((tags (ref (vec :i64))) (names (ref (vec :str))) (ty :i64))
  (ret (and (>= ty 0)
         (body-float-name (body-prim-name tags names ty)))))

(fn body-number-ty? :bool ((tags (ref (vec :i64))) (names (ref (vec :str))) (ty :i64))
  (ret (and (>= ty 0)
         (body-number-name (body-prim-name tags names ty)))))

(fn body-scalar-ty? :bool ((tags (ref (vec :i64))) (names (ref (vec :str))) (ty :i64))
  (ret (and (>= ty 0)
         (body-scalar-name (body-prim-name tags names ty)))))

(fn body-void-ty? :bool ((tags (ref (vec :i64))) (names (ref (vec :str))) (ty :i64))
  (ret (and (>= ty 0)
         (str-eq (body-prim-name tags names ty) "void"))))

(fn body-type-text :str ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (ptypes (ref (vec :i64))) (ty :i64))
  (ret (if (< ty 0) "?"
         (type-text tags names elem extra pbase ptypes ty))))

(fn body-fits :bool ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (ptypes (ref (vec :i64))) (a :i64) (b :i64))
  (ret (if (or (= a (body-unknown))
             (= b (body-unknown))) true
         (type-compatible tags names powner elem extra pbase ptypes a b))))

(fn body-find :i64 ((bk (ref (vec :str))) (bvl (ref (vec :i64))) (bsl (ref (vec :i64))) (name :str))
  (ret (map-get bk bvl bsl name)))

(fn body-bind check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (bn (ref (vec :i64))) (bt (ref (vec :i64))) (bm (ref (vec :i64))) (bv (ref (vec :i64))) (bu (ref (vec :i64))) (bd (ref (vec :i64))) (bk (ref (vec :str))) (bvl (ref (vec :i64))) (bsl (ref (vec :i64))) (name :str) (name-id :i64) (ty :i64) (mutable :i64) (depth :i64) (where :i64))
  (let at :i64 (body-find bk bvl bsl name))
  (if (and (>= at 0)
        (= (vec-get bd at) depth))
    (ret (check-fail-at nodes ntexts where 3 (str-concat "duplicate definition '" (str-concat name "'"))))
    (check-nothing))
  (vec-push bn name-id)
  (vec-push bt ty)
  (vec-push bm mutable)
  (vec-push bv 0)
  (vec-push bu 0)
  (vec-push bd depth)
  (map-put bk bvl bsl name (- (vec-len bn) 1))
  (ret (check-pass)))

(fn body-read check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (bt (ref (vec :i64))) (bv (ref (vec :i64))) (bu (ref (vec :i64))) (at :i64) (name :str) (where :i64) (out (ref (vec :i64))))
  (vec-set bu at 1)
  (if (= (vec-get bv at) 1)
    (ret (check-fail-at nodes ntexts where 300 (str-concat "use after move of '" (str-concat name "'"))))
    (check-nothing))
  (ret (body-store out (vec-get bt at))))

(fn body-snapshot :void ((bv (ref (vec :i64))) (bk (ref (vec :str))) (bvl (ref (vec :i64))) (out (ref (vec :i64))))
  (let n :i64 (vec-len bv))
  (vec-push out n)
  (letmut i :i64 0)
  (while (< i n)
    (vec-push out (vec-get bv i))
    (set i (+ i 1)))
  (let m :i64 (vec-len bk))
  (vec-push out m)
  (set i 0)
  (while (< i m)
    (vec-push out (vec-get bvl i))
    (set i (+ i 1)))
  (ret))

(fn body-restore :void ((bv (ref (vec :i64))) (bvl (ref (vec :i64))) (snap (ref (vec :i64))))
  (let n :i64 (vec-get snap 0))
  (letmut i :i64 0)
  (while (< i n)
    (vec-set bv i (vec-get snap (+ 1 i)))
    (set i (+ i 1)))
  (let m :i64 (vec-get snap (+ 1 n)))
  (set i 0)
  (while (< i m)
    (vec-set bvl i (vec-get snap (+ 2 n i)))
    (set i (+ i 1)))
  (while (< i (vec-len bvl))
    (vec-set bvl i -1)
    (set i (+ i 1)))
  (ret))

(fn body-byte :i64 ((s :str) (i :i64))
  (ret (cast :i64 (str-byte s i))))

(fn body-has-byte :bool ((s :str) (b :i64))
  (letmut i :i64 0)
  (letmut found :bool false)
  (while (and (not found)
           (< i (str-len s)))
    (set found (= (body-byte s i) b))
    (set i (+ i 1)))
  (ret found))

(fn body-float-text :bool ((s :str))
  (if (body-has-byte s 46)
    (ret true)
    (check-nothing))
  (if (body-has-byte s 101)
    (ret true)
    (check-nothing))
  (ret (body-has-byte s 69)))

(fn body-digits :i64 ((s :str) (from :i64))
  (letmut i :i64 from)
  (while (and (< i (str-len s))
           (= (body-byte s i) 48))
    (set i (+ i 1)))
  (ret i))

(fn body-mag-le-same :bool ((a :str) (a0 :i64) (b :str) (b0 :i64) (n :i64))
  (letmut i :i64 0)
  (letmut verdict :i64 0)
  (while (and (= verdict 0)
           (< i n))
    (let ca :i64 (body-byte a (+ a0 i)))
    (let cb :i64 (body-byte b (+ b0 i)))
    (set verdict (if (< ca cb) -1
                   (if (> ca cb) 1 0)))
    (set i (+ i 1)))
  (ret (<= verdict 0)))

(fn body-mag-le :bool ((a :str) (a0 :i64) (b :str) (b0 :i64))
  (let an :i64 (- (str-len a) a0))
  (let bn :i64 (- (str-len b) b0))
  (ret (if (< an bn) true
         (if (> an bn) false
           (body-mag-le-same a a0 b b0 an)))))

(fn body-width-max :str ((name :str))
  (if (str-eq name "i8")
    (ret "127")
    (check-nothing))
  (if (str-eq name "i16")
    (ret "32767")
    (check-nothing))
  (if (str-eq name "i32")
    (ret "2147483647")
    (check-nothing))
  (if (str-eq name "i64")
    (ret "9223372036854775807")
    (check-nothing))
  (if (str-eq name "u8")
    (ret "255")
    (check-nothing))
  (if (str-eq name "u16")
    (ret "65535")
    (check-nothing))
  (if (str-eq name "u32")
    (ret "4294967295")
    (check-nothing))
  (if (str-eq name "u64")
    (ret "18446744073709551615")
    (check-nothing))
  (ret "0"))

(fn body-width-min :str ((name :str))
  (if (str-eq name "i8")
    (ret "128")
    (check-nothing))
  (if (str-eq name "i16")
    (ret "32768")
    (check-nothing))
  (if (str-eq name "i32")
    (ret "2147483648")
    (check-nothing))
  (if (str-eq name "i64")
    (ret "9223372036854775808")
    (check-nothing))
  (ret "0"))

(fn body-int-fits :bool ((text :str) (width :str))
  (let n :i64 (str-len text))
  (let neg :bool (and (> n 0)
                   (= (body-byte text 0) 45)))
  (letmut start :i64 0)
  (if neg
    (set start 1)
    (if (and (> n 0)
          (= (body-byte text 0) 43))
      (set start 1)
      (check-nothing)))
  (let first :i64 (body-digits text start))
  (let unsigned :bool (= (body-byte width 0) 117))
  (if neg
    (ret (if unsigned
           (= first (str-len text))
           (body-mag-le text first (body-width-min width) 0)))
    (ret (body-mag-le text first (body-width-max width) 0))))

(fn body-number check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (text :str) (expected :i64) (where :i64) (out (ref (vec :i64))))
  (if (body-float-text text)
    (ret (if (and (>= expected 0)
               (body-float-ty? tags names expected))
           (body-store out expected)
           (body-store out (body-prim-ty tags names elem extra pbase powner "f64"))))
    (check-nothing))
  (letmut ty :i64 -1)
  (if (and (>= expected 0)
        (body-int-ty? tags names expected))
    (set ty expected)
    (set ty (body-prim-ty tags names elem extra pbase powner "i64")))
  (let width :str (body-prim-name tags names ty))
  (if (not (body-int-fits text width))
    (ret (check-fail-at nodes ntexts where 106 (str-concat "literal " (str-concat text (str-concat " does not fit :" width)))))
    (check-nothing))
  (ret (body-store out ty)))

(fn body-atom-value check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (bt (ref (vec :i64))) (bv (ref (vec :i64))) (bu (ref (vec :i64))) (bk (ref (vec :str))) (bvl (ref (vec :i64))) (bsl (ref (vec :i64))) (text :str) (where :i64) (out (ref (vec :i64))))
  (if (type-colon text)
    (ret (check-fail-at nodes ntexts where 2 (str-concat "type name '" (str-concat text "' is not a value"))))
    (check-nothing))
  (let at :i64 (body-find bk bvl bsl text))
  (if (>= at 0)
    (ret (body-read nodes ntexts bt bv bu at text where out))
    (check-nothing))
  (if (or (str-eq text "true")
        (str-eq text "false"))
    (ret (body-store out (body-prim-ty tags names elem extra pbase powner "bool")))
    (check-nothing))
  (ret (body-store out (body-unknown))))

(fn body-token check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (bt (ref (vec :i64))) (bv (ref (vec :i64))) (bu (ref (vec :i64))) (bk (ref (vec :str))) (bvl (ref (vec :i64))) (bsl (ref (vec :i64))) (id :i64) (expected :i64) (where :i64) (out (ref (vec :i64))))
  (let tok :i64 (get (vec-get nodes id) tok))
  (let text :str (body-text nodes ntexts id))
  (if (= tok 4)
    (ret (body-number nodes ntexts tags names elem extra pbase powner text expected where out))
    (check-nothing))
  (if (= tok 3)
    (ret (body-store out (body-prim-ty tags names elem extra pbase powner "str")))
    (check-nothing))
  (if (= tok 2)
    (ret (body-atom-value nodes ntexts tags names elem extra pbase powner bt bv bu bk bvl bsl text where out))
    (check-nothing))
  (ret (check-fail-at nodes ntexts where 2 "expected a value")))

(fn body-type-form? :bool ((kind :str))
  (if (str-eq kind "arr")
    (ret true)
    (check-nothing))
  (if (str-eq kind "vec")
    (ret true)
    (check-nothing))
  (if (str-eq kind "ptr")
    (ret true)
    (check-nothing))
  (if (str-eq kind "own")
    (ret true)
    (check-nothing))
  (if (str-eq kind "fn")
    (ret true)
    (check-nothing))
  (if (str-eq kind "fn*")
    (ret true)
    (check-nothing))
  (if (str-eq kind "res")
    (ret true)
    (check-nothing))
  (if (str-eq kind "opt")
    (ret true)
    (check-nothing))
  (if (str-eq kind "shared")
    (ret true)
    (check-nothing))
  (if (str-eq kind "chan")
    (ret true)
    (check-nothing))
  (ret (str-eq kind "atomic")))

(fn body-clearly-type? :bool ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (id :i64))
  (if (check-is-marker nodes ntexts id)
    (ret true)
    (check-nothing))
  (ret (and (body-atom? nodes id)
         (type-colon (body-text nodes ntexts id)))))

(fn body-type-slot? :bool ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (id :i64))
  (if (< id 0)
    (ret false)
    (check-nothing))
  (if (check-is-marker nodes ntexts id)
    (ret true)
    (check-nothing))
  (if (= (get (vec-get nodes id) tok) 2)
    (ret true)
    (check-nothing))
  (ret (body-type-form? (body-text nodes ntexts id))))

(fn body-arith-kind :bool ((kind :str))
  (if (str-eq kind "+")
    (ret true)
    (check-nothing))
  (if (str-eq kind "-")
    (ret true)
    (check-nothing))
  (if (str-eq kind "*")
    (ret true)
    (check-nothing))
  (if (str-eq kind "/")
    (ret true)
    (check-nothing))
  (ret (str-eq kind "%")))

(fn body-ordered-kind :bool ((kind :str))
  (if (str-eq kind "<")
    (ret true)
    (check-nothing))
  (if (str-eq kind "<=")
    (ret true)
    (check-nothing))
  (if (str-eq kind ">")
    (ret true)
    (check-nothing))
  (ret (str-eq kind ">=")))

(fn body-eq-kind :bool ((kind :str))
  (ret (or (str-eq kind "=")
         (str-eq kind "!="))))

(fn body-compare-kind :bool ((kind :str))
  (ret (or (body-ordered-kind kind)
         (body-eq-kind kind))))

(fn body-shift-kind :bool ((kind :str))
  (if (str-eq kind "shl")
    (ret true)
    (check-nothing))
  (if (str-eq kind "shr")
    (ret true)
    (check-nothing))
  (ret (str-eq kind "shr-u")))

(fn body-verb :str ((kind :str))
  (if (str-eq kind "+")
    (ret "add")
    (check-nothing))
  (if (str-eq kind "-")
    (ret "subtract")
    (check-nothing))
  (if (str-eq kind "*")
    (ret "multiply")
    (check-nothing))
  (if (str-eq kind "/")
    (ret "divide")
    (check-nothing))
  (ret "modulo"))

(fn body-operand-message :str ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (ptypes (ref (vec :i64))) (kind :str) (ty :i64) (operand :i64))
  (if (str-eq kind "%")
    (ret (str-concat "cannot take the modulo of " (str-concat (body-type-text tags names elem extra pbase ptypes ty)
                                                    (str-concat " by " (body-type-text tags names elem extra pbase ptypes operand)))))
    (check-nothing))
  (ret (str-concat "cannot " (str-concat (body-verb kind)
                               (str-concat " " (str-concat (body-type-text tags names elem extra pbase ptypes operand)
                                                 (str-concat " to " (body-type-text tags names elem extra pbase ptypes ty))))))))

(fn body-value check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (bn (ref (vec :i64))) (bt (ref (vec :i64))) (bm (ref (vec :i64))) (bv (ref (vec :i64))) (bu (ref (vec :i64))) (bd (ref (vec :i64))) (br (ref (vec :i64))) (bl (ref (vec :str))) (bk (ref (vec :str))) (bvl (ref (vec :i64))) (bsl (ref (vec :i64))) (bctl (ref (vec :i64))) (id :i64) (expected :i64) (where :i64) (out (ref (vec :i64))))
  (if (= (get (vec-get nodes id) tok) -1)
    (ret (body-expr nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl id expected out))
    (ret (body-token nodes ntexts tags names elem extra pbase powner bt bv bu bk bvl bsl id expected where out))))

(fn body-expr check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (bn (ref (vec :i64))) (bt (ref (vec :i64))) (bm (ref (vec :i64))) (bv (ref (vec :i64))) (bu (ref (vec :i64))) (bd (ref (vec :i64))) (br (ref (vec :i64))) (bl (ref (vec :str))) (bk (ref (vec :str))) (bvl (ref (vec :i64))) (bsl (ref (vec :i64))) (bctl (ref (vec :i64))) (id :i64) (expected :i64) (out (ref (vec :i64))))
  (let first :i64 (get (vec-get nodes id) first))
  (let kind :str (body-text nodes ntexts id))
  (if (= (get (vec-get nodes id) text) -1)
    (ret (if (= first -1)
           (check-fail-at nodes ntexts id 2 "empty form")
           (check-fail-at nodes ntexts id 2 "a form must start with a name")))
    (check-nothing))
  (if (body-arith-kind kind)
    (ret (body-arith nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl id expected out))
    (check-nothing))
  (if (body-compare-kind kind)
    (ret (body-compare nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl id out))
    (check-nothing))
  (if (body-shift-kind kind)
    (ret (body-shift nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl id out))
    (check-nothing))
  (if (str-eq kind "cast")
    (ret (body-cast nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl id out))
    (check-nothing))
  (if (or (str-eq kind "let")
        (str-eq kind "letmut"))
    (ret (body-let nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl id kind out))
    (check-nothing))
  (if (str-eq kind "set")
    (ret (body-set nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl id out))
    (check-nothing))
  (if (str-eq kind "ret")
    (ret (body-ret nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl id out))
    (check-nothing))
  (if (str-eq kind "if")
    (ret (body-if nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl id expected out))
    (check-nothing))
  (if (str-eq kind "while")
    (ret (body-while nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl id out))
    (check-nothing))
  (if (str-eq kind "match")
    (ret (body-match nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl id expected out))
    (check-nothing))
  (if (or (str-eq kind "break")
        (str-eq kind "continue"))
    (ret (body-loop-jump nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl id out))
    (check-nothing))
  (if (or (str-eq kind "and")
        (str-eq kind "or"))
    (ret (body-logical nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl id out))
    (check-nothing))
  (if (str-eq kind "not")
    (ret (body-not nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl id out))
    (check-nothing))
  (ret (body-store out (body-unknown))))

(fn body-arith check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (bn (ref (vec :i64))) (bt (ref (vec :i64))) (bm (ref (vec :i64))) (bv (ref (vec :i64))) (bu (ref (vec :i64))) (bd (ref (vec :i64))) (br (ref (vec :i64))) (bl (ref (vec :str))) (bk (ref (vec :str))) (bvl (ref (vec :i64))) (bsl (ref (vec :i64))) (bctl (ref (vec :i64))) (id :i64) (expected :i64) (out (ref (vec :i64))))
  (let kind :str (body-text nodes ntexts id))
  (let n :i64 (check-count nodes id))
  (if (< n 2)
    (ret (check-fail-at nodes ntexts id 102 (str-concat "'" (str-concat kind "' takes at least two operands"))))
    (check-nothing))
  (let a0 :i64 (check-child nodes id 0))
  (let a1 :i64 (check-child nodes id 1))
  (let look :bool (and (body-literal? nodes a0)
                    (not (body-literal? nodes a1))))
  (letmut one
    (vec :i64)
    (make (vec :i64)))
  (vec-push one -1)
  (letmut err check-error (check-pass))
  (if look
    (set err (body-value nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl a1 expected id one))
    (set err (body-value nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl a0 expected id one)))
  (letmut ty :i64 -1)
  (if (check-ok err)
    (set ty (vec-get one 0))
    (check-nothing))
  (if (and (check-ok err)
        (and (not (= ty (body-unknown)))
          (not (body-number-ty? tags names ty))))
    (set err (check-fail-at nodes ntexts
               (body-at nodes (if look a1 a0) id) 100
               (str-concat "'" (str-concat kind (str-concat "' needs numbers, found " (body-type-text tags names elem extra pbase ptypes ty))))))
    (check-nothing))
  (if (and (check-ok err) look)
    (set err (body-value nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl a0 ty id one))
    (check-nothing))
  (if (and (check-ok err) look)
    (if (not (body-fits tags names elem extra pbase powner ptypes ty (vec-get one 0)))
      (set err (check-fail-at nodes ntexts
                 (body-at nodes a0 id) 100
                 (body-operand-message tags names elem extra pbase ptypes kind ty (vec-get one 0))))
      (check-nothing))
    (check-nothing))
  (if (and (check-ok err)
        (and (not (= ty (body-unknown)))
          (and (str-eq kind "%")
            (body-float-ty? tags names ty))))
    (set err (check-fail-at nodes ntexts id 100 (str-concat "'%' needs integers, found " (body-type-text tags names elem extra pbase ptypes ty))))
    (check-nothing))
  (letmut i :i64 (if look 2 1))
  (while (and (check-ok err)
           (< i n))
    (let arg :i64 (check-child nodes id i))
    (set err (body-value nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl arg ty id one))
    (if (and (check-ok err)
          (not (= ty (body-unknown))))
      (if (not (body-fits tags names elem extra pbase powner ptypes ty (vec-get one 0)))
        (set err (check-fail-at nodes ntexts
                   (body-at nodes arg id) 100
                   (body-operand-message tags names elem extra pbase ptypes kind ty (vec-get one 0))))
        (check-nothing))
      (check-nothing))
    (set i (+ i 1)))
  (vec-free one)
  (ret (if (check-ok err)
         (body-store out ty) err)))

(fn body-shift check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (bn (ref (vec :i64))) (bt (ref (vec :i64))) (bm (ref (vec :i64))) (bv (ref (vec :i64))) (bu (ref (vec :i64))) (bd (ref (vec :i64))) (br (ref (vec :i64))) (bl (ref (vec :str))) (bk (ref (vec :str))) (bvl (ref (vec :i64))) (bsl (ref (vec :i64))) (bctl (ref (vec :i64))) (id :i64) (out (ref (vec :i64))))
  (let kind :str (body-text nodes ntexts id))
  (let n :i64 (check-count nodes id))
  (if (not (= n 2))
    (ret (check-fail-at nodes ntexts id 102 (str-concat "'" (str-concat kind "' takes a value and a count"))))
    (check-nothing))
  (let v :i64 (check-child nodes id 0))
  (let c :i64 (check-child nodes id 1))
  (let look :bool (and (body-literal? nodes v)
                    (not (body-literal? nodes c))))
  (letmut one
    (vec :i64)
    (make (vec :i64)))
  (vec-push one -1)
  (letmut err check-error (check-pass))
  (if look
    (set err (body-value nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl c (body-unknown) id one))
    (set err (body-value nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl v (body-unknown) id one)))
  (letmut ty :i64 -1)
  (if (check-ok err)
    (set ty (vec-get one 0))
    (check-nothing))
  (if (and (check-ok err)
        (and (not (= ty (body-unknown)))
          (not (body-int-ty? tags names ty))))
    (set err (check-fail-at nodes ntexts
               (body-at nodes (if look c v) id) 100
               (str-concat "'" (str-concat kind (str-concat "' needs an integer, found " (body-type-text tags names elem extra pbase ptypes ty))))))
    (check-nothing))
  (if (check-ok err)
    (if look
      (set err (body-value nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl v ty id one))
      (set err (body-value nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl c ty id one)))
    (check-nothing))
  (if (and (check-ok err)
        (and (not (= ty (body-unknown)))
          (not (body-fits tags names elem extra pbase powner ptypes ty (vec-get one 0)))))
    (set err (check-fail-at nodes ntexts
               (body-at nodes c id) 100
               (str-concat "cannot shift " (str-concat (body-type-text tags names elem extra pbase ptypes ty)
                                             (str-concat " by " (body-type-text tags names elem extra pbase ptypes (vec-get one 0)))))))
    (check-nothing))
  (vec-free one)
  (ret (if (check-ok err)
         (body-store out ty) err)))

(fn body-cast check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (bn (ref (vec :i64))) (bt (ref (vec :i64))) (bm (ref (vec :i64))) (bv (ref (vec :i64))) (bu (ref (vec :i64))) (bd (ref (vec :i64))) (br (ref (vec :i64))) (bl (ref (vec :str))) (bk (ref (vec :str))) (bvl (ref (vec :i64))) (bsl (ref (vec :i64))) (bctl (ref (vec :i64))) (id :i64) (out (ref (vec :i64))))
  (let n :i64 (check-count nodes id))
  (letmut index :i64 0)
  (if (check-is-marker nodes ntexts (check-child nodes id 0))
    (set index 1)
    (check-nothing))
  (if (not (= n (+ index 2)))
    (ret (check-fail-at nodes ntexts id 102 "'cast' takes a type and a value"))
    (check-nothing))
  (let titem :i64 (check-child nodes id index))
  (let vitem :i64 (check-child nodes id (+ index 1)))
  (letmut one
    (vec :i64)
    (make (vec :i64)))
  (vec-push one -1)
  (letmut err check-error (check-type-parse nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes titem id one))
  (letmut target :i64 -1)
  (if (check-ok err)
    (set target (vec-get one 0))
    (check-nothing))
  (if (and (check-ok err)
        (not (and (>= target 0)
               (body-number-name (body-prim-name tags names target)))))
    (set err (check-fail-at nodes ntexts id 100 (str-concat "a cast needs a numeric type, found " (body-type-text tags names elem extra pbase ptypes target))))
    (check-nothing))
  (if (check-ok err)
    (set err (body-value nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl vitem (body-unknown) id one))
    (check-nothing))
  (letmut source :i64 -1)
  (if (check-ok err)
    (set source (vec-get one 0))
    (check-nothing))
  (if (and (check-ok err)
        (and (not (= source (body-unknown)))
          (not (body-number-ty? tags names source))))
    (set err (check-fail-at nodes ntexts
               (body-at nodes vitem id) 100
               (str-concat "cannot cast " (str-concat (body-type-text tags names elem extra pbase ptypes source)
                                            (str-concat " to " (str-concat (body-type-text tags names elem extra pbase ptypes target) ": a cast converts numbers"))))))
    (check-nothing))
  (if (and (check-ok err)
        (and (not (= source (body-unknown)))
          (body-fits tags names elem extra pbase powner ptypes target source)))
    (set err (check-fail-at nodes ntexts id 100 (str-concat "cast from " (str-concat (body-type-text tags names elem extra pbase ptypes source)
                                                                           (str-concat " to " (str-concat (body-type-text tags names elem extra pbase ptypes target) " cannot change the type"))))))
    (check-nothing))
  (vec-free one)
  (ret (if (check-ok err)
         (body-store out target) err)))

(fn body-compare check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (bn (ref (vec :i64))) (bt (ref (vec :i64))) (bm (ref (vec :i64))) (bv (ref (vec :i64))) (bu (ref (vec :i64))) (bd (ref (vec :i64))) (br (ref (vec :i64))) (bl (ref (vec :str))) (bk (ref (vec :str))) (bvl (ref (vec :i64))) (bsl (ref (vec :i64))) (bctl (ref (vec :i64))) (id :i64) (out (ref (vec :i64))))
  (let kind :str (body-text nodes ntexts id))
  (let n :i64 (check-count nodes id))
  (if (not (= n 2))
    (ret (check-fail-at nodes ntexts id 102 (str-concat "'" (str-concat kind "' takes two operands"))))
    (check-nothing))
  (let l :i64 (check-child nodes id 0))
  (let r :i64 (check-child nodes id 1))
  (let ll :bool (body-literal? nodes l))
  (let rl :bool (body-literal? nodes r))
  (letmut one
    (vec :i64)
    (make (vec :i64)))
  (vec-push one -1)
  (letmut err check-error (check-pass))
  (letmut lt :i64 -1)
  (letmut rt :i64 -1)
  (if (and ll (not rl))
    (set err (body-value nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl r (body-unknown) id one))
    (check-nothing))
  (if (and ll (and (not rl)
                (check-ok err)))
    (set rt (vec-get one 0))
    (check-nothing))
  (if (and ll (and (not rl)
                (check-ok err)))
    (set err (body-value nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl l rt id one))
    (check-nothing))
  (if (and ll (and (not rl)
                (check-ok err)))
    (set lt (vec-get one 0))
    (check-nothing))
  (if (and rl (not ll))
    (set err (body-value nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl l (body-unknown) id one))
    (check-nothing))
  (if (and rl (and (not ll)
                (check-ok err)))
    (set lt (vec-get one 0))
    (check-nothing))
  (if (and rl (and (not ll)
                (check-ok err)))
    (set err (body-value nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl r lt id one))
    (check-nothing))
  (if (and rl (and (not ll)
                (check-ok err)))
    (set rt (vec-get one 0))
    (check-nothing))
  (if (or (and ll rl)
        (and (not ll)
          (not rl)))
    (set err (body-value nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl l (body-unknown) id one))
    (check-nothing))
  (if (and (or (and ll rl)
             (and (not ll)
               (not rl)))
        (check-ok err))
    (set lt (vec-get one 0))
    (check-nothing))
  (if (and (or (and ll rl)
             (and (not ll)
               (not rl)))
        (check-ok err))
    (set err (body-value nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl r lt id one))
    (check-nothing))
  (if (and (or (and ll rl)
             (and (not ll)
               (not rl)))
        (check-ok err))
    (set rt (vec-get one 0))
    (check-nothing))
  (if (and (check-ok err)
        (not (body-fits tags names elem extra pbase powner ptypes lt rt)))
    (set err (check-fail-at nodes ntexts
               (body-at nodes r id) 100
               (str-concat "cannot compare " (str-concat (body-type-text tags names elem extra pbase ptypes rt)
                                               (str-concat " with " (body-type-text tags names elem extra pbase ptypes lt))))))
    (check-nothing))
  (if (and (check-ok err)
        (and (body-ordered-kind kind)
          (and (not (= lt (body-unknown)))
            (not (body-number-ty? tags names lt)))))
    (set err (check-fail-at nodes ntexts
               (body-at nodes l id) 100
               (str-concat "'" (str-concat kind (str-concat "' needs numbers, found " (body-type-text tags names elem extra pbase ptypes lt))))))
    (check-nothing))
  (if (and (check-ok err)
        (and (body-eq-kind kind)
          (and (not (= lt (body-unknown)))
            (not (body-scalar-ty? tags names lt)))))
    (set err (check-fail-at nodes ntexts
               (body-at nodes l id) 100
               (str-concat "'" (str-concat kind (str-concat "' needs scalar operands, found " (body-type-text tags names elem extra pbase ptypes lt))))))
    (check-nothing))
  (vec-free one)
  (ret (if (check-ok err)
         (body-store out (body-prim-ty tags names elem extra pbase powner "bool")) err)))

(fn body-let-message :str ((kind :str) (name :str) (declared :str) (found :str))
  (ret (str-concat kind (str-concat " '" (str-concat name (str-concat "' has type " (str-concat declared (str-concat ", found " found))))))))

(fn body-let-annotation check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (id :i64) (n :i64) (kind :str) (info (ref (vec :i64))))
  (let c2 :i64 (check-child nodes id 1))
  (if (not (body-type-slot? nodes ntexts c2))
    (ret (check-fail-at nodes ntexts id 102 (str-concat kind " takes a name, an optional type and a value")))
    (check-nothing))
  (let marker :bool (check-is-marker nodes ntexts c2))
  (let titem :i64 (if marker (check-child nodes id 2) c2))
  (let next :i64 (if marker 3 2))
  (if (= titem -1)
    (ret (check-fail-at nodes ntexts id 101 "expected a type after ':'"))
    (check-nothing))
  (letmut one
    (vec :i64)
    (make (vec :i64)))
  (vec-push one -1)
  (letmut eb
    (vec :str)
    (make (vec :str)))
  (letmut et
    (vec :i64)
    (make (vec :i64)))
  (letmut err check-error (check-type nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild titem id 1 eb et one))
  (vec-free eb)
  (vec-free et)
  (if (not (check-ok err))
    (ret (check-free-one one err))
    (check-nothing))
  (if (not (= n (+ next 1)))
    (ret (check-free-one one (check-fail-at nodes ntexts id 102 (str-concat kind " takes a name, an optional type and a value"))))
    (check-nothing))
  (vec-set info 0 (vec-get one 0))
  (vec-set info 1 (check-child nodes id next))
  (ret (check-free-one one (check-pass))))

(fn body-let check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (bn (ref (vec :i64))) (bt (ref (vec :i64))) (bm (ref (vec :i64))) (bv (ref (vec :i64))) (bu (ref (vec :i64))) (bd (ref (vec :i64))) (br (ref (vec :i64))) (bl (ref (vec :str))) (bk (ref (vec :str))) (bvl (ref (vec :i64))) (bsl (ref (vec :i64))) (bctl (ref (vec :i64))) (id :i64) (kind :str) (out (ref (vec :i64))))
  (let n :i64 (check-count nodes id))
  (if (< n 2)
    (ret (check-fail-at nodes ntexts id 102 (str-concat kind " takes a name, an optional type and a value")))
    (check-nothing))
  (let name-item :i64 (check-child nodes id 0))
  (let name :str (check-atom-text nodes ntexts name-item))
  (if (not (check-named? name))
    (ret (check-fail-at nodes ntexts id 2 (str-concat kind " needs a name")))
    (check-nothing))
  (letmut info
    (vec :i64)
    (make (vec :i64)))
  (vec-push info (body-unknown))
  (vec-push info (check-child nodes id 1))
  (letmut err check-error (check-pass))
  (if (= n 2)
    (if (body-clearly-type? nodes ntexts (check-child nodes id 1))
      (set err (check-fail-at nodes ntexts id 102 (str-concat kind " takes a name, an optional type and a value")))
      (check-nothing))
    (check-nothing))
  (if (and (> n 2)
        (check-ok err))
    (set err (body-let-annotation nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild id n kind info))
    (check-nothing))
  (letmut val
    (vec :i64)
    (make (vec :i64)))
  (vec-push val -1)
  (if (check-ok err)
    (set err (body-value nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl
               (vec-get info 1)
               (vec-get info 0) id val))
    (check-nothing))
  (letmut ty :i64 -1)
  (if (check-ok err)
    (set ty (vec-get val 0))
    (check-nothing))
  (let declared :i64 (vec-get info 0))
  (let init :i64 (vec-get info 1))
  (if (and (check-ok err)
        (and (not (= declared (body-unknown)))
          (not (body-fits tags names elem extra pbase powner ptypes declared ty))))
    (set err (check-fail-at nodes ntexts
               (body-at nodes init id) 100
               (body-let-message kind name
                 (body-type-text tags names elem extra pbase ptypes declared)
                 (body-type-text tags names elem extra pbase ptypes ty))))
    (check-nothing))
  (if (and (check-ok err)
        (body-void-ty? tags names ty))
    (set err (check-fail-at nodes ntexts
               (body-at nodes init id) 100
               (str-concat "cannot bind '" (str-concat name "' to a :void value"))))
    (check-nothing))
  (letmut bound :i64 ty)
  (if (not (= declared (body-unknown)))
    (set bound declared)
    (check-nothing))
  (if (check-ok err)
    (set err (body-bind nodes ntexts bn bt bm bv bu bd bk bvl bsl name
               (get (vec-get nodes name-item) text) bound
               (if (str-eq kind "letmut") 1 0)
               (vec-get bctl 0) id))
    (check-nothing))
  (vec-free info)
  (vec-free val)
  (ret (if (check-ok err)
         (body-store out (body-prim-ty tags names elem extra pbase powner "void")) err)))

(fn body-set check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (bn (ref (vec :i64))) (bt (ref (vec :i64))) (bm (ref (vec :i64))) (bv (ref (vec :i64))) (bu (ref (vec :i64))) (bd (ref (vec :i64))) (br (ref (vec :i64))) (bl (ref (vec :str))) (bk (ref (vec :str))) (bvl (ref (vec :i64))) (bsl (ref (vec :i64))) (bctl (ref (vec :i64))) (id :i64) (out (ref (vec :i64))))
  (let n :i64 (check-count nodes id))
  (if (not (= n 2))
    (ret (check-fail-at nodes ntexts id 102 "set takes a name and a value"))
    (check-nothing))
  (let name-item :i64 (check-child nodes id 0))
  (let name :str (check-atom-text nodes ntexts name-item))
  (if (not (check-named? name))
    (ret (check-fail-at nodes ntexts id 2 "set needs a name"))
    (check-nothing))
  (let at :i64 (body-find bk bvl bsl name))
  (if (< at 0)
    (ret (check-fail-at nodes ntexts id 5 (str-concat "unknown name '" (str-concat name "'"))))
    (check-nothing))
  (if (= (vec-get bm at) 0)
    (ret (check-fail-at nodes ntexts id 104 (str-concat "cannot set immutable binding '" (str-concat name "'"))))
    (check-nothing))
  (let mut-ty :i64 (vec-get bt at))
  (letmut val
    (vec :i64)
    (make (vec :i64)))
  (vec-push val -1)
  (letmut err check-error (body-value nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl (check-child nodes id 1) mut-ty id val))
  (let v :i64 (vec-get val 0))
  (if (and (check-ok err)
        (not (body-fits tags names elem extra pbase powner ptypes mut-ty v)))
    (set err (check-fail-at nodes ntexts
               (body-at nodes (check-child nodes id 1) id) 100
               (str-concat "cannot set '" (str-concat name (str-concat "' of type " (str-concat (body-type-text tags names elem extra pbase ptypes mut-ty)
                                                                                      (str-concat " to " (body-type-text tags names elem extra pbase ptypes v))))))))
    (check-nothing))
  (vec-free val)
  (ret (if (check-ok err)
         (body-store out (body-prim-ty tags names elem extra pbase powner "void")) err)))

(fn body-ret check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (bn (ref (vec :i64))) (bt (ref (vec :i64))) (bm (ref (vec :i64))) (bv (ref (vec :i64))) (bu (ref (vec :i64))) (bd (ref (vec :i64))) (br (ref (vec :i64))) (bl (ref (vec :str))) (bk (ref (vec :str))) (bvl (ref (vec :i64))) (bsl (ref (vec :i64))) (bctl (ref (vec :i64))) (id :i64) (out (ref (vec :i64))))
  (let n :i64 (check-count nodes id))
  (if (> n 1)
    (ret (check-fail-at nodes ntexts id 102 "ret takes at most one value"))
    (check-nothing))
  (let ret-ty :i64 (vec-get br 0))
  (let label :str (vec-get bl 0))
  (if (= n 0)
    (ret (if (body-void-ty? tags names ret-ty)
           (body-store out (body-prim-ty tags names elem extra pbase powner "void"))
           (check-fail-at nodes ntexts id 100 (str-concat label (str-concat " returns " (str-concat (body-type-text tags names elem extra pbase ptypes ret-ty) ", found :void"))))))
    (check-nothing))
  (letmut val
    (vec :i64)
    (make (vec :i64)))
  (vec-push val -1)
  (letmut err check-error (body-value nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl (check-child nodes id 0) ret-ty id val))
  (let ty :i64 (vec-get val 0))
  (if (and (check-ok err)
        (and (not (= ty (body-unknown)))
          (not (body-fits tags names elem extra pbase powner ptypes ret-ty ty))))
    (set err (check-fail-at nodes ntexts id 100 (str-concat label (str-concat " returns " (str-concat (body-type-text tags names elem extra pbase ptypes ret-ty)
                                                                                            (str-concat ", found " (body-type-text tags names elem extra pbase ptypes ty)))))))
    (check-nothing))
  (vec-free val)
  (ret (if (check-ok err)
         (body-store out (body-prim-ty tags names elem extra pbase powner "void")) err)))

(fn body-variant-count :i64 ((tags (ref (vec :i64))) (extra (ref (vec :i64))) (ty :i64) (family :i64))
  (if (= family 0)
    (ret (vec-get extra ty))
    (check-nothing))
  (ret 2))

(fn body-variant-name :str ((tags (ref (vec :i64))) (names (ref (vec :str))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pvname (ref (vec :str))) (ty :i64) (family :i64) (i :i64))
  (if (= family 0)
    (ret (vec-get pvname (+ (vec-get pbase ty) i)))
    (check-nothing))
  (if (= family 1)
    (ret (if (= i 0) "ok" "err"))
    (check-nothing))
  (ret (if (= i 0) "some" "none")))

(fn body-variant-payload :i64 ((elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pchild (ref (vec :i64))) (ty :i64) (family :i64) (i :i64))
  (if (= family 0)
    (ret (vec-get pchild (+ (vec-get pbase ty) i)))
    (check-nothing))
  (if (= family 1)
    (ret (if (= i 0)
           (vec-get elem ty)
           (vec-get extra ty)))
    (check-nothing))
  (ret (if (= i 0)
         (vec-get elem ty) -1)))

(fn body-variant-find :i64 ((tags (ref (vec :i64))) (names (ref (vec :str))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pvname (ref (vec :str))) (ty :i64) (family :i64) (name :str))
  (let n :i64 (body-variant-count tags extra ty family))
  (letmut i :i64 0)
  (letmut found :i64 -1)
  (while (and (= found -1)
           (< i n))
    (if (str-eq (body-variant-name tags names extra pbase pvname ty family i) name)
      (set found i)
      (check-nothing))
    (set i (+ i 1)))
  (ret found))

(fn body-owner-text :str ((names (ref (vec :str))) (ty :i64) (family :i64))
  (if (= family 0)
    (ret (str-concat "enum '" (str-concat (vec-get names ty) "'")))
    (check-nothing))
  (ret (if (= family 1) "a result" "an optional")))

(fn body-arm-head? :bool ((nodes (ref (vec node))) (arm :i64))
  (ret (and (>= arm 0)
         (not (= (get (vec-get nodes arm) text) -1)))))

(fn body-arm-pat :i64 ((nodes (ref (vec node))) (arm :i64))
  (if (body-arm-head? nodes arm)
    (ret -3)
    (check-nothing))
  (ret (check-child nodes arm 0)))

(fn body-arm-items :i64 ((nodes (ref (vec node))) (arm :i64))
  (ret (if (body-arm-head? nodes arm)
         (+ (check-count nodes arm) 1)
         (check-count nodes arm))))

(fn body-arm-start :i64 ((nodes (ref (vec node))) (arm :i64))
  (ret (check-child nodes arm (if (body-arm-head? nodes arm) 0 1))))

(fn body-arm-n :i64 ((nodes (ref (vec node))) (arm :i64))
  (ret (if (body-arm-head? nodes arm)
         (check-count nodes arm)
         (- (check-count nodes arm) 1))))

(fn body-pat-form? :bool ((nodes (ref (vec node))) (pat :i64))
  (ret (and (>= pat 0)
         (= (get (vec-get nodes pat) tok) -1))))

(fn body-pat-tok :i64 ((nodes (ref (vec node))) (pat :i64))
  (if (= pat -3)
    (ret 2)
    (check-nothing))
  (ret (if (< pat 0) 2
         (get (vec-get nodes pat) tok))))

(fn body-pat-text :str ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (arm :i64) (pat :i64))
  (if (= pat -3)
    (ret (body-text nodes ntexts arm))
    (check-nothing))
  (ret (body-text nodes ntexts pat)))

(fn body-wild? :bool ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (arm :i64))
  (if (not (body-arm-head? nodes arm))
    (ret false)
    (check-nothing))
  (ret (str-eq (body-text nodes ntexts arm) "_")))

(fn body-list-count :i64 ((nodes (ref (vec node))) (first :i64))
  (letmut c :i64 first)
  (letmut n :i64 0)
  (while (not (= c -1))
    (set n (+ n 1))
    (set c (if (= c -1) -1
             (get (vec-get nodes c) next))))
  (ret n))

(fn body-flags :void ((mv (ref (vec :i64))) (n :i64))
  (letmut i :i64 0)
  (while (< i n)
    (vec-push mv 0)
    (set i (+ i 1)))
  (ret))

(fn body-mark-moved :void ((bv (ref (vec :i64))) (mv (ref (vec :i64))) (n :i64))
  (letmut i :i64 0)
  (while (< i n)
    (if (= (vec-get bv i) 1)
      (vec-set mv i 1)
      (check-nothing))
    (set i (+ i 1)))
  (ret))

(fn body-union-moved :void ((bv (ref (vec :i64))) (mv (ref (vec :i64))) (n :i64))
  (letmut i :i64 0)
  (while (< i n)
    (if (= (vec-get mv i) 1)
      (vec-set bv i 1)
      (check-nothing))
    (set i (+ i 1)))
  (ret))

(fn body-arm-shape check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (id :i64) (arm :i64) (prev-wild :i64))
  (if (= (check-count nodes arm) 0)
    (ret (check-fail-at nodes ntexts arm 102 "a match arm needs a pattern and a body"))
    (check-nothing))
  (let pat :i64 (body-arm-pat nodes arm))
  (if (body-pat-form? nodes pat)
    (if (= (get (vec-get nodes pat) text) -1)
      (ret (check-fail-at nodes ntexts pat 2 "a match pattern is a variant name, (variant name) or '_'"))
      (check-nothing))
    (check-nothing))
  (if (< (body-arm-items nodes arm) 2)
    (ret (check-fail-at nodes ntexts arm 102 "a match arm needs a pattern and a body"))
    (check-nothing))
  (if (= prev-wild 1)
    (ret (check-fail-at nodes ntexts arm 2 "an arm after '_' can never match"))
    (check-nothing))
  (ret (check-pass)))

(fn body-match-spine check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (id :i64))
  (if (< (check-count nodes id) 2)
    (ret (check-fail-at nodes ntexts id 102 "'match' takes a scrutinee and at least one arm"))
    (check-nothing))
  (letmut c :i64 (check-child nodes id 1))
  (letmut prev-wild :i64 0)
  (letmut err check-error (check-pass))
  (while (and (check-ok err)
           (not (= c -1)))
    (if (not (= (get (vec-get nodes c) tok) -1))
      (set err (check-fail-at nodes ntexts id 2 "a match arm must be (pattern body...)"))
      (set err (body-arm-shape nodes ntexts id c prev-wild)))
    (if (check-ok err)
      (set prev-wild (if (body-wild? nodes ntexts c) 1 0))
      (check-nothing))
    (set c (if (= c -1) -1
             (get (vec-get nodes c) next))))
  (ret err))

(fn body-pat-literal check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (ptypes (ref (vec :i64))) (arm :i64) (pat :i64) (ty :i64) (at :i64))
  (letmut one
    (vec :i64)
    (make (vec :i64)))
  (vec-push one -1)
  (letmut err check-error (body-number nodes ntexts tags names elem extra pbase powner (body-pat-text nodes ntexts arm pat) ty at one))
  (if (not (check-ok err))
    (ret (check-free-one one err))
    (check-nothing))
  (if (not (body-fits tags names elem extra pbase powner ptypes ty (vec-get one 0)))
    (ret (check-free-one one (check-fail-at nodes ntexts at 100 (str-concat "a " (str-concat (body-type-text tags names elem extra pbase ptypes (vec-get one 0))
                                                                                   (str-concat " pattern cannot test a " (body-type-text tags names elem extra pbase ptypes ty)))))))
    (check-nothing))
  (ret (check-free-one one (check-pass))))

(fn body-pat-int check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (ptypes (ref (vec :i64))) (id :i64) (arm :i64) (ty :i64))
  (let pat :i64 (body-arm-pat nodes arm))
  (let at :i64 (body-at nodes pat id))
  (if (body-pat-form? nodes pat)
    (ret (check-fail-at nodes ntexts at 2 (str-concat "'" (str-concat (body-type-text tags names elem extra pbase ptypes ty) "' has no variants: a match pattern is an integer literal or '_'"))))
    (check-nothing))
  (if (= (body-pat-tok nodes pat) 4)
    (ret (body-pat-literal nodes ntexts tags names elem extra pbase powner ptypes arm pat ty at))
    (check-nothing))
  (if (= (body-pat-tok nodes pat) 2)
    (if (str-eq (body-pat-text nodes ntexts arm pat) "_")
      (ret (check-pass))
      (check-nothing))
    (check-nothing))
  (ret (check-fail-at nodes ntexts at 2 "a match pattern is an integer literal or '_'")))

(fn body-pat-var check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (id :i64) (arm :i64) (ty :i64) (family :i64) (o (ref (vec :i64))) (os (ref (vec :str))))
  (let pat :i64 (body-arm-pat nodes arm))
  (let at :i64 (body-at nodes pat id))
  (let form :bool (body-pat-form? nodes pat))
  (if (= form false)
    (if (not (= (body-pat-tok nodes pat) 2))
      (ret (check-fail-at nodes ntexts at 2 "a match pattern is a variant name, (variant name) or '_'"))
      (check-nothing))
    (if (= (get (vec-get nodes pat) text) -1)
      (ret (check-fail-at nodes ntexts at 2 "a match pattern is a variant name, (variant name) or '_'"))
      (check-nothing)))
  (let name :str (body-pat-text nodes ntexts arm pat))
  (if (and (= form false)
        (str-eq name "_"))
    (ret (check-pass))
    (check-nothing))
  (let vi :i64 (body-variant-find tags names extra pbase pvname ty family name))
  (if (= vi -1)
    (ret (check-fail-at nodes ntexts at 100 (str-concat (body-owner-text names ty family)
                                              (str-concat " has no variant '" (str-concat name "'")))))
    (check-nothing))
  (let pay :i64 (body-variant-payload elem extra pbase pchild ty family vi))
  (if (= form false)
    (if (not (= pay -1))
      (ret (check-fail-at nodes ntexts at 100 (str-concat "variant '" (str-concat name (str-concat "' holds a value: write (" (str-concat name " name)"))))))
      (check-nothing))
    (check-nothing))
  (if (= form true)
    (if (= pay -1)
      (if (not (= (check-count nodes pat) 0))
        (ret (check-fail-at nodes ntexts at 102 (str-concat "variant '" (str-concat name (str-concat "' takes no value: write " name)))))
        (check-nothing))
      (if (not (= (check-count nodes pat) 1))
        (ret (check-fail-at nodes ntexts at 102 (str-concat "a pattern for variant '" (str-concat name "' binds exactly one name"))))
        (check-nothing)))
    (check-nothing))
  (let bound :i64 (if (= form true)
                    (check-child nodes pat 0) -1))
  (if (and (= form true)
        (not (= pay -1)))
    (if (or (< bound 0)
          (not (= (get (vec-get nodes bound) tok) 2)))
      (ret (check-fail-at nodes ntexts at 2 "a variant pattern binds one name or '_'"))
      (check-nothing))
    (check-nothing))
  (letmut binds :i64 (if (and (= form true)
                           (not (= pay -1))) 1 0))
  (letmut bname :str (if (= binds 1)
                       (body-text nodes ntexts bound) ""))
  (if (and (= binds 1)
        (str-eq bname "_"))
    (set binds 0)
    (check-nothing))
  (if (and (= binds 1)
        (type-colon bname))
    (ret (check-fail-at nodes ntexts at 2 "a variant pattern binds a name, not a type"))
    (check-nothing))
  (vec-set o 0 binds)
  (vec-set o 1 pay)
  (vec-set o 2 at)
  (vec-set o 3 1)
  (vec-set o 4 (if (= binds 1)
                 (get (vec-get nodes bound) text) -1))
  (vec-set os 0 name)
  (vec-set os 1 bname)
  (ret (check-pass)))

(fn body-exhaust check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pvname (ref (vec :str))) (ptypes (ref (vec :i64))) (id :i64) (ty :i64) (family :i64) (seen (ref (vec :str))))
  (let nv :i64 (body-variant-count tags extra ty family))
  (letmut missing :str "")
  (letmut nm :i64 0)
  (letmut i :i64 0)
  (while (< i nv)
    (let vn :str (body-variant-name tags names extra pbase pvname ty family i))
    (if (not (check-in seen vn))
      (set missing (str-concat missing (str-concat (if (= nm 0) "" ", ")
                                         (str-concat "'" (str-concat vn "'")))))
      (check-nothing))
    (if (not (check-in seen vn))
      (set nm (+ nm 1))
      (check-nothing))
    (set i (+ i 1)))
  (if (> nm 0)
    (ret (check-fail-at nodes ntexts id 600 (str-concat "this match on " (str-concat (body-type-text tags names elem extra pbase ptypes ty)
                                                                           (str-concat " does not handle " missing)))))
    (check-nothing))
  (ret (check-pass)))

(fn body-arm-run check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (bn (ref (vec :i64))) (bt (ref (vec :i64))) (bm (ref (vec :i64))) (bv (ref (vec :i64))) (bu (ref (vec :i64))) (bd (ref (vec :i64))) (br (ref (vec :i64))) (bl (ref (vec :str))) (bk (ref (vec :str))) (bvl (ref (vec :i64))) (bsl (ref (vec :i64))) (bctl (ref (vec :i64))) (items :i64) (count :i64) (bind :i64) (bname :str) (bid :i64) (bty :i64) (bat :i64) (expected :i64) (owner :i64) (out (ref (vec :i64))))
  (let d0 :i64 (vec-get bctl 0))
  (vec-set bctl 0 (+ d0 1))
  (letmut err check-error (check-pass))
  (if (= bind 1)
    (set err (body-bind nodes ntexts bn bt bm bv bu bd bk bvl bsl bname bid bty 0 (vec-get bctl 0) bat))
    (check-nothing))
  (letmut c :i64 items)
  (letmut i :i64 1)
  (while (and (check-ok err)
           (and (not (= c -1))
             (< i count)))
    (if (= (get (vec-get nodes c) tok) -1)
      (set err (body-statement nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl c))
      (set err (check-fail-at nodes ntexts owner 2 "a statement must be a form")))
    (set c (if (= c -1) -1
             (get (vec-get nodes c) next)))
    (set i (+ i 1)))
  (if (and (check-ok err)
        (not (= c -1)))
    (set err (body-value nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl c expected owner out))
    (check-nothing))
  (vec-set bctl 0 d0)
  (ret err))

(fn body-walk check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (bn (ref (vec :i64))) (bt (ref (vec :i64))) (bm (ref (vec :i64))) (bv (ref (vec :i64))) (bu (ref (vec :i64))) (bd (ref (vec :i64))) (br (ref (vec :i64))) (bl (ref (vec :str))) (bk (ref (vec :str))) (bvl (ref (vec :i64))) (bsl (ref (vec :i64))) (bctl (ref (vec :i64))) (items :i64) (count :i64) (owner :i64))
  (letmut c :i64 items)
  (letmut i :i64 0)
  (letmut err check-error (check-pass))
  (while (and (check-ok err)
           (and (not (= c -1))
             (< i count)))
    (if (= (get (vec-get nodes c) tok) -1)
      (set err (body-statement nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl c))
      (set err (check-fail-at nodes ntexts owner 2 "a statement must be a form")))
    (set c (if (= c -1) -1
             (get (vec-get nodes c) next)))
    (set i (+ i 1)))
  (ret err))

(fn body-block check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (bn (ref (vec :i64))) (bt (ref (vec :i64))) (bm (ref (vec :i64))) (bv (ref (vec :i64))) (bu (ref (vec :i64))) (bd (ref (vec :i64))) (br (ref (vec :i64))) (bl (ref (vec :str))) (bk (ref (vec :str))) (bvl (ref (vec :i64))) (bsl (ref (vec :i64))) (bctl (ref (vec :i64))) (items :i64) (count :i64) (owner :i64))
  (let d0 :i64 (vec-get bctl 0))
  (vec-set bctl 0 (+ d0 1))
  (letmut err check-error (body-walk nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl items count owner))
  (vec-set bctl 0 d0)
  (ret err))

(fn body-branch check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (bn (ref (vec :i64))) (bt (ref (vec :i64))) (bm (ref (vec :i64))) (bv (ref (vec :i64))) (bu (ref (vec :i64))) (bd (ref (vec :i64))) (br (ref (vec :i64))) (bl (ref (vec :str))) (bk (ref (vec :str))) (bvl (ref (vec :i64))) (bsl (ref (vec :i64))) (bctl (ref (vec :i64))) (snap (ref (vec :i64))) (mv (ref (vec :i64))) (n0 :i64) (item :i64) (expected :i64) (owner :i64) (out (ref (vec :i64))))
  (body-restore bv bvl snap)
  (letmut err check-error (body-arm-run nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl item 1 0 "" -1 (body-unknown) -1 expected owner out))
  (if (check-ok err)
    (body-mark-moved bv mv n0)
    (check-nothing))
  (ret err))

(fn body-if check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (bn (ref (vec :i64))) (bt (ref (vec :i64))) (bm (ref (vec :i64))) (bv (ref (vec :i64))) (bu (ref (vec :i64))) (bd (ref (vec :i64))) (br (ref (vec :i64))) (bl (ref (vec :str))) (bk (ref (vec :str))) (bvl (ref (vec :i64))) (bsl (ref (vec :i64))) (bctl (ref (vec :i64))) (id :i64) (expected :i64) (out (ref (vec :i64))))
  (if (not (= (check-count nodes id) 3))
    (ret (check-fail-at nodes ntexts id 102 "if takes a condition, a then and an else"))
    (check-nothing))
  (let cond :i64 (check-child nodes id 0))
  (let titem :i64 (check-child nodes id 1))
  (let eitem :i64 (check-child nodes id 2))
  (let bty :i64 (body-prim-ty tags names elem extra pbase powner "bool"))
  (letmut one
    (vec :i64)
    (make (vec :i64)))
  (vec-push one -1)
  (letmut err check-error (body-value nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl cond bty id one))
  (if (and (check-ok err)
        (not (body-fits tags names elem extra pbase powner ptypes bty (vec-get one 0))))
    (set err (check-fail-at nodes ntexts
               (body-at nodes cond id) 100
               (str-concat "condition must be :bool, found " (body-type-text tags names elem extra pbase ptypes (vec-get one 0)))))
    (check-nothing))
  (letmut snap
    (vec :i64)
    (make (vec :i64)))
  (body-snapshot bv bk bvl snap)
  (let n0 :i64 (vec-len bv))
  (letmut mv
    (vec :i64)
    (make (vec :i64)))
  (body-flags mv n0)
  (if (check-ok err)
    (set err (body-branch nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl snap mv n0 titem expected id one))
    (check-nothing))
  (letmut tty :i64 (body-unknown))
  (if (check-ok err)
    (set tty (vec-get one 0))
    (check-nothing))
  (if (check-ok err)
    (set err (body-branch nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl snap mv n0 eitem expected id one))
    (check-nothing))
  (letmut ety :i64 (body-unknown))
  (if (check-ok err)
    (set ety (vec-get one 0))
    (check-nothing))
  (body-restore bv bvl snap)
  (body-union-moved bv mv n0)
  (if (and (check-ok err)
        (not (body-fits tags names elem extra pbase powner ptypes tty ety)))
    (set err (check-fail-at nodes ntexts
               (body-at nodes eitem id) 100
               (str-concat "if branches do not match: " (str-concat (body-type-text tags names elem extra pbase ptypes tty)
                                                          (str-concat " and " (body-type-text tags names elem extra pbase ptypes ety))))))
    (check-nothing))
  (vec-free snap)
  (vec-free mv)
  (vec-free one)
  (ret (if (check-ok err)
         (body-store out tty) err)))

(fn body-while check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (bn (ref (vec :i64))) (bt (ref (vec :i64))) (bm (ref (vec :i64))) (bv (ref (vec :i64))) (bu (ref (vec :i64))) (bd (ref (vec :i64))) (br (ref (vec :i64))) (bl (ref (vec :str))) (bk (ref (vec :str))) (bvl (ref (vec :i64))) (bsl (ref (vec :i64))) (bctl (ref (vec :i64))) (id :i64) (out (ref (vec :i64))))
  (if (< (check-count nodes id) 1)
    (ret (check-fail-at nodes ntexts id 102 "while takes a condition and an optional body"))
    (check-nothing))
  (let cond :i64 (check-child nodes id 0))
  (let bty :i64 (body-prim-ty tags names elem extra pbase powner "bool"))
  (vec-set bctl 1 (+ (vec-get bctl 1) 1))
  (letmut one
    (vec :i64)
    (make (vec :i64)))
  (vec-push one -1)
  (letmut err check-error (body-value nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl cond bty id one))
  (if (and (check-ok err)
        (not (body-fits tags names elem extra pbase powner ptypes bty (vec-get one 0))))
    (set err (check-fail-at nodes ntexts
               (body-at nodes cond id) 100
               (str-concat "condition must be :bool, found " (body-type-text tags names elem extra pbase ptypes (vec-get one 0)))))
    (check-nothing))
  (letmut snap
    (vec :i64)
    (make (vec :i64)))
  (body-snapshot bv bk bvl snap)
  (let n0 :i64 (vec-len bv))
  (letmut mv
    (vec :i64)
    (make (vec :i64)))
  (body-flags mv n0)
  (body-restore bv bvl snap)
  (if (check-ok err)
    (set err (body-block nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl
               (check-child nodes id 1)
               (- (check-count nodes id) 1) id))
    (check-nothing))
  (if (check-ok err)
    (body-mark-moved bv mv n0)
    (check-nothing))
  (body-restore bv bvl snap)
  (body-union-moved bv mv n0)
  (vec-set bctl 1 (- (vec-get bctl 1) 1))
  (vec-free snap)
  (vec-free mv)
  (vec-free one)
  (ret (if (check-ok err)
         (body-store out (body-prim-ty tags names elem extra pbase powner "void")) err)))

(fn body-loop-jump check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (bn (ref (vec :i64))) (bt (ref (vec :i64))) (bm (ref (vec :i64))) (bv (ref (vec :i64))) (bu (ref (vec :i64))) (bd (ref (vec :i64))) (br (ref (vec :i64))) (bl (ref (vec :str))) (bk (ref (vec :str))) (bvl (ref (vec :i64))) (bsl (ref (vec :i64))) (bctl (ref (vec :i64))) (id :i64) (out (ref (vec :i64))))
  (let kind :str (body-text nodes ntexts id))
  (if (not (= (check-count nodes id) 0))
    (ret (check-fail-at nodes ntexts id 102 (str-concat "'" (str-concat kind "' takes no operands"))))
    (check-nothing))
  (if (= (vec-get bctl 1) 0)
    (ret (check-fail-at nodes ntexts id 2 (str-concat "'" (str-concat kind "' outside a loop"))))
    (check-nothing))
  (ret (body-store out (body-prim-ty tags names elem extra pbase powner "void"))))

(fn body-logical check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (bn (ref (vec :i64))) (bt (ref (vec :i64))) (bm (ref (vec :i64))) (bv (ref (vec :i64))) (bu (ref (vec :i64))) (bd (ref (vec :i64))) (br (ref (vec :i64))) (bl (ref (vec :str))) (bk (ref (vec :str))) (bvl (ref (vec :i64))) (bsl (ref (vec :i64))) (bctl (ref (vec :i64))) (id :i64) (out (ref (vec :i64))))
  (let kind :str (body-text nodes ntexts id))
  (if (not (= (check-count nodes id) 2))
    (ret (check-fail-at nodes ntexts id 102 (str-concat "'" (str-concat kind "' takes two operands"))))
    (check-nothing))
  (let bty :i64 (body-prim-ty tags names elem extra pbase powner "bool"))
  (letmut one
    (vec :i64)
    (make (vec :i64)))
  (vec-push one -1)
  (letmut c :i64 (check-child nodes id 0))
  (letmut err check-error (check-pass))
  (while (and (check-ok err)
           (not (= c -1)))
    (set err (body-value nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl c bty id one))
    (if (and (check-ok err)
          (not (body-fits tags names elem extra pbase powner ptypes bty (vec-get one 0))))
      (set err (check-fail-at nodes ntexts
                 (body-at nodes c id) 100
                 (str-concat "'" (str-concat kind (str-concat "' needs :bool operands, found " (body-type-text tags names elem extra pbase ptypes (vec-get one 0)))))))
      (check-nothing))
    (set c (if (= c -1) -1
             (get (vec-get nodes c) next))))
  (vec-free one)
  (ret (if (check-ok err)
         (body-store out bty) err)))

(fn body-not check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (bn (ref (vec :i64))) (bt (ref (vec :i64))) (bm (ref (vec :i64))) (bv (ref (vec :i64))) (bu (ref (vec :i64))) (bd (ref (vec :i64))) (br (ref (vec :i64))) (bl (ref (vec :str))) (bk (ref (vec :str))) (bvl (ref (vec :i64))) (bsl (ref (vec :i64))) (bctl (ref (vec :i64))) (id :i64) (out (ref (vec :i64))))
  (if (not (= (check-count nodes id) 1))
    (ret (check-fail-at nodes ntexts id 102 "'not' takes one operand"))
    (check-nothing))
  (let bty :i64 (body-prim-ty tags names elem extra pbase powner "bool"))
  (letmut one
    (vec :i64)
    (make (vec :i64)))
  (vec-push one -1)
  (let c :i64 (check-child nodes id 0))
  (letmut err check-error (body-value nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl c bty id one))
  (if (and (check-ok err)
        (not (body-fits tags names elem extra pbase powner ptypes bty (vec-get one 0))))
    (set err (check-fail-at nodes ntexts
               (body-at nodes c id) 100
               (str-concat "'not' needs a :bool operand, found " (body-type-text tags names elem extra pbase ptypes (vec-get one 0)))))
    (check-nothing))
  (vec-free one)
  (ret (if (check-ok err)
         (body-store out bty) err)))

(fn body-terminates :bool ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (id :i64))
  (if (< id 0)
    (ret false)
    (check-nothing))
  (if (not (= (get (vec-get nodes id) tok) -1))
    (ret false)
    (check-nothing))
  (let kind :str (body-text nodes ntexts id))
  (if (str-eq kind "ret")
    (ret true)
    (check-nothing))
  (if (and (str-eq kind "if")
        (= (check-count nodes id) 3))
    (ret (and (body-terminates nodes ntexts (check-child nodes id 1))
           (body-terminates nodes ntexts (check-child nodes id 2))))
    (check-nothing))
  (if (str-eq kind "match")
    (ret (body-arms-terminate nodes ntexts (check-child nodes id 1)))
    (check-nothing))
  (if (and (str-eq kind "while")
        (>= (check-count nodes id) 1))
    (if (body-true-cond? nodes ntexts (check-child nodes id 0))
      (ret (not (body-breaks-out nodes ntexts (check-child nodes id 1))))
      (check-nothing))
    (check-nothing))
  (ret false))

(fn body-arms-terminate :bool ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (first :i64))
  (letmut c :i64 first)
  (letmut n :i64 0)
  (letmut all :bool true)
  (while (not (= c -1))
    (if (> (check-count nodes c) 0)
      (if (not (body-terminates nodes ntexts (check-child nodes c (- (check-count nodes c) 1))))
        (set all false)
        (check-nothing))
      (set all false))
    (set n (+ n 1))
    (set c (if (= c -1) -1
             (get (vec-get nodes c) next))))
  (ret (and (> n 0) all)))

(fn body-true-cond? :bool ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (id :i64))
  (if (< id 0)
    (ret false)
    (check-nothing))
  (if (not (= (get (vec-get nodes id) tok) 2))
    (ret false)
    (check-nothing))
  (ret (str-eq (body-text nodes ntexts id) "true")))

(fn body-breaks-out :bool ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (first :i64))
  (letmut c :i64 first)
  (letmut found :bool false)
  (while (and (not found)
           (not (= c -1)))
    (if (= (get (vec-get nodes c) tok) -1)
      (set found (body-breaks-in nodes ntexts c))
      (check-nothing))
    (set c (if (= c -1) -1
             (get (vec-get nodes c) next))))
  (ret found))

(fn body-breaks-in :bool ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (id :i64))
  (let kind :str (body-text nodes ntexts id))
  (if (str-eq kind "break")
    (ret true)
    (check-nothing))
  (if (str-eq kind "while")
    (ret false)
    (check-nothing))
  (ret (body-breaks-out nodes ntexts (check-child nodes id 0))))

(fn body-any-terminates :bool ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (first :i64))
  (letmut c :i64 first)
  (letmut found :bool false)
  (while (and (not found)
           (not (= c -1)))
    (set found (body-terminates nodes ntexts c))
    (set c (if (= c -1) -1
             (get (vec-get nodes c) next))))
  (ret found))

(fn body-family :i64 ((tags (ref (vec :i64))) (ty :i64))
  (if (= ty (body-unknown))
    (ret 3)
    (check-nothing))
  (if (< ty 0)
    (ret 3)
    (check-nothing))
  (if (= (type-tag tags ty)
        (type-tag-enum))
    (ret 0)
    (check-nothing))
  (if (= (type-tag tags ty)
        (type-tag-res))
    (ret 1)
    (check-nothing))
  (if (= (type-tag tags ty)
        (type-tag-opt))
    (ret 2)
    (check-nothing))
  (ret -4))

(fn body-match check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (bn (ref (vec :i64))) (bt (ref (vec :i64))) (bm (ref (vec :i64))) (bv (ref (vec :i64))) (bu (ref (vec :i64))) (bd (ref (vec :i64))) (br (ref (vec :i64))) (bl (ref (vec :str))) (bk (ref (vec :str))) (bvl (ref (vec :i64))) (bsl (ref (vec :i64))) (bctl (ref (vec :i64))) (id :i64) (expected :i64) (out (ref (vec :i64))))
  (letmut err check-error (body-match-spine nodes ntexts id))
  (letmut one
    (vec :i64)
    (make (vec :i64)))
  (vec-push one -1)
  (let scrut :i64 (if (check-ok err)
                    (check-child nodes id 0) -1))
  (if (check-ok err)
    (set err (body-value nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl scrut (body-unknown) id one))
    (check-nothing))
  (letmut ty :i64 (body-unknown))
  (if (check-ok err)
    (set ty (vec-get one 0))
    (check-nothing))
  (letmut family :i64 -1)
  (if (check-ok err)
    (if (body-int-ty? tags names ty)
      (set family -1)
      (set family (body-family tags ty)))
    (check-nothing))
  (if (and (check-ok err)
        (= family -4))
    (set err (check-fail-at nodes ntexts id 100 (str-concat "'match' needs an integer, an enum, a result or an optional, found " (body-type-text tags names elem extra pbase ptypes ty))))
    (check-nothing))
  (letmut abind
    (vec :i64)
    (make (vec :i64)))
  (letmut abnm
    (vec :str)
    (make (vec :str)))
  (letmut aty
    (vec :i64)
    (make (vec :i64)))
  (letmut aat
    (vec :i64)
    (make (vec :i64)))
  (letmut abid
    (vec :i64)
    (make (vec :i64)))
  (letmut seen
    (vec :str)
    (make (vec :str)))
  (letmut o
    (vec :i64)
    (make (vec :i64)))
  (vec-push o 0)
  (vec-push o -1)
  (vec-push o -1)
  (vec-push o 0)
  (vec-push o -1)
  (letmut os
    (vec :str)
    (make (vec :str)))
  (vec-push os "")
  (vec-push os "")
  (letmut wild :i64 0)
  (letmut c :i64 (check-child nodes id 1))
  (while (and (check-ok err)
           (not (= c -1)))
    (vec-set o 0 0)
    (vec-set o 1 -1)
    (vec-set o 2 -1)
    (vec-set o 3 0)
    (vec-set o 4 -1)
    (vec-set os 0 "")
    (vec-set os 1 "")
    (if (= family -1)
      (set err (body-pat-int nodes ntexts tags names elem extra pbase powner ptypes id c ty))
      (if (= family 3)
        (check-nothing)
        (set err (body-pat-var nodes ntexts tags names elem extra pbase pchild pvname id c ty family o os))))
    (if (and (check-ok err)
          (= (vec-get o 3) 1))
      (if (check-in seen (vec-get os 0))
        (set err (check-fail-at nodes ntexts
                   (vec-get o 2) 2
                   (str-concat "an arm for '" (str-concat (vec-get os 0) "' can never match"))))
        (vec-push seen (vec-get os 0)))
      (check-nothing))
    (vec-push abind (vec-get o 0))
    (vec-push abnm (vec-get os 1))
    (vec-push aty (vec-get o 1))
    (vec-push aat (vec-get o 2))
    (vec-push abid (vec-get o 4))
    (if (body-wild? nodes ntexts c)
      (set wild 1)
      (check-nothing))
    (set c (if (= c -1) -1
             (get (vec-get nodes c) next))))
  (if (and (check-ok err)
        (and (>= family 0)
          (<= family 2)))
    (if (= wild 0)
      (set err (body-exhaust nodes ntexts tags names elem extra pbase pvname ptypes id ty family seen))
      (check-nothing))
    (check-nothing))
  (letmut res :i64 (body-unknown))
  (letmut have :i64 0)
  (letmut snap
    (vec :i64)
    (make (vec :i64)))
  (body-snapshot bv bk bvl snap)
  (let n0 :i64 (vec-len bv))
  (letmut mv
    (vec :i64)
    (make (vec :i64)))
  (body-flags mv n0)
  (set c (check-child nodes id 1))
  (letmut i :i64 0)
  (while (and (check-ok err)
           (not (= c -1)))
    (let sit :i64 (body-arm-start nodes c))
    (let nitems :i64 (body-arm-n nodes c))
    (body-restore bv bvl snap)
    (set err (body-arm-run nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl sit nitems
               (vec-get abind i)
               (vec-get abnm i)
               (vec-get abid i)
               (vec-get aty i)
               (vec-get aat i) expected id one))
    (if (and (check-ok err)
          (= have 0))
      (set res (vec-get one 0))
      (check-nothing))
    (if (and (check-ok err)
          (= have 1))
      (if (not (body-fits tags names elem extra pbase powner ptypes res (vec-get one 0)))
        (set err (check-fail-at nodes ntexts id 100 (str-concat "match arms do not agree: " (str-concat (body-type-text tags names elem extra pbase ptypes res)
                                                                                              (str-concat " and " (body-type-text tags names elem extra pbase ptypes (vec-get one 0)))))))
        (check-nothing))
      (check-nothing))
    (if (check-ok err)
      (set have 1)
      (check-nothing))
    (if (check-ok err)
      (body-mark-moved bv mv n0)
      (check-nothing))
    (set i (+ i 1))
    (set c (if (= c -1) -1
             (get (vec-get nodes c) next))))
  (body-restore bv bvl snap)
  (body-union-moved bv mv n0)
  (vec-free snap)
  (vec-free mv)
  (vec-free abind)
  (vec-free abnm)
  (vec-free aty)
  (vec-free aat)
  (vec-free abid)
  (vec-free seen)
  (vec-free o)
  (vec-free os)
  (vec-free one)
  (ret (if (check-ok err)
         (body-store out res) err)))

(fn body-statement check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (bn (ref (vec :i64))) (bt (ref (vec :i64))) (bm (ref (vec :i64))) (bv (ref (vec :i64))) (bu (ref (vec :i64))) (bd (ref (vec :i64))) (br (ref (vec :i64))) (bl (ref (vec :str))) (bk (ref (vec :str))) (bvl (ref (vec :i64))) (bsl (ref (vec :i64))) (bctl (ref (vec :i64))) (id :i64))
  (letmut one
    (vec :i64)
    (make (vec :i64)))
  (vec-push one -1)
  (letmut err check-error (body-expr nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl id (body-unknown) one))
  (vec-free one)
  (ret err))

(fn body-statements check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (bn (ref (vec :i64))) (bt (ref (vec :i64))) (bm (ref (vec :i64))) (bv (ref (vec :i64))) (bu (ref (vec :i64))) (bd (ref (vec :i64))) (br (ref (vec :i64))) (bl (ref (vec :str))) (bk (ref (vec :str))) (bvl (ref (vec :i64))) (bsl (ref (vec :i64))) (bctl (ref (vec :i64))) (start :i64) (owner :i64))
  (letmut err check-error (body-walk nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl start (body-list-count nodes start) owner))
  (if (and (check-ok err)
        (not (body-void-ty? tags names (vec-get br 0))))
    (if (not (body-any-terminates nodes ntexts start))
      (set err (check-fail-at nodes ntexts owner 105 (str-concat (vec-get bl 0)
                                                       (str-concat " must return " (str-concat (body-type-text tags names elem extra pbase ptypes (vec-get br 0)) " but a path falls off the end")))))
      (check-nothing))
    (check-nothing))
  (ret err))

(fn check-body-fn check-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (pvname (ref (vec :str))) (c :i64) (fnty :i64) (fname :str))
  (letmut bn
    (vec :i64)
    (make (vec :i64)))
  (letmut bt
    (vec :i64)
    (make (vec :i64)))
  (letmut bm
    (vec :i64)
    (make (vec :i64)))
  (letmut bv
    (vec :i64)
    (make (vec :i64)))
  (letmut bu
    (vec :i64)
    (make (vec :i64)))
  (letmut bd
    (vec :i64)
    (make (vec :i64)))
  (letmut br
    (vec :i64)
    (make (vec :i64)))
  (letmut bl
    (vec :str)
    (make (vec :str)))
  (letmut bk
    (vec :str)
    (make (vec :str)))
  (letmut bvl
    (vec :i64)
    (make (vec :i64)))
  (letmut bsl
    (vec :i64)
    (make (vec :i64)))
  (letmut bctl
    (vec :i64)
    (make (vec :i64)))
  (vec-push bctl 0)
  (vec-push bctl 0)
  (vec-push br (vec-get elem fnty))
  (vec-push bl (str-concat "function '" (str-concat fname "'")))
  (let c0 :i64 (get (vec-get nodes c) first))
  (let marker :bool (check-is-marker nodes ntexts c0))
  (let params :i64 (if marker
                     (check-child nodes c 2)
                     (check-child nodes c 1)))
  (let body :i64 (if marker
                   (check-child nodes c 3)
                   (check-child nodes c 2)))
  (letmut err check-error (check-pass))
  (letmut p :i64 (if (< params 0) -1
                   (get (vec-get nodes params) first)))
  (letmut i :i64 0)
  (while (and (check-ok err)
           (not (= p -1)))
    (let pname :str (body-text nodes ntexts p))
    (let pid :i64 (get (vec-get nodes p) text))
    (let pty :i64 (type-param-type ptypes pbase fnty i))
    (set err (body-bind nodes ntexts bn bt bm bv bu bd bk bvl bsl pname pid pty 0 0 p))
    (set i (+ i 1))
    (set p (if (= p -1) -1
             (get (vec-get nodes p) next))))
  (if (check-ok err)
    (set err (body-statements nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes pchild pvname bn bt bm bv bu bd br bl bk bvl bsl bctl body c))
    (check-nothing))
  (vec-free bn)
  (vec-free bt)
  (vec-free bm)
  (vec-free bv)
  (vec-free bu)
  (vec-free bd)
  (vec-free br)
  (vec-free bl)
  (vec-free bk)
  (vec-free bvl)
  (vec-free bsl)
  (vec-free bctl)
  (ret err))
