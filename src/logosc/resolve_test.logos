  (dump-src "(fn f :i64 () (ret 0))"))

(test nameless-module
  (expect (out "E0002\n0\nmod needs a name\n")
    (code 0)
    (leaks 0))
  (dump-src "(mod)\n(fn f :i64 () (ret 0))"))

(test extern-spelling
  (expect (out "E0002\nm/0\nextern needs (extern fn name :ret ((p :type) ...))\n")
    (code 0)
    (leaks 0))
  (dump-src "(mod m)\n(extern get :i64 ())"))

(test body-ignored
  (expect (out "OK\n")
    (code 0)
    (leaks 0))
  (dump-src "(mod m)\n(fn f :i64 () (println 1))"))

