(mod types-test)

(use lex)

(use tree)

(use types)

(fn t-free :void ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pattrs (ref (vec :i64))) (pchild (ref (vec :i64))) (powner (ref (vec :str))) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))) (nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (slot (ref (vec :i64))) (out (ref (vec :str))) (vout (ref (vec :str))) (bnames (ref (vec :str))) (btypes (ref (vec :i64))))
  (vec-free tags)
  (vec-free names)
  (vec-free elem)
  (vec-free extra)
  (vec-free pbase)
  (vec-free pnames)
  (vec-free ptypes)
  (vec-free pattrs)
  (vec-free pchild)
  (vec-free powner)
  (vec-free kinds)
  (vec-free texts)
  (vec-free lines)
  (vec-free cols)
  (vec-free nodes)
  (vec-free ntexts)
  (vec-free dnames)
  (vec-free dids)
  (vec-free slot)
  (vec-free out)
  (vec-free vout)
  (vec-free bnames)
  (vec-free btypes)
  (ret))

(fn t-diag :str ((e type-error))
  (ret (str-concat (type-code (get e code))
         (str-concat " " (get e message)))))

(fn t-join :str ((parts (ref (vec :str))))
  (letmut whole :str "")
  (letmut i :i64 0)
  (while (< i (vec-len parts))
    (set whole (str-concat whole (str-concat (if (= i 0) "" ",")
                                   (vec-get parts i))))
    (set i (+ i 1)))
  (ret whole))

(fn t-tree type-error ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pattrs (ref (vec :i64))) (pchild (ref (vec :i64))) (powner (ref (vec :str))) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))) (nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (slot (ref (vec :i64))) (out (ref (vec :str))) (vout (ref (vec :str))) (bnames (ref (vec :str))) (btypes (ref (vec :i64))))
  (if (> (vec-len nodes) 0)
    (ret (type-pass))
    (type-nothing))
  (let t tree-error (tree-parse kinds texts lines cols nodes ntexts))
  (ret (if (tree-ok t)
         (type-pass)
         (type-fail 1 "" (str-concat "E0001 " (get t msg))))))

(fn t-form :i64 ((nodes (ref (vec node))) (k :i64))
  (letmut f :i64 (get (vec-get nodes 0) first))
  (letmut i :i64 1)
  (while (and (< i k)
           (not (= f -1)))
    (set f (get (vec-get nodes f) next))
    (set i (+ i 1)))
  (ret f))

(fn t-item :i64 ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (k :i64))
  (let form :i64 (t-form nodes k))
  (let c2 :i64 (type-nth nodes form 1))
  (ret (if (and (= (get (vec-get nodes c2) tok) 2)
             (str-eq (type-node-text nodes ntexts c2) ":"))
         (type-nth nodes form 2) c2)))

(fn t-parse type-error ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pattrs (ref (vec :i64))) (pchild (ref (vec :i64))) (powner (ref (vec :str))) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))) (nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (slot (ref (vec :i64))) (out (ref (vec :str))) (vout (ref (vec :str))) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (k :i64))
  (letmut e type-error (t-tree tags names elem extra pbase pnames ptypes pattrs pchild powner kinds texts lines cols nodes ntexts dnames dids slot out vout bnames btypes))
  (if (not (type-ok e))
    (ret e)
    (type-nothing))
  (ret (type-parse nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes (t-item nodes ntexts k) slot)))

(fn t-diag-path :str ((e type-error))
  (ret (str-concat (type-code (get e code))
         (str-concat " " (str-concat (get e path)
                           (str-concat " " (get e message)))))))

(fn t-path :str ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pattrs (ref (vec :i64))) (pchild (ref (vec :i64))) (powner (ref (vec :str))) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))) (nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (slot (ref (vec :i64))) (out (ref (vec :str))) (vout (ref (vec :str))) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (k :i64))
  (letmut e type-error (t-tree tags names elem extra pbase pnames ptypes pattrs pchild powner kinds texts lines cols nodes ntexts dnames dids slot out vout bnames btypes))
  (if (not (type-ok e))
    (ret (t-diag e))
    (type-nothing))
  (set e (type-parse nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes (t-item nodes ntexts k) slot))
  (ret (if (type-ok e) "OK"
         (t-diag-path e))))

(fn t-deep :str ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pattrs (ref (vec :i64))) (pchild (ref (vec :i64))) (powner (ref (vec :str))) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))) (nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (slot (ref (vec :i64))) (out (ref (vec :str))) (vout (ref (vec :str))) (bnames (ref (vec :str))) (btypes (ref (vec :i64))))
  (letmut e type-error (t-tree tags names elem extra pbase pnames ptypes pattrs pchild powner kinds texts lines cols nodes ntexts dnames dids slot out vout bnames btypes))
  (if (not (type-ok e))
    (ret (t-diag e))
    (type-nothing))
  (let fn-id :i64 (t-form nodes 2))
  (let params :i64 (type-nth nodes fn-id 1))
  (let param :i64 (type-nth nodes params 0))
  (let ty :i64 (type-nth nodes param 0))
  (set e (type-parse nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes ty slot))
  (ret (if (type-ok e) "OK"
         (t-diag-path e))))

(fn t-push-row :void ((dnames (ref (vec :str))) (dids (ref (vec :i64))) (name :str) (id :i64))
  (vec-push dnames name)
  (vec-push dids id)
  (ret))

(fn t-declare :void ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pattrs (ref (vec :i64))) (pchild (ref (vec :i64))) (powner (ref (vec :str))) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))) (nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (slot (ref (vec :i64))) (out (ref (vec :str))) (vout (ref (vec :str))) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (table :str))
  (if (str-eq table "struct")
    (t-push-row dnames dids "point" (t-struct tags names elem extra pbase pnames ptypes pattrs pchild powner kinds texts lines cols nodes ntexts dnames dids slot out vout bnames btypes "m"))
    (type-nothing))
  (if (str-eq table "enum")
    (t-push-row dnames dids "parse-error" (t-enum tags names elem extra pbase pnames ptypes pattrs pchild powner kinds texts lines cols nodes ntexts dnames dids slot out vout bnames btypes "parse-error" "m"))
    (type-nothing))
  (ret))

(fn t-struct :i64 ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pattrs (ref (vec :i64))) (pchild (ref (vec :i64))) (powner (ref (vec :str))) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))) (nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (slot (ref (vec :i64))) (out (ref (vec :str))) (vout (ref (vec :str))) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (owner :str))
  (let start :i64 (type-field-start pchild))
  (vec-push ntexts "x")
  (type-field pattrs pchild
    (- (vec-len ntexts) 1)
    (type-prim tags names elem extra pbase powner "i64"))
  (vec-push ntexts "y")
  (type-field pattrs pchild
    (- (vec-len ntexts) 1)
    (type-prim tags names elem extra pbase powner "i64"))
  (ret (type-struct tags names elem extra pbase powner "point" owner start 2)))

(fn t-enum :i64 ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pattrs (ref (vec :i64))) (pchild (ref (vec :i64))) (powner (ref (vec :str))) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))) (nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (slot (ref (vec :i64))) (out (ref (vec :str))) (vout (ref (vec :str))) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (name :str) (owner :str))
  (let start :i64 (type-field-start pchild))
  (vec-push ntexts "ok")
  (type-field pattrs pchild
    (- (vec-len ntexts) 1)
    (type-prim tags names elem extra pbase powner "i64"))
  (vec-push ntexts "bad")
  (type-field pattrs pchild (- (vec-len ntexts) 1) -1)
  (ret (type-enum tags names elem extra pbase powner name owner start 2)))

(fn t-spell-of :str ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pattrs (ref (vec :i64))) (pchild (ref (vec :i64))) (powner (ref (vec :str))) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))) (nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (slot (ref (vec :i64))) (out (ref (vec :str))) (vout (ref (vec :str))) (bnames (ref (vec :str))) (btypes (ref (vec :i64))))
  (letmut m type-error (type-mangle tags names elem extra pbase ptypes (vec-get slot 0) "" out))
  (ret (if (type-ok m)
         (vec-get out 0)
         (t-diag m))))

(fn t-body-spell :str ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pattrs (ref (vec :i64))) (pchild (ref (vec :i64))) (powner (ref (vec :str))) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))) (nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (slot (ref (vec :i64))) (out (ref (vec :str))) (vout (ref (vec :str))) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (a :str) (b :str))
  (letmut e type-error (t-parse tags names elem extra pbase pnames ptypes pattrs pchild powner kinds texts lines cols nodes ntexts dnames dids slot out vout bnames btypes 1))
  (ret (if (not (type-ok e))
         (t-diag e)
         (t-spell-of tags names elem extra pbase pnames ptypes pattrs pchild powner kinds texts lines cols nodes ntexts dnames dids slot out vout bnames btypes))))

(fn t-body-table :str ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pattrs (ref (vec :i64))) (pchild (ref (vec :i64))) (powner (ref (vec :str))) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))) (nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (slot (ref (vec :i64))) (out (ref (vec :str))) (vout (ref (vec :str))) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (table :str) (table2 :str))
  (t-declare tags names elem extra pbase pnames ptypes pattrs pchild powner kinds texts lines cols nodes ntexts dnames dids slot out vout bnames btypes table)
  (ret (t-body-spell tags names elem extra pbase pnames ptypes pattrs pchild powner kinds texts lines cols nodes ntexts dnames dids slot out vout bnames btypes table table2)))

(fn t-body-compat :str ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pattrs (ref (vec :i64))) (pchild (ref (vec :i64))) (powner (ref (vec :str))) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))) (nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (slot (ref (vec :i64))) (out (ref (vec :str))) (vout (ref (vec :str))) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (a :str) (b :str))
  (letmut e type-error (t-parse tags names elem extra pbase pnames ptypes pattrs pchild powner kinds texts lines cols nodes ntexts dnames dids slot out vout bnames btypes 1))
  (if (not (type-ok e))
    (ret (t-diag e))
    (type-nothing))
  (let left :i64 (vec-get slot 0))
  (vec-set slot 0 -1)
  (set e (t-parse tags names elem extra pbase pnames ptypes pattrs pchild powner kinds texts lines cols nodes ntexts dnames dids slot out vout bnames btypes 2))
  (if (not (type-ok e))
    (ret (t-diag e))
    (type-nothing))
  (ret (if (type-compatible tags names powner elem extra pbase ptypes left (vec-get slot 0)) "true" "false")))

(fn t-body-subst :str ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pattrs (ref (vec :i64))) (pchild (ref (vec :i64))) (powner (ref (vec :str))) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))) (nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (slot (ref (vec :i64))) (out (ref (vec :str))) (vout (ref (vec :str))) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (a :str) (b :str))
  (letmut e type-error (t-parse tags names elem extra pbase pnames ptypes pattrs pchild powner kinds texts lines cols nodes ntexts dnames dids slot out vout bnames btypes 1))
  (if (not (type-ok e))
    (ret (t-diag e))
    (type-nothing))
  (let ty :i64 (vec-get slot 0))
  (vec-set slot 0 -1)
  (set e (t-parse tags names elem extra pbase pnames ptypes pattrs pchild powner kinds texts lines cols nodes ntexts dnames dids slot out vout bnames btypes 2))
  (if (not (type-ok e))
    (ret (t-diag e))
    (type-nothing))
  (vec-push bnames a)
  (vec-push btypes (vec-get slot 0))
  (vec-set slot 0 (type-substitute tags names elem extra pbase powner pnames ptypes bnames btypes ty))
  (ret (t-spell-of tags names elem extra pbase pnames ptypes pattrs pchild powner kinds texts lines cols nodes ntexts dnames dids slot out vout bnames btypes)))

(fn t-body-vars :str ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pattrs (ref (vec :i64))) (pchild (ref (vec :i64))) (powner (ref (vec :str))) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))) (nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (slot (ref (vec :i64))) (out (ref (vec :str))) (vout (ref (vec :str))) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (a :str) (b :str))
  (letmut e type-error (t-parse tags names elem extra pbase pnames ptypes pattrs pchild powner kinds texts lines cols nodes ntexts dnames dids slot out vout bnames btypes 1))
  (if (not (type-ok e))
    (ret (t-diag e))
    (type-nothing))
  (type-variables tags names elem extra pbase ptypes (vec-get slot 0) vout)
  (ret (t-join vout)))

(fn t-body-has :str ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pattrs (ref (vec :i64))) (pchild (ref (vec :i64))) (powner (ref (vec :str))) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))) (nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (slot (ref (vec :i64))) (out (ref (vec :str))) (vout (ref (vec :str))) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (a :str) (b :str))
  (letmut e type-error (t-parse tags names elem extra pbase pnames ptypes pattrs pchild powner kinds texts lines cols nodes ntexts dnames dids slot out vout bnames btypes 1))
  (ret (if (not (type-ok e))
         (t-diag e)
         (if (type-has-var tags names elem extra pbase ptypes (vec-get slot 0)) "true" "false"))))

(fn t-body-mangle-error :str ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pattrs (ref (vec :i64))) (pchild (ref (vec :i64))) (powner (ref (vec :str))) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))) (nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (slot (ref (vec :i64))) (out (ref (vec :str))) (vout (ref (vec :str))) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (a :str) (b :str))
  (letmut e type-error (t-parse tags names elem extra pbase pnames ptypes pattrs pchild powner kinds texts lines cols nodes ntexts dnames dids slot out vout bnames btypes 1))
  (ret (if (not (type-ok e))
         (t-diag e)
         (t-spell-of tags names elem extra pbase pnames ptypes pattrs pchild powner kinds texts lines cols nodes ntexts dnames dids slot out vout bnames btypes))))

(fn t-body-parse-error :str ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pattrs (ref (vec :i64))) (pchild (ref (vec :i64))) (powner (ref (vec :str))) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))) (nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (slot (ref (vec :i64))) (out (ref (vec :str))) (vout (ref (vec :str))) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (a :str) (b :str))
  (letmut e type-error (t-parse tags names elem extra pbase pnames ptypes pattrs pchild powner kinds texts lines cols nodes ntexts dnames dids slot out vout bnames btypes 1))
  (ret (if (type-ok e) "OK"
         (t-diag e))))

(fn t-body-path :str ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pattrs (ref (vec :i64))) (pchild (ref (vec :i64))) (powner (ref (vec :str))) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))) (nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (slot (ref (vec :i64))) (out (ref (vec :str))) (vout (ref (vec :str))) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (a :str) (b :str))
  (letmut e type-error (t-parse tags names elem extra pbase pnames ptypes pattrs pchild powner kinds texts lines cols nodes ntexts dnames dids slot out vout bnames btypes 1))
  (ret (if (type-ok e) "OK"
         (t-diag-path e))))

(fn t-body-text :str ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (pattrs (ref (vec :i64))) (pchild (ref (vec :i64))) (powner (ref (vec :str))) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))) (nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (slot (ref (vec :i64))) (out (ref (vec :str))) (vout (ref (vec :str))) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (a :str) (b :str))
  (letmut e type-error (t-parse tags names elem extra pbase pnames ptypes pattrs pchild powner kinds texts lines cols nodes ntexts dnames dids slot out vout bnames btypes 1))
  (ret (if (not (type-ok e))
