(mod types)

(use tree)

(type type-error (struct (failed :bool) (code :i64) (path :str) (message :str)))

(fn type-pass type-error ()
  (ret (make type-error false 0 "" "")))

(fn type-fail type-error ((code :i64) (path :str) (message :str))
  (ret (make type-error true code path message)))

(fn type-ok :bool ((e type-error))
  (ret (not (get e failed))))

(fn type-code :str ((n :i64))
  (ret (str-concat "E0" (str-concat (if (< n 10) "00"
                                      (if (< n 100) "0" ""))
                          (str-from-i64 n)))))

(fn type-nothing :void ()
  (ret))

(fn type-tag-prim :i64 ()
  (ret 0))

(fn type-tag-ptr :i64 ()
  (ret 1))

(fn type-tag-own :i64 ()
  (ret 2))

(fn type-tag-arr :i64 ()
  (ret 3))

(fn type-tag-vec :i64 ()
  (ret 4))

(fn type-tag-ref :i64 ()
  (ret 5))

(fn type-tag-res :i64 ()
  (ret 6))

(fn type-tag-opt :i64 ()
  (ret 7))

(fn type-tag-fn :i64 ()
  (ret 8))

(fn type-tag-shared :i64 ()
  (ret 9))

(fn type-tag-chan :i64 ()
  (ret 10))

(fn type-tag-atomic :i64 ()
  (ret 11))

(fn type-tag-struct :i64 ()
  (ret 12))

(fn type-tag-enum :i64 ()
  (ret 13))

(fn type-tag-var :i64 ()
  (ret 14))

(fn type-add :i64 ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (tag :i64) (name :str) (first :i64) (second :i64) (base :i64))
  (vec-push tags tag)
  (vec-push names name)
  (vec-push elem first)
  (vec-push extra second)
  (vec-push pbase base)
  (vec-push powner "")
  (ret (- (vec-len tags) 1)))

(fn type-prim :i64 ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (name :str))
  (ret (type-add tags names elem extra pbase powner (type-tag-prim) name -1 -1 -1)))

(fn type-ptr :i64 ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (child :i64))
  (ret (type-add tags names elem extra pbase powner (type-tag-ptr) "" child -1 -1)))

(fn type-own :i64 ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (child :i64))
  (ret (type-add tags names elem extra pbase powner (type-tag-own) "" child -1 -1)))

(fn type-vec :i64 ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (child :i64))
  (ret (type-add tags names elem extra pbase powner (type-tag-vec) "" child -1 -1)))

(fn type-ref :i64 ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (child :i64))
  (ret (type-add tags names elem extra pbase powner (type-tag-ref) "" child -1 -1)))

(fn type-opt :i64 ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (child :i64))
  (ret (type-add tags names elem extra pbase powner (type-tag-opt) "" child -1 -1)))

(fn type-shared :i64 ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (child :i64))
  (ret (type-add tags names elem extra pbase powner (type-tag-shared) "" child -1 -1)))

(fn type-chan :i64 ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (child :i64))
  (ret (type-add tags names elem extra pbase powner (type-tag-chan) "" child -1 -1)))

(fn type-atomic :i64 ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (child :i64))
  (ret (type-add tags names elem extra pbase powner (type-tag-atomic) "" child -1 -1)))

(fn type-arr :i64 ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (child :i64) (count :i64))
  (ret (type-add tags names elem extra pbase powner (type-tag-arr) "" child count -1)))

(fn type-res :i64 ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (ok :i64) (err :i64))
  (ret (type-add tags names elem extra pbase powner (type-tag-res) "" ok err -1)))

(fn type-fn :i64 ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (head :str) (ret :i64) (arity :i64) (base :i64))
  (ret (type-add tags names elem extra pbase powner
         (type-tag-fn) head ret arity
         (if (= arity 0) -1 base))))

(fn type-var :i64 ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (name :str))
  (ret (type-add tags names elem extra pbase powner (type-tag-var) name -1 -1 -1)))

(fn type-struct :i64 ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (name :str) (owner :str) (base :i64) (count :i64))
  (let id :i64 (type-add tags names elem extra pbase powner (type-tag-struct) name -1 count base))
  (vec-set powner id owner)
  (ret id))

(fn type-enum :i64 ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (name :str) (owner :str) (base :i64) (count :i64))
  (let id :i64 (type-add tags names elem extra pbase powner (type-tag-enum) name -1 count base))
  (vec-set powner id owner)
  (ret id))

(fn type-tag :i64 ((tags (ref (vec :i64))) (ty :i64))
  (ret (if (= ty -1) -1
         (vec-get tags ty))))

(fn type-name :str ((names (ref (vec :str))) (ty :i64))
  (ret (if (= ty -1) ""
         (vec-get names ty))))

(fn type-elem :i64 ((elem (ref (vec :i64))) (ty :i64))
  (ret (if (= ty -1) -1
         (vec-get elem ty))))

(fn type-extra :i64 ((extra (ref (vec :i64))) (ty :i64))
  (ret (if (= ty -1) -1
         (vec-get extra ty))))

(fn type-owner :str ((powner (ref (vec :str))) (ty :i64))
  (ret (if (= ty -1) ""
         (vec-get powner ty))))

(fn type-param-start :i64 ((ptypes (ref (vec :i64))))
  (ret (vec-len ptypes)))

(fn type-param :void ((pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (name :str) (ty :i64))
  (vec-push pnames name)
  (vec-push ptypes ty)
  (ret))

(fn type-params-append :void ((pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (tnames (ref (vec :str))) (ttypes (ref (vec :i64))))
  (letmut i :i64 0)
  (while (< i (vec-len tnames))
    (type-param pnames ptypes
      (vec-get tnames i)
      (vec-get ttypes i))
    (set i (+ i 1)))
  (ret))

(fn type-param-name :str ((pnames (ref (vec :str))) (pbase (ref (vec :i64))) (ty :i64) (i :i64))
  (ret (vec-get pnames (+ (vec-get pbase ty) i))))

(fn type-param-type :i64 ((ptypes (ref (vec :i64))) (pbase (ref (vec :i64))) (ty :i64) (i :i64))
  (ret (vec-get ptypes (+ (vec-get pbase ty) i))))

(fn type-field-start :i64 ((pchild (ref (vec :i64))))
  (ret (vec-len pchild)))

(fn type-field :void ((pattrs (ref (vec :i64))) (pchild (ref (vec :i64))) (name :i64) (ty :i64))
  (vec-push pattrs name)
  (vec-push pchild ty)
  (ret))

(fn type-field-name :str ((ntexts (ref (vec :str))) (pattrs (ref (vec :i64))) (pbase (ref (vec :i64))) (ty :i64) (i :i64))
  (ret (vec-get ntexts (vec-get pattrs (+ (vec-get pbase ty) i)))))

(fn type-field-type :i64 ((pchild (ref (vec :i64))) (pbase (ref (vec :i64))) (ty :i64) (i :i64))
  (ret (vec-get pchild (+ (vec-get pbase ty) i))))

(fn type-field-count :i64 ((extra (ref (vec :i64))) (ty :i64))
  (ret (if (= ty -1) 0
         (vec-get extra ty))))

(fn type-store :void ((out (ref (vec :str))) (s :str))
  (if (= (vec-len out) 0)
    (vec-push out s)
    (vec-set out 0 s))
  (ret))

(fn type-upper :bool ((s :str))
  (ret (and (= (str-len s) 1)
         (and (>= (cast :i64 (str-byte s 0)) 65)
           (<= (cast :i64 (str-byte s 0)) 90)))))

(fn type-digit :bool ((b :i64))
  (ret (and (>= b 48)
         (<= b 57))))

(fn type-digits :bool ((s :str))
  (letmut i :i64 0)
  (letmut ok :bool (> (str-len s) 0))
  (while (< i (str-len s))
    (set ok (and ok (type-digit (cast :i64 (str-byte s i)))))
    (set i (+ i 1)))
  (ret ok))

(fn type-colon :bool ((s :str))
  (ret (and (> (str-len s) 0)
         (= (cast :i64 (str-byte s 0)) 58))))

(fn type-primitive :bool ((name :str))
  (letmut all
    (vec :str)
    (make (vec :str)))
  (vec-push all "i8")
  (vec-push all "i16")
  (vec-push all "i32")
  (vec-push all "i64")
  (vec-push all "u8")
  (vec-push all "u16")
  (vec-push all "u32")
  (vec-push all "u64")
  (vec-push all "f32")
  (vec-push all "f64")
  (vec-push all "bool")
  (vec-push all "str")
  (vec-push all "void")
  (vec-push all "thread")
  (vec-push all "mutex")
  (vec-push all "run")
  (letmut i :i64 0)
  (letmut found :bool false)
  (while (< i (vec-len all))
    (set found (or found (str-eq (vec-get all i) name)))
    (set i (+ i 1)))
  (vec-free all)
  (ret found))

(fn type-nth :i64 ((nodes (ref (vec node))) (id :i64) (k :i64))
  (letmut c :i64 (get (vec-get nodes id) first))
  (letmut i :i64 0)
  (while (and (< i k)
           (not (= c -1)))
    (set c (get (vec-get nodes c) next))
    (set i (+ i 1)))
  (ret c))

(fn type-count :i64 ((nodes (ref (vec node))) (id :i64))
  (letmut c :i64 (get (vec-get nodes id) first))
  (letmut n :i64 0)
  (while (not (= c -1))
    (set n (+ n 1))
    (set c (get (vec-get nodes c) next)))
  (ret n))

(fn type-kind-text :str ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (id :i64))
  (let text :i64 (get (vec-get nodes id) text))
  (ret (if (= text -1) ""
         (vec-get ntexts text))))

(fn type-node-atom :bool ((nodes (ref (vec node))) (id :i64))
  (ret (and (not (= id -1))
         (= (get (vec-get nodes id) tok) 2))))

(fn type-node-text :str ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (id :i64))
  (ret (if (= id -1) ""
         (vec-get ntexts (get (vec-get nodes id) text)))))

(fn type-decl-find :i64 ((dnames (ref (vec :str))) (dids (ref (vec :i64))) (name :str))
  (letmut i :i64 0)
  (letmut found :i64 -1)
  (while (and (= found -1)
           (< i (vec-len dnames)))
    (set found (if (str-eq (vec-get dnames i) name)
                 (vec-get dids i) found))
    (set i (+ i 1)))
  (ret found))

(fn type-token-kind :str ((tok :i64))
  (ret (if (= tok 3) "string"
         (if (= tok 4) "number" "atom"))))

(fn type-free-one type-error ((one (ref (vec :i64))) (e type-error))
  (vec-free one)
  (ret e))

(fn type-free-both type-error ((a (ref (vec :i64))) (b (ref (vec :i64))) (e type-error))
  (vec-free a)
  (vec-free b)
  (ret e))

(fn type-parse type-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (id :i64) (out (ref (vec :i64))))
  (ret (type-under nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes id "" out)))

(fn type-under type-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (id :i64) (parent :str) (out (ref (vec :i64))))
  (if (= id -1)
    (ret (type-fail 101 parent "expected a type, found no node"))
    (ret (type-parse-node nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes id parent out))))

(fn type-parse-node type-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (id :i64) (parent :str) (out (ref (vec :i64))))
  (let tok :i64 (get (vec-get nodes id) tok))
  (if (= tok 2)
    (ret (type-parse-atom nodes ntexts dnames dids tags names elem extra pbase powner id parent out))
    (type-nothing))
  (if (not (= tok -1))
    (ret (type-fail 101 parent (str-concat "expected a type, found " (type-token-kind tok))))
    (type-nothing))
  (letmut err type-error (type-parse-form nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes id "" out))
  (ret (if (and (not (type-ok err))
             (str-eq (get err path) ""))
         (type-fail-here nodes ntexts id err) err)))

(fn type-fail-here type-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (id :i64) (e type-error))
  (ret (type-fail (get e code)
         (tree-path nodes ntexts 0 id)
         (get e message))))

(fn type-parse-atom type-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (id :i64) (where :str) (out (ref (vec :i64))))
  (ret (type-parse-atom-text dnames dids tags names elem extra pbase powner (type-node-text nodes ntexts id) where out)))

(fn type-parse-atom-text type-error ((dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (value :str) (where :str) (out (ref (vec :i64))))
  (if (type-upper value)
    (ret (type-atom-done out (type-var tags names elem extra pbase powner value)))
    (type-nothing))
  (if (type-colon value)
    (ret (type-parse-colon tags names elem extra pbase powner value where out))
    (type-nothing))
  (ret (type-atom-named dnames dids tags names elem extra pbase powner value where out)))

(fn type-parse-colon type-error ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (value :str) (where :str) (out (ref (vec :i64))))
  (let name :str (str-slice value 1 (str-len value)))
  (if (type-upper name)
    (ret (type-atom-done out (type-var tags names elem extra pbase powner name)))
    (type-nothing))
  (if (type-primitive name)
    (ret (type-atom-done out (type-prim tags names elem extra pbase powner name)))
    (type-nothing))
  (ret (type-fail 101 where (str-concat "unknown type '" (str-concat value "'")))))

(fn type-atom-named type-error ((dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (value :str) (where :str) (out (ref (vec :i64))))
  (let found :i64 (type-decl-find dnames dids value))
  (if (= found -1)
    (ret (type-atom-done out (type-struct tags names elem extra pbase powner value "" -1 0)))
    (ret (type-atom-done out found))))

(fn type-atom-done type-error ((out (ref (vec :i64))) (ty :i64))
  (vec-set out 0 ty)
  (ret (type-pass)))

(fn type-parse-form type-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (id :i64) (where :str) (out (ref (vec :i64))))
  (if (= (get (vec-get nodes id) text) -1)
    (ret (type-fail 101 where "expected a type, found an empty list"))
    (type-nothing))
  (ret (type-form-kind nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes id (type-kind-text nodes ntexts id) where out)))

(fn type-form-kind type-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (id :i64) (kind :str) (where :str) (out (ref (vec :i64))))
  (if (type-unary kind)
    (ret (type-parse-wrap nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes id kind where out))
    (type-nothing))
  (if (str-eq kind "ref")
    (ret (type-parse-ref nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes id where out))
    (type-nothing))
  (if (str-eq kind "arr")
    (ret (type-parse-arr nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes id where out))
    (type-nothing))
  (if (str-eq kind "res")
    (ret (type-parse-res nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes id where out))
    (type-nothing))
  (if (or (str-eq kind "fn")
        (str-eq kind "fn*"))
    (ret (type-parse-fn nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes id where out))
    (type-nothing))
  (ret (type-fail 101 where (str-concat "unknown type form '" (str-concat kind "'")))))

(fn type-unary :bool ((kind :str))
  (ret (or (str-eq kind "vec")
         (or (str-eq kind "ptr")
           (or (str-eq kind "own")
             (or (str-eq kind "opt")
               (or (str-eq kind "shared")
                 (or (str-eq kind "chan")
                   (str-eq kind "atomic")))))))))

(fn type-unary-tag :i64 ((kind :str))
  (ret (if (str-eq kind "vec")
         (type-tag-vec)
         (if (str-eq kind "ptr")
           (type-tag-ptr)
           (if (str-eq kind "own")
             (type-tag-own)
             (if (str-eq kind "opt")
               (type-tag-opt)
               (if (str-eq kind "shared")
                 (type-tag-shared)
                 (if (str-eq kind "chan")
                   (type-tag-chan)
                   (type-tag-atomic)))))))))

(fn type-parse-wrap type-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (id :i64) (kind :str) (where :str) (out (ref (vec :i64))))
  (if (not (= (type-count nodes id) 1))
    (ret (type-fail 101 where (str-concat kind " takes one element type")))
    (type-nothing))
  (letmut one
    (vec :i64)
    (make (vec :i64)))
  (vec-push one -1)
  (letmut err type-error (type-under nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes (type-nth nodes id 0) where one))
  (if (not (type-ok err))
    (ret (type-free-one one err))
    (type-nothing))
  (vec-set out 0 (type-add tags names elem extra pbase powner
                   (type-unary-tag kind) ""
                   (vec-get one 0) -1 -1))
  (vec-free one)
  (ret (type-pass)))

(fn type-parse-ref type-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (id :i64) (where :str) (out (ref (vec :i64))))
  (if (not (= (type-count nodes id) 1))
    (ret (type-fail 101 where "ref takes one element type"))
    (type-nothing))
  (letmut one
    (vec :i64)
    (make (vec :i64)))
  (vec-push one -1)
  (letmut err type-error (type-under nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes (type-nth nodes id 0) where one))
  (if (not (type-ok err))
    (ret (type-free-one one err))
    (type-nothing))
  (if (not (= (vec-get tags (vec-get one 0))
             (type-tag-vec)))
    (ret (type-free-one one (type-fail 100 where "a ref may name a vector only")))
    (type-nothing))
  (vec-set out 0 (type-ref tags names elem extra pbase powner (vec-get one 0)))
  (vec-free one)
  (ret (type-pass)))

(fn type-parse-arr type-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (id :i64) (where :str) (out (ref (vec :i64))))
  (if (not (= (type-count nodes id) 2))
    (ret (type-fail 101 where "arr takes an element type and a length"))
    (type-nothing))
  (let count :i64 (type-nth nodes id 1))
  (if (or (= count -1)
        (not (= (get (vec-get nodes count) tok) 4)))
    (ret (type-fail 101 where "an array length must be a non-negative integer"))
    (type-nothing))
  (let digits :str (type-node-text nodes ntexts count))
  (if (not (type-digits digits))
    (ret (type-fail 101 where "an array length must be a non-negative integer"))
    (type-nothing))
  (letmut one
    (vec :i64)
    (make (vec :i64)))
  (vec-push one -1)
  (letmut err type-error (type-under nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes (type-nth nodes id 0) where one))
  (if (not (type-ok err))
    (ret (type-free-one one err))
    (type-nothing))
  (vec-set out 0 (type-arr tags names elem extra pbase powner
                   (vec-get one 0)
                   (type-number digits)))
  (vec-free one)
  (ret (type-pass)))

(fn type-number :i64 ((digits :str))
  (letmut i :i64 0)
  (letmut n :i64 0)
  (while (< i (str-len digits))
    (set n (+ (* n 10)
             (- (cast :i64 (str-byte digits i)) 48)))
    (set i (+ i 1)))
  (ret n))

(fn type-parse-res type-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (id :i64) (where :str) (out (ref (vec :i64))))
  (if (not (= (type-count nodes id) 2))
    (ret (type-fail 101 where "res takes an ok type and an error type"))
    (type-nothing))
  (letmut pair
    (vec :i64)
    (make (vec :i64)))
  (vec-push pair -1)
  (vec-push pair -1)
  (letmut err type-error (type-under nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes (type-nth nodes id 0) where pair))
  (if (not (type-ok err))
    (ret (type-free-one pair err))
    (type-nothing))
  (let ok-id :i64 (vec-get pair 0))
  (vec-set pair 0 -1)
  (set err (type-under nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes (type-nth nodes id 1) where pair))
  (if (not (type-ok err))
    (ret (type-free-one pair err))
    (type-nothing))
  (vec-set out 0 (type-res tags names elem extra pbase powner ok-id (vec-get pair 0)))
  (vec-free pair)
  (ret (type-pass)))

(fn type-parse-fn type-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (id :i64) (where :str) (out (ref (vec :i64))))
  (let kind :str (type-kind-text nodes ntexts id))
  (if (= (get (vec-get nodes id) name) -1)
    (ret (type-fn-plain nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes id kind where out))
    (ret (type-fn-named nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes id kind where out))))

(fn type-fn-plain type-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (id :i64) (kind :str) (where :str) (out (ref (vec :i64))))
  (if (not (= (type-count nodes id) 2))
    (ret (type-fail 101 where (str-concat kind " takes a parameter list and a return type")))
    (type-nothing))
  (ret (type-fn-build nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes id kind
         (type-nth nodes id 0)
         (type-nth nodes id 1) where out)))

(fn type-fn-named type-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (id :i64) (kind :str) (where :str) (out (ref (vec :i64))))
  (if (not (= (type-count nodes id) 1))
    (ret (type-fail 101 where (str-concat kind " takes a parameter list and a return type")))
    (type-nothing))
  (ret (type-fail 101 where "a function type needs a parameter list")))

(fn type-fn-build type-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (id :i64) (kind :str) (params :i64) (ret-node :i64) (where :str) (out (ref (vec :i64))))
  (if (or (= params -1)
        (not (= (get (vec-get nodes params) tok) -1)))
    (ret (type-fail 101 where "a function type needs a parameter list"))
    (type-nothing))
  (letmut ttypes
    (vec :i64)
    (make (vec :i64)))
  (letmut err type-error (type-fn-list nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes params where ttypes))
  (if (not (type-ok err))
    (ret (type-free-one ttypes err))
    (type-nothing))
  (letmut one
    (vec :i64)
    (make (vec :i64)))
  (vec-push one -1)
  (set err (type-under nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes ret-node where one))
  (if (not (type-ok err))
    (ret (type-free-both ttypes one err))
    (type-nothing))
  (let ret-id :i64 (vec-get one 0))
  (let start :i64 (type-param-start ptypes))
  (type-params-nameless pnames ptypes ttypes)
  (vec-set out 0 (type-fn tags names elem extra pbase powner kind ret-id (vec-len ttypes) start))
  (vec-free one)
  (vec-free ttypes)
  (ret (type-pass)))

(fn type-fn-list type-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (params :i64) (where :str) (ttypes (ref (vec :i64))))
  (letmut i :i64 0)
  (letmut n :i64 (type-count nodes params))
  (letmut err type-error (type-pass))
  (let head :str (type-kind-text nodes ntexts params))
  (if (not (str-eq head ""))
    (set err (type-fn-head nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes params head where ttypes))
    (type-nothing))
  (if (and (type-ok err)
        (not (str-eq head "")))
    (set i (if (str-eq head ":") 1 0))
    (type-nothing))
  (while (and (type-ok err)
           (< i n))
    (set err (type-fn-entry nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes params i where ttypes))
    (set i (+ i (type-fn-step nodes ntexts (type-nth nodes params i)))))
  (ret err))

(fn type-fn-head type-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (params :i64) (head :str) (where :str) (ttypes (ref (vec :i64))))
  (if (str-eq head ":")
    (if (< (type-count nodes params) 1)
      (ret (type-fail 101 where "expected a type after ':'"))
      (ret (type-parse-gather nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes (type-nth nodes params 0) where ttypes)))
    (type-nothing))
  (ret (type-text-gather dnames dids tags names elem extra pbase powner head where ttypes)))

(fn type-fn-step :i64 ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (item :i64))
  (ret (if (type-node-atom nodes item)
         (if (str-eq (type-node-text nodes ntexts item) ":") 2 1) 1)))

(fn type-fn-entry type-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (params :i64) (i :i64) (where :str) (ttypes (ref (vec :i64))))
  (let n :i64 (type-count nodes params))
  (let step :i64 (type-fn-step nodes ntexts (type-nth nodes params i)))
  (let at :i64 (if (= step 2)
                 (+ i 1) i))
  (if (>= at n)
    (ret (type-fail 101 where "expected a type after ':'"))
    (type-nothing))
  (ret (type-parse-gather nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes (type-nth nodes params at) where ttypes)))

(fn type-parse-gather type-error ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (id :i64) (where :str) (ttypes (ref (vec :i64))))
  (letmut one
    (vec :i64)
    (make (vec :i64)))
  (vec-push one -1)
  (letmut err type-error (type-under nodes ntexts dnames dids tags names elem extra pbase powner pnames ptypes id where one))
  (if (not (type-ok err))
    (ret (type-free-one one err))
    (type-nothing))
  (vec-push ttypes (vec-get one 0))
  (vec-free one)
  (ret (type-pass)))

(fn type-text-gather type-error ((dnames (ref (vec :str))) (dids (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (value :str) (where :str) (ttypes (ref (vec :i64))))
  (letmut one
    (vec :i64)
    (make (vec :i64)))
  (vec-push one -1)
  (letmut err type-error (type-parse-atom-text dnames dids tags names elem extra pbase powner value where one))
  (if (not (type-ok err))
    (ret (type-free-one one err))
    (type-nothing))
  (vec-push ttypes (vec-get one 0))
  (vec-free one)
  (ret (type-pass)))

(fn type-params-nameless :void ((pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (ttypes (ref (vec :i64))))
  (letmut i :i64 0)
  (while (< i (vec-len ttypes))
    (type-param pnames ptypes "" (vec-get ttypes i))
    (set i (+ i 1)))
  (ret))

(fn type-compatible :bool ((tags (ref (vec :i64))) (names (ref (vec :str))) (powner (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (ptypes (ref (vec :i64))) (a :i64) (b :i64))
  (if (or (= a -1)
        (= b -1))
    (ret (and (= a -1)
           (= b -1)))
    (type-nothing))
  (let tag :i64 (vec-get tags a))
  (if (not (= tag (vec-get tags b)))
    (ret false)
    (type-nothing))
  (if (or (= tag (type-tag-prim))
        (= tag (type-tag-var)))
    (ret (str-eq (vec-get names a)
           (vec-get names b)))
    (type-nothing))
  (if (or (= tag (type-tag-struct))
        (= tag (type-tag-enum)))
    (ret (and (str-eq (vec-get names a)
                (vec-get names b))
           (type-same-owner (vec-get powner a)
             (vec-get powner b))))
    (type-nothing))
  (if (= tag (type-tag-arr))
    (ret (and (= (vec-get extra a)
                (vec-get extra b))
           (type-compatible tags names powner elem extra pbase ptypes
             (vec-get elem a)
             (vec-get elem b))))
    (type-nothing))
  (if (= tag (type-tag-res))
    (ret (and (type-compatible tags names powner elem extra pbase ptypes
                (vec-get elem a)
                (vec-get elem b))
           (type-compatible tags names powner elem extra pbase ptypes
             (vec-get extra a)
             (vec-get extra b))))
    (type-nothing))
  (if (= tag (type-tag-fn))
    (ret (type-compatible-fn tags names powner elem extra pbase ptypes a b))
    (type-nothing))
  (ret (type-compatible tags names powner elem extra pbase ptypes
         (vec-get elem a)
         (vec-get elem b))))

(fn type-same-owner :bool ((a :str) (b :str))
  (ret (or (str-eq a "")
         (or (str-eq b "")
           (str-eq a b)))))

(fn type-compatible-fn :bool ((tags (ref (vec :i64))) (names (ref (vec :str))) (powner (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (ptypes (ref (vec :i64))) (a :i64) (b :i64))
  (if (not (= (vec-get extra a)
             (vec-get extra b)))
    (ret false)
    (type-nothing))
  (if (not (str-eq (vec-get names a)
             (vec-get names b)))
    (ret false)
    (type-nothing))
  (letmut i :i64 0)
  (letmut ok :bool true)
  (while (and ok (< i (vec-get extra a)))
    (set ok (type-compatible tags names powner elem extra pbase ptypes
              (type-param-type ptypes pbase a i)
              (type-param-type ptypes pbase b i)))
    (set i (+ i 1)))
  (ret (if ok (type-compatible tags names powner elem extra pbase ptypes
                (vec-get elem a)
                (vec-get elem b)) false)))

(fn type-bound :i64 ((bnames (ref (vec :str))) (btypes (ref (vec :i64))) (name :str) (fallback :i64))
  (letmut i :i64 0)
  (letmut found :i64 fallback)
  (while (< i (vec-len bnames))
    (set found (if (str-eq (vec-get bnames i) name)
                 (vec-get btypes i) found))
    (set i (+ i 1)))
  (ret found))

(fn type-substitute :i64 ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (ty :i64))
  (if (= ty -1)
    (ret -1)
    (type-nothing))
  (let tag :i64 (vec-get tags ty))
  (if (= tag (type-tag-var))
    (ret (type-bound bnames btypes (vec-get names ty) ty))
    (type-nothing))
  (if (or (= tag (type-tag-prim))
        (or (= tag (type-tag-struct))
          (= tag (type-tag-enum))))
    (ret ty)
    (type-nothing))
  (if (= tag (type-tag-fn))
    (ret (type-substitute-fn tags names elem extra pbase powner pnames ptypes bnames btypes ty))
    (type-nothing))
  (if (= tag (type-tag-arr))
    (ret (type-add tags names elem extra pbase powner tag ""
           (type-substitute tags names elem extra pbase powner pnames ptypes bnames btypes (vec-get elem ty))
           (vec-get extra ty) -1))
    (type-nothing))
  (if (= tag (type-tag-res))
    (ret (type-add tags names elem extra pbase powner tag ""
           (type-substitute tags names elem extra pbase powner pnames ptypes bnames btypes (vec-get elem ty))
           (type-substitute tags names elem extra pbase powner pnames ptypes bnames btypes (vec-get extra ty)) -1))
    (type-nothing))
  (ret (type-add tags names elem extra pbase powner tag "" (type-substitute tags names elem extra pbase powner pnames ptypes bnames btypes (vec-get elem ty)) -1 -1)))

(fn type-substitute-fn :i64 ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))) (bnames (ref (vec :str))) (btypes (ref (vec :i64))) (ty :i64))
  (letmut tnames
    (vec :str)
    (make (vec :str)))
  (letmut ttypes
    (vec :i64)
    (make (vec :i64)))
  (letmut i :i64 0)
  (while (< i (vec-get extra ty))
    (vec-push tnames (type-param-name pnames pbase ty i))
    (vec-push ttypes (type-substitute tags names elem extra pbase powner pnames ptypes bnames btypes (type-param-type ptypes pbase ty i)))
    (set i (+ i 1)))
  (let start :i64 (type-param-start ptypes))
  (type-params-append pnames ptypes tnames ttypes)
  (let ret-id :i64 (type-substitute tags names elem extra pbase powner pnames ptypes bnames btypes (vec-get elem ty)))
  (let id :i64 (type-fn tags names elem extra pbase powner
                 (vec-get names ty) ret-id
                 (vec-len ttypes) start))
  (vec-free tnames)
  (vec-free ttypes)
  (ret id))

(fn type-variables :void ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (ptypes (ref (vec :i64))) (ty :i64) (out (ref (vec :str))))
  (if (= ty -1)
    (ret)
    (type-variables-node tags names elem extra pbase ptypes ty out)))

(fn type-variables-node :void ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (ptypes (ref (vec :i64))) (ty :i64) (out (ref (vec :str))))
  (let tag :i64 (vec-get tags ty))
  (if (= tag (type-tag-var))
    (type-push-name out (vec-get names ty))
    (type-nothing))
  (if (= tag (type-tag-arr))
    (type-variables tags names elem extra pbase ptypes (vec-get elem ty) out)
    (type-nothing))
  (if (= tag (type-tag-res))
    (type-variables-pair tags names elem extra pbase ptypes ty out)
    (type-nothing))
  (if (= tag (type-tag-fn))
    (type-variables-fn tags names elem extra pbase ptypes ty out)
    (type-nothing))
  (if (type-unary-tag? tags ty)
    (type-variables tags names elem extra pbase ptypes (vec-get elem ty) out)
    (type-nothing))
  (ret))

(fn type-unary-tag? :bool ((tags (ref (vec :i64))) (ty :i64))
  (let tag :i64 (vec-get tags ty))
  (ret (or (= tag (type-tag-ptr))
         (or (= tag (type-tag-own))
           (or (= tag (type-tag-vec))
             (or (= tag (type-tag-ref))
               (or (= tag (type-tag-opt))
                 (or (= tag (type-tag-shared))
                   (or (= tag (type-tag-chan))
                     (= tag (type-tag-atomic)))))))))))

(fn type-push-name :void ((out (ref (vec :str))) (name :str))
  (letmut i :i64 0)
  (letmut found :bool false)
  (while (< i (vec-len out))
    (set found (or found (str-eq (vec-get out i) name)))
    (set i (+ i 1)))
  (if (not found)
    (vec-push out name)
    (type-nothing))
  (ret))

(fn type-variables-pair :void ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (ptypes (ref (vec :i64))) (ty :i64) (out (ref (vec :str))))
  (type-variables tags names elem extra pbase ptypes (vec-get elem ty) out)
  (type-variables tags names elem extra pbase ptypes (vec-get extra ty) out)
  (ret))

(fn type-variables-fn :void ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (ptypes (ref (vec :i64))) (ty :i64) (out (ref (vec :str))))
  (letmut i :i64 0)
  (while (< i (vec-get extra ty))
    (type-variables tags names elem extra pbase ptypes (type-param-type ptypes pbase ty i) out)
    (set i (+ i 1)))
  (type-variables tags names elem extra pbase ptypes (vec-get elem ty) out)
  (ret))

(fn type-has-var :bool ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (ptypes (ref (vec :i64))) (ty :i64))
  (if (= ty -1)
    (ret false)
    (type-nothing))
  (let tag :i64 (vec-get tags ty))
  (if (= tag (type-tag-var))
    (ret true)
    (type-nothing))
  (if (= tag (type-tag-arr))
    (ret (type-has-var tags names elem extra pbase ptypes (vec-get elem ty)))
    (type-nothing))
  (if (= tag (type-tag-res))
    (ret (or (type-has-var tags names elem extra pbase ptypes (vec-get elem ty))
           (type-has-var tags names elem extra pbase ptypes (vec-get extra ty))))
    (type-nothing))
  (if (= tag (type-tag-fn))
    (ret (type-has-var-fn tags names elem extra pbase ptypes ty))
    (type-nothing))
  (ret (if (type-unary-tag? tags ty)
         (type-has-var tags names elem extra pbase ptypes (vec-get elem ty)) false)))

(fn type-has-var-fn :bool ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (ptypes (ref (vec :i64))) (ty :i64))
  (letmut i :i64 0)
  (letmut found :bool false)
  (while (and (not found)
           (< i (vec-get extra ty)))
    (set found (type-has-var tags names elem extra pbase ptypes (type-param-type ptypes pbase ty i)))
    (set i (+ i 1)))
  (ret (if found true (type-has-var tags names elem extra pbase ptypes (vec-get elem ty)))))

(fn type-safe :bool ((b :i64))
  (ret (or (type-digit b)
         (or (and (>= b 65)
               (<= b 90))
           (or (and (>= b 97)
                 (<= b 122))
             (= b 95))))))

(fn type-hex :str ((b :i64))
  (let hex :str "0123456789abcdef")
  (let hi :i64 (/ b 16))
  (let lo :i64 (% b 16))
  (ret (str-concat (str-slice hex hi (+ hi 1))
         (str-slice hex lo (+ lo 1)))))

(fn type-escape :str ((s :str))
  (letmut out :str "")
  (letmut i :i64 0)
  (while (< i (str-len s))
    (let b :i64 (cast :i64 (str-byte s i)))
    (set out (str-concat out (if (type-safe b)
                               (str-slice s i (+ i 1))
                               (str-concat "_x" (type-hex b)))))
    (set i (+ i 1)))
  (ret out))

(fn type-fragment :str ((name :str))
  (ret (str-concat (str-concat (str-from-i64 (str-len name)) "_")
         (type-escape name))))

(fn type-wrap :str ((head :str) (inner :str))
  (ret (str-concat (str-concat head "(")
         (str-concat inner ")"))))

(fn type-paren2 :str ((head :str) (inner :str))
  (ret (str-concat "(" (str-concat head (str-concat " " (str-concat inner ")"))))))

(fn type-text-fn :str ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (ptypes (ref (vec :i64))) (ty :i64))
  (letmut out :str "")
  (letmut i :i64 0)
  (while (< i (vec-get extra ty))
    (set out (str-concat out (str-concat (if (= i 0) "" " ")
                               (type-text tags names elem extra pbase ptypes (type-param-type ptypes pbase ty i)))))
    (set i (+ i 1)))
  (ret (str-concat "(" (str-concat (vec-get names ty)
                         (str-concat " (" (str-concat out (str-concat ") " (str-concat (type-text tags names elem extra pbase ptypes (vec-get elem ty)) ")"))))))))

(fn type-text :str ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (ptypes (ref (vec :i64))) (ty :i64))
  (if (= ty -1)
    (ret "")
    (type-nothing))
  (let tag :i64 (vec-get tags ty))
  (if (= tag (type-tag-prim))
    (ret (str-concat ":" (vec-get names ty)))
    (type-nothing))
  (if (or (= tag (type-tag-struct))
        (or (= tag (type-tag-enum))
          (= tag (type-tag-var))))
    (ret (vec-get names ty))
    (type-nothing))
  (if (= tag (type-tag-arr))
    (ret (str-concat "(arr " (str-concat (type-text tags names elem extra pbase ptypes (vec-get elem ty))
                               (str-concat " " (str-concat (str-from-i64 (vec-get extra ty)) ")")))))
    (type-nothing))
  (if (= tag (type-tag-res))
    (ret (str-concat "(res " (str-concat (type-text tags names elem extra pbase ptypes (vec-get elem ty))
                               (str-concat " " (str-concat (type-text tags names elem extra pbase ptypes (vec-get extra ty)) ")")))))
    (type-nothing))
  (if (= tag (type-tag-fn))
    (ret (type-text-fn tags names elem extra pbase ptypes ty))
    (type-nothing))
  (if (= tag (type-tag-ptr))
    (ret (type-paren2 "ptr" (type-text tags names elem extra pbase ptypes (vec-get elem ty))))
    (type-nothing))
  (if (= tag (type-tag-own))
    (ret (type-paren2 "own" (type-text tags names elem extra pbase ptypes (vec-get elem ty))))
    (type-nothing))
  (if (= tag (type-tag-vec))
    (ret (type-paren2 "vec" (type-text tags names elem extra pbase ptypes (vec-get elem ty))))
    (type-nothing))
  (if (= tag (type-tag-ref))
    (ret (type-paren2 "ref" (type-text tags names elem extra pbase ptypes (vec-get elem ty))))
    (type-nothing))
  (if (= tag (type-tag-opt))
    (ret (type-paren2 "opt" (type-text tags names elem extra pbase ptypes (vec-get elem ty))))
    (type-nothing))
  (if (= tag (type-tag-shared))
    (ret (type-paren2 "shared" (type-text tags names elem extra pbase ptypes (vec-get elem ty))))
    (type-nothing))
  (if (= tag (type-tag-chan))
    (ret (type-paren2 "chan" (type-text tags names elem extra pbase ptypes (vec-get elem ty))))
    (type-nothing))
  (if (= tag (type-tag-atomic))
    (ret (type-paren2 "atomic" (type-text tags names elem extra pbase ptypes (vec-get elem ty))))
    (type-nothing))
  (ret ""))

(fn type-spell-fn :str ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (ptypes (ref (vec :i64))) (ty :i64))
  (letmut out :str "")
  (letmut i :i64 0)
  (while (< i (vec-get extra ty))
    (set out (str-concat out (str-concat (if (= i 0) "" ",")
                               (type-spell tags names elem extra pbase ptypes (type-param-type ptypes pbase ty i)))))
    (set i (+ i 1)))
  (ret (str-concat (str-concat (vec-get names ty) "(")
         (str-concat (str-concat out ")")
           (type-spell tags names elem extra pbase ptypes (vec-get elem ty))))))

(fn type-spell :str ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (ptypes (ref (vec :i64))) (ty :i64))
  (let tag :i64 (vec-get tags ty))
  (if (= tag (type-tag-prim))
    (ret (vec-get names ty))
    (type-nothing))
  (if (= tag (type-tag-struct))
    (ret (str-concat "s" (type-fragment (vec-get names ty))))
    (type-nothing))
  (if (= tag (type-tag-enum))
    (ret (str-concat "e" (type-fragment (vec-get names ty))))
    (type-nothing))
  (if (= tag (type-tag-arr))
    (ret (str-concat (str-concat (str-concat "arr(" (type-spell tags names elem extra pbase ptypes (vec-get elem ty))) ",")
           (str-concat (str-from-i64 (vec-get extra ty)) ")")))
    (type-nothing))
  (if (= tag (type-tag-res))
    (ret (str-concat (str-concat (str-concat "res(" (type-spell tags names elem extra pbase ptypes (vec-get elem ty))) ",")
           (str-concat (type-spell tags names elem extra pbase ptypes (vec-get extra ty)) ")")))
    (type-nothing))
  (if (= tag (type-tag-fn))
    (ret (type-spell-fn tags names elem extra pbase ptypes ty))
    (type-nothing))
  (if (= tag (type-tag-ptr))
    (ret (type-wrap "ptr" (type-spell tags names elem extra pbase ptypes (vec-get elem ty))))
    (type-nothing))
  (if (= tag (type-tag-own))
    (ret (type-wrap "own" (type-spell tags names elem extra pbase ptypes (vec-get elem ty))))
    (type-nothing))
  (if (= tag (type-tag-vec))
    (ret (type-wrap "vec" (type-spell tags names elem extra pbase ptypes (vec-get elem ty))))
    (type-nothing))
  (if (= tag (type-tag-ref))
    (ret (type-wrap "ref" (type-spell tags names elem extra pbase ptypes (vec-get elem ty))))
    (type-nothing))
  (if (= tag (type-tag-opt))
    (ret (type-wrap "opt" (type-spell tags names elem extra pbase ptypes (vec-get elem ty))))
    (type-nothing))
  (if (= tag (type-tag-shared))
    (ret (type-wrap "shared" (type-spell tags names elem extra pbase ptypes (vec-get elem ty))))
    (type-nothing))
  (if (= tag (type-tag-chan))
    (ret (type-wrap "chan" (type-spell tags names elem extra pbase ptypes (vec-get elem ty))))
    (type-nothing))
  (if (= tag (type-tag-atomic))
    (ret (type-wrap "atomic" (type-spell tags names elem extra pbase ptypes (vec-get elem ty))))
    (type-nothing))
  (ret ""))

(fn type-mangle type-error ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (ptypes (ref (vec :i64))) (ty :i64) (where :str) (out (ref (vec :str))))
  (if (= ty -1)
    (ret (type-fail 101 where "expected a type, found -1"))
    (type-nothing))
  (letmut vars
    (vec :str)
    (make (vec :str)))
  (type-variables tags names elem extra pbase ptypes ty vars)
  (letmut err type-error (type-pass))
  (if (> (vec-len vars) 0)
    (set err (type-fail 501 where (str-concat "type variable " (str-concat (vec-get vars 0) " cannot be a type argument"))))
    (type-store out (type-spell tags names elem extra pbase ptypes ty)))
  (vec-free vars)
  (ret err))

(fn type-decl-spelling :str ((names (ref (vec :str))) (powner (ref (vec :str))) (ty :i64) (qualified :bool))
  (if (not qualified)
    (ret (vec-get names ty))
    (ret (str-concat (str-concat (vec-get powner ty) ".")
           (vec-get names ty)))))
