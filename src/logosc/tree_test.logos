(mod tree-test)

(use lex)

(use tree)

(fn label :str ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (id :i64))
  (let n node (vec-get nodes id))
  (let t :i64 (get n text))
  (ret (if (= (get n tok) -2) "file"
         (if (= (get n tok) -1)
           (if (= t -1) "()"
             (vec-get ntexts t))
           (str-concat "t" (str-concat (str-from-i64 (get n tok))
                             (str-concat ":" (vec-get ntexts t))))))))

(fn show-path :str ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (id :i64))
  (let p :str (tree-path nodes ntexts 0 id))
  (ret (if (str-eq p "") "-" p)))

(fn dump-node :void ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (id :i64) (depth :i64))
  (print id)
  (print " ")
  (print depth)
  (print " ")
  (print (show-path nodes ntexts id))
  (print " ")
  (println (label nodes ntexts id))
  (letmut c :i64 (get (vec-get nodes id) first))
  (while (not (= c -1))
    (dump-node nodes ntexts c (+ depth 1))
    (set c (get (vec-get nodes c) next))))

(fn print-tree-error :void ((t tree-error))
  (println "E0001")
  (println (get t path))
  (println (get t line))
  (println (get t col))
  (println (get t msg)))

(fn dump-ok :void ((nodes (ref (vec node))) (ntexts (ref (vec :str))))
  (println "OK")
  (println (vec-len nodes))
  (dump-node nodes ntexts 0 0))

(fn tree-dump :void ((kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))))
  (letmut nodes
    (vec node)
    (make (vec node)))
  (letmut ntexts
    (vec :str)
    (make (vec :str)))
  (let t tree-error (tree-parse kinds texts lines cols nodes ntexts))
  (if (tree-ok t)
    (dump-ok nodes ntexts)
    (print-tree-error t))
  (vec-free nodes)
  (vec-free ntexts))

(fn dump-src :void ((src :str))
  (letmut kinds
    (vec :i64)
    (make (vec :i64)))
  (letmut texts
    (vec :str)
    (make (vec :str)))
  (letmut lines
    (vec :i64)
    (make (vec :i64)))
  (letmut cols
    (vec :i64)
    (make (vec :i64)))
  (let e lex-error (lex src kinds texts lines cols))
  (if (lex-ok e)
    (tree-dump kinds texts lines cols)
    (println (get e msg)))
  (vec-free kinds)
  (vec-free texts)
  (vec-free lines)
  (vec-free cols))

(test mod-alone
  (expect (out "OK\n4\n0 0 - file\n1 1 a mod\n")
    (code 0)
    (leaks 0))
  (dump-src "(mod a)"))

(test nested-depth-5
  (expect (out "OK\n20\n0 0 - file\n1 1 d mod\n4 1 d/f fn\n7 2 - t2::i64\n8 2 d/f/1 ()\n9 2 d/f/2 ret\n11 3 d/f/2/0 a\n13 4 d/f/2/0/0 b\n15 5 d/f/2/0/0/0 c\n17 6 d/f/2/0/0/0/0 d\n19 7 - t4:1\n")
    (code 0)
    (leaks 0))
  (dump-src "(mod d)\n(fn f :i64 ()\n  (ret (a (b (c (d 1))))))"))

(test sibling-run
  (expect (out "OK\n19\n0 0 - file\n1 1 s mod\n4 1 s/a fn\n7 2 - t2::i64\n8 2 s/a/1 ()\n9 1 s/b fn\n12 2 - t2::i64\n13 2 s/b/1 ()\n14 1 s/c fn\n17 2 - t2::i64\n18 2 s/c/1 ()\n")
    (code 0)
    (leaks 0))
  (dump-src "(mod s)\n(fn a :i64 ())\n(fn b :i64 ())\n(fn c :i64 ())"))

(test nested-paths
  (expect (out "OK\n18\n0 0 - file\n1 1 p mod\n4 1 p/f fn\n7 2 - t2::i64\n8 2 p/f/1 ()\n9 3 p/f/1/0 x\n11 4 - t2::i64\n12 2 p/f/2 ret\n14 3 p/f/2/0 +\n16 4 - t2:x\n17 4 - t4:1\n")
    (code 0)
    (leaks 0))
  (dump-src "(mod p)\n(fn f :i64 ((x :i64)) (ret (+ x 1)))"))

(test unknown-head
  (expect (out "OK\n8\n0 0 - file\n1 1 u mod\n4 1 u/0 wibble\n6 2 - t4:1\n7 2 - t4:2\n")
    (code 0)
    (leaks 0))
  (dump-src "(mod u)\n(wibble 1 2)"))

(test lone-close
  (expect (out "E0001\n\n2\n1\nunbalanced ')'\n")
    (code 0)
    (leaks 0))
  (dump-src "(mod e)\n)"))

(test unclosed-form
  (expect (out "E0001\ne/f\n2\n1\nunbalanced '('\n")
    (code 0)
    (leaks 0))
  (dump-src "(mod e)\n(fn f :i64 ()"))

(test unclosed-nested
  (expect (out "E0001\ne/f/2/0\n2\n20\nunbalanced '('\n")
    (code 0)
    (leaks 0))
  (dump-src "(mod e)\n(fn f :i64 () (ret (+ 1"))

(test top-level-atom
  (expect (out "E0001\n\n1\n1\nform outside parentheses\n")
    (code 0)
    (leaks 0))
  (dump-src "x"))
