(mod concurrency)

(fn main :i64 ()
  (let c (chan :i64 4))
  (send c 11)
  (send c 31)
  (let a :i64 (recv c))
  (let b :i64 (recv c))
  (let m (mutex))
  (lock m)
  (unlock m)
  (let n (atomic :i64 0))
  (atomic-add n 5)
  (atomic-store n (+ (atomic-load n) 2))
  (ret (+ (atomic-load n)
         (+ a b))))
