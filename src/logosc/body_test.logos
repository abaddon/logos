  (expect (out "E0502\nm/f/2/2/1\na closure that captures cannot leave its function\n")
    (code 0)
    (leaks 0))
  (dump-src "(type holder (struct (f (fn () :void)))) (fn f :void ((x :i64)) (letmut h holder (make holder (fn :void () (println x)))))"))

(test c4-closure-missing-ret
  (expect (out "E0105\nm/f/2/1\nclosure must return :i64 but a path falls off the end\n")
    (code 0)
    (leaks 0))
  (dump-src "(fn f :i64 () (let g (fn :i64 () (println 1))) (ret (g)))"))

