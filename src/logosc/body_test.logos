(test env-snapshot
  (expect (out "shadow 1\nouter\nrestored\nnew\nabsent\nouter\n")
    (code 0)
    (leaks 0))
  (letmut nodes
    (vec node)
    (make (vec node)))
  (letmut ntexts
    (vec :str)
    (make (vec :str)))
  (letmut bn
    (vec :i64)
    (make (vec :i64)))
  (letmut bt
    (vec :i64)
    (make (vec :i64)))
  (letmut bm
    (vec :i64)
    (make (vec :i64)))
  (letmut bv
    (vec :i64)
    (make (vec :i64)))
  (letmut bu
    (vec :i64)
    (make (vec :i64)))
  (letmut bd
    (vec :i64)
    (make (vec :i64)))
  (letmut bk
    (vec :str)
    (make (vec :str)))
  (letmut bvl
    (vec :i64)
    (make (vec :i64)))
  (letmut bsl
    (vec :i64)
    (make (vec :i64)))
  (letmut snap
    (vec :i64)
    (make (vec :i64)))
  (body-bind nodes ntexts bn bt bm bv bu bd bk bvl bsl "x" -1 1 0 0 -1)
  (body-snapshot bv bk bvl snap)
  (body-bind nodes ntexts bn bt bm bv bu bd bk bvl bsl "x" -1 2 0 1 -1)
  (println (str-concat "shadow " (str-from-i64 (body-find bk bvl bsl "x"))))
  (vec-set bv 0 1)
  (body-restore bv bvl snap)
  (println (if (= (body-find bk bvl bsl "x") 0) "outer" "wrong"))
  (println (if (= (vec-get bv 0) 0) "restored" "leaked"))
  (body-bind nodes ntexts bn bt bm bv bu bd bk bvl bsl "y" -1 3 0 1 -1)
  (println (if (> (body-find bk bvl bsl "y") 0) "new" "absent"))
  (body-restore bv bvl snap)
  (println (if (= (body-find bk bvl bsl "y") -1) "absent" "leaked"))
  (body-restore bv bvl snap)
  (println (if (= (body-find bk bvl bsl "x") 0) "outer" "wrong"))
  (vec-free nodes)
  (vec-free ntexts)
  (vec-free bn)
  (vec-free bt)
  (vec-free bm)
  (vec-free bv)
  (vec-free bu)
  (vec-free bd)
  (vec-free bk)
  (vec-free bvl)
  (vec-free bsl)
  (vec-free snap))
