  (expect (out "E0100\nm/f/2/1/1/0\nparameter 'x' cannot be :void\n")
    (code 0)
    (leaks 0))
  (dump-src "(fn f :void () (let g (fn :void ((x :void)) (println x))) (g 1))"))

