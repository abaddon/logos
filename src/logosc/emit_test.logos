  (let ty22 :i64 (type-atomic tags names elem extra pbase powner ty21))
  (let ty23 :i64 (type-enum tags names elem extra pbase powner "parse-error" "" -1 0))
  (vec-push spell (emit-type-text tags names elem extra powner enames ewords mqual ty0 why))
