    (vec :str)
    (make (vec :str)))
  (letmut whole
    (vec :str)
    (make (vec :str)))
  (ir-enum enames ewords "parse-error" 2)
  (vec-push mqual 0)
  (vec-push why "")
  (let ty0 :i64 (type-prim tags names elem extra pbase powner "i64"))
  (let ty1 :i64 (type-struct tags names elem extra pbase powner "point" "" -1 0))
  (let ty2 :i64 (type-ptr tags names elem extra pbase powner ty1))
  (let ty3 :i64 (type-prim tags names elem extra pbase powner "str"))
  (let ty4 :i64 (type-vec tags names elem extra pbase powner ty3))
  (let ty5 :i64 (type-own tags names elem extra pbase powner ty4))
  (let ty6 :i64 (type-arr tags names elem extra pbase powner ty2 8))
  (let ty7 :i64 (type-vec tags names elem extra pbase powner ty0))
  (let ty8 :i64 (type-vec tags names elem extra pbase powner ty7))
  (let ty9 :i64 (type-vec tags names elem extra pbase powner ty1))
  (let ty10 :i64 (type-ref tags names elem extra pbase powner ty9))
  (let ty11 :i64 (type-opt tags names elem extra pbase powner ty0))
  (let ty12 :i64 (type-res tags names elem extra pbase powner ty11 ty9))
  (let ty13 :i64 (type-own tags names elem extra pbase powner ty1))
