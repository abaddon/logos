(mod emit-test)

(use ir)

(use emit)

(use types)

(fn t-header :str ()
  (ret "; generated by tools/ir_parity.py from logos.llvm.emit.\n; The Logos emitter must reproduce this file byte for byte.\n"))

(fn t-port-header :str ()
  (ret "; generated by tools/ir_parity.py from logos.llvm.emit.\n; The Logos emitter must reproduce this file byte for byte.\n; Port-only refusal: no Python IR can describe this arena.\n"))

(fn t-nothing :void ()
  (ret))

(fn t-fail :str ((name :str) (e ir-error))
  (ret (str-concat "FAIL " (str-concat name (str-concat ": " (get e text))))))

(fn t-join :str ((parts (ref (vec :str))))
  (letmut whole :str "")
  (letmut i :i64 0)
  (while (< i (vec-len parts))
    (set whole (str-concat whole (vec-get parts i)))
    (set i (+ i 1)))
  (ret whole))

(fn t-line-start :i64 ((s :str) (at :i64))
  (letmut i :i64 at)
  (while (and (> i 0)
           (not (= (cast :i64 (str-byte s (- i 1))) 10)))
    (set i (- i 1)))
  (ret i))

(fn t-line-end :i64 ((s :str) (at :i64))
  (letmut i :i64 at)
  (while (and (< i (str-len s))
           (not (= (cast :i64 (str-byte s i)) 10)))
    (set i (+ i 1)))
  (ret i))

(fn t-line-no :i64 ((s :str) (at :i64))
  (letmut i :i64 0)
  (letmut n :i64 1)
  (while (< i at)
    (if (= (cast :i64 (str-byte s i)) 10)
      (set n (+ n 1))
      (t-nothing))
    (set i (+ i 1)))
  (ret n))

(fn t-cut :str ((s :str) (lo :i64) (hi :i64))
  (ret (if (> (- hi lo) 70)
         (str-concat (str-slice s lo (+ lo 70)) "...")
         (str-slice s lo hi))))

(fn t-diff :str ((name :str) (path :str) (got :str))
  (let want :str (read-file path))
  (if (str-eq want got)
    (ret "ok")
    (t-nothing))
  (let size :i64 (if (< (str-len want)
                       (str-len got))
                   (str-len want)
                   (str-len got)))
  (letmut i :i64 0)
  (while (and (< i size)
           (= (str-byte want i)
             (str-byte got i)))
    (set i (+ i 1)))
  (ret (str-concat "FAIL " (str-concat name (str-concat " at byte " (str-concat (str-from-i64 i)
                                                                      (str-concat " (line " (str-concat (str-from-i64 (t-line-no want i))
                                                                                              (str-concat ")\n  want: " (str-concat (t-cut want
                                                                                                                                      (t-line-start want i)
                                                                                                                                      (t-line-end want i))
                                                                                                                          (str-concat "\n  got:  " (t-cut got
                                                                                                                                                     (t-line-start got i)
                                                                                                                                                     (t-line-end got i)))))))))))))

