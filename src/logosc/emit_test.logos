  (letmut tvals
    (vec :i64)
    (make (vec :i64)))
  (letmut out
    (vec :str)
    (make (vec :str)))
  (ir-module mtriple mqual "x86_64-unknown-linux-gnu" false)
  (let ty0 :i64 (type-prim tags names elem extra pbase powner "i64"))
  (let ty1 :i64 (type-prim tags names elem extra pbase powner "void"))
  (let f0 :i64 (ir-fn fnames fsyms fint fret fbase fcnt fparam fpc blabels pnames "untyped" "lg.m.untyped" true ty1))
  (ir-block blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 ops "entry")
  (ir-alloca ops dests a b c d t1 t2 t3 n1 sst scn tst tcn svals tvals "%e" -1)
  (ir-ret ops bbase bcnt bterm bty bhas bv1 bv2 bv3 ty0 "0")
  (ir-fn-end fbase fcnt fparam fpc blabels pnames f0)
  (let e ir-error (emit mtriple mqual tags names elem extra powner snames sbase scount sftys enames ewords gnames gdata dnames dsig dcnt dret sigtys fnames fsyms fint fret fbase fcnt fparam fpc pnames ptys blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 ops dests a b c d t1 t2 t3 n1 sst scn tst tcn svals tvals out))
  (letmut rc :str "")
  (if (ir-good e)
    (set rc "FAIL no-type: emit accepted the module")
    (set rc (t-diff "no-type" "/root/ai-language-program/src/logosc/fixtures/ir/no-type.txt" (str-concat (t-port-header)
                                                                                               (str-concat (get e text) "\n")))))
