(mod emit)

(use ir)

(fn emit-nothing :void ()
  (ret))

(fn emit-put :void ((v (ref (vec :str))) (s :str))
  (if (= (vec-len v) 0)
    (vec-push v s)
    (vec-set v 0 s))
  (ret))

(fn emit-bad :void ((flag (ref (vec :i64))) (why (ref (vec :str))) (msg :str))
  (if (= (vec-get flag 0) 0)
    (emit-put why msg)
    (emit-nothing))
  (vec-set flag 0 1)
  (ret))

(fn emit-no-type :str ((what :str) (flag (ref (vec :i64))) (why (ref (vec :str))))
  (emit-bad flag why (str-concat what " has no type"))
  (ret ""))

(fn emit-id-missing :str ((what :str) (flag (ref (vec :i64))) (why (ref (vec :str))))
  (emit-bad flag why (str-concat what " reads a type id the arena does not have"))
  (ret ""))

(fn emit-unknown-op :str ((op :i64) (flag (ref (vec :i64))) (why (ref (vec :str))))
  (emit-bad flag why (str-concat "unknown IR opcode " (str-from-i64 op)))
  (ret ""))

(fn emit-slot-bad :bool ((slot :i64) (texts (ref (vec :str))))
  (ret (if (= slot -1) false
         (or (< slot 0)
           (>= slot (vec-len texts))))))

(fn emit-check-run :void ((run (ref (vec :i64))) (tags (ref (vec :i64))) (flag (ref (vec :i64))) (why (ref (vec :str))))
  (letmut i :i64 0)
  (while (< i (vec-len run))
    (let id :i64 (vec-get run i))
    (if (and (not (= id -1))
          (or (< id 0)
            (>= id (vec-len tags))))
      (emit-bad flag why (emit-c4 "type run entry "
                           (str-from-i64 i) " reads type id "
                           (str-from-i64 id)))
      (emit-nothing))
    (set i (+ i 1)))
  (ret))

(fn emit-older-bad :bool ((tags (ref (vec :i64))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (i :i64))
  (let tag :i64 (vec-get tags i))
  (if (or (and (>= tag 1)
            (<= tag 7))
        (= tag 9))
    (ret (or (< (vec-get elem i) 0)
           (>= (vec-get elem i) i)))
    (emit-nothing))
  (if (= tag 6)
    (ret (or (< (vec-get extra i) 0)
           (>= (vec-get extra i) i)))
    (emit-nothing))
  (ret false))

(fn emit-needs-type :bool ((op :i64))
  (if (or (= op (ir-op-gaddr))
        (or (= op (ir-op-call))
          (or (= op (ir-op-allocarec))
            (or (= op (ir-op-geprec))
              (= op (ir-op-faddr))))))
    (ret false)
    (emit-nothing))
  (ret true))

(fn emit-needs-t2 :bool ((op :i64))
  (ret (or (= op (ir-op-insertvalue))
         (and (>= op (ir-op-trunc))
           (<= op (ir-op-bitcast))))))

(fn emit-var-line :str ((names (ref (vec :str))) (flag (ref (vec :i64))) (why (ref (vec :str))) (ty :i64))
  (emit-bad flag why (str-concat "no LLVM layout for type " (vec-get names ty)))
  (ret ""))

(fn emit-unknown-tag :str ((tag :i64) (flag (ref (vec :i64))) (why (ref (vec :str))))
  (emit-bad flag why (str-concat "no LLVM layout for type tag " (str-from-i64 tag)))
  (ret ""))

(fn emit-fail-free ir-error ((lines (ref (vec :str))) (flag (ref (vec :i64))) (why (ref (vec :str))) (tytext (ref (vec :str))))
  (let msg :str (vec-get why 0))
  (vec-free lines)
  (vec-free flag)
  (vec-free why)
  (vec-free tytext)
  (ret (ir-fail 1 msg)))

(fn emit-c3 :str ((x :str) (y :str) (z :str))
  (ret (str-concat x (str-concat y z))))

(fn emit-c4 :str ((w :str) (x :str) (y :str) (z :str))
  (ret (str-concat w (emit-c3 x y z))))

(fn emit-c5 :str ((v :str) (w :str) (x :str) (y :str) (z :str))
  (ret (str-concat v (emit-c4 w x y z))))

(fn emit-c6 :str ((u :str) (v :str) (w :str) (x :str) (y :str) (z :str))
  (ret (str-concat u (emit-c5 v w x y z))))

(fn emit-c7 :str ((t :str) (u :str) (v :str) (w :str) (x :str) (y :str) (z :str))
  (ret (str-concat t (emit-c6 u v w x y z))))

(fn emit-c8 :str ((s :str) (t :str) (u :str) (v :str) (w :str) (x :str) (y :str) (z :str))
  (ret (str-concat s (emit-c7 t u v w x y z))))

(fn emit-c9 :str ((r :str) (s :str) (t :str) (u :str) (v :str) (w :str) (x :str) (y :str) (z :str))
  (ret (str-concat r (emit-c8 s t u v w x y z))))

(fn emit-c10 :str ((q :str) (r :str) (s :str) (t :str) (u :str) (v :str) (w :str) (x :str) (y :str) (z :str))
  (ret (str-concat q (emit-c9 r s t u v w x y z))))

(fn emit-c11 :str ((p :str) (q :str) (r :str) (s :str) (t :str) (u :str) (v :str) (w :str) (x :str) (y :str) (z :str))
  (ret (str-concat p (emit-c10 q r s t u v w x y z))))

(fn emit-str-start :bool ((b :i64))
  (ret (or (and (>= b 65)
             (<= b 90))
         (or (and (>= b 97)
               (<= b 122))
           (or (= b 45)
             (or (= b 36)
               (or (= b 46)
                 (= b 95))))))))

(fn emit-str-char :bool ((b :i64))
  (ret (or (emit-str-start b)
         (and (>= b 48)
           (<= b 57)))))

(fn emit-plain :bool ((s :str))
  (if (= (str-len s) 0)
    (ret false)
    (emit-nothing))
  (if (not (emit-str-start (cast :i64 (str-byte s 0))))
    (ret false)
    (emit-nothing))
  (letmut i :i64 1)
  (letmut ok :bool true)
  (while (< i (str-len s))
    (set ok (and ok (emit-str-char (cast :i64 (str-byte s i)))))
    (set i (+ i 1)))
  (ret ok))

(fn emit-hex :str ((b :i64))
  (let hi :i64 (/ b 16))
  (let lo :i64 (% b 16))
  (ret (str-concat (str-slice "0123456789ABCDEF" hi (+ hi 1))
         (str-slice "0123456789ABCDEF" lo (+ lo 1)))))

(fn emit-name :str ((sigil :str) (name :str))
  (if (emit-plain name)
    (ret (str-concat sigil name))
    (emit-nothing))
  (letmut body :str "\"")
  (letmut i :i64 0)
  (while (< i (str-len name))
    (let b :i64 (cast :i64 (str-byte name i)))
    (if (and (and (>= b 32)
               (< b 127))
          (and (not (= b 34))
            (not (= b 92))))
      (set body (str-concat body (str-slice name i (+ i 1))))
      (set body (str-concat body (str-concat "\\" (emit-hex b)))))
    (set i (+ i 1)))
  (ret (str-concat sigil (str-concat body "\""))))

(fn emit-cstring :str ((data :str))
  (letmut body :str "c\"")
  (letmut i :i64 0)
  (while (< i (str-len data))
    (let b :i64 (cast :i64 (str-byte data i)))
    (if (and (and (>= b 32)
               (< b 127))
          (and (not (= b 34))
            (not (= b 92))))
      (set body (str-concat body (str-slice data i (+ i 1))))
      (set body (str-concat body (str-concat "\\" (emit-hex b)))))
    (set i (+ i 1)))
  (ret (str-concat body "\"")))

(fn emit-prim :str ((name :str))
  (if (str-eq name "i8")
    (ret "i8")
    (emit-nothing))
  (if (str-eq name "i16")
    (ret "i16")
    (emit-nothing))
  (if (str-eq name "i32")
    (ret "i32")
    (emit-nothing))
  (if (str-eq name "i64")
    (ret "i64")
    (emit-nothing))
  (if (str-eq name "u8")
    (ret "i8")
    (emit-nothing))
  (if (str-eq name "u16")
    (ret "i16")
    (emit-nothing))
  (if (str-eq name "u32")
    (ret "i32")
    (emit-nothing))
  (if (str-eq name "u64")
    (ret "i64")
    (emit-nothing))
  (if (str-eq name "bool")
    (ret "i1")
    (emit-nothing))
  (if (str-eq name "f32")
    (ret "float")
    (emit-nothing))
  (if (str-eq name "f64")
    (ret "double")
    (emit-nothing))
  (if (str-eq name "str")
    (ret "{ i8*, i64 }")
    (emit-nothing))
  (if (str-eq name "void")
    (ret "void")
    (emit-nothing))
  (if (str-eq name "thread")
    (ret "i8*")
    (emit-nothing))
  (if (str-eq name "mutex")
    (ret "i8*")
    (emit-nothing))
  (if (str-eq name "run")
    (ret "i8*")
    (emit-nothing))
  (ret ""))

(fn emit-text :str ((texts (ref (vec :str))) (ty :i64))
  (ret (if (= ty -1) ""
         (if (or (< ty 0)
               (>= ty (vec-len texts))) ""
           (vec-get texts ty)))))

(fn emit-decl-name :str ((names (ref (vec :str))) (ty :i64))
  (ret (vec-get names ty)))

(fn emit-enum-words :i64 ((enames (ref (vec :str))) (ewords (ref (vec :i64))) (name :str))
  (letmut i :i64 0)
  (letmut found :i64 -1)
  (while (< i (vec-len enames))
    (if (str-eq (vec-get enames i) name)
      (set found (vec-get ewords i))
      (emit-nothing))
    (set i (+ i 1)))
  (ret found))

(fn emit-prim-one :str ((name :str) (flag (ref (vec :i64))) (why (ref (vec :str))))
  (let spelled :str (emit-prim name))
  (if (> (str-len spelled) 0)
    (ret spelled)
    (emit-nothing))
  (emit-bad flag why (str-concat "no LLVM layout for type :" name))
  (ret ""))

(fn emit-missing-enum :str ((name :str) (flag (ref (vec :i64))) (why (ref (vec :str))))
  (emit-bad flag why (str-concat "no layout registered for enum '" (str-concat name "'")))
  (ret ""))

(fn emit-type-one :str ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (enames (ref (vec :str))) (ewords (ref (vec :i64))) (texts (ref (vec :str))) (flag (ref (vec :i64))) (why (ref (vec :str))) (ty :i64))
  (let tag :i64 (vec-get tags ty))
  (if (= tag 0)
    (ret (emit-prim-one (vec-get names ty) flag why))
    (emit-nothing))
  (if (or (= tag 1)
        (= tag 2))
    (ret (emit-c2 (emit-text texts (vec-get elem ty)) "*"))
    (emit-nothing))
  (if (= tag 3)
    (ret (emit-c5 "["
           (str-from-i64 (vec-get extra ty)) " x "
           (emit-text texts (vec-get elem ty)) "]"))
    (emit-nothing))
  (if (= tag 4)
    (ret (emit-c5 "{ " (emit-text texts (vec-get elem ty)) "*, i64, i64 }" "" ""))
    (emit-nothing))
  (if (= tag 5)
    (ret (emit-c2 (emit-text texts (vec-get elem ty)) "*"))
    (emit-nothing))
  (if (= tag 6)
    (ret (emit-c6 "{ i1, "
           (emit-text texts (vec-get elem ty)) ", "
           (emit-text texts (vec-get extra ty)) " }" ""))
    (emit-nothing))
  (if (= tag 7)
    (ret (emit-c4 "{ i1, " (emit-text texts (vec-get elem ty)) " }" ""))
    (emit-nothing))
  (if (= tag 8)
    (ret "{ i8*, i8* }")
    (emit-nothing))
  (if (= tag 9)
    (ret (emit-text texts (vec-get elem ty)))
    (emit-nothing))
  (if (or (= tag 10)
        (= tag 11))
    (ret "i8*")
    (emit-nothing))
  (if (= tag 12)
    (ret (emit-name "%" (str-concat "struct." (emit-decl-name names ty))))
    (emit-nothing))
  (if (= tag 13)
    (ret (emit-enum-line enames ewords names flag why ty))
    (emit-nothing))
  (if (= tag 14)
    (ret (emit-var-line names flag why ty))
    (emit-nothing))
  (ret (emit-unknown-tag tag flag why)))

(fn emit-c2 :str ((x :str) (y :str))
  (ret (str-concat x y)))

(fn emit-enum-line :str ((enames (ref (vec :str))) (ewords (ref (vec :i64))) (names (ref (vec :str))) (flag (ref (vec :i64))) (why (ref (vec :str))) (ty :i64))
  (let name :str (emit-decl-name names ty))
  (let words :i64 (emit-enum-words enames ewords name))
  (if (< words 0)
    (ret (emit-missing-enum name flag why))
    (emit-nothing))
  (ret (emit-c4 "{ i32, [" (str-from-i64 words) " x i64] }" "")))

(fn emit-types :void ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (enames (ref (vec :str))) (ewords (ref (vec :i64))) (flag (ref (vec :i64))) (why (ref (vec :str))) (texts (ref (vec :str))))
  (letmut i :i64 0)
  (while (< i (vec-len tags))
    (let bad :bool (emit-older-bad tags elem extra i))
    (if bad
      (vec-push texts "")
      (vec-push texts (emit-type-one tags names elem extra enames ewords texts flag why i)))
    (if bad
      (emit-bad flag why (emit-c3 "type " (str-from-i64 i) " has a child id that is not older"))
      (emit-nothing))
    (set i (+ i 1)))
  (ret))

(fn emit-record :str ((texts (ref (vec :str))) (types (ref (vec :i64))) (start :i64) (count :i64))
  (if (= count 0)
    (ret "{ }")
    (emit-nothing))
  (letmut body :str "")
  (letmut k :i64 0)
  (while (< k count)
    (if (> k 0)
      (set body (str-concat body ", "))
      (emit-nothing))
    (set body (str-concat body (emit-text texts (vec-get types (+ start k)))))
    (set k (+ k 1)))
  (ret (emit-c3 "{ " body " }")))

(fn emit-fnptr :str ((texts (ref (vec :str))) (types (ref (vec :i64))) (ret :i64) (start :i64) (count :i64))
  (letmut body :str "")
  (letmut k :i64 0)
  (while (< k count)
    (if (> k 0)
      (set body (str-concat body ", "))
      (emit-nothing))
    (set body (str-concat body (emit-text texts (vec-get types (+ start k)))))
    (set k (+ k 1)))
  (ret (emit-c4 (emit-text texts ret) " (" body ")*")))

(fn emit-global-size :i64 ((gnames (ref (vec :str))) (gdata (ref (vec :str))) (name :str))
  (letmut i :i64 0)
  (letmut found :i64 -1)
  (while (< i (vec-len gnames))
    (if (str-eq (vec-get gnames i) name)
      (set found (str-len (vec-get gdata i)))
      (emit-nothing))
    (set i (+ i 1)))
  (ret found))

(fn emit-decl-find :i64 ((dnames (ref (vec :str))) (name :str))
  (letmut i :i64 0)
  (letmut found :i64 -1)
  (while (< i (vec-len dnames))
    (if (str-eq (vec-get dnames i) name)
      (set found i)
      (emit-nothing))
    (set i (+ i 1)))
  (ret found))

(fn emit-fn-find :i64 ((fnames (ref (vec :str))) (fsyms (ref (vec :str))) (name :str))
  (letmut i :i64 0)
  (letmut found :i64 -1)
  (while (< i (vec-len fnames))
    (let sym :str (vec-get fsyms i))
    (let spelled :str (if (> (str-len sym) 0) sym
                        (vec-get fnames i)))
    (if (str-eq spelled name)
      (set found i)
      (emit-nothing))
    (set i (+ i 1)))
  (ret found))

(fn emit-global-line :str ((gnames (ref (vec :str))) (gdata (ref (vec :str))) (i :i64))
  (let data :str (vec-get gdata i))
  (let size :i64 (str-len data))
  (ret (emit-c6 "@"
         (vec-get gnames i) " = private unnamed_addr constant ["
         (str-from-i64 size) " x i8] "
         (if (= size 0) "zeroinitializer"
           (emit-cstring data)))))

(fn emit-struct-line :str ((snames (ref (vec :str))) (sbase (ref (vec :i64))) (scount (ref (vec :i64))) (sftys (ref (vec :i64))) (texts (ref (vec :str))) (i :i64))
  (ret (emit-c3 (emit-name "%" (str-concat "struct." (vec-get snames i))) " = type "
         (emit-record texts sftys
           (vec-get sbase i)
           (vec-get scount i)))))

(fn emit-call-build :str ((texts (ref (vec :str))) (types (ref (vec :i64))) (tstart :i64) (tcount :i64) (svals (ref (vec :str))) (start :i64) (count :i64) (dest :str) (callee :str) (at :str) (ret :i64))
  (letmut args :str "")
  (letmut k :i64 0)
  (while (< k count)
    (if (> k 0)
      (set args (str-concat args ", "))
      (emit-nothing))
    (set args (str-concat args (emit-c3 (emit-text texts (vec-get types (+ tstart k))) " "
                                 (vec-get svals (+ start k)))))
    (set k (+ k 1)))
  (let target :str (if (str-eq at "%") callee
                     (emit-name at callee)))
  (let call :str (emit-c7 "call " (emit-text texts ret) " " target "(" args ")"))
  (ret (if (= (str-len dest) 0) call
         (emit-c3 dest " = " call))))

(fn emit-call-arity :str ((callee :str) (want :i64) (got :i64) (flag (ref (vec :i64))) (why (ref (vec :str))))
  (emit-bad flag why (emit-c7 "'" callee "' takes "
                       (str-from-i64 want) " arguments, call passes "
                       (str-from-i64 got) ""))
  (ret ""))

(fn emit-call-check :str ((texts (ref (vec :str))) (types (ref (vec :i64))) (tstart :i64) (tcount :i64) (ret :i64) (svals (ref (vec :str))) (start :i64) (count :i64) (flag (ref (vec :i64))) (why (ref (vec :str))) (dest :str) (callee :str) (at :str))
  (if (not (= count tcount))
    (ret (emit-call-arity callee tcount count flag why))
    (emit-nothing))
  (ret (emit-call-build texts types tstart tcount svals start count dest callee at ret)))

(fn emit-call-line :str ((texts (ref (vec :str))) (sigtys (ref (vec :i64))) (dnames (ref (vec :str))) (dsig (ref (vec :i64))) (dcnt (ref (vec :i64))) (dret (ref (vec :i64))) (fnames (ref (vec :str))) (fsyms (ref (vec :str))) (fret (ref (vec :i64))) (fparam (ref (vec :i64))) (fpc (ref (vec :i64))) (ptys (ref (vec :i64))) (svals (ref (vec :str))) (flag (ref (vec :i64))) (why (ref (vec :str))) (dest :str) (callee :str) (start :i64) (count :i64))
  (let d :i64 (emit-decl-find dnames callee))
  (if (>= d 0)
    (ret (emit-call-check texts sigtys
           (vec-get dsig d)
           (vec-get dcnt d)
           (vec-get dret d) svals start count flag why dest callee "@"))
    (emit-nothing))
  (let f :i64 (emit-fn-find fnames fsyms callee))
  (if (>= f 0)
    (ret (emit-call-check texts ptys
           (vec-get fparam f)
           (vec-get fpc f)
           (vec-get fret f) svals start count flag why dest callee "@"))
    (emit-nothing))
  (emit-bad flag why (emit-c3 "call to undefined function '@" callee "'"))
  (ret ""))

(fn emit-faddr-build :str ((texts (ref (vec :str))) (types (ref (vec :i64))) (tstart :i64) (tcount :i64) (ret :i64) (dest :str) (symbol :str))
  (ret (emit-c6 dest " = bitcast "
         (emit-fnptr texts types ret tstart tcount) " "
         (emit-name "@" symbol) " to i8*")))

(fn emit-faddr-line :str ((texts (ref (vec :str))) (sigtys (ref (vec :i64))) (dnames (ref (vec :str))) (dsig (ref (vec :i64))) (dcnt (ref (vec :i64))) (dret (ref (vec :i64))) (fnames (ref (vec :str))) (fsyms (ref (vec :str))) (fret (ref (vec :i64))) (fparam (ref (vec :i64))) (fpc (ref (vec :i64))) (ptys (ref (vec :i64))) (flag (ref (vec :i64))) (why (ref (vec :str))) (dest :str) (symbol :str))
  (let d :i64 (emit-decl-find dnames symbol))
  (if (>= d 0)
    (ret (emit-faddr-build texts sigtys
           (vec-get dsig d)
           (vec-get dcnt d)
           (vec-get dret d) dest symbol))
    (emit-nothing))
  (let f :i64 (emit-fn-find fnames fsyms symbol))
  (if (>= f 0)
    (ret (emit-faddr-build texts ptys
           (vec-get fparam f)
           (vec-get fpc f)
           (vec-get fret f) dest symbol))
    (emit-nothing))
  (emit-bad flag why (emit-c3 "address of undefined function '@" symbol "'"))
  (ret ""))

(fn emit-missing-global :str ((name :str) (flag (ref (vec :i64))) (why (ref (vec :str))))
  (emit-bad flag why (emit-c3 "reference to undeclared global '@" name "'"))
  (ret ""))

(fn emit-gaddr-line :str ((gnames (ref (vec :str))) (gdata (ref (vec :str))) (dest :str) (name :str) (flag (ref (vec :i64))) (why (ref (vec :str))))
  (let size :i64 (emit-global-size gnames gdata name))
  (if (< size 0)
    (ret (emit-missing-global name flag why))
    (emit-nothing))
  (let n :str (str-from-i64 size))
  (ret (emit-c8 dest " = getelementptr inbounds [" n " x i8], [" n " x i8]* " (emit-name "@" name) ", i64 0, i64 0")))

(fn emit-phi-line :str ((texts (ref (vec :str))) (svals (ref (vec :str))) (dest :str) (ty :i64) (start :i64) (count :i64))
  (letmut body :str "")
  (letmut k :i64 0)
  (while (< k count)
    (if (> k 0)
      (set body (str-concat body ", "))
      (emit-nothing))
    (set body (str-concat body (emit-c5 "[ "
                                 (vec-get svals (+ start (* k 2))) ", %"
                                 (vec-get svals (+ start (* k 2) 1)) " ]")))
    (set k (+ k 1)))
  (ret (emit-c5 dest " = phi " (emit-text texts ty) " " body)))

(fn emit-gep-line :str ((texts (ref (vec :str))) (svals (ref (vec :str))) (dest :str) (base :i64) (value :str) (start :i64) (count :i64))
  (letmut steps :str "")
  (letmut k :i64 0)
  (while (< k count)
    (if (> k 0)
      (set steps (str-concat steps ", "))
      (emit-nothing))
    (set steps (str-concat steps (emit-c3 (vec-get svals (+ start (* k 2))) " "
                                   (vec-get svals (+ start (* k 2) 1)))))
    (set k (+ k 1)))
  (let spelled :str (emit-text texts base))
  (ret (emit-c9 dest " = getelementptr " spelled ", " spelled "* " value ", " steps)))

(fn emit-geprec-line :str ((texts (ref (vec :str))) (record :str) (dest :str) (base :str) (index :i64))
  (ret (emit-c9 dest " = getelementptr " record ", " record "* " base ", i32 0, i32 " (str-from-i64 index))))

(fn emit-icall-arity :str ((got :i64) (want :i64) (flag (ref (vec :i64))) (why (ref (vec :str))))
  (emit-bad flag why (emit-c4 "indirect call passes "
                       (str-from-i64 got) " arguments for "
                       (str-from-i64 want)))
  (ret ""))

(fn emit-icall-line :str ((texts (ref (vec :str))) (tvals (ref (vec :i64))) (tst (ref (vec :i64))) (tcn (ref (vec :i64))) (svals (ref (vec :str))) (flag (ref (vec :i64))) (why (ref (vec :str))) (i :i64) (dest :str) (callee :str) (start :i64) (count :i64) (ret :i64))
  (let tstart :i64 (vec-get tst i))
  (let tcount :i64 (vec-get tcn i))
  (if (not (= count tcount))
    (ret (emit-icall-arity count tcount flag why))
    (emit-nothing))
  (ret (emit-call-build texts tvals tstart tcount svals start count dest callee "%" ret)))

(fn emit-instr :str ((texts (ref (vec :str))) (gnames (ref (vec :str))) (gdata (ref (vec :str))) (sigtys (ref (vec :i64))) (dnames (ref (vec :str))) (dsig (ref (vec :i64))) (dcnt (ref (vec :i64))) (dret (ref (vec :i64))) (fnames (ref (vec :str))) (fsyms (ref (vec :str))) (fret (ref (vec :i64))) (fparam (ref (vec :i64))) (fpc (ref (vec :i64))) (ptys (ref (vec :i64))) (flag (ref (vec :i64))) (why (ref (vec :str))) (ops (ref (vec :i64))) (dests (ref (vec :str))) (a (ref (vec :str))) (b (ref (vec :str))) (c (ref (vec :str))) (d (ref (vec :str))) (t1 (ref (vec :i64))) (t2 (ref (vec :i64))) (n1 (ref (vec :i64))) (sst (ref (vec :i64))) (scn (ref (vec :i64))) (tst (ref (vec :i64))) (tcn (ref (vec :i64))) (svals (ref (vec :str))) (tvals (ref (vec :i64))) (i :i64))
  (let op :i64 (vec-get ops i))
  (if (= (str-len (ir-op-text op)) 0)
    (ret (emit-unknown-op op flag why))
    (emit-nothing))
  (if (or (emit-slot-bad (vec-get t1 i) texts)
        (emit-slot-bad (vec-get t2 i) texts))
    (ret (emit-id-missing (emit-c3 "IR row " (str-from-i64 i) "") flag why))
    (emit-nothing))
  (if (and (emit-needs-type op)
        (= (vec-get t1 i) -1))
    (ret (emit-no-type (emit-c3 "IR row " (str-from-i64 i) "") flag why))
    (emit-nothing))
  (if (and (emit-needs-t2 op)
        (= (vec-get t2 i) -1))
    (ret (emit-no-type (emit-c3 "IR row " (str-from-i64 i) "") flag why))
    (emit-nothing))
  (let dest :str (vec-get dests i))
  (let left :str (vec-get a i))
  (let right :str (vec-get b i))
  (let third :str (vec-get c i))
  (let index :i64 (vec-get n1 i))
  (let ty :str (emit-text texts (vec-get t1 i)))
  (if (= op (ir-op-alloca))
    (ret (emit-c3 dest " = alloca " ty))
    (emit-nothing))
  (if (= op (ir-op-store))
    (ret (emit-c8 "store " ty " " left ", " ty "* " right))
    (emit-nothing))
  (if (= op (ir-op-load))
    (ret (emit-c7 dest " = load " ty ", " ty "* " left))
    (emit-nothing))
  (if (= op (ir-op-gaddr))
    (ret (emit-gaddr-line gnames gdata dest left flag why))
    (emit-nothing))
  (if (ir-is-binary op)
    (ret (emit-c9 dest " = " (ir-op-text op) " " ty " " left ", " right))
    (emit-nothing))
  (if (or (= op (ir-op-icmp))
        (= op (ir-op-fcmp)))
    (ret (emit-c11 dest " = " (ir-op-text op) " " left " " ty " " right ", " third))
    (emit-nothing))
  (if (= op (ir-op-phi))
    (ret (emit-phi-line texts svals dest
           (vec-get t1 i)
           (vec-get sst i)
           (vec-get scn i)))
    (emit-nothing))
  (if (= op (ir-op-insertvalue))
    (ret (emit-c11 dest " = insertvalue " ty " " left ", "
           (emit-text texts (vec-get t2 i)) " " right ", "
           (str-from-i64 index)))
    (emit-nothing))
  (if (= op (ir-op-extractvalue))
    (ret (emit-c7 dest " = extractvalue " ty " " left ", " (str-from-i64 index)))
    (emit-nothing))
  (if (= op (ir-op-gep))
    (ret (emit-gep-line texts svals dest
           (vec-get t1 i) left
           (vec-get sst i)
           (vec-get scn i)))
    (emit-nothing))
  (if (ir-is-convert op)
    (ret (emit-c9 dest " = "
           (ir-op-text op) " " ty " " left " to "
           (emit-text texts (vec-get t2 i))))
    (emit-nothing))
  (if (= op (ir-op-bitcast))
    (ret (emit-c7 dest " = bitcast " ty " " left " to " (emit-text texts (vec-get t2 i))))
    (emit-nothing))
  (if (= op (ir-op-call))
    (ret (emit-call-line texts sigtys dnames dsig dcnt dret fnames fsyms fret fparam fpc ptys svals flag why dest left
           (vec-get sst i)
           (vec-get scn i)))
    (emit-nothing))
  (if (= op (ir-op-allocarec))
    (ret (emit-c3 dest " = alloca " (emit-record texts tvals
                                      (vec-get tst i)
                                      (vec-get tcn i))))
    (emit-nothing))
  (if (= op (ir-op-geprec))
    (ret (emit-geprec-line texts (emit-record texts tvals
                                   (vec-get tst i)
                                   (vec-get tcn i)) dest left index))
    (emit-nothing))
  (if (= op (ir-op-bitcastrec))
    (ret (emit-c8 dest " = bitcast " ty " " left " to " (emit-record texts tvals
                                                          (vec-get tst i)
                                                          (vec-get tcn i)) "*"))
    (emit-nothing))
  (if (= op (ir-op-bitcastout))
    (ret (emit-c7 dest " = bitcast " (emit-record texts tvals
                                       (vec-get tst i)
                                       (vec-get tcn i)) "* " left " to " ty))
    (emit-nothing))
  (if (= op (ir-op-faddr))
    (ret (emit-faddr-line texts sigtys dnames dsig dcnt dret fnames fsyms fret fparam fpc ptys flag why dest left))
    (emit-nothing))
  (if (= op (ir-op-fnptr))
    (ret (emit-c5 dest " = bitcast i8* " left " to " (emit-fnptr texts tvals
                                                       (vec-get t1 i)
                                                       (vec-get tst i)
                                                       (vec-get tcn i))))
    (emit-nothing))
  (if (= op (ir-op-icall))
    (ret (emit-icall-line texts tvals tst tcn svals flag why i dest left
           (vec-get sst i)
           (vec-get scn i)
           (vec-get t1 i)))
    (emit-nothing))
  (emit-bad flag why (str-concat "unknown IR opcode " (str-from-i64 op)))
  (ret ""))

(fn emit-no-term :str ((label :str) (flag (ref (vec :i64))) (why (ref (vec :str))))
  (emit-bad flag why (emit-c3 "block '" label "' has no terminator"))
  (ret ""))

(fn emit-term :str ((texts (ref (vec :str))) (blabels (ref (vec :str))) (bterm (ref (vec :i64))) (bty (ref (vec :i64))) (bhas (ref (vec :i64))) (bv1 (ref (vec :str))) (bv2 (ref (vec :str))) (bv3 (ref (vec :str))) (flag (ref (vec :i64))) (why (ref (vec :str))) (b :i64))
  (let term :i64 (vec-get bterm b))
  (if (= term 0)
    (ret (emit-no-term (vec-get blabels b) flag why))
    (emit-nothing))
  (if (emit-slot-bad (vec-get bty b) texts)
    (ret (emit-id-missing (emit-c3 "block '" (vec-get blabels b) "' terminator") flag why))
    (emit-nothing))
  (if (and (= term (ir-term-ret))
        (and (= (vec-get bhas b) 1)
          (= (vec-get bty b) -1)))
    (ret (emit-no-type (emit-c3 "block '" (vec-get blabels b) "' terminator") flag why))
    (emit-nothing))
  (if (= term (ir-term-ret))
    (ret (if (= (vec-get bhas b) 1)
           (emit-c4 "ret "
             (emit-text texts (vec-get bty b)) " "
             (vec-get bv1 b)) "ret void"))
    (emit-nothing))
  (if (= term (ir-term-br))
    (ret (str-concat "br label %" (vec-get bv1 b)))
    (emit-nothing))
  (if (= term (ir-term-cbr))
    (ret (emit-c8 "br i1 "
           (vec-get bv1 b) ", label %"
           (vec-get bv2 b) ", label %"
           (vec-get bv3 b) "" ""))
    (emit-nothing))
  (if (= term (ir-term-unreachable))
    (ret "unreachable")
    (emit-nothing))
  (emit-bad flag why (str-concat "unknown IR terminator " (str-from-i64 term)))
  (ret ""))

(fn emit-block :void ((texts (ref (vec :str))) (gnames (ref (vec :str))) (gdata (ref (vec :str))) (sigtys (ref (vec :i64))) (dnames (ref (vec :str))) (dsig (ref (vec :i64))) (dcnt (ref (vec :i64))) (dret (ref (vec :i64))) (fnames (ref (vec :str))) (fsyms (ref (vec :str))) (fret (ref (vec :i64))) (fparam (ref (vec :i64))) (fpc (ref (vec :i64))) (ptys (ref (vec :i64))) (flag (ref (vec :i64))) (why (ref (vec :str))) (ops (ref (vec :i64))) (dests (ref (vec :str))) (a (ref (vec :str))) (b (ref (vec :str))) (c (ref (vec :str))) (d (ref (vec :str))) (t1 (ref (vec :i64))) (t2 (ref (vec :i64))) (n1 (ref (vec :i64))) (sst (ref (vec :i64))) (scn (ref (vec :i64))) (tst (ref (vec :i64))) (tcn (ref (vec :i64))) (svals (ref (vec :str))) (tvals (ref (vec :i64))) (blabels (ref (vec :str))) (bbase (ref (vec :i64))) (bcnt (ref (vec :i64))) (bterm (ref (vec :i64))) (bty (ref (vec :i64))) (bhas (ref (vec :i64))) (bv1 (ref (vec :str))) (bv2 (ref (vec :str))) (bv3 (ref (vec :str))) (lines (ref (vec :str))) (bl :i64))
  (vec-push lines (str-concat (vec-get blabels bl) ":"))
  (letmut i :i64 (vec-get bbase bl))
  (let past :i64 (+ i (vec-get bcnt bl)))
  (while (< i past)
    (let line :str (emit-instr texts gnames gdata sigtys dnames dsig dcnt dret fnames fsyms fret fparam fpc ptys flag why ops dests a b c d t1 t2 n1 sst scn tst tcn svals tvals i))
    (if (= (str-len line) 0)
      (emit-nothing)
      (vec-push lines (str-concat "  " line)))
    (set i (+ i 1)))
  (vec-push lines (str-concat "  " (emit-term texts blabels bterm bty bhas bv1 bv2 bv3 flag why bl)))
  (ret))

(fn emit-fn :void ((texts (ref (vec :str))) (fnames (ref (vec :str))) (fsyms (ref (vec :str))) (fint (ref (vec :i64))) (fret (ref (vec :i64))) (fbase (ref (vec :i64))) (fcnt (ref (vec :i64))) (fparam (ref (vec :i64))) (fpc (ref (vec :i64))) (ptys (ref (vec :i64))) (pnames (ref (vec :str))) (gnames (ref (vec :str))) (gdata (ref (vec :str))) (sigtys (ref (vec :i64))) (dnames (ref (vec :str))) (dsig (ref (vec :i64))) (dcnt (ref (vec :i64))) (dret (ref (vec :i64))) (flag (ref (vec :i64))) (why (ref (vec :str))) (ops (ref (vec :i64))) (dests (ref (vec :str))) (a (ref (vec :str))) (b (ref (vec :str))) (c (ref (vec :str))) (d (ref (vec :str))) (t1 (ref (vec :i64))) (t2 (ref (vec :i64))) (n1 (ref (vec :i64))) (sst (ref (vec :i64))) (scn (ref (vec :i64))) (tst (ref (vec :i64))) (tcn (ref (vec :i64))) (svals (ref (vec :str))) (tvals (ref (vec :i64))) (blabels (ref (vec :str))) (bbase (ref (vec :i64))) (bcnt (ref (vec :i64))) (bterm (ref (vec :i64))) (bty (ref (vec :i64))) (bhas (ref (vec :i64))) (bv1 (ref (vec :str))) (bv2 (ref (vec :str))) (bv3 (ref (vec :str))) (lines (ref (vec :str))) (f :i64))
  (let sym :str (vec-get fsyms f))
  (let name :str (if (> (str-len sym) 0) sym
                   (vec-get fnames f)))
  (let pstart :i64 (vec-get fparam f))
  (let past :i64 (+ pstart (vec-get fpc f)))
  (letmut p :i64 pstart)
  (letmut plist :str "")
  (while (< p past)
    (if (> p pstart)
      (set plist (str-concat plist ", "))
      (emit-nothing))
    (set plist (str-concat plist (emit-c3 (emit-text texts (vec-get ptys p)) " "
                                   (emit-name "%" (vec-get pnames p)))))
    (set p (+ p 1)))
  (vec-push lines (emit-c8 "define "
                    (if (= (vec-get fint f) 1) "internal " "")
                    (emit-text texts (vec-get fret f)) " "
                    (emit-name "@" name) "(" plist ") {"))
  (let blstart :i64 (vec-get fbase f))
  (let blpast :i64 (+ blstart (vec-get fcnt f)))
  (letmut bl :i64 blstart)
  (while (< bl blpast)
    (emit-block texts gnames gdata sigtys dnames dsig dcnt dret fnames fsyms fret fparam fpc ptys flag why ops dests a b c d t1 t2 n1 sst scn tst tcn svals tvals blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 lines bl)
    (set bl (+ bl 1)))
  (vec-push lines "}")
  (ret))

(fn emit-join :str ((lines (ref (vec :str))) (lo :i64) (hi :i64))
  (if (= (- hi lo) 0)
    (ret "")
    (emit-nothing))
  (if (= (- hi lo) 1)
    (ret (vec-get lines lo))
    (emit-nothing))
  (let mid :i64 (+ lo (/ (- hi lo) 2)))
  (ret (str-concat (emit-join lines lo mid)
         (str-concat "\n" (emit-join lines mid hi)))))

(fn emit-decl-line :str ((texts (ref (vec :str))) (sigtys (ref (vec :i64))) (dnames (ref (vec :str))) (dsig (ref (vec :i64))) (dcnt (ref (vec :i64))) (dret (ref (vec :i64))) (i :i64))
  (let start :i64 (vec-get dsig i))
  (let count :i64 (vec-get dcnt i))
  (letmut params :str "")
  (letmut k :i64 0)
  (while (< k count)
    (if (> k 0)
      (set params (str-concat params ", "))
      (emit-nothing))
    (set params (str-concat params (emit-text texts (vec-get sigtys (+ start k)))))
    (set k (+ k 1)))
  (ret (emit-c7 "declare "
         (emit-text texts (vec-get dret i)) " "
         (emit-name "@" (vec-get dnames i)) "(" params ")")))

(fn emit ir-error ((mtriple (ref (vec :str))) (mqual (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (powner (ref (vec :str))) (snames (ref (vec :str))) (sbase (ref (vec :i64))) (scount (ref (vec :i64))) (sftys (ref (vec :i64))) (enames (ref (vec :str))) (ewords (ref (vec :i64))) (gnames (ref (vec :str))) (gdata (ref (vec :str))) (dnames (ref (vec :str))) (dsig (ref (vec :i64))) (dcnt (ref (vec :i64))) (dret (ref (vec :i64))) (sigtys (ref (vec :i64))) (fnames (ref (vec :str))) (fsyms (ref (vec :str))) (fint (ref (vec :i64))) (fret (ref (vec :i64))) (fbase (ref (vec :i64))) (fcnt (ref (vec :i64))) (fparam (ref (vec :i64))) (fpc (ref (vec :i64))) (pnames (ref (vec :str))) (ptys (ref (vec :i64))) (blabels (ref (vec :str))) (bbase (ref (vec :i64))) (bcnt (ref (vec :i64))) (bterm (ref (vec :i64))) (bty (ref (vec :i64))) (bhas (ref (vec :i64))) (bv1 (ref (vec :str))) (bv2 (ref (vec :str))) (bv3 (ref (vec :str))) (ops (ref (vec :i64))) (dests (ref (vec :str))) (a (ref (vec :str))) (b (ref (vec :str))) (c (ref (vec :str))) (d (ref (vec :str))) (t1 (ref (vec :i64))) (t2 (ref (vec :i64))) (t3 (ref (vec :i64))) (n1 (ref (vec :i64))) (sst (ref (vec :i64))) (scn (ref (vec :i64))) (tst (ref (vec :i64))) (tcn (ref (vec :i64))) (svals (ref (vec :str))) (tvals (ref (vec :i64))) (out (ref (vec :str))))
  (letmut lines
    (vec :str)
    (make (vec :str)))
  (letmut flag
    (vec :i64)
    (make (vec :i64)))
  (letmut why
    (vec :str)
    (make (vec :str)))
  (letmut tytext
    (vec :str)
    (make (vec :str)))
  (vec-push flag 0)
  (vec-push why "")
  (emit-check-run sigtys tags flag why)
  (emit-check-run ptys tags flag why)
  (emit-check-run tvals tags flag why)
  (emit-check-run dret tags flag why)
  (emit-check-run fret tags flag why)
  (if (= (vec-get flag 0) 1)
    (ret (emit-fail-free lines flag why tytext))
    (emit-nothing))
  (emit-types tags names elem extra enames ewords flag why tytext)
  (if (= (vec-get flag 0) 1)
    (ret (emit-fail-free lines flag why tytext))
    (emit-nothing))
  (vec-push lines "; generated by logos")
  (vec-push lines (emit-c3 "target triple = \"" (vec-get mtriple 0) "\""))
  (vec-push lines "")
  (letmut i :i64 0)
  (while (< i (vec-len snames))
    (vec-push lines (emit-struct-line snames sbase scount sftys tytext i))
    (set i (+ i 1)))
  (if (= (vec-len snames) 0)
    (emit-nothing)
    (vec-push lines ""))
  (set i 0)
  (while (< i (vec-len gnames))
    (vec-push lines (emit-global-line gnames gdata i))
    (set i (+ i 1)))
  (if (= (vec-len gnames) 0)
    (emit-nothing)
    (vec-push lines ""))
  (set i 0)
  (while (< i (vec-len dnames))
    (vec-push lines (emit-decl-line tytext sigtys dnames dsig dcnt dret i))
    (set i (+ i 1)))
  (if (= (vec-len dnames) 0)
    (emit-nothing)
    (vec-push lines ""))
  (set i 0)
  (while (< i (vec-len fnames))
    (if (> i 0)
      (vec-push lines "")
      (emit-nothing))
    (emit-fn tytext fnames fsyms fint fret fbase fcnt fparam fpc ptys pnames gnames gdata sigtys dnames dsig dcnt dret flag why ops dests a b c d t1 t2 n1 sst scn tst tcn svals tvals blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 lines i)
    (set i (+ i 1)))
  (let text :str (str-concat (emit-join lines 0 (vec-len lines)) "\n"))
  (let failed :bool (= (vec-get flag 0) 1))
  (let msg :str (vec-get why 0))
  (vec-free lines)
  (vec-free flag)
  (vec-free why)
  (vec-free tytext)
  (if failed
    (ret (ir-fail 1 msg))
    (emit-nothing))
  (emit-put out text)
  (ret (ir-ok)))

(fn emit-type-text :str ((tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (powner (ref (vec :str))) (enames (ref (vec :str))) (ewords (ref (vec :i64))) (mqual (ref (vec :i64))) (ty :i64) (why (ref (vec :str))))
  (letmut texts
    (vec :str)
    (make (vec :str)))
  (letmut flag
    (vec :i64)
    (make (vec :i64)))
  (vec-push flag 0)
  (emit-types tags names elem extra enames ewords flag why texts)
  (if (emit-slot-bad ty texts)
    (emit-bad flag why "the requested type id is not in the arena")
    (emit-nothing))
  (let text :str (emit-text texts ty))
  (vec-free texts)
  (vec-free flag)
  (ret text))
