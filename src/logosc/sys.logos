(mod sys)

(extern fn rt_exe_path :str ())

(extern fn rt_getenv :str ((name :str)))

(fn sys-nothing :void ()
  (ret))

(fn sys-env :str ((name :str))
  (ret (rt_getenv name)))

(fn sys-exe :str ()
  (ret (rt_exe_path)))

(fn sys-trim :str ((s :str))
  (letmut n :i64 (str-len s))
  (while (and (> n 1)
           (= (cast :i64 (str-byte s (- n 1))) 47))
    (set n (- n 1)))
  (ret (str-slice s 0 n)))

(fn sys-dir :str ((path :str))
  (let n :i64 (str-len path))
  (letmut i :i64 (- n 1))
  (letmut at :i64 -1)
  (while (and (= at -1)
           (>= i 0))
    (set at (if (= (cast :i64 (str-byte path i)) 47) i at))
    (set i (- i 1)))
  (ret (if (= at -1) ""
         (if (= at 0) "/"
           (str-slice path 0 at)))))

(fn sys-join :str ((dir :str) (base :str))
  (let d :str (sys-trim dir))
  (ret (if (str-eq d "") base
         (if (str-eq d "/")
           (str-concat "/" base)
           (str-concat d (str-concat "/" base))))))

(fn sys-root :str ()
  (let env :str (sys-trim (rt_getenv "LOGOS_ROOT")))
  (if (not (str-eq env ""))
    (ret env)
    (sys-nothing))
  (let exe :str (rt_exe_path))
  (if (str-eq exe "")
    (ret "")
    (sys-nothing))
  (ret (sys-dir (sys-dir exe))))

(fn sys-split-paths :void ((out (ref (vec :str))) (s :str))
  (let n :i64 (str-len s))
  (letmut start :i64 0)
  (letmut i :i64 0)
  (while (< i n)
    (if (= (cast :i64 (str-byte s i)) 58)
      (if (> i start)
        (vec-push out (str-slice s start i))
        (sys-nothing))
      (sys-nothing))
    (if (= (cast :i64 (str-byte s i)) 58)
      (set start (+ i 1))
      (sys-nothing))
    (set i (+ i 1)))
  (if (> i start)
    (vec-push out (str-slice s start i))
    (sys-nothing))
  (ret))

(fn sys-list :str ((items (ref (vec :str))))
  (letmut text :str "")
  (letmut i :i64 0)
  (while (< i (vec-len items))
    (set text (if (str-eq text "")
                (vec-get items i)
                (str-concat text (str-concat ", " (vec-get items i)))))
    (set i (+ i 1)))
  (ret text))
