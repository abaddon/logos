(mod lex)

(type lex-error (struct (failed :bool) (line :i64) (col :i64) (msg :str)))

(fn lex-pass lex-error ()
  (ret (make lex-error false 0 0 "")))

(fn lex-fail lex-error ((line :i64) (col :i64) (msg :str))
  (ret (make lex-error true line col msg)))

(fn lex-byte :i64 ((s :str) (i :i64))
  (ret (cast :i64 (str-byte s i))))

(fn lex-space :bool ((b :i64))
  (ret (or (= b 32)
         (and (>= b 9)
           (<= b 13)))))

(fn lex-control :bool ((b :i64))
  (ret (or (and (< b 32)
             (not (lex-space b)))
         (= b 127))))

(fn lex-digit :bool ((b :i64))
  (ret (and (>= b 48)
         (<= b 57))))

(fn lex-sign :bool ((b :i64))
  (ret (or (= b 43)
         (= b 45))))

(fn lex-ok :bool ((e lex-error))
  (ret (not (get e failed))))

(fn lex-continuation :bool ((b :i64))
  (ret (and (>= b 128)
         (< b 192))))

(fn lex-advance :void ((st (ref (vec :i64))) (b :i64))
  (vec-set st 0 (+ (vec-get st 0) 1))
  (vec-set st 2 (if (= b 10) 1
                  (+ (vec-get st 2)
                    (if (lex-continuation b) 0 1))))
  (vec-set st 1 (if (= b 10)
                  (+ (vec-get st 1) 1)
                  (vec-get st 1))))

(fn lex-past-escape :void ((st (ref (vec :i64))))
  (vec-set st 0 (+ (vec-get st 0) 2))
  (vec-set st 2 (+ (vec-get st 2) 2)))

(fn lex-skip :void ((src :str) (st (ref (vec :i64))) (n :i64))
  (while (and (< (vec-get st 0) n)
           (lex-space (lex-byte src (vec-get st 0))))
    (lex-advance st (lex-byte src (vec-get st 0)))))

(fn lex-digits :i64 ((s :str) (from :i64) (n :i64))
  (letmut at :i64 from)
  (while (and (< at n)
           (lex-digit (lex-byte s at)))
    (set at (+ at 1)))
  (ret at))

(fn lex-frac :i64 ((s :str) (from :i64) (n :i64))
  (letmut dot :bool (and (< from n)
                      (= (lex-byte s from) 46)))
  (letmut end :i64 from)
  (if dot
    (set end (lex-digits s (+ from 1) n))
    (set end from))
  (ret (if (and dot (= end (+ from 1))) -1 end)))

(fn lex-exponent-at :i64 ((s :str) (from :i64) (n :i64))
  (ret (if (and (< from n)
             (or (= (lex-byte s from) 101)
               (= (lex-byte s from) 69)))
         (if (and (< (+ from 1) n)
               (lex-sign (lex-byte s (+ from 1))))
           (+ from 2)
           (+ from 1)) -1)))

(fn lex-exponent :i64 ((s :str) (from :i64) (n :i64))
  (let at :i64 (lex-exponent-at s from n))
  (letmut end :i64 from)
  (if (= at -1)
    (set end from)
    (set end (lex-digits s at n)))
  (ret (if (and (> at -1)
             (= end at)) -1 end)))

(fn lex-number-tail :bool ((s :str) (head :i64) (n :i64))
  (let frac :i64 (lex-frac s head n))
  (letmut ok :bool false)
  (if (= frac -1)
    (set ok false)
    (set ok (= (lex-exponent s frac n) n)))
  (ret ok))

(fn lex-number :bool ((s :str))
  (let n :i64 (str-len s))
  (let start :i64 (if (and (> n 0)
                        (lex-sign (lex-byte s 0))) 1 0))
  (let head :i64 (lex-digits s start n))
  (letmut ok :bool false)
  (if (> head start)
    (set ok (lex-number-tail s head n))
    (set ok false))
  (ret ok))

(fn lex-escaped :bool ((b :i64))
  (ret (or (= b 92)
         (or (= b 34)
           (or (= b 110)
             (or (= b 116)
               (or (= b 114)
                 (= b 48))))))))

(fn lex-escape-text :str ((s :str) (at :i64))
  (let b :i64 (lex-byte s (+ at 1)))
  (ret (if (= b 92) "\\"
         (if (= b 34) "\""
           (if (= b 110) "\n"
             (if (= b 116) "\t"
               (if (= b 114) "\r" "\0")))))))

(fn lex-escape-msg :str ((s :str) (at :i64))
  (ret (str-concat "unknown escape \\" (str-slice s
                                         (+ at 1)
                                         (+ at 2)))))

(fn lex-string-code :i64 ((s :str) (at :i64) (n :i64))
  (let b :i64 (lex-byte s at))
  (ret (if (= b 34) 2
         (if (= b 92)
           (if (>= (+ at 1) n) 4
             (if (lex-escaped (lex-byte s (+ at 1))) 1 3)) 0))))

(fn lex-emit :void ((kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))) (kind :i64) (text :str) (line :i64) (col :i64))
  (vec-push kinds kind)
  (vec-push texts text)
  (vec-push lines line)
  (vec-push cols col))

(fn lex-paren lex-error ((st (ref (vec :i64))) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))) (kind :i64) (text :str) (b :i64))
  (lex-emit kinds texts lines cols kind text
    (vec-get st 1)
    (vec-get st 2))
  (lex-advance st b)
  (ret (lex-pass)))

(fn lex-atom-byte :bool ((b :i64))
  (ret (and (not (lex-space b))
         (and (not (lex-control b))
           (and (not (= b 40))
             (and (not (= b 41))
               (not (= b 34))))))))

(fn lex-atom lex-error ((src :str) (st (ref (vec :i64))) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))) (n :i64))
  (let line :i64 (vec-get st 1))
  (let col :i64 (vec-get st 2))
  (let start :i64 (vec-get st 0))
  (while (and (< (vec-get st 0) n)
           (lex-atom-byte (lex-byte src (vec-get st 0))))
    (lex-advance st (lex-byte src (vec-get st 0))))
  (let text :str (str-slice src start (vec-get st 0)))
  (lex-emit kinds texts lines cols (if (lex-number text) 4 2) text line col)
  (ret (lex-pass)))

(fn lex-string-token lex-error ((src :str) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))) (line :i64) (col :i64) (open :i64) (lit :bool) (out :str) (end :i64))
  (lex-emit kinds texts lines cols 3 (if lit out (str-slice src (+ open 1) end)) line col)
  (ret (lex-pass)))

(fn lex-string lex-error ((src :str) (st (ref (vec :i64))) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))) (n :i64))
  (let line :i64 (vec-get st 1))
  (let col :i64 (vec-get st 2))
  (let open :i64 (vec-get st 0))
  (letmut out :str "")
  (letmut lit :bool false)
  (letmut end :i64 -1)
  (letmut err lex-error (lex-pass))
  (letmut go :bool true)
  (lex-advance st 34)
  (while (and go (< (vec-get st 0) n))
    (let at :i64 (vec-get st 0))
    (let b :i64 (lex-byte src at))
    (let code :i64 (lex-string-code src at n))
    (let esc :bool (= code 1))
    (let text :str (if esc
                     (lex-escape-text src at)
                     (if (= code 0)
                       (str-slice src at (+ at 1)) "")))
    (set end (if (= code 2) at end))
    (set go (< code 2))
    (set out (if (and (or lit esc)
                   (> (str-len text) 0))
               (str-concat (if lit out (str-slice src (+ open 1) at)) text) out))
    (set lit (or lit esc))
    (set err (if (= code 3)
               (lex-fail (vec-get st 1)
                 (vec-get st 2)
                 (lex-escape-msg src at)) err))
    (if esc
      (lex-past-escape st)
      (lex-advance st b)))
  (ret (if (not (lex-ok err)) err
         (if (= end -1)
           (lex-fail line col "unterminated string")
           (lex-string-token src kinds texts lines cols line col open lit out end)))))

(fn lex-token lex-error ((src :str) (st (ref (vec :i64))) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))) (n :i64))
  (let b :i64 (lex-byte src (vec-get st 0)))
  (ret (if (lex-control b)
         (lex-fail (vec-get st 1)
           (vec-get st 2) "unknown character")
         (if (= b 40)
           (lex-paren st kinds texts lines cols 0 "(" b)
           (if (= b 41)
             (lex-paren st kinds texts lines cols 1 ")" b)
             (if (= b 34)
               (lex-string src st kinds texts lines cols n)
               (lex-atom src st kinds texts lines cols n)))))))

(fn lex-next lex-error ((src :str) (st (ref (vec :i64))) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))) (n :i64))
  (lex-skip src st n)
  (ret (if (< (vec-get st 0) n)
         (lex-token src st kinds texts lines cols n)
         (lex-pass))))

(fn lex lex-error ((src :str) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))))
  (letmut st
    (vec :i64)
    (make (vec :i64)))
  (vec-push st 0)
  (vec-push st 1)
  (vec-push st 1)
  (let n :i64 (str-len src))
  (letmut err lex-error (lex-pass))
  (letmut go :bool true)
  (while (and go (< (vec-get st 0) n))
    (set err (lex-next src st kinds texts lines cols n))
    (set go (lex-ok err)))
  (vec-free st)
  (ret err))
