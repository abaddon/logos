(mod check-test)

(use lex)

(use tree)

(use resolve)

(use check)

(use types)

(use map)

(fn show-check-fail :void ((e check-error))
  (println (check-code (get e code)))
  (println (get e path))
  (println (get e message)))

(fn show-check :void ((e check-error))
  (if (check-ok e)
    (println "OK")
    (show-check-fail e)))

(fn show-resolve-fail :void ((e resolve-error))
  (println (resolve-code (get e code)))
  (println (get e path))
  (println (get e message)))

(fn show-resolve :void ((e resolve-error))
  (if (resolve-ok e)
    (println "OK")
    (show-resolve-fail e)))

(fn dump-resolved :void ((path :str) (nodes (ref (vec node))) (ntexts (ref (vec :str))))
  (letmut defs
    (vec resolve-def)
    (make (vec resolve-def)))
  (letmut mods
    (vec resolve-mod)
    (make (vec resolve-mod)))
  (let re resolve-error (resolve-set nodes ntexts path defs mods))
  (if (resolve-ok re)
    (show-check (check-file mods nodes ntexts))
    (show-resolve re))
  (vec-free defs)
  (vec-free mods))

(fn dump-tree :void ((path :str) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))) (nodes (ref (vec node))) (ntexts (ref (vec :str))))
  (let t tree-error (tree-parse kinds texts lines cols nodes ntexts))
  (if (tree-ok t)
    (dump-resolved path nodes ntexts)
    (println (get t msg))))

(fn dump-src-at :void ((path :str) (src :str))
  (letmut kinds
    (vec :i64)
    (make (vec :i64)))
  (letmut texts
    (vec :str)
    (make (vec :str)))
  (letmut lines
    (vec :i64)
    (make (vec :i64)))
  (letmut cols
    (vec :i64)
    (make (vec :i64)))
  (letmut nodes
    (vec node)
    (make (vec node)))
  (letmut ntexts
    (vec :str)
    (make (vec :str)))
  (let e lex-error (lex src kinds texts lines cols))
  (if (lex-ok e)
    (dump-tree path kinds texts lines cols nodes ntexts)
    (println (get e msg)))
  (vec-free kinds)
  (vec-free texts)
  (vec-free lines)
  (vec-free cols)
  (vec-free nodes)
  (vec-free ntexts))

(fn dump-src :void ((src :str))
  (dump-src-at "src/logosc/check_test.logos" (str-concat "(mod m)\n" src)))

(fn dump-file :void ((path :str))
  (dump-src-at path (read-file path)))

(fn dup-main :void ()
  (letmut nodes
    (vec node)
    (make (vec node)))
  (letmut ntexts
    (vec :str)
    (make (vec :str)))
  (letmut kinds
    (vec :i64)
    (make (vec :i64)))
  (letmut texts
    (vec :str)
    (make (vec :str)))
  (letmut lines
    (vec :i64)
    (make (vec :i64)))
  (letmut cols
    (vec :i64)
    (make (vec :i64)))
  (let e lex-error (lex "(mod main-a)\n(fn main :i64 () (ret 0))" kinds texts lines cols))
  (if (lex-ok e)
    (dup-main-tree nodes ntexts kinds texts lines cols)
    (println (get e msg)))
  (vec-free nodes)
  (vec-free ntexts)
  (vec-free kinds)
  (vec-free texts)
  (vec-free lines)
  (vec-free cols))

(fn dup-main-tree :void ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))))
  (let t tree-error (tree-parse kinds texts lines cols nodes ntexts))
  (if (tree-ok t)
    (dup-main-mods nodes ntexts)
    (println (get t msg))))

(fn dup-main-mods :void ((nodes (ref (vec node))) (ntexts (ref (vec :str))))
  (letmut mods
    (vec resolve-mod)
    (make (vec resolve-mod)))
  (vec-push mods (make resolve-mod "main-a" "src/logosc/fixtures/check/main-a.logos" 0 0))
  (vec-push mods (make resolve-mod "main-b" "src/logosc/fixtures/check/main-b.logos" 0 0))
  (show-check (check-file mods nodes ntexts))
  (vec-free mods))

