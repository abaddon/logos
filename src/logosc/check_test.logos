(fn instance-arena :void ((args (ref (vec :i64))) (tags (ref (vec :i64))) (names (ref (vec :str))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (powner (ref (vec :str))) (pnames (ref (vec :str))) (ptypes (ref (vec :i64))))
  (let i64 :i64 (type-prim tags names elem extra pbase powner "i64"))
  (let p :i64 (type-struct tags names elem extra pbase powner "point" "m" -1 0))
  (let v :i64 (type-vec tags names elem extra pbase powner p))
  (vec-push args i64)
  (vec-push args v)
  (ret))

(test instance-name
  (expect (out "keep$i64$vec(s5_point)\n")
    (code 0)
    (leaks 0))
  (instance-name-case))

(fn instance-name-case :void ()
  (letmut tags
    (vec :i64)
    (make (vec :i64)))
  (letmut names
    (vec :str)
    (make (vec :str)))
  (letmut elem
    (vec :i64)
    (make (vec :i64)))
  (letmut extra
    (vec :i64)
    (make (vec :i64)))
  (letmut pbase
    (vec :i64)
    (make (vec :i64)))
  (letmut powner
    (vec :str)
    (make (vec :str)))
  (letmut pnames
    (vec :str)
    (make (vec :str)))
  (letmut ptypes
    (vec :i64)
    (make (vec :i64)))
  (letmut args
    (vec :i64)
    (make (vec :i64)))
  (instance-arena args tags names elem extra pbase powner pnames ptypes)
  (letmut out
    (vec :str)
    (make (vec :str)))
  (vec-push out "")
  (let e check-error (check-instance-name tags names elem extra pbase ptypes "keep" args "m/f/2" out))
  (if (check-ok e)
    (println (vec-get out 0))
    (show-check-fail e))
  (vec-free tags)
  (vec-free names)
  (vec-free elem)
  (vec-free extra)
  (vec-free pbase)
  (vec-free powner)
  (vec-free pnames)
  (vec-free ptypes)
  (vec-free args)
  (vec-free out))

(test instance-var
  (expect (out "E0501\nm/f/2\ntype variable T cannot be a type argument\n")
    (code 0)
    (leaks 0))
  (instance-var-case))

(fn instance-var-case :void ()
  (letmut tags
    (vec :i64)
    (make (vec :i64)))
  (letmut names
    (vec :str)
    (make (vec :str)))
  (letmut elem
    (vec :i64)
    (make (vec :i64)))
  (letmut extra
    (vec :i64)
    (make (vec :i64)))
  (letmut pbase
    (vec :i64)
    (make (vec :i64)))
  (letmut powner
    (vec :str)
    (make (vec :str)))
  (letmut pnames
    (vec :str)
    (make (vec :str)))
  (letmut ptypes
    (vec :i64)
    (make (vec :i64)))
  (letmut args
    (vec :i64)
    (make (vec :i64)))
  (vec-push args (type-var tags names elem extra pbase powner "T"))
  (letmut out
    (vec :str)
    (make (vec :str)))
  (vec-push out "")
  (show-check (check-instance-name tags names elem extra pbase ptypes "id" args "m/f/2" out))
  (vec-free tags)
  (vec-free names)
  (vec-free elem)
  (vec-free extra)
  (vec-free pbase)
  (vec-free powner)
  (vec-free pnames)
  (vec-free ptypes)
  (vec-free args)
  (vec-free out))

(test instance-duplicate
  (expect (out "0\n0\n1\n")
    (code 0)
    (leaks 0))
  (instance-duplicate-case))

(fn instance-duplicate-case :void ()
  (letmut keys
    (vec :str)
    (make (vec :str)))
  (letmut vals
    (vec :i64)
    (make (vec :i64)))
  (letmut slots
    (vec :i64)
    (make (vec :i64)))
  (map-init slots 8)
  (letmut instances
    (vec :str)
    (make (vec :str)))
  (letmut one
    (vec :i64)
    (make (vec :i64)))
  (vec-push one -1)
  (letmut e check-error (check-instance-add keys vals slots instances "id$i64" "m/f/2" one))
  (println (str-from-i64 (vec-get one 0)))
  (vec-set one 0 -1)
  (set e (check-instance-add keys vals slots instances "id$i64" "m/f/2" one))
  (println (str-from-i64 (vec-get one 0)))
  (if (check-ok e)
    (println (str-from-i64 (vec-len instances)))
    (show-check-fail e))
  (vec-free keys)
  (vec-free vals)
  (vec-free slots)
  (vec-free instances)
  (vec-free one))

(test instance-limit
  (expect (out "E0500\nm/f/2\nmore than 256 instantiations of generic functions\n")
    (code 0)
    (leaks 0))
  (instance-limit-case))

(fn instance-limit-case :void ()
  (letmut keys
    (vec :str)
    (make (vec :str)))
  (letmut vals
    (vec :i64)
    (make (vec :i64)))
  (letmut slots
    (vec :i64)
    (make (vec :i64)))
  (map-init slots 8)
  (letmut instances
    (vec :str)
    (make (vec :str)))
  (letmut one
    (vec :i64)
    (make (vec :i64)))
  (vec-push one -1)
  (letmut err check-error (check-pass))
  (letmut i :i64 0)
  (while (and (check-ok err)
           (< i 257))
    (set err (check-instance-add keys vals slots instances (str-concat "id$" (str-from-i64 i)) "m/f/2" one))
    (set i (+ i 1)))
  (show-check err)
  (vec-free keys)
  (vec-free vals)
  (vec-free slots)
  (vec-free instances)
  (vec-free one))
