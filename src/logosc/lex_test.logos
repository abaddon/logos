(mod lex-test)

(use lex)

(fn print-tokens :void ((kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))))
  (println (vec-len kinds))
  (letmut i :i64 0)
  (while (< i (vec-len kinds))
    (print (vec-get kinds i))
    (print " ")
    (print (vec-get lines i))
    (print " ")
    (print (vec-get cols i))
    (print " ")
    (print (str-len (vec-get texts i)))
    (print " ")
    (println (vec-get texts i))
    (set i (+ i 1))))

(fn print-fault :void ((f lex-error))
  (println (get f line))
  (println (get f col))
  (println (get f msg)))

(fn print-bytes :void ((t :str))
  (println (str-len t))
  (letmut i :i64 0)
  (while (< i (str-len t))
    (println (str-byte t i))
    (set i (+ i 1))))

(fn dump :void ((src :str))
  (letmut kinds
    (vec :i64)
    (make (vec :i64)))
  (letmut texts
    (vec :str)
    (make (vec :str)))
  (letmut lines
    (vec :i64)
    (make (vec :i64)))
  (letmut cols
    (vec :i64)
    (make (vec :i64)))
  (let e lex-error (lex src kinds texts lines cols))
  (if (lex-ok e)
    (print-tokens kinds texts lines cols)
    (print-fault e))
  (vec-free kinds)
  (vec-free texts)
  (vec-free lines)
  (vec-free cols))

(fn dump-bytes :void ((src :str))
  (letmut kinds
    (vec :i64)
    (make (vec :i64)))
  (letmut texts
    (vec :str)
    (make (vec :str)))
  (letmut lines
    (vec :i64)
    (make (vec :i64)))
  (letmut cols
    (vec :i64)
    (make (vec :i64)))
  (let e lex-error (lex src kinds texts lines cols))
  (if (lex-ok e)
    (print-bytes (vec-get texts 0))
    (print-fault e))
  (vec-free kinds)
  (vec-free texts)
  (vec-free lines)
  (vec-free cols))

(test empty
  (expect (out "0\n")
    (code 0)
    (leaks 0))
  (dump ""))

(test paren
  (expect (out "1\n0 1 1 1 (\n")
    (code 0)
    (leaks 0))
  (dump "("))

(test close-then-open
  (expect (out "2\n1 1 1 1 )\n0 1 2 1 (\n")
    (code 0)
    (leaks 0))
  (dump ")("))

(test run
  (expect (out "6\n0 1 1 1 (\n2 1 2 1 a\n1 1 3 1 )\n0 1 5 1 (\n2 1 6 1 b\n1 1 7 1 )\n")
    (code 0)
    (leaks 0))
  (dump "(a) (b)"))

(test form
  (expect (out "5\n0 1 1 1 (\n2 1 2 1 +\n4 1 4 2 -3\n4 1 7 1 4\n1 1 8 1 )\n")
    (code 0)
    (leaks 0))
  (dump "(+ -3 4)"))

(test numbers
  (expect (out "9\n4 1 1 1 1\n4 1 3 3 1.5\n4 1 7 4 1e10\n4 1 12 7 -2.5E-3\n4 1 20 2 +7\n2 1 23 2 5.\n2 1 26 2 1e\n2 1 29 5 1.5.2\n2 1 35 2 .5\n")
    (code 0)
    (leaks 0))
  (dump "1 1.5 1e10 -2.5E-3 +7 5. 1e 1.5.2 .5"))

(test tab-column
  (expect (out "1\n0 1 2 1 (\n")
    (code 0)
    (leaks 0))
  (dump "\t("))

(test unicode-columns
  (expect (out "4\n2 1 1 6 héllo\n0 1 7 1 (\n2 1 8 1 x\n1 1 9 1 )\n")
    (code 0)
    (leaks 0))
  (dump "héllo (x)"))

(test wide-char-column
  (expect (out "2\n2 1 1 3 →\n0 1 3 1 (\n")
    (code 0)
    (leaks 0))
  (dump "→\t("))

(test lines
  (expect (out "3\n2 1 1 1 a\n2 2 2 1 b\n2 4 3 1 c\n")
    (code 0)
    (leaks 0))
  (dump "a\n b\n\n  c"))

(test whitespace
  (expect (out "4\n0 1 1 1 (\n2 1 4 1 a\n2 2 2 1 b\n1 2 4 1 )\n")
    (code 0)
    (leaks 0))
  (dump "(  a\r\n\tb )"))

(test adjacent-strings
  (expect (out "2\n3 1 1 1 a\n3 1 4 1 b\n")
    (code 0)
    (leaks 0))
  (dump "\"a\"\"b\""))

(test escape-string
  (expect (out "6\n92\n34\n10\n9\n13\n0\n")
    (code 0)
    (leaks 0))
  (dump-bytes "\"\\\\\\\"\\n\\t\\r\\0\""))

(test nul-string
  (expect (out "3\n97\n0\n98\n")
    (code 0)
    (leaks 0))
  (dump-bytes "\"a\0b\""))

(test empty-string
  (expect (out "0\n")
    (code 0)
    (leaks 0))
  (dump-bytes "\"\""))

(test string-with-newline
  (expect (out "3\n97\n10\n98\n")
    (code 0)
    (leaks 0))
  (dump-bytes "\"a\nb\""))

(test unterminated
  (expect (out "1\n1\nunterminated string\n")
    (code 0)
    (leaks 0))
  (dump "\"abc"))

(test unterminated-escape
  (expect (out "1\n1\nunterminated string\n")
    (code 0)
    (leaks 0))
  (dump "\"abc\\"))

(test unknown-escape
  (expect (out "1\n3\nunknown escape \\q\n")
    (code 0)
    (leaks 0))
  (dump "\"a\\qb\""))

(test unknown-escape-newline
  (expect (out "1\n3\nunknown escape \\\n\n")
    (code 0)
    (leaks 0))
  (dump "\"a\\\nb\""))

(test unknown-escape-unterminated
  (expect (out "1\n3\nunknown escape \\q\n")
    (code 0)
    (leaks 0))
  (dump "\"a\\q"))

(test unknown-character
  (expect (out "1\n2\nunknown character\n")
    (code 0)
    (leaks 0))
  (dump "(\0)"))
