  (vec-free bhas)
  (vec-free ops)
  (vec-free t1)
  (vec-free t2)
  (vec-free t3)
  (vec-free n1)
  (vec-free sst)
  (vec-free scn)
  (vec-free tst)
  (vec-free tcn)
  (vec-free tvals)
  (vec-free tags)
  (vec-free elem)
  (vec-free extra)
  (vec-free pbase)
  (vec-free tptypes)
  (vec-free pchild)
  (vec-free mtriple)
  (vec-free snames)
  (vec-free enames)
  (vec-free gnames)
  (vec-free gdata)
  (vec-free dnames)
  (vec-free fnames)
  (vec-free fsyms)
  (vec-free pnames)
  (vec-free blabels)
  (vec-free bv1)
  (vec-free bv2)
  (vec-free bv3)
  (vec-free dests)
  (vec-free sa)
  (vec-free sb)
  (vec-free sc)
  (vec-free sd)
  (vec-free svals)
  (vec-free tnames)
  (vec-free powner)
  (vec-free tpnames)
  (vec-free pvname)
  (vec-free nod)
  (vec-free ntx)
  (vec-free out)
  (vec-free defs)
  (vec-free mods)
  (vec-free kinds)
  (vec-free texts)
  (vec-free lines)
  (vec-free cols)
  (ret status))

(fn main-tree :i64 ((verb :str) (path :str) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))) (nodes (ref (vec node))) (ntexts (ref (vec :str))))
  (let t tree-error (tree-parse kinds texts lines cols nodes ntexts))
  (ret (if (tree-ok t)
         (if (str-eq verb "resolve")
           (main-resolved path nodes ntexts)
           (if (str-eq verb "check")
             (main-checked path nodes ntexts)
             (main-print nodes ntexts)))
         (main-diag path "E0001"
           (get t line)
           (get t col)
           (get t msg)))))

(fn main-source :i64 ((verb :str) (path :str) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))) (nodes (ref (vec node))) (ntexts (ref (vec :str))))
  (let why :str (main-file-why path))
  (if (> (str-len why) 0)
    (ret (main-fmt-bad path why))
    (main-nothing))
  (let src :str (read-file path))
  (let e lex-error (lex src kinds texts lines cols))
  (ret (if (lex-ok e)
         (main-tree verb path kinds texts lines cols nodes ntexts)
         (main-diag path "E0006"
           (get e line)
           (get e col)
           (get e msg)))))

(fn main-run :i64 ((verb :str) (path :str))
  (letmut kinds
    (vec :i64)
    (make (vec :i64)))
  (letmut texts
    (vec :str)
    (make (vec :str)))
  (letmut lines
    (vec :i64)
    (make (vec :i64)))
  (letmut cols
    (vec :i64)
    (make (vec :i64)))
  (letmut nodes
    (vec node)
    (make (vec node)))
  (letmut ntexts
    (vec :str)
    (make (vec :str)))
  (letmut status :i64 (main-source verb path kinds texts lines cols nodes ntexts))
  (vec-free kinds)
  (vec-free texts)
  (vec-free lines)
  (vec-free cols)
  (vec-free nodes)
  (vec-free ntexts)
  (ret status))

(fn main-paths :void ((a (ref (vec :str))) (first :i64) (count :i64) (paths (ref (vec :str))))
  (letmut i :i64 0)
  (while (< i count)
    (vec-push paths (vec-get a (+ first i)))
    (set i (+ i 1)))
  (ret))

(fn main-resolve-set :i64 ((a (ref (vec :str))) (first :i64) (count :i64))
  (letmut paths
    (vec :str)
    (make (vec :str)))
  (main-paths a first count paths)
  (let bad :str (main-unreadable paths))
  (if (not (str-eq bad ""))
    (ret (main-unreadable-free paths bad))
    (main-nothing))
  (letmut defs
    (vec resolve-def)
    (make (vec resolve-def)))
  (letmut mods
    (vec resolve-mod)
    (make (vec resolve-mod)))
  (let e resolve-error (resolve-set-of paths defs mods))
  (letmut status :i64 0)
  (if (resolve-ok e)
    (main-nothing)
    (set status (main-resolve-diag (vec-get paths 0) e)))
  (vec-free defs)
  (vec-free mods)
  (vec-free paths)
  (ret status))

(fn main-str-less :bool ((a :str) (b :str))
  (let an :i64 (str-len a))
  (let bn :i64 (str-len b))
  (let lim :i64 (if (< an bn) an bn))
  (letmut i :i64 0)
  (letmut stop :bool false)
  (while (and (not stop)
           (< i lim))
    (if (= (cast :i64 (str-byte a i))
          (cast :i64 (str-byte b i)))
      (set i (+ i 1))
      (set stop true)))
  (ret (if (< i lim)
         (< (cast :i64 (str-byte a i))
           (cast :i64 (str-byte b i)))
         (< an bn))))

(fn main-sort :void ((names (ref (vec :str))))
  (let n :i64 (vec-len names))
  (letmut i :i64 1)
  (while (< i n)
    (let item :str (vec-get names i))
    (letmut j :i64 i)
    (while (and (> j 0)
             (main-str-less item (vec-get names (- j 1))))
      (vec-set names j (vec-get names (- j 1)))
      (set j (- j 1)))
    (vec-set names j item)
    (set i (+ i 1)))
  (ret))

(fn main-join :str ((dir :str) (name :str))
  (ret (if (and (> (str-len dir) 0)
             (= (cast :i64 (str-byte dir (- (str-len dir) 1))) 47))
         (str-concat dir name)
         (str-concat dir (str-concat "/" name)))))

(fn main-logos-name :bool ((name :str))
  (let n :i64 (str-len name))
  (ret (if (< n 6) false
         (str-eq (str-slice name (- n 6) n) ".logos"))))

(fn main-or :i64 ((a :i64) (b :i64))
  (ret (if (= a 0) b a)))

(fn main-fmt-bad :i64 ((path :str) (msg :str))
  (main-write "logos: ")
  (main-write path)
  (main-write ": ")
  (main-write msg)
  (main-write "\n")
  (ret 1))

(fn main-fmt-diag :i64 ((path :str) (code :str) (line :i64) (col :i64) (msg :str))
  (main-diag-text path code line col msg)
  (ret 2))

(fn main-fmt-loaded :i64 ((path :str) (src :str) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))) (nodes (ref (vec node))) (ntexts (ref (vec :str))))
  (let e lex-error (lex src kinds texts lines cols))
  (if (not (lex-ok e))
    (ret (main-fmt-diag path "E0006"
           (get e line)
           (get e col)
           (get e msg)))
    (main-nothing))
  (let t tree-error (tree-parse kinds texts lines cols nodes ntexts))
  (ret (if (tree-ok t) 0
         (main-fmt-diag path "E0001"
           (get t line)
           (get t col)
           (get t msg)))))

(fn main-fmt-render :i64 ((path :str) (nodes (ref (vec node))) (ntexts (ref (vec :str))))
  (let fd :i64 (rt_create path))
  (if (< fd 0)
    (ret (main-fmt-write-bad path))
    (main-nothing))
  (fmt fd nodes ntexts)
  (let _ :i32 (close fd))
  (ret 0))

(fn main-fmt-write-bad :i64 ((path :str))
  (let why :str (path-error path))
  (ret (main-fmt-bad path (if (> (str-len why) 0) why "cannot write"))))

(fn main-fmt-file :i64 ((path :str))
  (let why :str (main-file-why path))
  (if (> (str-len why) 0)
    (ret (main-fmt-bad path why))
    (main-nothing))
  (letmut kinds
    (vec :i64)
    (make (vec :i64)))
  (letmut texts
    (vec :str)
    (make (vec :str)))
  (letmut lines
    (vec :i64)
    (make (vec :i64)))
  (letmut cols
    (vec :i64)
    (make (vec :i64)))
  (letmut nodes
    (vec node)
    (make (vec node)))
  (letmut ntexts
    (vec :str)
    (make (vec :str)))
  (let src :str (read-file path))
  (letmut status :i64 (main-fmt-loaded path src kinds texts lines cols nodes ntexts))
  (if (= status 0)
    (set status (main-fmt-render path nodes ntexts))
    (main-nothing))
  (vec-free kinds)
  (vec-free texts)
  (vec-free lines)
  (vec-free cols)
  (vec-free nodes)
  (vec-free ntexts)
  (ret status))

(fn main-fmt-stdin :i64 ()
  (letmut kinds
    (vec :i64)
    (make (vec :i64)))
  (letmut texts
    (vec :str)
    (make (vec :str)))
  (letmut lines
    (vec :i64)
    (make (vec :i64)))
  (letmut cols
    (vec :i64)
    (make (vec :i64)))
  (letmut nodes
    (vec node)
    (make (vec node)))
  (letmut ntexts
    (vec :str)
    (make (vec :str)))
  (let src :str (read-all))
  (letmut status :i64 (main-fmt-loaded "<stdin>" src kinds texts lines cols nodes ntexts))
  (if (= status 0)
    (fmt 1 nodes ntexts)
    (main-nothing))
  (vec-free kinds)
  (vec-free texts)
  (vec-free lines)
  (vec-free cols)
  (vec-free nodes)
  (vec-free ntexts)
  (ret status))

(fn main-fmt-tree :i64 ((dir :str))
  (letmut names
    (vec :str)
    (read-dir dir))
  (main-sort names)
  (letmut status :i64 0)
  (letmut i :i64 0)
  (while (< i (vec-len names))
    (let name :str (vec-get names i))
    (let path :str (main-join dir name))
    (if (is-dir path)
      (set status (main-or status (main-fmt-tree path)))
      (if (main-logos-name name)
        (set status (main-or status (main-fmt-file path)))
        (main-nothing)))
    (set i (+ i 1)))
  (vec-free names)
  (ret status))

(fn main-fmt-path :i64 ((arg :str))
  (ret (if (is-dir arg)
         (main-fmt-tree arg)
         (main-fmt-file arg))))

(fn main-fmt-twice :i64 ()
  (main-write "logos: fmt: '-' may be given at most once\n")
  (ret 2))

(fn main-fmt :i64 ((a (ref (vec :str))) (first :i64) (count :i64))
  (letmut dashes :i64 0)
  (letmut i :i64 0)
  (while (< i count)
    (if (str-eq (vec-get a (+ first i)) "-")
      (set dashes (+ dashes 1))
      (main-nothing))
    (set i (+ i 1)))
  (if (> dashes 1)
    (ret (main-fmt-twice))
    (main-nothing))
  (letmut status :i64 0)
  (set i 0)
  (while (< i count)
    (let arg :str (vec-get a (+ first i)))
    (if (str-eq arg "-")
      (set status (main-or status (main-fmt-stdin)))
      (set status (main-or status (main-fmt-path arg))))
    (set i (+ i 1)))
  (ret status))

(fn main-test-only :i64 ((value :str) (next :i64) (only (ref (vec :str))))
  (vec-set only 0 value)
  (ret next))

(fn main-test-level :bool ((s :str))
  (let n :i64 (str-len s))
  (ret (if (< n 3) false
         (if (not (and (= (cast :i64 (str-byte s 0)) 45)
                    (= (cast :i64 (str-byte s 1)) 79))) false
           (main-test-digits s 2 n)))))

(fn main-test-digits :bool ((s :str) (i :i64) (n :i64))
  (letmut ok :bool true)
  (letmut j :i64 i)
  (while (< j n)
    (let b :i64 (cast :i64 (str-byte s j)))
    (if (and (>= b 48)
          (<= b 57))
      (main-nothing)
      (set ok false))
    (set j (+ j 1)))
  (ret ok))

(fn main-test-opts :i64 ((a (ref (vec :str))) (i :i64) (n :i64) (levels (ref (vec :str))))
  (letmut j :i64 i)
  (while (and (< j n)
           (main-test-level (vec-get a j)))
    (vec-push levels (vec-get a j))
    (set j (+ j 1)))
  (ret (if (= j i) -1 j)))

(fn main-test-opt-eq :i64 ((s :str) (next :i64) (levels (ref (vec :str))))
  (vec-push levels (str-slice s 6 (str-len s)))
  (ret next))

(fn main-test-update :i64 ((flags (ref (vec :i64))) (next :i64))
  (vec-set flags 2 1)
  (ret next))

(fn main-test-path :i64 ((s :str) (next :i64) (path (ref (vec :str))) (flags (ref (vec :i64))))
  (if (= (vec-get flags 0) 1)
    (ret -1)
    (main-nothing))
  (vec-set path 0 s)
  (vec-set flags 0 1)
  (ret next))

(fn main-test-arg :i64 ((a (ref (vec :str))) (i :i64) (n :i64) (path (ref (vec :str))) (only (ref (vec :str))) (levels (ref (vec :str))) (flags (ref (vec :i64))))
  (let s :str (vec-get a i))
  (ret (if (str-eq s "--only")
         (if (< (+ i 1) n)
           (main-test-only (vec-get a (+ i 1))
             (+ i 2) only) -1)
         (if (and (> (str-len s) 7)
               (str-eq (str-slice s 0 7) "--only="))
           (main-test-only (str-slice s 7 (str-len s))
             (+ i 1) only)
           (if (str-eq s "--opt")
             (main-test-opts a (+ i 1) n levels)
             (if (and (> (str-len s) 6)
                   (str-eq (str-slice s 0 6) "--opt="))
               (main-test-opt-eq s (+ i 1) levels)
               (if (str-eq s "--update-baseline")
                 (main-test-update flags (+ i 1))
                 (if (and (> (str-len s) 0)
                       (= (cast :i64 (str-byte s 0)) 45)) -1
                   (main-test-path s (+ i 1) path flags)))))))))

(fn main-test-unknown :i64 ((name :str))
  (fmt-emit 2 (str-concat "logos: test: unknown test category '" (str-concat name "'\n")))
  (ret 2))

(fn main-categories :void ((out (ref (vec :str))))
  (vec-push out "parse")
  (vec-push out "type")
  (vec-push out "exec")
  (vec-push out "mem")
  (vec-push out "thread")
  (vec-push out "generics")
  (vec-push out "regress")
  (vec-push out "diff")
  (ret))

(fn main-has-category :bool ((root :str))
  (letmut names
    (vec :str)
    (make (vec :str)))
  (main-categories names)
  (letmut i :i64 0)
  (letmut found :bool false)
  (while (and (not found)
           (< i (vec-len names)))
    (if (is-dir (main-join root (vec-get names i)))
      (set found true)
      (main-nothing))
    (set i (+ i 1)))
  (vec-free names)
  (ret found))

(fn main-baseline-problem :str ((path :str))
  (ret (if (is-dir path)
         (main-baseline-root-problem path)
         (if (str-eq (path-error path) "") "--update-baseline needs a directory, not a single file"
           (str-concat "--update-baseline needs a directory, and '" (str-concat path "' is not one"))))))

(fn main-baseline-root-problem :str ((path :str))
  (ret (if (h-known-category (main-base path))
         (str-concat "--update-baseline needs the suite root, not the category directory '" (str-concat path "'"))
         (if (main-has-category path) ""
           (str-concat "--update-baseline needs the suite root, a directory holding a category such as 'exec'; '" (str-concat path "' is not one"))))))

(fn main-test-baseline :i64 ((path :str))
  (let problem :str (main-baseline-problem path))
  (if (str-eq problem "")
    (ret 0)
    (ret (main-test-fail problem))))

(fn main-test-fail :i64 ((problem :str))
  (fmt-emit 2 (str-concat "logos: test: " (str-concat problem "\n")))
  (ret 2))

(fn main-test-run :i64 ((path (ref (vec :str))) (only (ref (vec :str))) (levels (ref (vec :str))) (flags (ref (vec :i64))))
  (let root :str (vec-get path 0))
  (let name :str (vec-get only 0))
  (let update :i64 (vec-get flags 2))
  (letmut status :i64 0)
  (if (= update 1)
    (set status (main-test-baseline root))
    (main-nothing))
  (if (> status 0)
    (ret status)
    (main-nothing))
  (if (and (not (str-eq name ""))
        (not (h-known-category name)))
    (ret (main-test-unknown name))
    (main-nothing))
  (ret (h-run root name levels update)))

(fn main-test :i64 ((a (ref (vec :str))) (n :i64) (prog :str))
  (letmut path
    (vec :str)
    (make (vec :str)))
  (vec-push path "tests")
  (letmut only
    (vec :str)
    (make (vec :str)))
  (vec-push only "")
  (letmut levels
    (vec :str)
    (make (vec :str)))
  (letmut flags
    (vec :i64)
    (make (vec :i64)))
  (vec-push flags 0)
  (vec-push flags 0)
  (vec-push flags 0)
  (letmut i :i64 2)
  (letmut badat :i64 -1)
  (while (and (= (vec-get flags 1) 0)
           (< i n))
    (set badat i)
    (set i (main-test-arg a i n path only levels flags))
    (vec-set flags 1 (if (< i 0) 1
                       (vec-get flags 1))))
  (letmut status :i64 0)
  (if (= (vec-get flags 1) 1)
    (set status (main-bad-flag prog "test" a n badat))
    (set status (main-test-run path only levels flags)))
  (vec-free path)
  (vec-free only)
  (vec-free levels)
  (vec-free flags)
  (ret status))

(fn main-guide-text :i64 ()
  (let text :str (guide-markdown))
  (if (str-eq text "")
    (ret 1)
    (fmt-emit 1 text))
  (ret 0))

(fn main-guide-json :i64 ()
  (let text :str (guide-manifest))
  (if (str-eq text "")
    (ret 1)
    (fmt-emit 1 (str-concat text "\n")))
  (ret 0))

(fn main-guide-flags :void ((a (ref (vec :str))) (n :i64) (flags (ref (vec :i64))) (extra (ref (vec :str))))
  (letmut i :i64 2)
  (while (< i n)
    (let s :str (vec-get a i))
    (if (str-eq s "--check")
      (vec-set flags 1 1)
      (if (str-eq s "--json")
        (vec-set flags 0 1)
        (vec-push extra s)))
    (set i (+ i 1)))
  (ret))

(fn main-guide-mutex :str ()
  (ret "argument --json: not allowed with argument --check"))

(fn main-guide :i64 ((a (ref (vec :str))) (n :i64) (prog :str))
  (letmut flags
    (vec :i64)
    (make (vec :i64)))
  (vec-push flags (if (main-json-mode) 1 0))
  (vec-push flags 0)
  (letmut extra
    (vec :str)
    (make (vec :str)))
  (main-guide-flags a n flags extra)
  (if (and (= (vec-get flags 0) 1)
        (= (vec-get flags 1) 1))
    (ret (main-cli-error prog "guide" (main-guide-mutex)))
    (main-nothing))
  (if (> (vec-len extra) 0)
    (ret (main-unrecognized prog (main-join-vec extra)))
    (main-nothing))
  (let json :i64 (vec-get flags 0))
  (let check :i64 (vec-get flags 1))
  (vec-free flags)
  (vec-free extra)
  (if (= (guide-consistent) 1)
    (ret 1)
    (main-nothing))
  (if (= check 1)
    (ret (guide-check))
    (main-nothing))
  (if (= json 1)
    (ret (main-guide-json))
    (main-nothing))
  (ret (main-guide-text)))

(fn main-join-vec :str ((items (ref (vec :str))))
  (letmut text :str "")
  (letmut first :bool true)
  (letmut i :i64 0)
  (while (< i (vec-len items))
    (if first
      (set text (vec-get items i))
      (set text (str-concat text (str-concat " " (vec-get items i)))))
    (set first false)
    (set i (+ i 1)))
  (ret text))

(fn main-fmt-options :void ((a (ref (vec :str))) (n :i64) (counts (ref (vec :i64))))
  (letmut i :i64 2)
  (while (< i n)
    (let s :str (vec-get a i))
    (if (or (str-eq s "-")
          (not (= (cast :i64 (str-byte s 0)) 45)))
      (vec-set counts 0 (+ (vec-get counts 0) 1))
      (if (= (vec-get counts 1) -1)
        (vec-set counts 1 i)
        (main-nothing)))
    (set i (+ i 1)))
  (ret))

(fn main-fmt-verb :i64 ((a (ref (vec :str))) (n :i64) (prog :str))
  (letmut counts
    (vec :i64)
    (make (vec :i64)))
  (vec-push counts 0)
  (vec-push counts -1)
  (main-fmt-options a n counts)
  (if (= (vec-get counts 0) 0)
    (ret (main-required prog "fmt" "FILE"))
    (main-nothing))
  (if (= (vec-get counts 1) -1)
    (main-nothing)
    (ret (main-unrecognized prog (vec-get a (vec-get counts 1)))))
  (vec-free counts)
  (ret (main-fmt a 2 (- n 2))))

(fn main-port-verb :i64 ((a (ref (vec :str))) (n :i64) (prog :str) (verb :str))
  (if (< n 3)
    (ret (main-port-arity prog verb))
    (main-nothing))
  (if (not (= n 3))
    (if (str-eq verb "resolve")
      (ret (main-resolve-set a 2 (- n 2)))
      (ret (main-port-arity prog verb)))
    (main-nothing))
  (ret (main-run verb (vec-get a 2))))

(fn main-port-arity :i64 ((prog :str) (verb :str))
  (fmt-emit 2 (str-concat "usage: " (str-concat prog (str-concat (main-verb-usage verb) "\n"))))
  (ret 2))

(fn main-help-flag :bool ((a (ref (vec :str))) (n :i64))
  (letmut i :i64 2)
  (letmut found :bool false)
  (while (< i n)
    (let s :str (vec-get a i))
    (if (or (str-eq s "-h")
          (str-eq s "--help"))
      (set found true)
      (main-nothing))
    (set i (+ i 1)))
  (ret found))

(fn main-verb-help :i64 ((verb :str) (prog :str))
  (fmt-emit 1 (str-concat "usage: " (str-concat prog (str-concat (main-verb-usage verb)
                                                       (str-concat "\n\n" (main-verb-about verb))))))
  (ret 0))

(fn main-verb :i64 ((a (ref (vec :str))) (n :i64) (prog :str))
  (let verb :str (vec-get a 1))
  (if (main-help-flag a n)
    (ret (main-verb-help verb prog))
    (main-nothing))
  (if (str-eq verb "version")
    (ret (main-version a n prog))
    (main-nothing))
  (if (str-eq verb "show")
    (ret (main-show a n prog))
    (main-nothing))
  (if (str-eq verb "build")
    (ret (main-build a n prog))
    (main-nothing))
  (if (str-eq verb "test")
    (ret (main-test a n prog))
    (main-nothing))
  (if (str-eq verb "fmt")
    (ret (main-fmt-verb a n prog))
    (main-nothing))
  (if (str-eq verb "guide")
    (ret (main-guide a n prog))
    (main-nothing))
  (if (str-eq verb "resolve")
    (ret (main-port-verb a n prog verb))
    (main-nothing))
  (if (str-eq verb "check")
    (ret (main-port-verb a n prog verb))
    (main-nothing))
  (ret (main-invalid prog verb)))

(fn main-args :i64 ((a (ref (vec :str))))
  (let n :i64 (vec-len a))
  (let prog :str (main-prog a))
  (ret (if (< n 2)
         (main-help prog)
         (if (or (str-eq (vec-get a 1) "-h")
               (str-eq (vec-get a 1) "--help"))
           (main-help prog)
           (if (str-eq (vec-get a 1) "--version")
             (if (> n 2)
               (main-unrecognized prog (main-join-args a 2 n))
               (main-version-print))
             (main-verb a n prog))))))

(fn main :i64 ()
  (letmut a
    (vec :str)
    (args))
  (letmut rest
    (vec :str)
    (make (vec :str)))
  (letmut i :i64 0)
  (while (< i (vec-len a))
    (if (str-eq (vec-get a i) "--json")
      (main-nothing)
      (vec-push rest (vec-get a i)))
    (set i (+ i 1)))
  (letmut status :i64 (main-args rest))
  (vec-free rest)
  (vec-free a)
  (ret status))
