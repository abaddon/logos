(mod main)

(use lex)

(use tree)

(use fmt)

(use resolve)

(use check)

(use lower)

(use ir)

(use emit)

(use harness)

(use guide)

(use sys)

(fn main-write :void ((s :str))
  (fmt-emit 2 s)
  (ret))

(fn main-fail :i64 ((msg :str))
  (main-write "logos: ")
  (main-write msg)
  (main-write "\n")
  (ret 1))

(fn main-unreadable-free :i64 ((paths (ref (vec :str))) (bad :str))
  (let why :str (path-error bad))
  (vec-free paths)
  (ret (main-fmt-bad bad why)))

(fn main-hex2 :str ((n :i64))
  (let digits :str "0123456789abcdef")
  (ret (str-concat (str-slice digits
                     (/ n 16)
                     (+ (/ n 16) 1))
         (str-slice digits
           (% n 16)
           (+ (% n 16) 1)))))

(fn main-json-str :str ((s :str))
  (letmut out :str "\"")
  (letmut i :i64 0)
  (while (< i (str-len s))
    (let b :i64 (cast :i64 (str-byte s i)))
    (if (= b 34)
      (set out (str-concat out "\\\""))
      (if (= b 92)
        (set out (str-concat out "\\\\"))
        (if (= b 10)
          (set out (str-concat out "\\n"))
          (if (= b 9)
            (set out (str-concat out "\\t"))
            (if (= b 13)
              (set out (str-concat out "\\r"))
              (if (< b 32)
                (set out (str-concat out (str-concat "\\u00" (main-hex2 b))))
                (set out (str-concat out (str-slice s i (+ i 1))))))))))
    (set i (+ i 1)))
  (ret (str-concat out "\"")))

(fn main-json-mode :bool ()
  (letmut a
    (vec :str)
    (args))
  (letmut i :i64 0)
  (letmut found :bool false)
  (while (< i (vec-len a))
    (if (str-eq (vec-get a i) "--json")
      (set found true)
      (main-nothing))
    (set i (+ i 1)))
  (vec-free a)
  (ret found))

(fn main-diag-json :void ((file :str) (at :str) (code :str) (line :i64) (col :i64) (msg :str))
  (letmut out :str "{\"schema_version\":1,\"diagnostics\":[{\"severity\":\"error\",\"code\":")
  (set out (str-concat out (main-json-str code)))
  (set out (str-concat out ",\"message\":"))
  (set out (str-concat out (main-json-str msg)))
  (set out (str-concat out ",\"node_path\":"))
  (set out (str-concat out (main-json-str at)))
  (set out (str-concat out ",\"file\":"))
  (set out (str-concat out (main-json-str file)))
  (set out (str-concat out ",\"line\":"))
  (set out (str-concat out (str-from-i64 line)))
  (set out (str-concat out ",\"col\":"))
  (set out (str-concat out (str-from-i64 col)))
  (main-write (str-concat out "}]}\n"))
  (ret))

(fn main-base :str ((s :str))
  (letmut i :i64 0)
  (letmut start :i64 0)
  (while (< i (str-len s))
    (if (= (cast :i64 (str-byte s i)) 47)
      (set start (+ i 1))
      (main-nothing))
    (set i (+ i 1)))
  (ret (str-slice s start (str-len s))))

(fn main-prog :str ((a (ref (vec :str))))
  (ret (if (> (vec-len a) 0)
         (main-base (vec-get a 0)) "logosc")))

(fn main-help :i64 ((prog :str))
  (fmt-emit 1 (str-concat "usage: " (str-concat prog " [-h] [--version] [--json] command ...\n\nCompiler for Logos, a prefix-form language for AI readers.\n\npositional arguments:\n  command\n    build     compile Logos source files to a native binary\n    check     type-check one file and print nothing on success\n    fmt       rewrite Logos source in canonical form\n    guide     print the generated Logos manual or its manifest\n    resolve   resolve the names of one or more files\n    show      print one node of a Logos file\n    test      compile and run the (test ...) nodes in a file\n    version   print the compiler version\n\noptions:\n  -h, --help     show this help message and exit\n  --version      print the compiler version and exit\n  --json         emit diagnostics and reports as JSON\n\nEvery verb accepts -h for its own flags, and --json anywhere on the\ncommand line. Exit codes: 0 success, 2 source or usage error, 1 I/O or\ntoolchain failure.\n")))
  (ret 0))

(fn main-verb-usage :str ((verb :str))
  (ret (if (str-eq verb "build") " build [-h] [-o OUT] [--opt O] [--target TRIPLE] [--keep-ir] FILE [FILE ...]"
         (if (str-eq verb "test") " test [-h] [--only CAT] [--opt O] [--update-baseline] [PATH]"
           (if (str-eq verb "fmt") " fmt [-h] FILE [FILE ...]"
             (if (str-eq verb "show") " show [-h] FILE PATH"
               (if (str-eq verb "version") " version [-h] [--json]"
                 (if (str-eq verb "guide") " guide [-h] [--json | --check]"
                   (if (str-eq verb "resolve") " resolve [-h] FILE [FILE ...]"
                     (if (str-eq verb "check") " check [-h] FILE" " [-h] command ..."))))))))))

(fn main-verb-about :str ((verb :str))
  (ret (if (str-eq verb "build") "compile Logos source files to a native binary\n\npositional arguments:\n  FILE            one or more .logos files; the first is the entry module\n\noptions:\n  -h, --help      show this help message and exit\n  -o OUT          write the binary to OUT (default build/<stem>)\n  --opt O         optimisation level given to clang (default -O0)\n  --target TRIPLE emit and link for TRIPLE (default x86_64-unknown-linux-gnu)\n  --keep-ir       keep the generated IR beside the binary\n  --json          emit diagnostics as JSON on stderr\n"
         (if (str-eq verb "test") "compile and run the (test ...) nodes in a file, then compare them to\nthe baseline\n\npositional arguments:\n  PATH            a file or a directory of cases (default: the whole corpus)\n\noptions:\n  -h, --help      show this help message and exit\n  --only CAT      run only the cases in one category\n  --opt O         optimisation level (default -O0; repeat for both)\n  --update-baseline  rewrite tests/summary.txt from this run\n"
           (if (str-eq verb "fmt") "rewrite Logos source in canonical form, in place\n\npositional arguments:\n  FILE            one or more .logos files, or - for stdin\n\noptions:\n  -h, --help      show this help message and exit\n  --json          emit diagnostics as JSON on stderr\n"
             (if (str-eq verb "show") "print one node of a Logos file, selected by its node path\n\npositional arguments:\n  FILE            the source file\n  PATH            a node path such as main/2/0\n\noptions:\n  -h, --help      show this help message and exit\n  --json          emit diagnostics as JSON on stderr\n"
               (if (str-eq verb "version") "print the compiler version\n\noptions:\n  -h, --help      show this help message and exit\n  --json          print {\"schema_version\":1,\"name\":\"logos\",\"version\":...}\n"
                 (if (str-eq verb "guide") "print the generated Logos manual or its manifest\n\noptions:\n  -h, --help      show this help message and exit\n  --json          print the machine-readable manifest (schema_version 1)\n  --check         fail unless docs/LOGOS.md matches this compiler\n"
                   (if (str-eq verb "resolve") "resolve the names of one or more files and print the module table\n\npositional arguments:\n  FILE            one or more .logos files\n\noptions:\n  -h, --help      show this help message and exit\n  --json          emit diagnostics as JSON on stderr\n"
                     (if (str-eq verb "check") "type-check one file and print nothing on success\n\npositional arguments:\n  FILE            the source file\n\noptions:\n  -h, --help      show this help message and exit\n  --json          emit diagnostics as JSON on stderr\n" ""))))))))))

(fn main-verb-label :str ((verb :str))
  (ret (if (str-eq verb "") ""
         (str-concat " " verb))))

(fn main-cli-error :i64 ((prog :str) (verb :str) (msg :str))
  (fmt-emit 2 (str-concat "usage: " (str-concat prog (str-concat (main-verb-usage verb) "\n"))))
  (fmt-emit 2 (str-concat prog (str-concat (main-verb-label verb)
                                 (str-concat ": error: " (str-concat msg "\n")))))
  (ret 2))

(fn main-required :i64 ((prog :str) (verb :str) (names :str))
  (ret (main-cli-error prog verb (str-concat "the following arguments are required: " names))))

(fn main-unrecognized :i64 ((prog :str) (rest :str))
  (ret (main-cli-error prog "" (str-concat "unrecognized arguments: " rest))))

(fn main-invalid :i64 ((prog :str) (verb :str))
  (ret (main-cli-error prog "" (str-concat "argument command: invalid choice: '" (str-concat verb "' (choose from 'build', 'check', 'fmt', 'guide', 'resolve', 'show', 'test', 'version')")))))

(fn main-semver :str ()
  (ret "0.2.1"))

(fn main-version-print :i64 ()
  (if (main-json-mode)
    (fmt-emit 1 (str-concat "{\"schema_version\":1,\"name\":\"logos\",\"version\":" (str-concat (main-json-str (main-semver)) "}\n")))
    (fmt-emit 1 (str-concat "logos " (str-concat (main-semver) "\n"))))
  (ret 0))

(fn main-join-args :str ((a (ref (vec :str))) (i :i64) (n :i64))
  (letmut text :str "")
  (letmut first :bool true)
  (letmut j :i64 i)
  (while (< j n)
    (if first
      (set text (vec-get a j))
      (set text (str-concat text (str-concat " " (vec-get a j)))))
    (set first false)
    (set j (+ j 1)))
  (ret text))

(fn main-version :i64 ((a (ref (vec :str))) (n :i64) (prog :str))
  (if (> n 2)
    (ret (main-unrecognized prog (main-join-args a 2 n)))
    (main-nothing))
  (ret (main-version-print)))

(fn main-prefix :bool ((p :str) (path :str))
  (ret (if (>= (str-len path)
             (+ (str-len p) 1))
         (and (str-eq (str-slice path 0 (str-len p)) p)
           (= (cast :i64 (str-byte path (str-len p))) 47)) false)))

(fn main-find-below :i64 ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (base :str) (id :i64) (path :str))
  (letmut c :i64 (get (vec-get nodes id) first))
  (letmut idx :i64 0)
  (letmut found :i64 -1)
  (while (and (= found -1)
           (not (= c -1)))
    (let cp :str (str-concat base (str-concat "/" (str-from-i64 idx))))
    (if (str-eq cp path)
      (set found c)
      (if (and (= (get (vec-get nodes c) tok) -1)
            (main-prefix cp path))
        (set found (main-find-below nodes ntexts cp c path))
        (main-nothing)))
    (set c (get (vec-get nodes c) next))
    (set idx (+ idx 1)))
  (ret found))

(fn main-find-at :i64 ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (c :i64) (path :str))
  (let p :str (tree-path nodes ntexts 0 c))
  (ret (if (str-eq p path) c
         (if (main-prefix p path)
           (main-find-below nodes ntexts p c path) -1))))

(fn main-find-tree :i64 ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (path :str))
  (if (str-eq path "")
    (ret 0)
    (main-nothing))
  (letmut c :i64 (get (vec-get nodes 0) first))
  (letmut found :i64 -1)
  (while (and (= found -1)
           (not (= c -1)))
    (if (= (get (vec-get nodes c) tok) -1)
      (set found (main-find-at nodes ntexts c path))
      (main-nothing))
    (set c (get (vec-get nodes c) next)))
  (ret found))

(fn main-show-missing :i64 ((path :str) (target :str))
  (fmt-emit 2 (str-concat "logos: show: no node at path '" (str-concat target (str-concat "' in " (str-concat path "\n")))))
  (ret 1))

(fn main-render :void ((fd :i64) (nodes (ref (vec node))) (ntexts (ref (vec :str))) (id :i64) (indent :i64))
  (let _ :i64 (if (= (get (vec-get nodes id) tok) -1)
                (fmt-form fd nodes ntexts id (fmt-indent fd indent))
                (fmt-token fd ntexts
                  (get (vec-get nodes id) tok)
                  (get (vec-get nodes id) text)
                  (fmt-indent fd indent))))
  (fmt-emit fd "\n")
  (ret))

(fn main-show-one :void ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (id :i64))
  (main-render 1 nodes ntexts id 0)
  (ret))

(fn main-show-nodes :i64 ((path :str) (nodes (ref (vec node))) (ntexts (ref (vec :str))) (target :str))
  (let id :i64 (main-find-tree nodes ntexts target))
  (if (= id -1)
    (ret (main-show-missing path target))
    (main-nothing))
  (if (= id 0)
    (fmt 1 nodes ntexts)
    (main-show-one nodes ntexts id))
  (ret 0))

(fn main-show-file :i64 ((path :str) (target :str))
  (let why :str (main-file-why path))
  (if (> (str-len why) 0)
    (ret (main-fmt-bad path why))
    (main-nothing))
  (letmut kinds
    (vec :i64)
    (make (vec :i64)))
  (letmut texts
    (vec :str)
    (make (vec :str)))
  (letmut lines
    (vec :i64)
    (make (vec :i64)))
  (letmut cols
    (vec :i64)
    (make (vec :i64)))
  (letmut nodes
    (vec node)
    (make (vec node)))
  (letmut ntexts
    (vec :str)
    (make (vec :str)))
  (let src :str (read-file path))
  (letmut status :i64 (main-fmt-loaded path src kinds texts lines cols nodes ntexts))
  (if (= status 0)
    (set status (main-show-nodes path nodes ntexts target))
    (main-nothing))
  (vec-free kinds)
  (vec-free texts)
  (vec-free lines)
  (vec-free cols)
  (vec-free nodes)
  (vec-free ntexts)
  (ret status))

(fn main-show :i64 ((a (ref (vec :str))) (n :i64) (prog :str))
  (if (< n 4)
    (ret (main-required prog "show" (if (= n 2) "FILE, PATH" "PATH")))
    (if (> n 4)
      (ret (main-unrecognized prog (main-join-args a 4 n)))
      (main-nothing)))
  (ret (main-show-file (vec-get a 2)
         (vec-get a 3))))

(fn main-diag-plain :void ((path :str) (code :str) (line :i64) (col :i64) (msg :str))
  (main-write path)
  (main-write ":")
  (main-write (str-from-i64 line))
  (main-write ":")
  (main-write (str-from-i64 col))
  (main-write ": ")
  (main-write code)
  (main-write ": ")
  (main-write msg)
  (main-write "\n")
  (ret))

(fn main-diag-trailer :void ((file :str) (at :str))
  (if (or (str-eq file "")
        (str-eq at ""))
    (ret)
    (main-nothing))
  (if (> (str-len (main-file-why file)) 0)
    (ret)
    (main-nothing))
  (letmut kinds
    (vec :i64)
    (make (vec :i64)))
  (letmut texts
    (vec :str)
    (make (vec :str)))
  (letmut lines
    (vec :i64)
    (make (vec :i64)))
  (letmut cols
    (vec :i64)
    (make (vec :i64)))
  (letmut nodes
    (vec node)
    (make (vec node)))
  (letmut ntexts
    (vec :str)
    (make (vec :str)))
  (let src :str (read-file file))
  (let e lex-error (lex src kinds texts lines cols))
  (if (lex-ok e)
    (main-diag-named at kinds texts lines cols nodes ntexts)
    (main-nothing))
  (vec-free kinds)
  (vec-free texts)
  (vec-free lines)
  (vec-free cols)
  (vec-free nodes)
  (vec-free ntexts)
  (ret))

(fn main-diag-named :void ((at :str) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))) (nodes (ref (vec node))) (ntexts (ref (vec :str))))
  (let t tree-error (tree-parse kinds texts lines cols nodes ntexts))
  (if (not (tree-ok t))
    (ret)
    (main-nothing))
  (let id :i64 (main-find-tree nodes ntexts at))
  (if (< id 0)
    (ret)
    (main-render 2 nodes ntexts id 4))
  (ret))

(fn main-diag-text :void ((path :str) (code :str) (line :i64) (col :i64) (msg :str))
  (if (main-json-mode)
    (main-diag-json path "" code line col msg)
    (main-diag-plain path code line col msg))
  (ret))

(fn main-diag :i64 ((path :str) (code :str) (line :i64) (col :i64) (msg :str))
  (main-diag-text path code line col msg)
  (ret 2))

(fn main-at :str ((path :str) (file :str) (line :i64) (col :i64) (fallback :str))
  (ret (if (not (str-eq path "")) path
         (if (not (str-eq file ""))
           (str-concat file (str-concat ":" (str-concat (str-from-i64 line)
                                              (str-concat ":" (str-from-i64 col))))) fallback))))

(fn main-resolve-plain :i64 ((file :str) (e resolve-error))
  (main-write (main-at (get e path)
                (get e file)
                (get e line)
                (get e col) file))
  (main-write ": ")
  (main-write (resolve-code (get e code)))
  (main-write ": ")
  (main-write (get e message))
  (main-write "\n")
  (main-diag-trailer (main-diag-file (get e file) file)
    (get e path))
  (ret 2))

(fn main-diag-file :str ((file :str) (at :str))
  (ret (if (not (str-eq file "")) file at)))

(fn main-diag-json-2 :i64 ((file :str) (at :str) (code :str) (line :i64) (col :i64) (msg :str))
  (main-diag-json file at code line col msg)
  (ret 2))

(fn main-resolve-diag :i64 ((file :str) (e resolve-error))
  (ret (if (main-json-mode)
         (main-diag-json-2 (main-diag-file (get e file) file)
           (get e path)
           (resolve-code (get e code))
           (get e line)
           (get e col)
           (get e message))
         (main-resolve-plain file e))))

(fn main-resolved :i64 ((file :str) (nodes (ref (vec node))) (ntexts (ref (vec :str))))
  (let e resolve-error (resolve-file nodes ntexts file))
  (ret (if (resolve-ok e) 0
         (main-resolve-diag file e))))

(fn main-print :i64 ((nodes (ref (vec node))) (ntexts (ref (vec :str))))
  (fmt 1 nodes ntexts)
  (ret 0))

(fn main-check-plain :i64 ((file :str) (e check-error))
  (let at :str (get e path))
  (main-write (if (str-eq at "") file at))
  (main-write ": ")
  (main-write (check-code (get e code)))
  (main-write ": ")
  (main-write (get e message))
  (main-write "\n")
  (main-diag-trailer file at)
  (ret 2))

(fn main-check-diag :i64 ((file :str) (e check-error))
  (ret (if (main-json-mode)
         (main-diag-json-2 file
           (get e path)
           (check-code (get e code)) 0 0
           (get e message))
         (main-check-plain file e))))

(fn main-checked-run :i64 ((file :str) (mods (ref (vec resolve-mod))) (nodes (ref (vec node))) (ntexts (ref (vec :str))))
  (let e check-error (check-file mods nodes ntexts))
  (ret (if (check-ok e) 0
         (main-check-diag file e))))

(fn main-checked :i64 ((file :str) (nodes (ref (vec node))) (ntexts (ref (vec :str))))
  (letmut defs
    (vec resolve-def)
    (make (vec resolve-def)))
  (letmut mods
    (vec resolve-mod)
    (make (vec resolve-mod)))
  (let e resolve-error (resolve-set nodes ntexts file defs mods))
  (letmut status :i64 0)
  (if (resolve-ok e)
    (set status (main-checked-run file mods nodes ntexts))
    (set status (main-resolve-diag file e)))
  (vec-free defs)
  (vec-free mods)
  (ret status))

(fn main-nothing :void ()
  (ret))

(fn main-lower-plain :i64 ((file :str) (e lower-error))
  (let at :str (get e path))
  (main-write (if (str-eq at "") file at))
  (main-write ": ")
  (main-write (lower-code (get e code)))
  (main-write ": ")
  (main-write (get e message))
  (main-write "\n")
  (main-diag-trailer file at)
  (ret 2))

(fn main-lower-diag :i64 ((file :str) (e lower-error))
  (ret (if (main-json-mode)
         (main-diag-json-2 file
           (get e path)
           (lower-code (get e code)) 0 0
           (get e message))
         (main-lower-plain file e))))

(fn main-ir-plain :i64 ((file :str) (at :str) (msg :str))
  (main-write (if (str-eq at "") file at))
  (main-write ": E0002: ")
  (main-write msg)
  (main-write "\n")
  (main-diag-trailer file at)
  (ret 2))

(fn main-ir-diag :i64 ((file :str) (nod (ref (vec node))) (ntx (ref (vec :str))) (e ir-error))
  (let at :str (tree-path nod ntx 0 0))
  (ret (if (main-json-mode)
         (main-diag-json-2 file at "E0002" 0 0 (get e text))
         (main-ir-plain file at (get e text)))))

(fn main-spit-bad :i64 ((path :str))
  (ret (main-fail (str-concat "cannot write " path))))

(fn main-spit :i64 ((path :str) (text :str))
  (let fd :i64 (rt_create path))
  (if (< fd 0)
    (ret (main-spit-bad path))
    (main-nothing))
  (let w :i64 (fmt-write fd text))
  (let _ :i32 (close fd))
  (ret (if (= w (str-len text)) 0
         (main-spit-bad path))))

(fn main-stem :str ((path :str))
  (let n :i64 (str-len path))
  (letmut slash :i64 -1)
  (letmut i :i64 0)
  (while (< i n)
    (if (= (cast :i64 (str-byte path i)) 47)
      (set slash i)
      (main-nothing))
    (set i (+ i 1)))
  (letmut dot :i64 -1)
  (set i (+ slash 1))
  (while (< i n)
    (if (= (cast :i64 (str-byte path i)) 46)
      (set dot i)
      (main-nothing))
    (set i (+ i 1)))
  (ret (if (> dot (+ slash 1))
         (str-slice path (+ slash 1) dot)
         (str-slice path (+ slash 1) n))))

(fn main-ir-path :str ((path :str))
  (ret (str-concat "build/" (str-concat (main-stem path) ".ll"))))

(fn main-sanitize :str ((s :str))
  (letmut out :str "")
  (letmut i :i64 0)
  (while (< i (str-len s))
    (let b :i64 (cast :i64 (str-byte s i)))
    (set out (str-concat out (if (or (= b 47)
                                   (= b 92)) "_"
                               (str-slice s i (+ i 1)))))
    (set i (+ i 1)))
  (ret out))

(fn main-ir-path-of :str ((path :str) (tname :str))
  (ret (if (str-eq tname "")
         (str-concat "build/" (str-concat (main-stem path) ".ll"))
         (str-concat "build/" (str-concat (main-stem path)
                                (str-concat "." (str-concat (main-sanitize tname) ".ll")))))))

(fn main-out-path :str ((path :str))
  (ret (str-concat "build/" (main-stem path))))

(fn main-dir :str ((path :str))
  (let n :i64 (str-len path))
  (letmut slash :i64 -1)
  (letmut i :i64 0)
  (while (< i n)
    (if (= (cast :i64 (str-byte path i)) 47)
      (set slash i)
      (main-nothing))
    (set i (+ i 1)))
  (ret (if (< slash 0) ""
         (if (= slash 0) "/"
           (str-slice path 0 slash)))))

(fn main-runtime-candidates :void ((out (ref (vec :str))))
  (let root :str (sys-root))
  (if (not (str-eq root ""))
    (vec-push out (sys-join root "share/logos/runtime/rt.c"))
    (main-nothing))
  (if (not (str-eq root ""))
    (vec-push out (sys-join root "logos/runtime/rt.c"))
    (main-nothing))
  (vec-push out "logos/runtime/rt.c")
  (ret))

(fn main-runtime :str ((cands (ref (vec :str))))
  (letmut i :i64 0)
  (letmut found :str "")
  (while (and (str-eq found "")
           (< i (vec-len cands)))
    (if (main-exists (vec-get cands i))
      (set found (vec-get cands i))
      (main-nothing))
    (set i (+ i 1)))
  (ret found))

(fn main-exists :bool ((path :str))
  (letmut argv
    (vec :str)
    (make (vec :str)))
  (vec-push argv "-f")
  (vec-push argv path)
  (let r :run (run "test" argv))
  (ret (= (run-status r) 0)))

(fn main-file-why :str ((path :str))
  (let why :str (path-error path))
  (ret (if (> (str-len why) 0) why
         (if (main-exists path) "" "not a regular file"))))

(fn main-mkdir :void ((dir :str))
  (if (str-eq dir "")
    (ret)
    (main-nothing))
  (let _ :i64 (mkdirs dir))
  (ret))

(fn main-joined :str ((argv (ref (vec :str))))
  (letmut text :str "clang")
  (letmut i :i64 0)
  (while (< i (vec-len argv))
    (set text (str-concat text (str-concat " " (vec-get argv i))))
    (set i (+ i 1)))
  (ret text))

(fn main-link-bad :i64 ((text :str) (r :run) (ll :str) (out :str))
  (letmut err :str (run-err r))
  (let n :i64 (str-len err))
  (if (and (> n 0)
        (= (cast :i64 (str-byte err (- n 1))) 10))
    (set err (str-slice err 0 (- n 1)))
    (main-nothing))
  (main-write "logos: clang failed: ")
  (main-write text)
  (if (> (str-len err) 0)
    (set err (str-concat "\n" err))
    (main-nothing))
  (main-write err)
  (main-write "\n")
  (unlink ll)
  (unlink out)
  (ret 1))

(fn main-link-missing :i64 ((ll :str) (out :str) (file :str) (cands (ref (vec :str))))
  (let at :str (if (str-eq file "") "build" file))
  (let msg :str (str-concat "runtime not found; searched: " (sys-list cands)))
  (unlink ll)
  (unlink out)
  (if (main-json-mode)
    (main-diag-json at "" "E0800" 0 0 msg)
    (main-write (str-concat (str-concat at ": E0800: ")
                  (str-concat msg "\n"))))
  (ret 1))

(fn main-link :i64 ((ll :str) (out :str) (opt :str) (dbg :i64) (file :str) (target :str))
  (letmut cands
    (vec :str)
    (make (vec :str)))
  (main-runtime-candidates cands)
  (let rt :str (main-runtime cands))
  (letmut bad :i64 0)
  (if (str-eq rt "")
    (set bad (main-link-missing ll out file cands))
    (main-nothing))
  (vec-free cands)
  (if (= bad 0)
    (main-nothing)
    (ret bad))
  (letmut argv
    (vec :str)
    (make (vec :str)))
  (if (= dbg 1)
    (vec-push argv "-DLOGOS_DEBUG=1")
    (main-nothing))
  (vec-push argv opt)
  (vec-push argv "-target")
  (vec-push argv target)
  (vec-push argv ll)
  (vec-push argv rt)
  (vec-push argv "-o")
  (vec-push argv out)
  (vec-push argv "-lpthread")
  (vec-push argv "-lm")
  (let text :str (main-joined argv))
  (let r :run (run "clang" argv))
  (ret (if (= (run-status r) 0) 0
         (main-link-bad text r ll out))))

(fn main-append :void ((mnod (ref (vec node))) (mntx (ref (vec :str))) (starts (ref (vec :i64))) (ends (ref (vec :i64))) (nod (ref (vec node))) (ntx (ref (vec :str))))
  (vec-push starts (vec-len mnod))
  (vec-push starts (vec-len mntx))
  (letmut i :i64 0)
  (while (< i (vec-len nod))
    (vec-push mnod (vec-get nod i))
    (set i (+ i 1)))
  (letmut t :i64 0)
  (while (< t (vec-len ntx))
    (vec-push mntx (vec-get ntx t))
    (set t (+ t 1)))
  (vec-push ends (vec-len mnod))
  (vec-push ends (vec-len mntx))
  (ret))

(fn main-load-module :i64 ((mods (ref (vec resolve-mod))) (m :i64) (mnod (ref (vec node))) (mntx (ref (vec :str))) (starts (ref (vec :i64))) (ends (ref (vec :i64))))
  (let file :str (get (vec-get mods m) file))
  (letmut kinds
    (vec :i64)
    (make (vec :i64)))
  (letmut texts
    (vec :str)
    (make (vec :str)))
  (letmut lines
    (vec :i64)
    (make (vec :i64)))
  (letmut cols
    (vec :i64)
    (make (vec :i64)))
  (letmut tnod
    (vec node)
    (make (vec node)))
  (letmut tntx
    (vec :str)
    (make (vec :str)))
  (let src :str (read-file file))
  (let le lex-error (lex src kinds texts lines cols))
  (if (not (lex-ok le))
    (ret (main-diag file "E0006"
           (get le line)
           (get le col)
           (get le msg)))
    (main-nothing))
  (let te tree-error (tree-parse kinds texts lines cols tnod tntx))
  (if (not (tree-ok te))
    (ret (main-diag file "E0001"
           (get te line)
           (get te col)
           (get te msg)))
    (main-nothing))
  (main-append mnod mntx starts ends tnod tntx)
  (vec-free kinds)
  (vec-free texts)
  (vec-free lines)
  (vec-free cols)
  (vec-free tnod)
  (vec-free tntx)
  (ret 0))

(fn main-check-main :i64 ((file :str) (mods (ref (vec resolve-mod))) (nod (ref (vec node))) (ntx (ref (vec :str))) (tname :str))
  (let me check-error (check-required-main mods nod ntx))
  (ret (if (or (not (str-eq tname ""))
             (check-ok me)) 0
         (main-check-diag file me))))

(fn main-built :i64 ((paths (ref (vec :str))) (dest :str) (opt :str) (target :str) (mqual (ref (vec :i64))) (sbase (ref (vec :i64))) (scount (ref (vec :i64))) (sftys (ref (vec :i64))) (ewords (ref (vec :i64))) (dsig (ref (vec :i64))) (dcnt (ref (vec :i64))) (dret (ref (vec :i64))) (sigtys (ref (vec :i64))) (fint (ref (vec :i64))) (fret (ref (vec :i64))) (fbase (ref (vec :i64))) (fcnt (ref (vec :i64))) (fparam (ref (vec :i64))) (fpc (ref (vec :i64))) (ptys (ref (vec :i64))) (bbase (ref (vec :i64))) (bcnt (ref (vec :i64))) (bterm (ref (vec :i64))) (bty (ref (vec :i64))) (bhas (ref (vec :i64))) (ops (ref (vec :i64))) (t1 (ref (vec :i64))) (t2 (ref (vec :i64))) (t3 (ref (vec :i64))) (n1 (ref (vec :i64))) (sst (ref (vec :i64))) (scn (ref (vec :i64))) (tst (ref (vec :i64))) (tcn (ref (vec :i64))) (tvals (ref (vec :i64))) (tags (ref (vec :i64))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (tptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (mtriple (ref (vec :str))) (snames (ref (vec :str))) (enames (ref (vec :str))) (gnames (ref (vec :str))) (gdata (ref (vec :str))) (dnames (ref (vec :str))) (fnames (ref (vec :str))) (fsyms (ref (vec :str))) (pnames (ref (vec :str))) (blabels (ref (vec :str))) (bv1 (ref (vec :str))) (bv2 (ref (vec :str))) (bv3 (ref (vec :str))) (dests (ref (vec :str))) (sa (ref (vec :str))) (sb (ref (vec :str))) (sc (ref (vec :str))) (sd (ref (vec :str))) (svals (ref (vec :str))) (tnames (ref (vec :str))) (powner (ref (vec :str))) (tpnames (ref (vec :str))) (pvname (ref (vec :str))) (nod (ref (vec node))) (ntx (ref (vec :str))) (out (ref (vec :str))) (defs (ref (vec resolve-def))) (mods (ref (vec resolve-mod))) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))) (tname :str))
  (let file :str (vec-get paths 0))
  (let src :str (read-file file))
  (let le lex-error (lex src kinds texts lines cols))
  (if (lex-ok le)
    (main-nothing)
    (ret (main-diag file "E0006"
           (get le line)
           (get le col)
           (get le msg))))
  (let te tree-error (tree-parse kinds texts lines cols nod ntx))
  (if (tree-ok te)
    (main-nothing)
    (ret (main-diag file "E0001"
           (get te line)
           (get te col)
           (get te msg))))
  (let re resolve-error (resolve-set-of paths defs mods))
  (if (resolve-ok re)
    (main-nothing)
    (ret (main-resolve-diag file re)))
  (let ce check-error (check-file mods nod ntx))
  (if (check-ok ce)
    (main-nothing)
    (ret (main-check-diag file ce)))
  (let mc :i64 (main-check-main file mods nod ntx tname))
  (if (= mc 0)
    (main-nothing)
    (ret mc))
  (letmut mnods
    (vec node)
    (make (vec node)))
  (letmut mntx
    (vec :str)
    (make (vec :str)))
  (letmut mstarts
    (vec :i64)
    (make (vec :i64)))
  (letmut mends
    (vec :i64)
    (make (vec :i64)))
  (main-append mnods mntx mstarts mends nod ntx)
  (letmut bad :i64 0)
  (letmut m :i64 1)
  (while (and (= bad 0)
           (< m (vec-len mods)))
    (set bad (main-load-module mods m mnods mntx mstarts mends))
    (set m (+ m 1)))
  (if (= bad 0)
    (main-nothing)
    (ret bad))
  (let lw lower-error (lower-build mtriple mqual target snames sbase scount sftys enames ewords gnames gdata dnames dsig dcnt dret sigtys fnames fsyms fint fret fbase fcnt fparam fpc pnames ptys blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals tags tnames elem extra pbase powner tpnames tptypes pchild pvname nod ntx mnods mntx mstarts mends tname))
  (vec-free mnods)
  (vec-free mntx)
  (vec-free mstarts)
  (vec-free mends)
  (if (lower-ok lw)
    (main-nothing)
    (ret (main-lower-diag file lw)))
  (let em ir-error (emit mtriple mqual tags tnames elem extra powner snames sbase scount sftys enames ewords gnames gdata dnames dsig dcnt dret sigtys fnames fsyms fint fret fbase fcnt fparam fpc pnames ptys blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals out))
  (if (ir-good em)
    (main-nothing)
    (ret (main-ir-diag file nod ntx em)))
  (let ll :str (main-ir-path-of file tname))
  (main-mkdir "build")
  (let wrote :i64 (main-spit ll (vec-get out 0)))
  (if (= wrote 0)
    (main-nothing)
    (ret wrote))
  (main-mkdir (main-dir dest))
  (ret (main-link ll dest opt (if (str-eq tname "") 0 1) file target)))

(fn main-flag-next :i64 ((a (ref (vec :str))) (i :i64) (into (ref (vec :str))))
  (vec-push into (vec-get a (+ i 1)))
  (ret (+ i 2)))

(fn main-attached-next :i64 ((s :str) (off :i64) (i :i64) (into (ref (vec :str))))
  (vec-push into (str-slice s off (str-len s)))
  (ret (+ i 1)))

(fn main-path-next :i64 ((a (ref (vec :str))) (i :i64) (paths (ref (vec :str))))
  (vec-push paths (vec-get a i))
  (ret (+ i 1)))

(fn main-arg :i64 ((a (ref (vec :str))) (n :i64) (i :i64) (paths (ref (vec :str))) (outs (ref (vec :str))) (opts (ref (vec :str))) (tnames (ref (vec :str))) (ttargets (ref (vec :str))))
  (let s :str (vec-get a i))
  (ret (if (str-eq s "-o")
         (if (< (+ i 1) n)
           (main-flag-next a i outs) -1)
         (if (str-eq s "--opt")
           (if (< (+ i 1) n)
             (main-flag-next a i opts) -1)
           (if (and (> (str-len s) 6)
                 (str-eq (str-slice s 0 6) "--opt="))
             (main-attached-next s 6 i opts)
             (if (str-eq s "--target")
               (if (< (+ i 1) n)
                 (main-flag-next a i ttargets) -1)
               (if (and (> (str-len s) 9)
                     (str-eq (str-slice s 0 9) "--target="))
                 (main-attached-next s 9 i ttargets)
                 (if (str-eq s "--test")
                   (if (< (+ i 1) n)
                     (main-flag-next a i tnames) -1)
                   (if (str-eq s "--keep-ir")
                     (+ i 1)
                     (if (and (> (str-len s) 0)
                           (= (cast :i64 (str-byte s 0)) 45)) -1
                       (main-path-next a i paths)))))))))))

(fn main-dest :str ((paths (ref (vec :str))) (outs (ref (vec :str))))
  (ret (if (> (vec-len outs) 0)
         (vec-get outs (- (vec-len outs) 1))
         (main-out-path (vec-get paths 0)))))

(fn main-opt :str ((opts (ref (vec :str))))
  (ret (if (> (vec-len opts) 0)
         (vec-get opts (- (vec-len opts) 1)) "-O2")))

(fn main-target-name :str ((ttargets (ref (vec :str))))
  (ret (if (> (vec-len ttargets) 0)
         (vec-get ttargets (- (vec-len ttargets) 1)) "x86_64-unknown-linux-gnu")))

(fn main-target-bad :str ((target :str))
  (ret (if (str-eq target "x86_64-unknown-linux-gnu") ""
         (str-concat "unsupported target '" (str-concat target "': this compiler emits x86_64-unknown-linux-gnu only")))))

(fn main-build :i64 ((a (ref (vec :str))) (n :i64) (prog :str))
  (letmut paths
    (vec :str)
    (make (vec :str)))
  (letmut outs
    (vec :str)
    (make (vec :str)))
  (letmut opts
    (vec :str)
    (make (vec :str)))
  (letmut tnames
    (vec :str)
    (make (vec :str)))
  (letmut ttargets
    (vec :str)
    (make (vec :str)))
  (letmut i :i64 2)
  (letmut bad :bool false)
  (letmut badat :i64 -1)
  (while (and (not bad)
           (< i n))
    (set badat i)
    (set i (main-arg a n i paths outs opts tnames ttargets))
    (if (< i 0)
      (set bad true)
      (main-nothing)))
  (if (= (vec-len paths) 0)
    (if bad
      (ret (main-bad-flag prog "build" a n badat))
      (ret (main-required prog "build" "FILE")))
    (main-nothing))
  (let target :str (main-target-name ttargets))
  (let tbad :str (main-target-bad target))
  (if (not (str-eq tbad ""))
    (ret (main-cli-error prog "build" tbad))
    (main-nothing))
  (letmut status :i64 0)
  (letmut gone :str "")
  (if bad
    (main-nothing)
    (set gone (main-unreadable paths)))
  (if bad
    (set status (main-bad-flag prog "build" a n badat))
    (if (not (str-eq gone ""))
      (set status (main-fmt-bad gone (path-error gone)))
      (set status (main-build-all paths
                    (main-dest paths outs)
                    (main-opt opts)
                    (main-test-name tnames) target))))
  (vec-free paths)
  (vec-free outs)
  (vec-free opts)
  (vec-free tnames)
  (vec-free ttargets)
  (ret status))

(fn main-unreadable :str ((paths (ref (vec :str))))
  (letmut i :i64 0)
  (letmut found :str "")
  (while (and (str-eq found "")
           (< i (vec-len paths)))
    (if (> (str-len (main-file-why (vec-get paths i))) 0)
      (set found (vec-get paths i))
      (main-nothing))
    (set i (+ i 1)))
  (ret found))

(fn main-bad-flag :i64 ((prog :str) (verb :str) (a (ref (vec :str))) (n :i64) (i :i64))
  (let s :str (vec-get a i))
  (ret (if (or (str-eq s "-o")
             (or (str-eq s "--opt")
               (or (and (str-eq verb "build")
                     (str-eq s "--target"))
                 (or (str-eq s "--test")
                   (str-eq s "--only")))))
         (main-cli-error prog verb (str-concat "argument " (str-concat s ": expected one argument")))
         (main-unrecognized prog s))))

(fn main-test-name :str ((tnames (ref (vec :str))))
  (ret (if (> (vec-len tnames) 0)
         (vec-get tnames (- (vec-len tnames) 1)) "")))

