(mod main)

(use lex)

(use tree)

(use fmt)

(use resolve)

(use check)

(use lower)

(use ir)

(use emit)

(extern fn rt_write :i64 ((fd :i64) (text :str)))

(extern fn rt_create :i64 ((path :str)))

(extern fn close :i32 ((fd :i64)))

(fn main-write :void ((s :str))
  (let _ :i64 (rt_write 2 s))
  (ret))

(fn main-usage :i64 ()
  (main-write "usage: gen2 <fmt|check> <file>\n")
  (main-write "       gen2 resolve <file>...\n")
  (main-write "       gen2 build <file>... -o <out>\n")
  (ret 2))

(fn main-diag :i64 ((path :str) (code :str) (line :i64) (col :i64) (msg :str))
  (main-write path)
  (main-write ":")
  (main-write (str-from-i64 line))
  (main-write ":")
  (main-write (str-from-i64 col))
  (main-write ": ")
  (main-write code)
  (main-write ": ")
  (main-write msg)
  (main-write "\n")
  (ret 2))

(fn main-at :str ((path :str) (file :str) (line :i64) (col :i64) (fallback :str))
  (ret (if (not (str-eq path "")) path
         (if (not (str-eq file ""))
           (str-concat file (str-concat ":" (str-concat (str-from-i64 line)
                                              (str-concat ":" (str-from-i64 col))))) fallback))))

(fn main-resolve-diag :i64 ((file :str) (e resolve-error))
  (main-write (main-at (get e path)
                (get e file)
                (get e line)
                (get e col) file))
  (main-write ": ")
  (main-write (resolve-code (get e code)))
  (main-write ": ")
  (main-write (get e message))
  (main-write "\n")
  (ret 2))

(fn main-resolved :i64 ((file :str) (nodes (ref (vec node))) (ntexts (ref (vec :str))))
  (let e resolve-error (resolve-file nodes ntexts file))
  (ret (if (resolve-ok e) 0
         (main-resolve-diag file e))))

(fn main-print :i64 ((nodes (ref (vec node))) (ntexts (ref (vec :str))))
  (fmt nodes ntexts)
  (ret 0))

(fn main-check-diag :i64 ((file :str) (e check-error))
  (let at :str (get e path))
  (main-write (if (str-eq at "") file at))
  (main-write ": ")
  (main-write (check-code (get e code)))
  (main-write ": ")
  (main-write (get e message))
  (main-write "\n")
  (ret 2))

(fn main-checked-run :i64 ((file :str) (mods (ref (vec resolve-mod))) (nodes (ref (vec node))) (ntexts (ref (vec :str))))
  (let e check-error (check-file mods nodes ntexts))
  (ret (if (check-ok e) 0
         (main-check-diag file e))))

(fn main-checked :i64 ((file :str) (nodes (ref (vec node))) (ntexts (ref (vec :str))))
  (letmut defs
    (vec resolve-def)
    (make (vec resolve-def)))
  (letmut mods
    (vec resolve-mod)
    (make (vec resolve-mod)))
  (let e resolve-error (resolve-set nodes ntexts file defs mods))
  (letmut status :i64 0)
  (if (resolve-ok e)
    (set status (main-checked-run file mods nodes ntexts))
    (set status (main-resolve-diag file e)))
  (vec-free defs)
  (vec-free mods)
  (ret status))

(fn main-nothing :void ()
  (ret))

(fn main-lower-diag :i64 ((file :str) (e lower-error))
  (let at :str (get e path))
  (main-write (if (str-eq at "") file at))
  (main-write ": ")
  (main-write (lower-code (get e code)))
  (main-write ": ")
  (main-write (get e message))
  (main-write "\n")
  (ret 2))

(fn main-ir-diag :i64 ((file :str) (nod (ref (vec node))) (ntx (ref (vec :str))) (e ir-error))
  (let at :str (tree-path nod ntx 0 0))
  (main-write (if (str-eq at "") file at))
  (main-write ": E0002: ")
  (main-write (get e text))
  (main-write "\n")
  (ret 2))

(fn main-spit-bad :i64 ((path :str))
  (main-write "gen2 build: cannot write ")
  (main-write path)
  (main-write "\n")
  (ret 2))

(fn main-spit :i64 ((path :str) (text :str))
  (let fd :i64 (rt_create path))
  (if (< fd 0)
    (ret (main-spit-bad path))
    (main-nothing))
  (let w :i64 (rt_write fd text))
  (let _ :i32 (close fd))
  (ret (if (= w (str-len text)) 0
         (main-spit-bad path))))

(fn main-append :void ((mnod (ref (vec node))) (mntx (ref (vec :str))) (starts (ref (vec :i64))) (ends (ref (vec :i64))) (nod (ref (vec node))) (ntx (ref (vec :str))))
  (vec-push starts (vec-len mnod))
  (vec-push starts (vec-len mntx))
  (letmut i :i64 0)
  (while (< i (vec-len nod))
    (vec-push mnod (vec-get nod i))
    (set i (+ i 1)))
  (letmut t :i64 0)
  (while (< t (vec-len ntx))
    (vec-push mntx (vec-get ntx t))
    (set t (+ t 1)))
  (vec-push ends (vec-len mnod))
  (vec-push ends (vec-len mntx))
  (ret))

(fn main-load-module :i64 ((mods (ref (vec resolve-mod))) (m :i64) (mnod (ref (vec node))) (mntx (ref (vec :str))) (starts (ref (vec :i64))) (ends (ref (vec :i64))))
  (let file :str (get (vec-get mods m) file))
  (letmut kinds
    (vec :i64)
    (make (vec :i64)))
  (letmut texts
    (vec :str)
    (make (vec :str)))
  (letmut lines
    (vec :i64)
    (make (vec :i64)))
  (letmut cols
    (vec :i64)
    (make (vec :i64)))
  (letmut tnod
    (vec node)
    (make (vec node)))
  (letmut tntx
    (vec :str)
    (make (vec :str)))
  (let src :str (read-file file))
  (let le lex-error (lex src kinds texts lines cols))
  (if (not (lex-ok le))
    (ret (main-diag file "E0006"
           (get le line)
           (get le col)
           (get le msg)))
    (main-nothing))
  (let te tree-error (tree-parse kinds texts lines cols tnod tntx))
  (if (not (tree-ok te))
    (ret (main-diag file "E0001"
           (get te line)
           (get te col)
           (get te msg)))
    (main-nothing))
  (main-append mnod mntx starts ends tnod tntx)
  (vec-free kinds)
  (vec-free texts)
  (vec-free lines)
  (vec-free cols)
  (vec-free tnod)
  (vec-free tntx)
  (ret 0))

(fn main-built :i64 ((paths (ref (vec :str))) (path :str) (mqual (ref (vec :i64))) (sbase (ref (vec :i64))) (scount (ref (vec :i64))) (sftys (ref (vec :i64))) (ewords (ref (vec :i64))) (dsig (ref (vec :i64))) (dcnt (ref (vec :i64))) (dret (ref (vec :i64))) (sigtys (ref (vec :i64))) (fint (ref (vec :i64))) (fret (ref (vec :i64))) (fbase (ref (vec :i64))) (fcnt (ref (vec :i64))) (fparam (ref (vec :i64))) (fpc (ref (vec :i64))) (ptys (ref (vec :i64))) (bbase (ref (vec :i64))) (bcnt (ref (vec :i64))) (bterm (ref (vec :i64))) (bty (ref (vec :i64))) (bhas (ref (vec :i64))) (ops (ref (vec :i64))) (t1 (ref (vec :i64))) (t2 (ref (vec :i64))) (t3 (ref (vec :i64))) (n1 (ref (vec :i64))) (sst (ref (vec :i64))) (scn (ref (vec :i64))) (tst (ref (vec :i64))) (tcn (ref (vec :i64))) (tvals (ref (vec :i64))) (tags (ref (vec :i64))) (elem (ref (vec :i64))) (extra (ref (vec :i64))) (pbase (ref (vec :i64))) (tptypes (ref (vec :i64))) (pchild (ref (vec :i64))) (mtriple (ref (vec :str))) (snames (ref (vec :str))) (enames (ref (vec :str))) (gnames (ref (vec :str))) (gdata (ref (vec :str))) (dnames (ref (vec :str))) (fnames (ref (vec :str))) (fsyms (ref (vec :str))) (pnames (ref (vec :str))) (blabels (ref (vec :str))) (bv1 (ref (vec :str))) (bv2 (ref (vec :str))) (bv3 (ref (vec :str))) (dests (ref (vec :str))) (sa (ref (vec :str))) (sb (ref (vec :str))) (sc (ref (vec :str))) (sd (ref (vec :str))) (svals (ref (vec :str))) (tnames (ref (vec :str))) (powner (ref (vec :str))) (tpnames (ref (vec :str))) (pvname (ref (vec :str))) (nod (ref (vec node))) (ntx (ref (vec :str))) (out (ref (vec :str))) (defs (ref (vec resolve-def))) (mods (ref (vec resolve-mod))) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))))
  (let file :str (vec-get paths 0))
  (let src :str (read-file file))
  (let le lex-error (lex src kinds texts lines cols))
  (if (lex-ok le)
    (main-nothing)
    (ret (main-diag file "E0006"
           (get le line)
           (get le col)
           (get le msg))))
  (let te tree-error (tree-parse kinds texts lines cols nod ntx))
  (if (tree-ok te)
    (main-nothing)
    (ret (main-diag file "E0001"
           (get te line)
           (get te col)
           (get te msg))))
  (let re resolve-error (resolve-set-of paths defs mods))
  (if (resolve-ok re)
    (main-nothing)
    (ret (main-resolve-diag file re)))
  (let ce check-error (check-file mods nod ntx))
  (if (check-ok ce)
    (main-nothing)
    (ret (main-check-diag file ce)))
  (let me check-error (check-required-main mods nod ntx))
  (if (check-ok me)
    (main-nothing)
    (ret (main-check-diag file me)))
  (letmut mnods
    (vec node)
    (make (vec node)))
  (letmut mntx
    (vec :str)
    (make (vec :str)))
  (letmut mstarts
    (vec :i64)
    (make (vec :i64)))
  (letmut mends
    (vec :i64)
    (make (vec :i64)))
  (main-append mnods mntx mstarts mends nod ntx)
  (letmut bad :i64 0)
  (letmut m :i64 1)
  (while (and (= bad 0)
           (< m (vec-len mods)))
    (set bad (main-load-module mods m mnods mntx mstarts mends))
    (set m (+ m 1)))
  (if (= bad 0)
    (main-nothing)
    (ret bad))
  (let lw lower-error (lower-build mtriple mqual snames sbase scount sftys enames ewords gnames gdata dnames dsig dcnt dret sigtys fnames fsyms fint fret fbase fcnt fparam fpc pnames ptys blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals tags tnames elem extra pbase powner tpnames tptypes pchild pvname nod ntx mnods mntx mstarts mends))
  (vec-free mnods)
  (vec-free mntx)
  (vec-free mstarts)
  (vec-free mends)
  (if (lower-ok lw)
    (main-nothing)
    (ret (main-lower-diag file lw)))
  (let em ir-error (emit mtriple mqual tags tnames elem extra powner snames sbase scount sftys enames ewords gnames gdata dnames dsig dcnt dret sigtys fnames fsyms fint fret fbase fcnt fparam fpc pnames ptys blabels bbase bcnt bterm bty bhas bv1 bv2 bv3 ops dests sa sb sc sd t1 t2 t3 n1 sst scn tst tcn svals tvals out))
  (if (ir-good em)
    (main-nothing)
    (ret (main-ir-diag file nod ntx em)))
  (ret (main-spit path (vec-get out 0))))

