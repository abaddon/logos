(mod fmt-test)

(use lex)

(use tree)

(use fmt)

(fn print-lex-error :void ((e lex-error))
  (println (get e msg)))

(fn print-tree-error :void ((t tree-error))
  (println (get t msg)))

(fn fmt-arena :void ((kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))) (nodes (ref (vec node))) (ntexts (ref (vec :str))))
  (let t tree-error (tree-parse kinds texts lines cols nodes ntexts))
  (if (tree-ok t)
    (fmt nodes ntexts)
    (print-tree-error t)))

(fn fmt-src :void ((src :str))
  (letmut kinds
    (vec :i64)
    (make (vec :i64)))
  (letmut texts
    (vec :str)
    (make (vec :str)))
  (letmut lines
    (vec :i64)
    (make (vec :i64)))
  (letmut cols
    (vec :i64)
    (make (vec :i64)))
  (letmut nodes
    (vec node)
    (make (vec node)))
  (letmut ntexts
    (vec :str)
    (make (vec :str)))
  (let e lex-error (lex src kinds texts lines cols))
  (if (lex-ok e)
    (fmt-arena kinds texts lines cols nodes ntexts)
    (print-lex-error e))
  (vec-free kinds)
  (vec-free texts)
  (vec-free lines)
  (vec-free cols)
  (vec-free nodes)
  (vec-free ntexts))

(test mod-alone
  (expect (out "(mod a)\n")
    (code 0)
    (leaks 0))
  (fmt-src "(mod a)\n"))

(test inline-ret
  (expect (out "(mod a)\n\n(fn add :i64 ((a :i64) (b :i64))\n  (ret (+ a b)))\n")
    (code 0)
    (leaks 0))
  (fmt-src "(mod a)\n\n(fn add :i64 ((a :i64) (b :i64))\n  (ret (+ a b)))\n"))

(test fn-body-breaks
  (expect (out "(mod f)\n\n(fn sum :i64 ((n :i64))\n  (letmut i :i64 0)\n  (letmut total :i64 0)\n  (while (< i n)\n    (set total (+ total i))\n    (set i (+ i 1)))\n  (ret total))\n")
    (code 0)
    (leaks 0))
  (fmt-src "(mod f)\n\n(fn sum :i64 ((n :i64))\n  (letmut i :i64 0)\n  (letmut total :i64 0)\n  (while (< i n)\n    (set total (+ total i))\n    (set i (+ i 1)))\n  (ret total))\n"))

(test test-body-breaks
  (expect (out "(mod t)\n\n(test t\n  (expect (out \"ok\\n\")\n    (code 0)\n    (leaks 0))\n  (println \"ok\"))\n")
    (code 0)
    (leaks 0))
  (fmt-src "(mod t)\n\n(test t\n  (expect (out \"ok\\n\")\n    (code 0)\n    (leaks 0))\n  (println \"ok\"))\n"))

(test struct-inline
  (expect (out "(mod s)\n\n(type point (struct (x :i64) (y :i64)))\n")
    (code 0)
    (leaks 0))
  (fmt-src "(mod s)\n\n(type point (struct (x :i64) (y :i64)))\n"))

(test enum-inline
  (expect (out "(mod e)\n\n(type option (enum (none) (some :i64)))\n")
    (code 0)
    (leaks 0))
  (fmt-src "(mod e)\n\n(type option (enum (none) (some :i64)))\n"))

(test escapes
  (expect (out "(mod s)\n\n(fn f :i64 ()\n  (ret \"a\\\\b\\\"c\\n\\t\\r\\0é\"))\n")
    (code 0)
    (leaks 0))
  (fmt-src "(mod s)\n\n(fn f :i64 ()\n  (ret \"a\\\\b\\\"c\\n\\t\\r\\0é\"))\n"))

(test raw-newline
  (expect (out "(mod s)\n\n(fn f :i64 ()\n  (ret \"a\\nb\\tc\"))\n")
    (code 0)
    (leaks 0))
  (fmt-src "(mod s)\n\n(fn f :i64 ()\n  (ret \"a\nb\tc\"))\n"))

(test deep-nested
  (expect (out "(mod d)\n\n(fn f :i64 ()\n  (ret (a (b (c (d 1))))))\n")
    (code 0)
    (leaks 0))
  (fmt-src "(mod d)\n\n(fn f :i64 ()\n  (ret (a (b (c (d 1))))))\n"))

(test sibling-run
  (expect (out "(mod s)\n\n(fn pick :i64 ((a :i64))\n  (if (> a 0)\n    (ret 1)\n    (if (= a 0)\n      (ret 2)\n      (ret 3))))\n")
    (code 0)
    (leaks 0))
  (fmt-src "(mod s)\n\n(fn pick :i64 ((a :i64))\n  (if (> a 0)\n    (ret 1)\n    (if (= a 0)\n      (ret 2)\n      (ret 3))))\n"))

(test composite-return
  (expect (out "(mod c)\n\n(fn f\n  (vec :i64) ()\n  (ret (vec-len (make (vec :i64)))))\n")
    (code 0)
    (leaks 0))
  (fmt-src "(mod c)\n\n(fn f (vec :i64) ()\n  (ret (vec-len (make (vec :i64)))))\n"))

(test extern-named
  (expect (out "(mod x)\n\n(extern fn getpid :i64 ())\n")
    (code 0)
    (leaks 0))
  (fmt-src "(mod x)\n\n(extern fn getpid :i64 ())\n"))

(test closure
  (expect (out "(mod c)\n\n(fn main :void ()\n  (let f (fn :i64 ((x :i64))\n           (ret (+ x 1))))\n  (println (f 2)))\n")
    (code 0)
    (leaks 0))
  (fmt-src "(mod c)\n\n(fn main :void ()\n  (let f (fn :i64 ((x :i64))\n           (ret (+ x 1))))\n  (println (f 2)))\n"))

(test bare-heads
  (expect (out "(mod h)\n\n(\"s\" x)\n\n(1 2)\n")
    (code 0)
    (leaks 0))
  (fmt-src "(mod h)\n\n(\"s\" x)\n\n(1 2)\n"))

(test empty-list
  (expect (out "(mod e)\n\n(fn f :i64 ()\n  (ret ()))\n")
    (code 0)
    (leaks 0))
  (fmt-src "(mod e)\n\n(fn f :i64 ()\n  (ret ()))\n"))

(test unicode-head
  (expect (out "(mod u)\n\n(é (g (a 1)\n     (b 2))\n  (c 3)\n  (d 4))\n")
    (code 0)
    (leaks 0))
  (fmt-src "(mod u)\n\n(é (g (a 1) (b 2)) (c 3) (d 4))\n"))

(test canonical-file
  (expect (out "(mod canon)\n\n(use str)\n\n(type pair (struct (left :i64) (right :i64)))\n\n(type shape (enum (point :i64) (nothing)))\n\n(extern fn getpid :i64 ())\n\n(fn add :i64 ((a :i64) (b :i64))\n  (ret (+ a b)))\n\n(fn pick :str ((n :i64))\n  (ret (match n (0 \"zero\") (_ \"many\"))))\n\n(test add\n  (expect (out \"3\\n\")\n    (code 0)\n    (leaks 0))\n  (println (add 1 2)))\n")
    (code 0)
    (leaks 0))
  (fmt-src "(mod canon)\n\n(use str)\n\n(type pair (struct (left :i64) (right :i64)))\n\n(type shape (enum (point :i64) (nothing)))\n\n(extern fn getpid :i64 ())\n\n(fn add :i64 ((a :i64) (b :i64))\n  (ret (+ a b)))\n\n(fn pick :str ((n :i64))\n  (ret (match n (0 \"zero\") (_ \"many\"))))\n\n(test add\n  (expect (out \"3\\n\")\n    (code 0)\n    (leaks 0))\n  (println (add 1 2)))\n"))

(test empty-file
  (expect (out "")
    (code 0)
    (leaks 0))
  (fmt-src ""))

(test numbers-and-cast
  (expect (out "(mod n)\n\n(fn f :f64 ()\n  (ret (+ -2.5E-3 (cast :f64 1e10))))\n")
    (code 0)
    (leaks 0))
  (fmt-src "(mod n)\n\n(fn f :f64 ()\n  (ret (+ -2.5E-3 (cast :f64 1e10))))\n"))

(test match-and-calls
  (expect (out "(mod m)\n\n(fn classify :str ((n :i64))\n  (ret (match n (0 \"zero\") (_ \"many\"))))\n\n(fn half :f64 ((x :f64))\n  (ret (/ x 2.0)))\n")
    (code 0)
    (leaks 0))
  (fmt-src "(mod m)\n\n(fn classify :str ((n :i64))\n  (ret (match n\n         (0 \"zero\")\n         (_ \"many\"))))\n\n(fn half :f64 ((x :f64))\n  (ret (/ x 2.0)))\n"))
