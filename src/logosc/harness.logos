(mod harness)

(use lex)

(use tree)

(use fmt)

(extern fn rt_create :i64 ((path :str)))

(extern fn close :i32 ((fd :i64)))

(extern fn unlink :i32 ((path :str)))

(type h-found (struct (code :str) (problem :str)))

(fn h-nothing :void ()
  (ret))

(fn h-slash-last :i64 ((s :str))
  (letmut at :i64 -1)
  (letmut i :i64 0)
  (while (< i (str-len s))
    (if (= (cast :i64 (str-byte s i)) 47)
      (set at i)
      (h-nothing))
    (set i (+ i 1)))
  (ret at))

(fn h-base :str ((s :str))
  (let at :i64 (h-slash-last s))
  (ret (if (< at 0) s
         (str-slice s
           (+ at 1)
           (str-len s)))))

(fn h-parent :str ((s :str))
  (let at :i64 (h-slash-last s))
  (ret (if (< at 0) ""
         (if (= at 0) "/"
           (str-slice s 0 at)))))

(fn h-trim-nl :str ((s :str))
  (letmut n :i64 (str-len s))
  (while (and (> n 0)
           (= (cast :i64 (str-byte s (- n 1))) 10))
    (set n (- n 1)))
  (ret (str-slice s 0 n)))

(fn h-categories :void ((out (ref (vec :str))))
  (vec-push out "parse")
  (vec-push out "type")
  (vec-push out "exec")
  (vec-push out "mem")
  (vec-push out "thread")
  (vec-push out "generics")
  (vec-push out "regress")
  (vec-push out "diff")
  (ret))

(fn h-known-category :bool ((s :str))
  (letmut all
    (vec :str)
    (make (vec :str)))
  (h-categories all)
  (letmut i :i64 0)
  (letmut found :bool false)
  (while (and (not found)
           (< i (vec-len all)))
    (set found (str-eq (vec-get all i) s))
    (set i (+ i 1)))
  (vec-free all)
  (ret found))

(fn h-category-walk :str ((dir :str))
  (if (str-eq dir "")
    (ret "exec")
    (h-nothing))
  (if (str-eq dir "/")
    (ret "exec")
    (h-nothing))
  (ret (if (h-known-category (h-base dir))
         (h-base dir)
         (h-category-walk (h-parent dir)))))

(fn h-category-of :str ((path :str))
  (ret (h-category-walk (h-parent path))))

(fn h-category-dir-walk :str ((fallback :str) (dir :str))
  (if (str-eq dir "")
    (ret fallback)
    (h-nothing))
  (if (str-eq dir "/")
    (ret fallback)
    (h-nothing))
  (ret (if (h-known-category (h-base dir)) dir
         (h-category-dir-walk fallback (h-parent dir)))))

(fn h-category-dir :str ((path :str))
  (ret (h-category-dir-walk (h-parent path)
         (h-parent path))))

(fn h-relative :str ((dir :str) (path :str))
  (let dl :i64 (str-len dir))
  (letmut rest :str path)
  (if (and (> dl 0)
        (> (str-len path) dl))
    (if (= (cast :i64 (str-byte path dl)) 47)
      (set rest (str-slice path
                  (+ dl 1)
                  (str-len path)))
      (h-nothing))
    (h-nothing))
  (let n :i64 (str-len rest))
  (ret (if (and (>= n 6)
             (str-eq (str-slice rest (- n 6) n) ".logos"))
         (str-slice rest 0 (- n 6)) rest)))

(fn h-join :str ((dir :str) (name :str))
  (ret (if (str-eq dir "") name
         (if (= (cast :i64 (str-byte dir (- (str-len dir) 1))) 47)
           (str-concat dir name)
           (str-concat dir (str-concat "/" name))))))

(fn h-logos-name :bool ((name :str))
  (let n :i64 (str-len name))
  (ret (if (< n 6) false
         (str-eq (str-slice name (- n 6) n) ".logos"))))

(fn h-str-less :bool ((a :str) (b :str))
  (let an :i64 (str-len a))
  (let bn :i64 (str-len b))
  (let lim :i64 (if (< an bn) an bn))
  (letmut i :i64 0)
  (letmut stop :bool false)
  (while (and (not stop)
           (< i lim))
    (if (= (cast :i64 (str-byte a i))
          (cast :i64 (str-byte b i)))
      (set i (+ i 1))
      (set stop true)))
  (ret (if (< i lim)
         (< (cast :i64 (str-byte a i))
           (cast :i64 (str-byte b i)))
         (< an bn))))

(fn h-sort :void ((names (ref (vec :str))))
  (let n :i64 (vec-len names))
  (letmut i :i64 1)
  (while (< i n)
    (let item :str (vec-get names i))
    (letmut j :i64 i)
    (while (and (> j 0)
             (h-str-less item (vec-get names (- j 1))))
      (vec-set names j (vec-get names (- j 1)))
      (set j (- j 1)))
    (vec-set names j item)
    (set i (+ i 1)))
  (ret))

(fn h-append :void ((from (ref (vec :str))) (into (ref (vec :str))))
  (letmut i :i64 0)
  (while (< i (vec-len from))
    (vec-push into (vec-get from i))
    (set i (+ i 1)))
  (ret))

(fn h-walk :void ((dir :str) (out (ref (vec :str))))
  (letmut names
    (vec :str)
    (read-dir dir))
  (letmut i :i64 0)
  (while (< i (vec-len names))
    (let name :str (vec-get names i))
    (let path :str (h-join dir name))
    (if (is-dir path)
      (h-walk path out)
      (if (h-logos-name name)
        (vec-push out path)
        (h-nothing)))
    (set i (+ i 1)))
  (vec-free names)
  (ret))

(fn h-walk-sorted :void ((dir :str) (all (ref (vec :str))))
  (letmut part
    (vec :str)
    (make (vec :str)))
  (h-walk dir part)
  (h-sort part)
  (h-append part all)
  (vec-free part)
  (ret))

(fn h-has-category :bool ((root :str))
  (ret (or (is-dir (h-join root "parse"))
         (or (is-dir (h-join root "type"))
           (or (is-dir (h-join root "exec"))
             (or (is-dir (h-join root "mem"))
               (or (is-dir (h-join root "thread"))
                 (or (is-dir (h-join root "generics"))
                   (or (is-dir (h-join root "regress"))
                     (is-dir (h-join root "diff")))))))))))

(fn h-walk-cat :void ((root :str) (cat :str) (all (ref (vec :str))))
  (let dir :str (h-join root cat))
  (if (is-dir dir)
    (h-walk-sorted dir all)
    (h-nothing))
  (ret))

(fn h-walk-cats :void ((root :str) (all (ref (vec :str))))
  (h-walk-cat root "parse" all)
  (h-walk-cat root "type" all)
  (h-walk-cat root "exec" all)
  (h-walk-cat root "mem" all)
  (h-walk-cat root "thread" all)
  (h-walk-cat root "generics" all)
  (h-walk-cat root "regress" all)
  (h-walk-cat root "diff" all)
  (ret))

(fn h-only-match :bool ((cat :str) (only :str))
  (ret (if (str-eq only "") true
         (str-eq cat only))))

(fn h-filter :void ((all (ref (vec :str))) (only :str) (files (ref (vec :str))))
  (letmut i :i64 0)
  (while (< i (vec-len all))
    (if (h-only-match (h-category-of (vec-get all i)) only)
      (vec-push files (vec-get all i))
      (h-nothing))
    (set i (+ i 1)))
  (ret))

(fn h-exists :bool ((path :str))
  (ret (or (is-dir path)
         (str-eq (path-error path) ""))))

(fn h-file-exists :bool ((path :str))
  (ret (and (not (is-dir path))
         (str-eq (path-error path) ""))))

(fn h-in-list :bool ((v (ref (vec :str))) (s :str))
  (letmut i :i64 0)
  (letmut found :bool false)
  (while (and (not found)
           (< i (vec-len v)))
    (if (str-eq (vec-get v i) s)
      (set found true)
      (h-nothing))
    (set i (+ i 1)))
  (ret found))

(fn h-skip-diff :void ((every (ref (vec :str))) (claimed (ref (vec :str))) (skipped (ref (vec :str))))
  (letmut i :i64 0)
  (while (< i (vec-len every))
    (if (h-in-list claimed (vec-get every i))
      (h-nothing)
      (vec-push skipped (vec-get every i)))
    (set i (+ i 1)))
  (ret))

(fn h-discover :i64 ((root :str) (only :str) (files (ref (vec :str))) (skipped (ref (vec :str))))
  (if (not (h-exists root))
    (ret -1)
    (h-nothing))
  (letmut all
    (vec :str)
    (make (vec :str)))
  (if (is-dir root)
    (if (h-has-category root)
      (h-walk-cats root all)
      (h-walk-sorted root all))
    (vec-push all root))
  (if (is-dir root)
    (if (h-has-category root)
      (h-skip-scan root all skipped)
      (h-nothing))
    (h-nothing))
  (h-filter all only files)
  (vec-free all)
  (ret 0))

(fn h-skip-scan :void ((root :str) (claimed (ref (vec :str))) (skipped (ref (vec :str))))
  (letmut every
    (vec :str)
    (make (vec :str)))
  (h-walk-sorted root every)
  (h-skip-diff every claimed skipped)
  (vec-free every)
  (ret))

(fn h-missing :void ((root :str))
  (fmt-emit 2 (str-concat "logos: test: " (str-concat root ": no such file or directory\n")))
  (ret))

(fn h-quote-byte :bool ((b :i64))
  (ret (or (and (>= b 48)
             (<= b 57))
         (or (and (>= b 65)
               (<= b 90))
           (or (and (>= b 97)
                 (<= b 122))
             (or (= b 47)
               (or (= b 46)
                 (or (= b 95)
                   (or (= b 45)
                     (= b 126))))))))))

(fn h-hex :str ((n :i64))
  (ret (if (< n 10)
         (str-from-i64 n)
         (str-slice "ABCDEF"
           (- n 10)
           (+ (- n 10) 1)))))

(fn h-encode :str ((s :str))
  (letmut text :str "")
  (letmut i :i64 0)
  (while (< i (str-len s))
    (let b :i64 (cast :i64 (str-byte s i)))
    (if (h-quote-byte b)
      (set text (str-concat text (str-slice s i (+ i 1))))
      (set text (str-concat text (str-concat "%" (str-concat (h-hex (/ b 16))
                                                   (h-hex (% b 16)))))))
    (set i (+ i 1)))
  (ret text))

(fn h-one-line :str ((text :str))
  (letmut out :str "")
  (letmut i :i64 0)
  (while (< i (str-len text))
    (let b :i64 (cast :i64 (str-byte text i)))
    (if (= b 13)
      (set out (str-concat out "\\r"))
      (if (= b 10)
        (set out (str-concat out "\\n"))
        (if (= b 9)
          (set out (str-concat out "\\t"))
          (set out (str-concat out (str-slice text i (+ i 1)))))))
    (set i (+ i 1)))
  (ret (if (> (str-len out) 240)
         (str-concat (str-slice out 0 237) "...") out)))

(fn h-pass :void ((id :str) (totals (ref (vec :i64))) (records (ref (vec :str))))
  (println (str-concat "PASS " (str-concat id " -")))
  (vec-push records (str-concat "PASS " (str-concat (h-encode id) " -")))
  (vec-set totals 0 (+ (vec-get totals 0) 1))
  (ret))

(fn h-fail :void ((id :str) (detail :str) (totals (ref (vec :i64))) (records (ref (vec :str))))
  (println (str-concat "FAIL " (str-concat id (str-concat " " detail))))
  (vec-push records (str-concat "FAIL " (str-concat (h-encode id)
                                          (str-concat " " (h-one-line detail)))))
  (vec-set totals 1 (+ (vec-get totals 1) 1))
  (ret))

(fn h-skips :void ((skipped (ref (vec :str))))
  (letmut i :i64 0)
  (while (< i (vec-len skipped))
    (println (str-concat "SKIP " (vec-get skipped i)))
    (set i (+ i 1)))
  (ret))

(fn h-skip-line :void ((n :i64))
  (fmt-emit 2 (str-concat "logos: test: " (str-concat (str-from-i64 n) " file(s) outside the known categories were skipped\n")))
  (ret))

(fn h-summary :void ((totals (ref (vec :i64))))
  (println (str-concat (str-from-i64 (vec-get totals 0))
             (str-concat " passed, " (str-concat (str-from-i64 (vec-get totals 1))
                                       (str-concat " failed, " (str-concat (str-from-i64 (vec-get totals 2)) " leaked"))))))
  (ret))

(fn h-default-levels :void ((opts (ref (vec :str))))
  (vec-push opts "-O0")
  (vec-push opts "-O2")
  (ret))

(fn h-levels :void ((opts (ref (vec :str))) (levels (ref (vec :str))))
  (if (= (vec-len levels) 0)
    (h-default-levels opts)
    (h-append levels opts))
  (ret))

(fn h-arg-count :i64 ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (id :i64))
  (letmut c :i64 (get (vec-get nodes id) first))
  (letmut n :i64 0)
  (while (not (= c -1))
    (set n (+ n 1))
    (set c (get (vec-get nodes c) next)))
  (ret n))

(fn h-child-count :i64 ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (id :i64) (kind :str))
  (letmut c :i64 (get (vec-get nodes id) first))
  (letmut n :i64 0)
  (while (not (= c -1))
    (if (tree-kind-is nodes ntexts c kind)
      (set n (+ n 1))
      (h-nothing))
    (set c (get (vec-get nodes c) next)))
  (ret n))

(fn h-child-find :i64 ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (id :i64) (kind :str))
  (letmut c :i64 (get (vec-get nodes id) first))
  (letmut found :i64 -1)
  (while (and (= found -1)
           (not (= c -1)))
    (if (tree-kind-is nodes ntexts c kind)
      (set found c)
      (h-nothing))
    (set c (get (vec-get nodes c) next)))
  (ret found))

(fn h-node-text :str ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (id :i64))
  (ret (vec-get ntexts (get (vec-get nodes id) text))))

(fn h-digit :bool ((b :i64))
  (ret (and (>= b 48)
         (<= b 57))))

(fn h-int-literal :bool ((s :str))
  (let n :i64 (str-len s))
  (if (= n 0)
    (ret false)
    (h-nothing))
  (letmut i :i64 0)
  (let b0 :i64 (cast :i64 (str-byte s 0)))
  (if (or (= b0 43)
        (= b0 45))
    (set i 1)
    (h-nothing))
  (if (= i n)
    (ret false)
    (h-nothing))
  (letmut ok :bool true)
  (while (< i n)
    (if (h-digit (cast :i64 (str-byte s i)))
      (h-nothing)
      (set ok false))
    (set i (+ i 1)))
  (ret ok))

(fn h-code-text :bool ((s :str))
  (if (not (= (str-len s) 5))
    (ret false)
    (h-nothing))
  (if (not (= (cast :i64 (str-byte s 0)) 69))
    (ret false)
    (h-nothing))
  (letmut i :i64 1)
  (letmut ok :bool true)
  (while (< i 5)
    (if (h-digit (cast :i64 (str-byte s i)))
      (h-nothing)
      (set ok false))
    (set i (+ i 1)))
  (ret ok))

(fn h-space :bool ((b :i64))
  (ret (or (= b 32)
         (or (= b 9)
           (or (= b 10)
             (or (= b 11)
               (or (= b 12)
                 (= b 13))))))))

(fn h-trim :str ((s :str))
  (letmut start :i64 0)
  (letmut end :i64 (str-len s))
  (while (and (< start end)
           (h-space (cast :i64 (str-byte s start))))
    (set start (+ start 1)))
  (while (and (> end start)
           (h-space (cast :i64 (str-byte s (- end 1)))))
    (set end (- end 1)))
  (ret (str-slice s start end)))

(fn h-newline :bool ((s :str))
  (letmut i :i64 0)
  (letmut found :bool false)
  (while (and (not found)
           (< i (str-len s)))
    (if (= (cast :i64 (str-byte s i)) 10)
      (set found true)
      (h-nothing))
    (set i (+ i 1)))
  (ret found))

(fn h-clause-index :i64 ((kind :str))
  (ret (if (str-eq kind "out") 0
         (if (str-eq kind "code") 1
           (if (str-eq kind "leaks") 2
             (if (str-eq kind "err-contains") 3 -1))))))

(fn h-takes :str ((kind :str) (what :str))
  (ret (str-concat "(" (str-concat kind (str-concat " ...) takes " what)))))

(fn h-needs :str ((kind :str) (what :str))
  (ret (str-concat "(" (str-concat kind (str-concat " ...) needs " what)))))

(fn h-unknown-clause :str ((kind :str))
  (ret (str-concat "unknown directive '(" (str-concat kind " ...)'"))))

(fn h-duplicate-clause :str ((kind :str))
  (ret (str-concat "duplicate directive '(" (str-concat kind " ...)'"))))

(fn h-integer-node :bool ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (id :i64))
  (ret (and (= (get (vec-get nodes id) tok) 4)
         (h-int-literal (h-node-text nodes ntexts id)))))

(fn h-clause-type :str ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (clause :i64) (kind :str))
  (let arg :i64 (get (vec-get nodes clause) first))
  (ret (if (str-eq kind "code")
         (if (h-integer-node nodes ntexts arg) ""
           (h-needs kind "an integer"))
         (if (str-eq kind "leaks")
           (if (h-integer-node nodes ntexts arg) ""
             (h-needs kind "an integer"))
           (if (not (= (get (vec-get nodes arg) tok) 3))
             (h-needs kind "a string")
             (if (and (str-eq kind "err-contains")
                   (= (str-len (h-node-text nodes ntexts arg)) 0)) "(err-contains ...) needs a non-empty string" ""))))))

(fn h-one-clause :str ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (clause :i64) (seen (ref (vec :i64))))
  (let kind :str (h-node-text nodes ntexts clause))
  (let at :i64 (h-clause-index kind))
  (if (and (>= at 0)
        (= (vec-get seen at) 1))
    (ret (h-duplicate-clause kind))
    (h-nothing))
  (if (not (= (h-arg-count nodes ntexts clause) 1))
    (ret (h-takes kind "one value"))
    (h-nothing))
  (if (< at 0)
    (ret (h-unknown-clause kind))
    (h-nothing))
  (vec-set seen at 1)
  (ret (h-clause-type nodes ntexts clause kind)))

(fn h-clauses :str ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (expect :i64))
  (letmut seen
    (vec :i64)
    (make (vec :i64)))
  (vec-push seen 0)
  (vec-push seen 0)
  (vec-push seen 0)
  (vec-push seen 0)
  (letmut c :i64 (get (vec-get nodes expect) first))
  (letmut problem :str "")
  (letmut any :i64 0)
  (while (and (str-eq problem "")
           (not (= c -1)))
    (if (not (= (get (vec-get nodes c) tok) -1))
      (set problem "expect takes clauses, not atoms")
      (set problem (h-one-clause nodes ntexts c seen)))
    (set any (+ any 1))
    (set c (get (vec-get nodes c) next)))
  (vec-free seen)
  (ret (if (not (str-eq problem "")) problem
         (if (= any 0) "expect needs at least one clause" ""))))

(fn h-legacy :str ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (test :i64))
  (let id :i64 (h-child-find nodes ntexts test "expect-leak"))
  (if (= id -1)
    (ret "")
    (h-nothing))
  (if (not (= (h-arg-count nodes ntexts id) 1))
    (ret "(expect-leak ...) takes one value")
    (h-nothing))
  (let arg :i64 (get (vec-get nodes id) first))
  (ret (if (h-integer-node nodes ntexts arg) "" "(expect-leak ...) needs an integer")))

(fn h-directive-detail :str ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (test :i64))
  (let ne :i64 (h-child-count nodes ntexts test "expect"))
  (let nl :i64 (h-child-count nodes ntexts test "expect-leak"))
  (if (> ne 1)
    (ret (str-concat "test has " (str-concat (str-from-i64 ne) " (expect ...) directives, wanted one")))
    (h-nothing))
  (if (> nl 1)
    (ret (str-concat "test has " (str-concat (str-from-i64 nl) " (expect-leak ...) directives, wanted one")))
    (h-nothing))
  (let legacy :str (h-legacy nodes ntexts test))
  (if (not (str-eq legacy ""))
    (ret legacy)
    (h-nothing))
  (if (= ne 0)
    (ret "test has no (expect ...) directive")
    (h-nothing))
  (let expect :i64 (h-child-find nodes ntexts test "expect"))
  (let clauses :str (h-clauses nodes ntexts expect))
  (ret (if (not (str-eq clauses "")) clauses
         (if (and (> nl 0)
               (> (h-child-count nodes ntexts expect "leaks") 0)) "both (leaks ...) and (expect-leak ...) declare a count" ""))))

(fn h-test-name :str ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (test :i64) (index :i64))
  (let nt :i64 (get (vec-get nodes test) name))
  (ret (if (= nt -1)
         (str-concat "unnamed-" (str-from-i64 index))
         (vec-get ntexts nt))))

(type h-expect (struct (out :str) (has-out :i64) (code :i64) (has-code :i64) (leaks :i64) (has-leaks :i64) (err :str) (has-err :i64)))

(fn h-expect-values h-expect ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (test :i64))
  (let expect :i64 (h-child-find nodes ntexts test "expect"))
  (let outn :i64 (h-child-find nodes ntexts expect "out"))
  (let coden :i64 (h-child-find nodes ntexts expect "code"))
  (let leaksn :i64 (h-child-find nodes ntexts expect "leaks"))
  (let errn :i64 (h-child-find nodes ntexts expect "err-contains"))
  (ret (make h-expect
         (if (= outn -1) ""
           (h-node-text nodes ntexts (get (vec-get nodes outn) first)))
         (if (= outn -1) 0 1)
         (if (= coden -1) 0
           (h-int-text (h-node-text nodes ntexts (get (vec-get nodes coden) first))))
         (if (= coden -1) 0 1)
         (if (= leaksn -1) 0
           (h-int-text (h-node-text nodes ntexts (get (vec-get nodes leaksn) first))))
         (if (= leaksn -1) 0 1)
         (if (= errn -1) ""
           (h-node-text nodes ntexts (get (vec-get nodes errn) first)))
         (if (= errn -1) 0 1))))

(fn h-int-text :i64 ((s :str))
  (let n :i64 (str-len s))
  (let b0 :i64 (if (> n 0)
                 (cast :i64 (str-byte s 0)) 0))
  (letmut i :i64 0)
  (letmut sign :i64 1)
  (if (or (= b0 45)
        (= b0 43))
    (set i 1)
    (h-nothing))
  (if (= b0 45)
    (set sign -1)
    (h-nothing))
  (letmut v :i64 0)
  (while (< i n)
    (set v (+ (* v 10)
             (- (cast :i64 (str-byte s i)) 48)))
    (set i (+ i 1)))
  (ret (* sign v)))

(fn h-repr :str ((s :str))
  (letmut out :str "'")
  (letmut i :i64 0)
  (while (< i (str-len s))
    (let b :i64 (cast :i64 (str-byte s i)))
    (set out (str-concat out (if (= b 92) "\\\\"
                               (if (= b 39) "\\'"
                                 (if (= b 10) "\\n"
                                   (if (= b 13) "\\r"
                                     (if (= b 9) "\\t"
                                       (str-slice s i (+ i 1)))))))))
    (set i (+ i 1)))
  (ret (str-concat out "'")))

(fn h-leaks :i64 ((err :str))
  (let n :i64 (str-len err))
  (letmut i :i64 0)
  (letmut count :i64 0)
  (letmut at-start :bool true)
  (while (< i n)
    (if at-start
      (if (and (>= (- n i) 5)
            (str-eq (str-slice err i (+ i 5)) "LEAK "))
        (set count (+ count 1))
        (h-nothing))
      (h-nothing))
    (if (= (cast :i64 (str-byte err i)) 10)
      (set at-start true)
      (set at-start false))
    (set i (+ i 1)))
  (ret count))

(fn h-contains :bool ((hay :str) (needle :str))
  (let hn :i64 (str-len hay))
  (let nn :i64 (str-len needle))
  (if (= nn 0)
    (ret true)
    (h-nothing))
  (letmut i :i64 0)
  (letmut found :bool false)
  (while (and (not found)
           (<= (+ i nn) hn))
    (if (str-eq (str-slice hay i (+ i nn)) needle)
      (set found true)
      (h-nothing))
    (set i (+ i 1)))
  (ret found))

(fn h-first-line :str ((s :str))
  (let n :i64 (str-len s))
  (letmut i :i64 0)
  (letmut end :i64 n)
  (letmut stop :bool false)
  (while (and (not stop)
           (< i n))
    (if (= (cast :i64 (str-byte s i)) 10)
      (set stop true)
      (set i (+ i 1))))
  (if stop
    (set end i)
    (h-nothing))
  (if (and (> end 0)
        (= (cast :i64 (str-byte s (- end 1))) 13))
    (set end (- end 1))
    (h-nothing))
  (ret (str-slice s 0 end)))

(fn h-more :str ((so :str) (one :str))
  (ret (if (str-eq so "") one
         (str-concat so (str-concat "; " one)))))

(fn h-compare :str ((e h-expect) (out :str) (err :str) (code :i64) (leaks :i64))
  (letmut problems :str "")
  (if (= (get e has-out) 1)
    (if (not (str-eq out (get e out)))
      (set problems (h-more problems (str-concat "stdout: expected " (str-concat (h-repr (get e out))
                                                                       (str-concat ", got " (h-repr out))))))
      (h-nothing))
    (h-nothing))
  (if (= (get e has-code) 1)
    (if (not (= code (get e code)))
      (set problems (h-more problems (str-concat "exit code: expected " (str-concat (str-from-i64 (get e code))
                                                                          (str-concat ", got " (str-from-i64 code))))))
      (h-nothing))
    (h-nothing))
  (if (= (get e has-leaks) 1)
    (if (not (= leaks (get e leaks)))
      (set problems (h-more problems (str-concat "leaks: expected " (str-concat (str-from-i64 (get e leaks))
                                                                      (str-concat ", got " (str-from-i64 leaks))))))
      (h-nothing))
    (h-nothing))
  (if (= (get e has-err) 1)
    (if (not (h-contains err (get e err)))
      (set problems (h-more problems (str-concat "stderr: expected to contain " (str-concat (h-repr (get e err))
                                                                                  (str-concat ", got " (h-repr err))))))
      (h-nothing))
    (h-nothing))
  (ret problems))

(fn h-level :str ((opt :str))
  (letmut out :str "")
  (letmut i :i64 0)
  (while (< i (str-len opt))
    (let b :i64 (cast :i64 (str-byte opt i)))
    (if (and (>= b 48)
          (<= b 57))
      (set out (str-concat out (str-slice opt i (+ i 1))))
      (h-nothing))
    (if (and (>= b 65)
          (<= b 90))
      (set out (str-concat out (str-slice opt i (+ i 1))))
      (h-nothing))
    (if (and (>= b 97)
          (<= b 122))
      (set out (str-concat out (str-slice opt i (+ i 1))))
      (h-nothing))
    (set i (+ i 1)))
  (ret (if (str-eq out "") "O0" out)))

(fn h-pad2 :str ((n :i64))
  (ret (if (< n 10)
         (str-concat "0" (str-from-i64 n))
         (str-from-i64 n))))

(fn h-safe-byte :bool ((b :i64))
  (ret (if (and (>= b 48)
             (<= b 57)) true
         (if (and (>= b 65)
               (<= b 90)) true
           (if (and (>= b 97)
                 (<= b 122)) true
             (if (= b 95) true
               (if (= b 46) true
                 (= b 45))))))))

(fn h-safe-name :str ((name :str))
  (letmut out :str "")
  (letmut i :i64 0)
  (while (< i (str-len name))
    (let b :i64 (cast :i64 (str-byte name i)))
    (set out (str-concat out (if (h-safe-byte b)
                               (str-slice name i (+ i 1)) "_")))
    (set i (+ i 1)))
  (ret out))

(fn h-binary-path :str ((cat :str) (rel :str) (name :str) (index :i64) (opt :str))
  (ret (str-concat "build/harness/" (str-concat cat (str-concat "/" (str-concat rel (str-concat "/" (str-concat (h-pad2 index)
                                                                                                      (str-concat "-" (str-concat (h-safe-name name)
                                                                                                                        (str-concat "." (str-concat (h-level opt) ".bin"))))))))))))

(fn h-case-budget :i64 ()
  (ret 10000))

(fn h-build-budget :i64 ()
  (ret 0))

(type h-outcome (struct (detail :str) (has :i64) (out :str) (err :str) (code :i64) (leaks :i64)))

(fn h-outcome-fail h-outcome ((detail :str))
  (ret (make h-outcome detail 0 "" "" 0 0)))

(fn h-execute h-outcome ((self :str) (path :str) (name :str) (out :str) (opt :str) (e h-expect))
  (letmut bargs
    (vec :str)
    (make (vec :str)))
  (vec-push bargs "build")
  (vec-push bargs path)
  (vec-push bargs "--test")
  (vec-push bargs name)
  (vec-push bargs "--opt")
  (vec-push bargs opt)
  (vec-push bargs "-o")
  (vec-push bargs out)
  (let b :run (run self bargs (h-build-budget)))
  (if (not (= (run-status b) 0))
    (ret (h-outcome-fail (str-concat opt (str-concat ": build failed: " (h-first-line (run-err b))))))
    (h-nothing))
  (letmut rargs
    (vec :str)
    (make (vec :str)))
  (let r :run (run out rargs (h-case-budget)))
  (let status :i64 (run-status r))
  (if (= status -1)
    (ret (h-outcome-fail (str-concat opt (str-concat ": " (run-err r)))))
    (h-nothing))
  (if (= status 124)
    (ret (h-outcome-fail (str-concat opt ": timed out after 10s")))
    (h-nothing))
  (let err :str (run-err r))
  (let leaks :i64 (h-leaks err))
  (let problems :str (h-compare e (run-out r) err status leaks))
  (ret (make h-outcome
         (if (str-eq problems "") ""
           (str-concat opt (str-concat ": " problems))) 1
         (run-out r) err status leaks)))

(fn h-comma :str ((parts :str) (one :str))
  (ret (if (str-eq parts "") one
         (str-concat parts (str-concat ", " one)))))

(fn h-disagree-one :str ((oopts (ref (vec :str))) (oout (ref (vec :str))) (oerr (ref (vec :str))) (ocode (ref (vec :i64))) (j :i64))
  (letmut parts :str "")
  (if (not (str-eq (vec-get oout 0)
             (vec-get oout j)))
    (set parts (h-comma parts (str-concat "stdout " (str-concat (h-repr (vec-get oout 0))
                                                      (str-concat " vs " (h-repr (vec-get oout j)))))))
    (h-nothing))
  (if (not (= (vec-get ocode 0)
             (vec-get ocode j)))
    (set parts (h-comma parts (str-concat "exit code " (str-concat (str-from-i64 (vec-get ocode 0))
                                                         (str-concat " vs " (str-from-i64 (vec-get ocode j)))))))
    (h-nothing))
  (if (not (str-eq (vec-get oerr 0)
             (vec-get oerr j)))
    (set parts (h-comma parts (str-concat "stderr " (str-concat (h-repr (vec-get oerr 0))
                                                      (str-concat " vs " (h-repr (vec-get oerr j)))))))
    (h-nothing))
  (ret (if (str-eq parts "") ""
         (str-concat (vec-get oopts 0)
           (str-concat " and " (str-concat (vec-get oopts j)
                                 (str-concat " disagree: " parts)))))))

(fn h-test :void ((self :str) (path :str) (cat :str) (rel :str) (nodes (ref (vec node))) (ntexts (ref (vec :str))) (test :i64) (index :i64) (opts (ref (vec :str))) (totals (ref (vec :i64))) (records (ref (vec :str))))
  (let name :str (h-test-name nodes ntexts test index))
  (let id :str (str-concat cat (str-concat "/" (str-concat rel (str-concat "/" name)))))
  (let detail :str (h-directive-detail nodes ntexts test))
  (if (not (str-eq detail ""))
    (h-fail id detail totals records)
    (h-nothing))
  (if (not (str-eq detail ""))
    (ret)
    (h-nothing))
  (let e h-expect (h-expect-values nodes ntexts test))
  (letmut problems :str "")
  (letmut oopts
    (vec :str)
    (make (vec :str)))
  (letmut oout
    (vec :str)
    (make (vec :str)))
  (letmut oerr
    (vec :str)
    (make (vec :str)))
  (letmut ocode
    (vec :i64)
    (make (vec :i64)))
  (letmut i :i64 0)
  (while (< i (vec-len opts))
    (let opt :str (vec-get opts i))
    (let out :str (h-binary-path cat rel name index opt))
    (let o h-outcome (h-execute self path name out opt e))
    (if (not (str-eq (get o detail) ""))
      (set problems (h-more problems (get o detail)))
      (h-nothing))
    (if (= (get o has) 1)
      (vec-push oopts opt)
      (h-nothing))
    (if (= (get o has) 1)
      (vec-push oout (get o out))
      (h-nothing))
    (if (= (get o has) 1)
      (vec-push oerr (get o err))
      (h-nothing))
    (if (= (get o has) 1)
      (vec-push ocode (get o code))
      (h-nothing))
    (if (= (get o has) 1)
      (vec-set totals 2 (+ (vec-get totals 2)
                          (get o leaks)))
      (h-nothing))
    (set i (+ i 1)))
  (letmut j :i64 1)
  (while (< j (vec-len oopts))
    (let d :str (h-disagree-one oopts oout oerr ocode j))
    (if (not (str-eq d ""))
      (set problems (h-more problems d))
      (h-nothing))
    (set j (+ j 1)))
  (vec-free oopts)
  (vec-free oout)
  (vec-free oerr)
  (vec-free ocode)
  (if (str-eq problems "")
    (h-pass id totals records)
    (h-fail id problems totals records))
  (ret))

(fn h-tests :void ((self :str) (path :str) (cat :str) (rel :str) (nodes (ref (vec node))) (ntexts (ref (vec :str))) (opts (ref (vec :str))) (totals (ref (vec :i64))) (records (ref (vec :str))))
  (letmut c :i64 (get (vec-get nodes 0) first))
  (letmut index :i64 0)
  (while (not (= c -1))
    (if (tree-kind-is nodes ntexts c "test")
      (h-test self path cat rel nodes ntexts c index opts totals records)
      (h-nothing))
    (if (tree-kind-is nodes ntexts c "test")
      (set index (+ index 1))
      (h-nothing))
    (set c (get (vec-get nodes c) next)))
  (ret))

(fn h-expect-path :str ((path :str))
  (let n :i64 (str-len path))
  (ret (if (and (>= n 6)
             (str-eq (str-slice path (- n 6) n) ".logos"))
         (str-concat (str-slice path 0 (- n 6)) ".expect")
         (str-concat path ".expect"))))

(fn h-expect-error h-found ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (id :i64) (code :str))
  (let arg :i64 (get (vec-get nodes id) first))
  (if (not (= (h-arg-count nodes ntexts id) 1))
    (ret (make h-found code "(expect-error ...) takes one code"))
    (h-nothing))
  (if (not (= (get (vec-get nodes arg) tok) 2))
    (ret (make h-found code "(expect-error ...) takes one code"))
    (h-nothing))
  (let value :str (h-node-text nodes ntexts arg))
  (if (not (h-code-text value))
    (ret (make h-found code (str-concat "expect-error needs a code like E0101, found '" (str-concat value "'"))))
    (h-nothing))
  (ret (if (and (not (str-eq code ""))
             (not (str-eq code value)))
         (make h-found code (str-concat "two expect-error directives: " (str-concat code (str-concat " and " value))))
         (make h-found value ""))))

(fn h-directive-at h-found ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (c :i64) (code :str))
  (ret (if (not (tree-kind-is nodes ntexts c "expect-error"))
         (make h-found code "")
         (h-expect-error nodes ntexts c code))))

(fn h-directive h-found ((nodes (ref (vec node))) (ntexts (ref (vec :str))))
  (letmut code :str "")
  (letmut problem :str "")
  (letmut c :i64 (get (vec-get nodes 0) first))
  (while (and (str-eq problem "")
           (not (= c -1)))
    (let f h-found (h-directive-at nodes ntexts c code))
    (set problem (get f problem))
    (set code (get f code))
    (set c (get (vec-get nodes c) next)))
  (ret (make h-found code problem)))

(fn h-sidecar h-found ((path :str) (code :str))
  (let side :str (h-expect-path path))
  (let name :str (h-base side))
  (if (not (h-file-exists side))
    (ret (make h-found code ""))
    (h-nothing))
  (let why :str (path-error side))
  (if (> (str-len why) 0)
    (ret (make h-found code (str-concat "cannot read " (str-concat name (str-concat ": " why)))))
    (h-nothing))
  (let text :str (h-trim (read-file side)))
  (if (h-newline text)
    (ret (make h-found code (str-concat name " holds more than one line")))
    (h-nothing))
  (if (not (h-code-text text))
    (ret (make h-found code (str-concat name (str-concat " needs a code like E0101, found '" (str-concat text "'")))))
    (h-nothing))
  (ret (if (and (not (str-eq code ""))
             (not (str-eq code text)))
         (make h-found code (str-concat "expect-error " (str-concat code (str-concat " disagrees with " (str-concat name (str-concat " " text))))))
         (make h-found text ""))))

(fn h-expected h-found ((nodes (ref (vec node))) (ntexts (ref (vec :str))) (path :str))
  (let d h-found (h-directive nodes ntexts))
  (ret (if (not (str-eq (get d problem) "")) d
         (h-sidecar path (get d code)))))

(fn h-file-parsed :void ((self :str) (path :str) (cat :str) (rel :str) (base :str) (nodes (ref (vec node))) (ntexts (ref (vec :str))) (opts (ref (vec :str))) (totals (ref (vec :i64))) (records (ref (vec :str))))
  (let f h-found (h-expected nodes ntexts path))
  (if (> (str-len (get f problem)) 0)
    (h-fail base (get f problem) totals records)
    (if (> (str-len (get f code)) 0)
      (h-pass base totals records)
      (h-tests self path cat rel nodes ntexts opts totals records))))

(fn h-file-tree :void ((self :str) (path :str) (cat :str) (rel :str) (base :str) (kinds (ref (vec :i64))) (texts (ref (vec :str))) (lines (ref (vec :i64))) (cols (ref (vec :i64))) (nodes (ref (vec node))) (ntexts (ref (vec :str))) (opts (ref (vec :str))) (totals (ref (vec :i64))) (records (ref (vec :str))))
  (let t tree-error (tree-parse kinds texts lines cols nodes ntexts))
  (if (tree-ok t)
    (h-file-parsed self path cat rel base nodes ntexts opts totals records)
    (h-fail base (str-concat "parse failed: " (get t msg)) totals records)))

(fn h-file-parse :void ((self :str) (path :str) (cat :str) (rel :str) (base :str) (opts (ref (vec :str))) (totals (ref (vec :i64))) (records (ref (vec :str))))
  (letmut kinds
    (vec :i64)
    (make (vec :i64)))
  (letmut texts
    (vec :str)
    (make (vec :str)))
  (letmut lines
    (vec :i64)
    (make (vec :i64)))
  (letmut cols
    (vec :i64)
    (make (vec :i64)))
  (letmut nodes
    (vec node)
    (make (vec node)))
  (letmut ntexts
    (vec :str)
    (make (vec :str)))
  (let src :str (read-file path))
  (let e lex-error (lex src kinds texts lines cols))
  (if (lex-ok e)
    (h-file-tree self path cat rel base kinds texts lines cols nodes ntexts opts totals records)
    (h-fail base (str-concat "parse failed: " (get e msg)) totals records))
  (vec-free kinds)
  (vec-free texts)
  (vec-free lines)
  (vec-free cols)
  (vec-free nodes)
  (vec-free ntexts)
  (ret))

(fn h-file :void ((self :str) (path :str) (opts (ref (vec :str))) (totals (ref (vec :i64))) (records (ref (vec :str))))
  (let cat :str (h-category-of path))
  (let rel :str (h-relative (h-category-dir path) path))
  (let base :str (str-concat cat (str-concat "/" rel)))
  (let why :str (path-error path))
  (if (> (str-len why) 0)
    (h-fail base (str-concat "cannot read " (str-concat path (str-concat ": " why))) totals records)
    (h-file-parse self path cat rel base opts totals records))
  (ret))

(fn h-starts :bool ((s :str) (p :str))
  (ret (and (>= (str-len s)
              (str-len p))
         (str-eq (str-slice s 0 (str-len p)) p))))

(fn h-split-at :i64 ((s :str) (from :i64))
  (letmut i :i64 from)
  (letmut at :i64 -1)
  (while (and (= at -1)
           (< i (str-len s)))
    (if (= (cast :i64 (str-byte s i)) 32)
      (set at i)
      (h-nothing))
    (set i (+ i 1)))
  (ret at))

(fn h-line-id :str ((line :str))
  (let a :i64 (h-split-at line 0))
  (if (= a -1)
    (ret "")
    (h-nothing))
  (let b :i64 (h-split-at line (+ a 1)))
  (ret (if (= b -1)
         (str-slice line
           (+ a 1)
           (str-len line))
         (str-slice line (+ a 1) b))))

(fn h-line-cat :str ((line :str))
  (let id :str (h-line-id line))
  (letmut i :i64 0)
  (letmut at :i64 -1)
  (while (and (= at -1)
           (< i (str-len id)))
    (if (= (cast :i64 (str-byte id i)) 47)
      (set at i)
      (h-nothing))
    (set i (+ i 1)))
  (ret (if (= at -1) id
         (str-slice id 0 at))))

(fn h-lines :void ((text :str) (out (ref (vec :str))))
  (letmut start :i64 0)
  (letmut i :i64 0)
  (while (< i (str-len text))
    (if (= (cast :i64 (str-byte text i)) 10)
      (vec-push out (str-slice text start i))
      (h-nothing))
    (if (= (cast :i64 (str-byte text i)) 10)
      (set start (+ i 1))
      (h-nothing))
    (set i (+ i 1)))
  (if (< start (str-len text))
    (vec-push out (str-slice text start (str-len text)))
    (h-nothing))
  (ret))

(fn h-digits :i64 ((s :str))
  (letmut i :i64 0)
  (letmut n :i64 0)
  (letmut ok :bool true)
  (while (< i (str-len s))
    (let b :i64 (cast :i64 (str-byte s i)))
    (if (and (>= b 48)
          (<= b 57))
      (set n (+ (* n 10)
               (- b 48)))
      (set ok false))
    (set i (+ i 1)))
  (ret (if ok n -1)))

(fn h-cwd-join :str ((root :str) (name :str))
  (letmut end :i64 (str-len root))
  (while (and (> end 0)
           (= (cast :i64 (str-byte root (- end 1))) 47))
    (set end (- end 1)))
  (ret (str-concat (str-slice root 0 end)
         (str-concat "/" name))))

(fn h-join-spaces :str ((items (ref (vec :str))))
  (letmut text :str "")
  (letmut first :bool true)
  (letmut i :i64 0)
  (while (< i (vec-len items))
    (if first
      (set text (vec-get items i))
      (set text (str-concat text (str-concat " " (vec-get items i)))))
    (set first false)
    (set i (+ i 1)))
  (ret text))

(fn h-record-index :i64 ((records (ref (vec :str))) (line :str))
  (let id :str (h-line-id line))
  (letmut i :i64 0)
  (letmut found :i64 -1)
  (while (and (= found -1)
           (< i (vec-len records)))
    (if (str-eq (h-line-id (vec-get records i)) id)
      (set found i)
      (h-nothing))
    (set i (+ i 1)))
  (ret found))

(fn h-known-id :bool ((old (ref (vec :str))) (line :str))
  (let id :str (h-line-id line))
  (letmut i :i64 0)
  (letmut found :bool false)
  (while (and (not found)
           (< i (vec-len old)))
    (if (str-eq (h-line-id (vec-get old i)) id)
      (set found true)
      (h-nothing))
    (set i (+ i 1)))
  (ret found))

(fn h-merged :void ((old (ref (vec :str))) (records (ref (vec :str))) (only :str) (out (ref (vec :str))))
  (letmut i :i64 0)
  (while (< i (vec-len old))
    (let line :str (vec-get old i))
    (let at :i64 (h-record-index records line))
    (if (> at -1)
      (vec-push out (vec-get records at))
      (if (str-eq (h-line-cat line) only)
        (h-nothing)
        (vec-push out line)))
    (set i (+ i 1)))
  (letmut j :i64 0)
  (while (< j (vec-len records))
    (if (h-known-id old (vec-get records j))
      (h-nothing)
      (vec-push out (vec-get records j)))
    (set j (+ j 1)))
  (ret))

(fn h-baseline-text :str ((root :str) (only :str) (records (ref (vec :str))) (leaks :i64) (opts (ref (vec :str))))
  (letmut out
    (vec :str)
    (make (vec :str)))
  (if (str-eq only "")
    (h-baseline-full records leaks opts out)
    (h-baseline-merge root only records out))
  (letmut text :str "")
  (letmut i :i64 0)
  (while (< i (vec-len out))
    (set text (str-concat text (str-concat (vec-get out i) "\n")))
    (set i (+ i 1)))
  (vec-free out)
  (ret text))

(fn h-baseline-full :void ((records (ref (vec :str))) (leaks :i64) (opts (ref (vec :str))) (out (ref (vec :str))))
  (vec-push out (str-concat "LEAKS " (str-from-i64 leaks)))
  (vec-push out (str-concat "OPTS " (h-join-spaces opts)))
  (h-append records out)
  (ret))

(fn h-baseline-merge :void ((root :str) (only :str) (records (ref (vec :str))) (out (ref (vec :str))))
  (let path :str (h-cwd-join root "summary.txt"))
  (letmut old
    (vec :str)
    (make (vec :str)))
  (letmut total
    (vec :i64)
    (make (vec :i64)))
  (vec-push total -1)
  (letmut optext
    (vec :str)
    (make (vec :str)))
  (vec-push optext "")
  (if (h-file-exists path)
    (h-baseline-read path old total optext)
    (h-nothing))
  (if (>= (vec-get total 0) 0)
    (vec-push out (str-concat "LEAKS " (str-from-i64 (vec-get total 0))))
    (h-nothing))
  (if (not (str-eq (vec-get optext 0) ""))
    (vec-push out (str-concat "OPTS " (vec-get optext 0)))
    (h-nothing))
  (h-merged old records only out)
  (vec-free old)
  (vec-free total)
  (vec-free optext)
  (ret))

(fn h-baseline-read :void ((path :str) (old (ref (vec :str))) (total (ref (vec :i64))) (opts (ref (vec :str))))
  (letmut lines
    (vec :str)
    (make (vec :str)))
  (h-lines (read-file path) lines)
  (letmut i :i64 0)
  (while (< i (vec-len lines))
    (let line :str (vec-get lines i))
    (if (str-eq (h-trim line) "")
      (h-nothing)
      (if (h-starts line "LEAKS ")
        (h-baseline-total line total)
        (if (h-starts line "OPTS ")
          (vec-set opts 0 (h-trim (str-slice line 5 (str-len line))))
          (vec-push old line))))
    (set i (+ i 1)))
  (vec-free lines)
  (ret))

(fn h-baseline-total :void ((line :str) (total (ref (vec :i64))))
  (let n :i64 (h-digits (h-trim (str-slice line 6 (str-len line)))))
  (if (>= n 0)
    (vec-set total 0 n)
    (h-nothing))
  (ret))

(fn h-hex-digit :i64 ((b :i64))
  (ret (if (and (>= b 48)
             (<= b 57))
         (- b 48)
         (if (and (>= b 65)
               (<= b 70))
           (+ (- b 65) 10)
           (if (and (>= b 97)
                 (<= b 102))
             (+ (- b 97) 10) -1)))))

(fn h-hex-value :i64 ((s :str) (at :i64))
  (if (>= (+ at 1)
        (str-len s))
    (ret -1)
    (h-nothing))
  (let hi :i64 (h-hex-digit (cast :i64 (str-byte s at))))
  (let lo :i64 (h-hex-digit (cast :i64 (str-byte s (+ at 1)))))
  (ret (if (and (>= hi 0)
             (>= lo 0))
         (+ (* hi 16) lo) -1)))

(fn h-printable :str ()
  (ret " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"))

(fn h-byte-char :str ((b :i64))
  (if (and (>= b 32)
        (<= b 126))
    (ret (str-slice (h-printable)
           (- b 32)
           (+ (- b 32) 1)))
    (h-nothing))
  (if (= b 9)
    (ret "\t")
    (h-nothing))
  (if (= b 10)
    (ret "\n")
    (h-nothing))
  (if (= b 13)
    (ret "\r")
    (h-nothing))
  (ret ""))

(fn h-decode-hex :void ((hex :i64) (s :str) (i :i64) (out (ref (vec :str))))
  (let ch :str (h-byte-char hex))
  (if (str-eq ch "")
    (vec-push out (str-slice s i (+ i 3)))
    (vec-push out ch))
  (ret))

(fn h-decode-unit :i64 ((s :str) (i :i64) (out (ref (vec :str))))
  (let b :i64 (cast :i64 (str-byte s i)))
  (let hex :i64 (if (= b 37)
                  (h-hex-value s (+ i 1)) -1))
  (if (>= hex 0)
    (h-decode-hex hex s i out)
    (vec-push out (str-slice s i (+ i 1))))
  (ret (if (>= hex 0) 3 1)))

(fn h-concat-all :str ((parts (ref (vec :str))))
  (letmut text :str "")
  (letmut i :i64 0)
  (while (< i (vec-len parts))
    (set text (str-concat text (vec-get parts i)))
    (set i (+ i 1)))
  (ret text))

(fn h-decode :str ((s :str))
  (letmut parts
    (vec :str)
    (make (vec :str)))
  (letmut i :i64 0)
  (while (< i (str-len s))
    (set i (+ i (h-decode-unit s i parts))))
  (let text :str (h-concat-all parts))
  (vec-free parts)
  (ret text))

(fn h-strip-cr :str ((line :str))
  (let n :i64 (str-len line))
  (ret (if (and (> n 0)
             (= (cast :i64 (str-byte line (- n 1))) 13))
         (str-slice line 0 (- n 1)) line)))

(fn h-note :void ((problem (ref (vec :str))) (number :i64) (text :str))
  (if (str-eq (vec-get problem 0) "")
    (vec-set problem 0 (str-concat (str-from-i64 number)
                         (str-concat ": " text)))
    (h-nothing))
  (ret))

(fn h-baseline-leaks :void ((line :str) (number :i64) (total (ref (vec :i64))) (problem (ref (vec :str))))
  (let value :str (h-trim (str-slice line 6 (str-len line))))
  (let n :i64 (h-digits value))
  (if (and (> (str-len value) 0)
        (>= n 0))
    (vec-set total 0 n)
    (h-note problem number (str-concat "leak total needs a number, found '" (str-concat value "'"))))
  (ret))

(fn h-level-token :bool ((s :str))
  (let n :i64 (str-len s))
  (ret (and (and (>= n 3)
              (str-eq (str-slice s 0 2) "-O"))
         (>= (h-digits (str-slice s 2 n)) 0))))

(fn h-tokens :void ((s :str) (out (ref (vec :str))))
  (letmut start :i64 0)
  (letmut i :i64 0)
  (while (< i (str-len s))
    (if (= (cast :i64 (str-byte s i)) 32)
      (h-token-cut s start i out)
      (h-nothing))
    (if (= (cast :i64 (str-byte s i)) 32)
      (set start (+ i 1))
      (h-nothing))
    (set i (+ i 1)))
  (h-token-cut s start (str-len s) out)
  (ret))

(fn h-token-cut :void ((s :str) (start :i64) (end :i64) (out (ref (vec :str))))
  (if (< start end)
    (vec-push out (str-slice s start end))
    (h-nothing))
  (ret))

(fn h-levels-ok :bool ((s :str))
  (letmut tokens
    (vec :str)
    (make (vec :str)))
  (h-tokens s tokens)
  (letmut i :i64 0)
  (letmut ok :bool (> (vec-len tokens) 0))
  (while (< i (vec-len tokens))
    (set ok (and ok (h-level-token (vec-get tokens i))))
    (set i (+ i 1)))
  (vec-free tokens)
  (ret ok))

(fn h-baseline-opts :void ((line :str) (number :i64) (opts (ref (vec :str))) (problem (ref (vec :str))))
  (let value :str (h-trim (str-slice line 5 (str-len line))))
  (if (h-levels-ok value)
    (vec-set opts 0 value)
    (h-note problem number (str-concat "levels must be spellings like -O0, found '" (str-concat value "'"))))
  (ret))

(fn h-baseline-record :void ((line :str) (number :i64) (records (ref (vec :str))) (problem (ref (vec :str))))
  (let at :i64 (h-split-at line 0))
  (if (= at -1)
    (h-note problem number "baseline line needs a status and a case")
    (h-baseline-record-status line number at records problem))
  (ret))

(fn h-baseline-record-status :void ((line :str) (number :i64) (at :i64) (records (ref (vec :str))) (problem (ref (vec :str))))
  (let status :str (str-slice line 0 at))
  (if (or (str-eq status "PASS")
        (str-eq status "FAIL"))
    (vec-push records line)
    (h-note problem number (str-concat "baseline status must be PASS or FAIL, found '" (str-concat status "'"))))
  (ret))

(fn h-baseline-line :void ((line :str) (number :i64) (records (ref (vec :str))) (total (ref (vec :i64))) (opts (ref (vec :str))) (problem (ref (vec :str))))
  (if (str-eq (h-trim line) "")
    (h-nothing)
    (if (h-starts line "LEAKS ")
      (h-baseline-leaks line number total problem)
      (if (h-starts line "OPTS ")
        (h-baseline-opts line number opts problem)
        (h-baseline-record line number records problem))))
  (ret))

(fn h-baseline-parse :void ((text :str) (records (ref (vec :str))) (total (ref (vec :i64))) (opts (ref (vec :str))) (problem (ref (vec :str))))
  (letmut lines
    (vec :str)
    (make (vec :str)))
  (h-lines text lines)
  (letmut i :i64 0)
  (while (< i (vec-len lines))
    (h-baseline-line (h-strip-cr (vec-get lines i))
      (+ i 1) records total opts problem)
    (set i (+ i 1)))
  (vec-free lines)
  (ret))

(fn h-rec-status :str ((line :str))
  (let at :i64 (h-split-at line 0))
  (ret (if (= at -1) ""
         (str-slice line 0 at))))

(fn h-rec-detail :str ((line :str))
  (let a :i64 (h-split-at line 0))
  (let b :i64 (if (= a -1) -1
                (h-split-at line (+ a 1))))
  (ret (if (= b -1) "-"
         (str-slice line
           (+ b 1)
           (str-len line)))))

(fn h-rec-id :str ((line :str))
  (ret (h-decode (h-line-id line))))

(fn h-status-of :str ((records (ref (vec :str))) (id :str))
  (letmut i :i64 0)
  (letmut found :str "")
  (while (and (str-eq found "")
           (< i (vec-len records)))
    (if (str-eq (h-rec-id (vec-get records i)) id)
      (set found (h-rec-status (vec-get records i)))
      (h-nothing))
    (set i (+ i 1)))
  (ret found))

(fn h-has-id :bool ((records (ref (vec :str))) (id :str))
  (letmut i :i64 0)
  (letmut found :bool false)
  (while (and (not found)
           (< i (vec-len records)))
    (if (str-eq (h-rec-id (vec-get records i)) id)
      (set found true)
      (h-nothing))
    (set i (+ i 1)))
  (ret found))

(fn h-id-category :str ((id :str))
  (letmut i :i64 0)
  (letmut at :i64 -1)
  (while (and (= at -1)
           (< i (str-len id)))
    (if (= (cast :i64 (str-byte id i)) 47)
      (set at i)
      (h-nothing))
    (set i (+ i 1)))
  (ret (if (= at -1) id
         (str-slice id 0 at))))

(fn h-in-scope :bool ((full :i64) (scope (ref (vec :str))) (cat :str))
  (ret (or (= full 1)
         (or (= (vec-len scope) 0)
           (h-in-list scope cat)))))

(fn h-add-problem :void ((ids (ref (vec :str))) (details (ref (vec :str))) (id :str) (detail :str))
  (vec-push ids id)
  (vec-push details detail)
  (ret))

(fn h-compare-run :void ((base (ref (vec :str))) (run (ref (vec :str))) (ids (ref (vec :str))) (details (ref (vec :str))))
  (letmut i :i64 0)
  (while (< i (vec-len run))
    (let line :str (vec-get run i))
    (let id :str (h-rec-id line))
    (let before :str (h-status-of base id))
    (h-compare-case before line id ids details)
    (set i (+ i 1)))
  (ret))

(fn h-compare-case :void ((before :str) (line :str) (id :str) (ids (ref (vec :str))) (details (ref (vec :str))))
  (if (str-eq before "")
    (h-add-problem ids details id "new case has no baseline result")
    (if (and (str-eq before "PASS")
          (str-eq (h-rec-status line) "FAIL"))
      (h-add-problem ids details id (str-concat "regression: passed in baseline, now fails: " (h-rec-detail line)))
      (h-nothing)))
  (ret))

(fn h-compare-base :void ((base (ref (vec :str))) (run (ref (vec :str))) (full :i64) (scope (ref (vec :str))) (ids (ref (vec :str))) (details (ref (vec :str))))
  (letmut i :i64 0)
  (while (< i (vec-len base))
    (h-compare-missing (vec-get base i) run full scope ids details)
    (set i (+ i 1)))
  (ret))

(fn h-compare-missing :void ((line :str) (run (ref (vec :str))) (full :i64) (scope (ref (vec :str))) (ids (ref (vec :str))) (details (ref (vec :str))))
  (let id :str (h-rec-id line))
  (if (str-eq (h-rec-status line) "PASS")
    (if (h-has-id run id)
      (h-nothing)
      (if (h-in-scope full scope (h-id-category id))
        (h-add-problem ids details id "regression: passed in baseline, missing from this run")
        (h-nothing)))
    (h-nothing))
  (ret))

(fn h-tokens-equal :bool ((a (ref (vec :str))) (b (ref (vec :str))))
  (letmut i :i64 0)
  (letmut same :bool (= (vec-len a)
                       (vec-len b)))
  (while (and same (< i (vec-len a)))
    (set same (str-eq (vec-get a i)
                (vec-get b i)))
    (set i (+ i 1)))
  (ret same))

(fn h-opts-same :bool ((a :str) (b :str))
  (letmut left
    (vec :str)
    (make (vec :str)))
  (letmut right
    (vec :str)
    (make (vec :str)))
  (h-tokens a left)
  (h-tokens b right)
  (let same :bool (h-tokens-equal left right))
  (vec-free left)
  (vec-free right)
  (ret same))

(fn h-compare-leaks :void ((total :i64) (bopts :str) (leaks :i64) (ropts :str) (full :i64) (ids (ref (vec :str))) (details (ref (vec :str))))
  (if (and (= full 1)
        (and (>= total 0)
          (and (h-opts-same bopts ropts)
            (> leaks total))))
    (h-add-problem ids details "suite/leaks" (str-concat "regression: leak total " (str-concat (str-from-i64 leaks)
                                                                                     (str-concat " exceeds baseline " (str-from-i64 total)))))
    (h-nothing))
  (ret))

(fn h-baseline-problems :void ((base (ref (vec :str))) (total :i64) (bopts :str) (run (ref (vec :str))) (leaks :i64) (ropts :str) (full :i64) (scope (ref (vec :str))) (ids (ref (vec :str))) (details (ref (vec :str))))
  (h-compare-run base run ids details)
  (h-compare-base base run full scope ids details)
  (h-compare-leaks total bopts leaks ropts full ids details)
  (ret))

(fn h-problem-before :bool ((id :str) (detail :str) (other :str) (other-detail :str))
  (ret (if (str-eq id other)
         (h-str-less detail other-detail)
         (h-str-less id other))))

(fn h-sort-problems :void ((ids (ref (vec :str))) (details (ref (vec :str))))
  (let n :i64 (vec-len ids))
  (letmut i :i64 1)
  (while (< i n)
    (let id :str (vec-get ids i))
    (let detail :str (vec-get details i))
    (letmut j :i64 i)
    (while (and (> j 0)
             (h-problem-before id detail
               (vec-get ids (- j 1))
               (vec-get details (- j 1))))
      (vec-set ids j (vec-get ids (- j 1)))
      (vec-set details j (vec-get details (- j 1)))
      (set j (- j 1)))
    (vec-set ids j id)
    (vec-set details j detail)
    (set i (+ i 1)))
  (ret))

(fn h-refuse :i64 ((err (ref (vec :str))) (text :str))
  (vec-push err (str-concat "logos: test: " text))
  (ret 1))

(fn h-count-line :str ((path :str) (n :i64))
  (ret (str-concat "baseline " (str-concat path (str-concat ": " (str-concat (str-from-i64 n) " regression(s)"))))))

(fn h-emit-problems :i64 ((path :str) (ids (ref (vec :str))) (details (ref (vec :str))) (out (ref (vec :str))))
  (h-sort-problems ids details)
  (letmut i :i64 0)
  (while (< i (vec-len ids))
    (vec-push out (str-concat "BASELINE " (str-concat (vec-get ids i)
                                            (str-concat " " (vec-get details i)))))
    (set i (+ i 1)))
  (vec-push out (h-count-line path (vec-len ids)))
  (ret (if (> (vec-len ids) 0) 1 0)))

(fn h-judge :i64 ((path :str) (records (ref (vec :str))) (total (ref (vec :i64))) (opts (ref (vec :str))) (problem (ref (vec :str))) (run (ref (vec :str))) (leaks :i64) (ropts :str) (full :i64) (scope (ref (vec :str))) (out (ref (vec :str))) (err (ref (vec :str))))
  (if (not (str-eq (vec-get problem 0) ""))
    (ret (h-refuse err (str-concat path (str-concat ":" (vec-get problem 0)))))
    (h-nothing))
  (if (str-eq (vec-get opts 0) "")
    (ret (h-refuse err (str-concat path ": baseline has no OPTS header, so its leak total cannot be compared with this run; regenerate it with --update-baseline")))
    (h-nothing))
  (letmut ids
    (vec :str)
    (make (vec :str)))
  (letmut details
    (vec :str)
    (make (vec :str)))
  (h-baseline-problems records
    (vec-get total 0)
    (vec-get opts 0) run leaks ropts full scope ids details)
  (let status :i64 (h-emit-problems path ids details out))
  (vec-free ids)
  (vec-free details)
  (ret status))

(fn h-file-lines :i64 ((path :str) (text :str) (run (ref (vec :str))) (leaks :i64) (ropts :str) (full :i64) (scope (ref (vec :str))) (out (ref (vec :str))) (err (ref (vec :str))))
  (letmut records
    (vec :str)
    (make (vec :str)))
  (letmut total
    (vec :i64)
    (make (vec :i64)))
  (vec-push total -1)
  (letmut opts
    (vec :str)
    (make (vec :str)))
  (vec-push opts "")
  (letmut problem
    (vec :str)
    (make (vec :str)))
  (vec-push problem "")
  (h-baseline-parse text records total opts problem)
  (let status :i64 (h-judge path records total opts problem run leaks ropts full scope out err))
  (vec-free records)
  (vec-free total)
  (vec-free opts)
  (vec-free problem)
  (ret status))

(fn h-baseline-lines :i64 ((exists :i64) (path :str) (text :str) (run (ref (vec :str))) (leaks :i64) (ropts :str) (full :i64) (scope (ref (vec :str))) (out (ref (vec :str))) (err (ref (vec :str))))
  (if (= exists 0)
    (ret (h-none-line out))
    (ret (h-file-lines path text run leaks ropts full scope out err))))

(fn h-none-line :i64 ((out (ref (vec :str))))
  (vec-push out "baseline: none")
  (ret 0))

(fn h-trim-slashes :str ((s :str))
  (letmut end :i64 (str-len s))
  (while (and (> end 1)
           (= (cast :i64 (str-byte s (- end 1))) 47))
    (set end (- end 1)))
  (ret (str-slice s 0 end)))

(fn h-full-run :i64 ((root :str) (only :str))
  (ret (if (and (str-eq only "")
             (and (is-dir root)
               (not (h-known-category (h-base (h-trim-slashes root)))))) 1 0)))

(fn h-scope-of :void ((files (ref (vec :str))) (scope (ref (vec :str))))
  (letmut i :i64 0)
  (while (< i (vec-len files))
    (let cat :str (h-category-of (vec-get files i)))
    (if (h-in-list scope cat)
      (h-nothing)
      (vec-push scope cat))
    (set i (+ i 1)))
  (ret))

(fn h-print-lines :void ((lines (ref (vec :str))))
  (letmut i :i64 0)
  (while (< i (vec-len lines))
    (println (vec-get lines i))
    (set i (+ i 1)))
  (ret))

(fn h-print-errs :void ((lines (ref (vec :str))))
  (letmut i :i64 0)
  (while (< i (vec-len lines))
    (fmt-emit 2 (str-concat (vec-get lines i) "\n"))
    (set i (+ i 1)))
  (ret))

(fn h-baseline-compare :i64 ((root :str) (only :str) (records (ref (vec :str))) (totals (ref (vec :i64))) (opts (ref (vec :str))) (files (ref (vec :str))))
  (let path :str (h-cwd-join root "summary.txt"))
  (letmut out
    (vec :str)
    (make (vec :str)))
  (letmut errs
    (vec :str)
    (make (vec :str)))
  (letmut scope
    (vec :str)
    (make (vec :str)))
  (h-scope-of files scope)
  (letmut status :i64 0)
  (if (and (is-dir root)
        (h-file-exists path))
    (set status (h-baseline-lines 1 path
                  (read-file path) records
                  (vec-get totals 2)
                  (h-join-spaces opts)
                  (h-full-run root only) scope out errs))
    (set status (h-baseline-lines 0 path "" records
                  (vec-get totals 2)
                  (h-join-spaces opts)
                  (h-full-run root only) scope out errs)))
  (h-print-lines out)
  (h-print-errs errs)
  (vec-free out)
  (vec-free errs)
  (vec-free scope)
  (ret status))

(fn h-write-text :i64 ((path :str) (text :str))
  (let fd :i64 (rt_create path))
  (if (< fd 0)
    (ret 1)
    (h-nothing))
  (fmt-emit fd text)
  (let _ :i32 (close fd))
  (ret 0))

(fn h-baseline-save :i64 ((root :str) (only :str) (records (ref (vec :str))) (totals (ref (vec :i64))) (opts (ref (vec :str))))
  (let path :str (h-cwd-join root "summary.txt"))
  (let text :str (h-baseline-text root only records (vec-get totals 2) opts))
  (if (= (h-write-text path text) 0)
    (h-nothing)
    (ret (h-baseline-bad path)))
  (println (str-concat "baseline " (str-concat path (str-concat ": " (str-concat (str-from-i64 (+ (vec-get totals 0)
                                                                                                 (vec-get totals 1))) " cases")))))
  (ret 0))

(fn h-baseline-bad :i64 ((path :str))
  (fmt-emit 2 (str-concat "logos: test: " (str-concat path ": cannot write baseline\n")))
  (ret 1))

(fn h-run :i64 ((root :str) (only :str) (levels (ref (vec :str))) (update :i64))
  (letmut argv
    (vec :str)
    (args))
  (let self :str (if (> (vec-len argv) 0)
                   (vec-get argv 0) ""))
  (letmut files
    (vec :str)
    (make (vec :str)))
  (letmut skipped
    (vec :str)
    (make (vec :str)))
  (letmut totals
    (vec :i64)
    (make (vec :i64)))
  (vec-push totals 0)
  (vec-push totals 0)
  (vec-push totals 0)
  (letmut records
    (vec :str)
    (make (vec :str)))
  (let found :i64 (h-discover root only files skipped))
  (if (= found -1)
    (h-missing root)
    (h-nothing))
  (if (= found -1)
    (ret 1)
    (h-nothing))
  (letmut opts
    (vec :str)
    (make (vec :str)))
  (h-levels opts levels)
  (letmut i :i64 0)
  (while (< i (vec-len files))
    (h-file self (vec-get files i) opts totals records)
    (set i (+ i 1)))
  (h-skips skipped)
  (h-summary totals)
  (let cases :i64 (+ (vec-get totals 0)
                    (vec-get totals 1)))
  (let failed :i64 (vec-get totals 1))
  (if (= cases 0)
    (println (str-concat "test: no cases found in " root))
    (if (> (vec-len skipped) 0)
      (h-skip-line (vec-len skipped))
      (h-nothing)))
  (letmut mut-status :i64 0)
  (if (> failed 0)
    (set mut-status 1)
    (if (= cases 0)
      (set mut-status 1)
      (if (> (vec-len skipped) 0)
        (set mut-status 1)
        (h-nothing))))
  (letmut saved :i64 0)
  (if (and (= update 1)
        (and (> cases 0)
          (= (vec-len skipped) 0)))
    (set saved (h-baseline-save root only records totals opts))
    (h-nothing))
  (if (> saved 0)
    (set mut-status 1)
    (h-nothing))
  (if (and (= update 0)
        (and (> cases 0)
          (= (vec-len skipped) 0)))
    (if (> (h-baseline-compare root only records totals opts files) 0)
      (set mut-status 1)
      (h-nothing))
    (h-nothing))
  (vec-free files)
  (vec-free skipped)
  (vec-free opts)
  (vec-free totals)
  (vec-free records)
  (vec-free argv)
  (ret mut-status))
