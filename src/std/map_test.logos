(test value-minus-one
  (expect (out "-1\ntrue\n2\n5\nfalse\n")
    (code 0)
    (leaks 0))
  (letmut keys
    (vec :str)
    (make (vec :str)))
  (letmut vals
    (vec :i64)
    (make (vec :i64)))
  (letmut slots
    (vec :i64)
    (make (vec :i64)))
  (map-init slots 8)
  (map-put keys vals slots "a" -1)
  (map-put keys vals slots "b" 5)
  (println (map-get keys vals slots "a"))
  (println (map-has keys slots "a"))
  (println (map-count keys))
  (println (map-get keys vals slots "b"))
  (println (map-has keys slots "zz"))
  (vec-free keys)
