(test many
  (expect (out "1000\n2048\n0\n500\n999\n499500\n1000\nfalse\n-1\n")
    (code 0)
    (leaks 0))
  (letmut keys
    (vec :str)
    (make (vec :str)))
  (letmut vals
    (vec :i64)
    (make (vec :i64)))
  (letmut slots
    (vec :i64)
    (make (vec :i64)))
  (map-init slots 8)
  (letmut i :i64 0)
  (while (< i 1000)
    (map-put keys vals slots (str-concat "k" (str-from-i64 i)) i)
    (set i (+ i 1)))
  (println (map-count keys))
  (println (vec-len slots))
  (println (map-get keys vals slots "k0"))
  (println (map-get keys vals slots "k500"))
  (println (map-get keys vals slots "k999"))
  (letmut sum :i64 0)
  (set i 0)
  (while (< i 1000)
    (set sum (+ sum (map-get keys vals slots (str-concat "k" (str-from-i64 i)))))
    (set i (+ i 1)))
  (println sum)
  (println (used-slots slots))
  (println (map-has keys slots "k1000"))
  (println (map-get keys vals slots "k1000"))
  (vec-free keys)
  (vec-free vals)
  (vec-free slots))

(test uninitialised
