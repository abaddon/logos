(mod map-test)

(use map)

(fn used-slots :i64 ((slots (ref (vec :i64))))
  (letmut i :i64 0)
  (letmut used :i64 0)
  (while (< i (vec-len slots))
    (set used (if (> (vec-get slots i) 0)
                (+ used 1) used))
    (set i (+ i 1)))
  (ret used))

(test empty
  (expect (out "0\n8\nfalse\n-1\n")
    (code 0)
    (leaks 0))
  (letmut keys
    (vec :str)
    (make (vec :str)))
  (letmut vals
    (vec :i64)
    (make (vec :i64)))
  (letmut slots
    (vec :i64)
    (make (vec :i64)))
  (map-init slots 8)
  (println (map-count keys))
  (println (vec-len slots))
  (println (map-has keys slots "a"))
  (println (map-get keys vals slots "a"))
  (vec-free keys)
  (vec-free vals)
  (vec-free slots))

(test one-key
  (expect (out "7\ntrue\n1\n-1\nfalse\n")
    (code 0)
    (leaks 0))
  (letmut keys
    (vec :str)
    (make (vec :str)))
  (letmut vals
    (vec :i64)
    (make (vec :i64)))
  (letmut slots
    (vec :i64)
    (make (vec :i64)))
  (map-init slots 8)
  (map-put keys vals slots "a" 7)
  (println (map-get keys vals slots "a"))
  (println (map-has keys slots "a"))
  (println (map-count keys))
  (println (map-get keys vals slots "b"))
  (println (map-has keys slots "b"))
  (vec-free keys)
  (vec-free vals)
  (vec-free slots))

(test overwrite
  (expect (out "2\n1\n")
    (code 0)
    (leaks 0))
  (letmut keys
    (vec :str)
    (make (vec :str)))
  (letmut vals
    (vec :i64)
    (make (vec :i64)))
  (letmut slots
    (vec :i64)
    (make (vec :i64)))
  (map-init slots 8)
  (map-put keys vals slots "a" 1)
  (map-put keys vals slots "a" 2)
  (println (map-get keys vals slots "a"))
  (println (map-count keys))
  (vec-free keys)
  (vec-free vals)
  (vec-free slots))

(test collision
  (expect (out "true\n1\n10\n20\n30\n40\n4\n8\n")
    (code 0)
    (leaks 0))
  (letmut keys
    (vec :str)
    (make (vec :str)))
  (letmut vals
    (vec :i64)
    (make (vec :i64)))
  (letmut slots
    (vec :i64)
    (make (vec :i64)))
  (map-init slots 8)
  (println (= (map-hash "a" 8)
             (map-hash "i" 8)))
  (println (map-hash "a" 8))
  (map-put keys vals slots "a" 10)
  (map-put keys vals slots "i" 20)
  (map-put keys vals slots "q" 30)
  (map-put keys vals slots "y" 40)
  (println (map-get keys vals slots "a"))
  (println (map-get keys vals slots "i"))
  (println (map-get keys vals slots "q"))
  (println (map-get keys vals slots "y"))
  (println (map-count keys))
  (println (vec-len slots))
  (vec-free keys)
  (vec-free vals)
  (vec-free slots))

(test growth
  (expect (out "16\n6\n1\n2\n3\n4\n5\n6\n6\n99\n-1\n")
    (code 0)
    (leaks 0))
  (letmut keys
    (vec :str)
    (make (vec :str)))
  (letmut vals
    (vec :i64)
    (make (vec :i64)))
  (letmut slots
    (vec :i64)
    (make (vec :i64)))
  (map-init slots 8)
  (map-put keys vals slots "a" 1)
  (map-put keys vals slots "b" 2)
  (map-put keys vals slots "c" 3)
  (map-put keys vals slots "d" 4)
  (map-put keys vals slots "e" 5)
  (map-put keys vals slots "f" 6)
  (println (vec-len slots))
  (println (map-count keys))
  (println (map-get keys vals slots "a"))
  (println (map-get keys vals slots "b"))
  (println (map-get keys vals slots "c"))
  (println (map-get keys vals slots "d"))
  (println (map-get keys vals slots "e"))
  (println (map-get keys vals slots "f"))
  (println (used-slots slots))
  (map-put keys vals slots "i" 99)
  (println (map-get keys vals slots "i"))
  (println (map-get keys vals slots "zz"))
  (vec-free keys)
  (vec-free vals)
  (vec-free slots))

