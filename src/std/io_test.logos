(mod io-test)

(use io)

(fn block :str ()
  (letmut s :str "0123456789abcdef")
  (letmut d :i64 0)
  (while (< d 6)
    (set s (str-concat s s))
    (set d (+ d 1)))
  (ret s))

(fn byte-sum :i64 ((s :str))
  (let n :i64 (str-len s))
  (letmut i :i64 0)
  (letmut total :i64 0)
  (while (< i n)
    (set total (+ total (cast :i64 (str-byte s i))))
    (set i (+ i 1)))
  (ret total))

(test round-trip
  (expect (out "true\n0\n5\n7\n0\n12\ntrue\n104\n100\n")
    (code 0)
    (leaks 0))
  (let path :str (io-temp-path "round" 1))
  (let fd :i64 (io-create path))
  (println (> fd -1))
  (println (io-write fd ""))
  (println (io-write fd "hello"))
  (println (io-write fd ", world"))
  (println (io-close fd))
  (let text :str (io-read path))
  (println (str-len text))
  (println (= text "hello, world"))
  (println (str-byte text 0))
  (println (str-byte text 11)))

(test fragments
  (expect (out "true\n1024\n1048576\n0\n1048576\n73531392\n48\n102\n")
    (code 0)
    (leaks 0))
  (let path :str (io-temp-path "frag" 2))
  (let fd :i64 (io-create path))
  (println (> fd -1))
  (let chunk :str (block))
  (println (str-len chunk))
  (letmut i :i64 0)
  (letmut written :i64 0)
  (while (< i 1024)
    (set written (+ written (io-write fd chunk)))
    (set i (+ i 1)))
  (println written)
  (println (io-close fd))
  (let text :str (io-read path))
  (println (str-len text))
  (println (byte-sum text))
  (println (str-byte text 0))
  (println (str-byte text 1048575)))

(test empty-file
  (expect (out "true\n0\n0\ntrue\n")
    (code 0)
    (leaks 0))
  (let path :str (io-temp-path "empty" 3))
  (let fd :i64 (io-create path))
  (println (> fd -1))
  (println (io-write fd ""))
  (println (io-close fd))
  (let text :str (io-read path))
  (println (= text "")))

(test missing-directory
  (expect (out "true\nstill running\n")
    (code 0)
    (leaks 0))
  (let fd :i64 (io-create "/tmp/logos-io-missing-parent-2f4c9/file.txt"))
  (println (= fd -1))
  (println "still running"))

(test temp-paths
  (expect (out "true\ntrue\ntrue\ntrue\n")
    (code 0)
    (leaks 0))
  (let a :str (io-temp-path "x" 7))
  (let b :str (io-temp-path "x" 8))
  (println (= a "/tmp/x-7"))
  (println (= b "/tmp/x-8"))
  (println (not (= a b)))
  (println (= a (io-temp-path "x" 7))))
