(mod map)

(fn map-hash :i64 ((s :str) (size :i64))
  (letmut h :i64 0)
  (letmut i :i64 0)
  (let n :i64 (str-len s))
  (while (< i n)
    (set h (+ (* h 1099511628211)
             (cast :i64 (str-byte s i))))
    (set i (+ i 1)))
  (letmut idx :i64 (% h size))
  (ret (if (< idx 0)
         (+ idx size) idx)))

(fn map-init :void ((slots (ref (vec :i64))) (size :i64))
  (letmut i :i64 0)
  (while (< i size)
    (vec-push slots 0)
    (set i (+ i 1))))

(fn map-find :i64 ((keys (ref (vec :str))) (slots (ref (vec :i64))) (k :str))
  (let size :i64 (vec-len slots))
  (letmut idx :i64 (map-hash k size))
  (letmut done :bool false)
  (while (not done)
    (let e :i64 (vec-get slots idx))
    (set done (if (= e 0) true
                (str-eq (vec-get keys (- e 1)) k)))
    (set idx (if done idx (% (+ idx 1) size))))
  (ret (if (= (vec-get slots idx) 0) -1 idx)))

(fn map-get :i64 ((keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))) (k :str))
  (let idx :i64 (map-find keys slots k))
  (ret (if (< idx 0) -1
         (vec-get vals (- (vec-get slots idx) 1)))))

(fn map-has :bool ((keys (ref (vec :str))) (slots (ref (vec :i64))) (k :str))
  (ret (> (map-find keys slots k) -1)))

(fn map-count :i64 ((keys (ref (vec :str))))
  (ret (vec-len keys)))

(fn map-needs-grow :bool ((keys (ref (vec :str))) (slots (ref (vec :i64))))
  (let n :i64 (vec-len slots))
  (ret (if (= n 0) true
         (> (* (+ (vec-len keys) 1) 10)
           (* n 7)))))

(fn map-grow :void ((keys (ref (vec :str))) (slots (ref (vec :i64))))
  (let old :i64 (vec-len slots))
  (let size :i64 (if (= old 0) 8
                   (* old 2)))
  (letmut i :i64 old)
  (while (< i size)
    (vec-push slots 0)
    (set i (+ i 1)))
  (set i 0)
  (while (< i size)
    (vec-set slots i 0)
    (set i (+ i 1)))
  (set i 0)
  (while (< i (vec-len keys))
    (letmut idx :i64 (map-hash (vec-get keys i) size))
    (while (> (vec-get slots idx) 0)
      (set idx (% (+ idx 1) size)))
    (vec-set slots idx (+ i 1))
    (set i (+ i 1))))

(fn map-insert :void ((keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))) (k :str) (v :i64))
  (let size :i64 (vec-len slots))
  (letmut idx :i64 (map-hash k size))
  (while (> (vec-get slots idx) 0)
    (set idx (% (+ idx 1) size)))
  (vec-push keys k)
  (vec-push vals v)
  (vec-set slots idx (vec-len keys)))

(fn map-put :void ((keys (ref (vec :str))) (vals (ref (vec :i64))) (slots (ref (vec :i64))) (k :str) (v :i64))
  (while (map-needs-grow keys slots)
    (map-grow keys slots))
  (let idx :i64 (map-find keys slots k))
  (if (< idx 0)
    (map-insert keys vals slots k v)
    (vec-set vals (- (vec-get slots idx) 1) v)))
