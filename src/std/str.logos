(mod str)

(fn string-match-at :bool ((hay :str) (needle :str) (at :i64) (n :i64))
  (letmut j :i64 0)
  (letmut same :bool true)
  (while (and same (< j n))
    (set same (= (str-byte hay (+ at j))
                (str-byte needle j)))
    (set j (+ j 1)))
  (ret same))

(fn string-find :i64 ((hay :str) (needle :str) (from :i64))
  (let hn :i64 (str-len hay))
  (let nn :i64 (str-len needle))
  (letmut at :i64 from)
  (letmut found :i64 -1)
  (if (or (< from 0)
        (> from hn))
    (set found -1)
    (if (> nn (- hn from))
      (set found -1)
      (while (and (= found -1)
               (<= (+ at nn) hn))
        (if (string-match-at hay needle at nn)
          (set found at)
          (set at (+ at 1))))))
  (ret found))

(fn string-starts-with :bool ((s :str) (prefix :str))
  (let sn :i64 (str-len s))
  (let pn :i64 (str-len prefix))
  (letmut same :bool false)
  (if (> pn sn)
    (set same false)
    (set same (string-match-at s prefix 0 pn)))
  (ret same))

(fn string-split-nonempty :void ((parts (ref (vec :str))) (sep :str) (s :str) (sn :i64))
  (let kn :i64 (str-len sep))
  (letmut at :i64 0)
  (letmut go :bool true)
  (while go
    (let m :i64 (string-find s sep at))
    (let end :i64 (if (> m -1) m sn))
    (vec-push parts (str-slice s at end))
    (set go (> m -1))
    (set at (if (> m -1)
              (+ m kn) at))))

(fn string-split :
  (vec :str) ((sep :str) (s :str))
  (letmut parts
    (vec :str)
    (make (vec :str)))
  (if (= (str-len sep) 0)
    (vec-push parts s)
    (string-split-nonempty parts sep s (str-len s)))
  (ret parts))

(fn string-join :str ((parts (vec :str)) (sep :str))
  (letmut out :str "")
  (letmut i :i64 0)
  (while (< i (vec-len parts))
    (set out (if (= i 0)
               (vec-get parts i)
               (str-concat (str-concat out sep)
                 (vec-get parts i))))
    (set i (+ i 1)))
  (vec-free parts)
  (ret out))
