(mod str-test)

(use str)

(fn round-trip :bool ((s :str) (sep :str))
  (letmut parts
    (vec :str)
    (string-split sep s))
  (let same :bool (= (string-join parts sep) s))
  (vec-free parts)
  (ret same))

(test find
  (expect (out "0\n-1\n0\n3\n3\n-1\n-1\n2\n5\n-1\n1\n3\n-1\n-1\n")
    (code 0)
    (leaks 0))
  (println (string-find "" "" 0))
  (println (string-find "" "a" 0))
  (println (string-find "hello" "he" 0))
  (println (string-find "hello" "lo" 0))
  (println (string-find "hello" "lo" 3))
  (println (string-find "hello" "lo" 4))
  (println (string-find "hello" "zz" 0))
  (println (string-find "hello" "" 2))
  (println (string-find "hello" "" 5))
  (println (string-find "hello" "" 9))
  (println (string-find "aaaa" "aa" 1))
  (println (string-find "héllo" "llo" 0))
  (println (string-find "hello" "lo" -1))
  (println (string-find "hi" "hello" 0)))

(test find-whole
  (expect (out "0\n0\n1\n-1\n")
    (code 0)
    (leaks 0))
  (println (string-find "hello" "hello" 0))
  (println (string-find "a" "a" 0))
  (println (string-find "aa" "a" 1))
  (println (string-find "aa" "a" 2)))

(test starts-with
  (expect (out "true\ntrue\ntrue\nfalse\nfalse\ntrue\nfalse\ntrue\n")
    (code 0)
    (leaks 0))
  (println (string-starts-with "hello" "he"))
  (println (string-starts-with "hello" ""))
  (println (string-starts-with "hello" "hello"))
  (println (string-starts-with "hello" "hellos"))
  (println (string-starts-with "" "a"))
  (println (string-starts-with "héllo" "hé"))
  (println (string-starts-with "hello" "ello"))
  (println (string-starts-with "" "")))

(test split-empty-and-missing
  (expect (out "1\n0\n1\ntrue\n1\ntrue\n1\n0\n")
    (code 0)
    (leaks 0))
  (letmut a
    (vec :str)
    (string-split "," ""))
  (println (vec-len a))
  (println (str-len (vec-get a 0)))
  (vec-free a)
  (letmut b
    (vec :str)
    (string-split "," "abc"))
  (println (vec-len b))
  (println (= (vec-get b 0) "abc"))
  (vec-free b)
  (letmut c
    (vec :str)
    (string-split "" "abc"))
  (println (vec-len c))
  (println (= (vec-get c 0) "abc"))
  (vec-free c)
  (letmut d
    (vec :str)
    (string-split "" ""))
  (println (vec-len d))
  (println (str-len (vec-get d 0)))
  (vec-free d))

(test split-empties-kept
  (expect (out "4\na\n0\nb\n0\ntrue\n")
    (code 0)
    (leaks 0))
  (letmut p
    (vec :str)
    (string-split "," "a,,b,"))
  (println (vec-len p))
  (println (vec-get p 0))
  (println (str-len (vec-get p 1)))
  (println (vec-get p 2))
  (println (str-len (vec-get p 3)))
  (println (= (vec-get p 1) ""))
  (vec-free p))

(test split-edges
  (expect (out "2\n0\n3\ntrue\n3\n")
    (code 0)
    (leaks 0))
  (letmut lead
    (vec :str)
    (string-split "," ",a"))
  (println (vec-len lead))
  (println (str-len (vec-get lead 0)))
  (vec-free lead)
  (letmut multi
    (vec :str)
    (string-split "::" "a::b::"))
  (println (vec-len multi))
  (println (= (vec-get multi 1) "b"))
  (println (vec-len multi))
  (vec-free multi))

(test join
  (expect (out "0\nsolo\na-b-c\n-\n")
    (code 0)
    (leaks 0))
  (letmut zero
    (vec :str)
    (make (vec :str)))
  (println (str-len (string-join zero ",")))
  (vec-free zero)
  (letmut one
    (vec :str)
    (make (vec :str)))
  (vec-push one "solo")
  (println (string-join one ","))
  (vec-free one)
  (letmut many
    (vec :str)
    (make (vec :str)))
  (vec-push many "a")
  (vec-push many "b")
  (vec-push many "c")
  (println (string-join many "-"))
  (vec-free many)
  (letmut blanks
    (vec :str)
    (make (vec :str)))
  (vec-push blanks "")
  (vec-push blanks "")
  (println (string-join blanks "-"))
  (vec-free blanks))

(test round-trip-table
  (expect (out "true\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\n")
    (code 0)
    (leaks 0))
  (println (round-trip "" ","))
  (println (round-trip "a" ","))
  (println (round-trip "a,b" ","))
  (println (round-trip "a,,b," ","))
  (println (round-trip "a\0b,c" ","))
  (println (round-trip "héllo→,x" ","))
  (println (round-trip "aXXbXXc" "XX"))
  (println (round-trip ",," ","))
  (println (round-trip "field one\tfield two" "\t")))

(test round-trip-length
  (expect (out "2\n3\n5\n2\n")
    (code 0)
    (leaks 0))
  (letmut parts
    (vec :str)
    (string-split "," "a\0b,c"))
  (println (vec-len parts))
  (println (str-len (vec-get parts 0)))
  (println (str-len (string-join parts ",")))
  (println (vec-len parts))
  (vec-free parts))

(test growth
  (expect (out "98304\n32769\n0\n2\ntrue\n")
    (code 0)
    (leaks 0))
  (letmut line :str "ab,")
  (letmut d :i64 0)
  (while (< d 15)
    (set line (str-concat line line))
    (set d (+ d 1)))
  (println (str-len line))
  (letmut parts
    (vec :str)
    (string-split "," line))
  (println (vec-len parts))
  (println (str-len (vec-get parts 32768)))
  (println (str-len (vec-get parts 1)))
  (println (= (vec-get parts 32767) "ab"))
  (vec-free parts))
