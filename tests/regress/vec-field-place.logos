(mod vec-field-place)

(type bucket (struct (items (vec :i64)) (label :i64)))

(test push-grow-read-free-through-a-field-place
  (expect (out "0\n9\n8\n7\n")
    (code 0)
    (leaks 0))
  (letmut b bucket (make bucket (make (vec :i64)) 7))
  (println (vec-len (get b items)))
  (letmut i :i64 0)
  (while (< i 9)
    (vec-push (get b items) i)
    (set i (+ i 1)))
  (println (vec-len (get b items)))
  (println (vec-get (get b items) 8))
  (println (get b label))
  (vec-free (get b items)))

(test free-then-set-field-reinitialises
  (expect (out "2\n0\n1\n9\n")
    (code 0)
    (leaks 0))
  (letmut b bucket (make bucket (make (vec :i64)) 1))
  (vec-push (get b items) 5)
  (vec-push (get b items) 6)
  (println (vec-len (get b items)))
  (vec-free (get b items))
  (set-field b items (make (vec :i64)))
  (println (vec-len (get b items)))
  (vec-push (get b items) 9)
  (println (vec-len (get b items)))
  (println (vec-get (get b items) 0))
  (vec-free (get b items)))

(test free-then-push-starts-an-empty-vector
  (expect (out "1\n9\n")
    (code 0)
    (leaks 0))
  (letmut b bucket (make bucket (make (vec :i64)) 0))
  (vec-push (get b items) 1)
  (vec-push (get b items) 2)
  (vec-free (get b items))
  (vec-push (get b items) 9)
  (println (vec-len (get b items)))
  (println (vec-get (get b items) 0))
  (vec-free (get b items)))
