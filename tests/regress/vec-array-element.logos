(mod vec-array-element)

(test push-one-element-and-free-both
  (expect (out "1\n7\n")
    (code 0)
    (leaks 0))
  (letmut a
    (arr (vec :i64) 2)
    (make (arr (vec :i64) 2)
      (make (vec :i64))
      (make (vec :i64))))
  (vec-push (arr-get a 0) 7)
  (println (vec-len (arr-get a 0)))
  (println (vec-get (arr-get a 0) 0))
  (vec-free (arr-get a 1))
  (vec-free (arr-get a 0)))
