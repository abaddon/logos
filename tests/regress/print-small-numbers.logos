(mod print-small-numbers)

(fn show :void ((a :i8) (b :i16) (c :i32) (d :u8) (e :u16) (f :u32) (g :f32))
  (print a)
  (print " ")
  (print b)
  (print " ")
  (print c)
  (print " ")
  (print d)
  (print " ")
  (print e)
  (print " ")
  (print f)
  (print " ")
  (print g)
  (print "\n")
  (println a)
  (println b)
  (println c)
  (println d)
  (println e)
  (println f)
  (println g))

(test every-small-width
  (expect (out "-128 -32768 -2147483648 255 65535 4294967295 -1.5\n-128\n-32768\n-2147483648\n255\n65535\n4294967295\n-1.5\n")
    (code 0)
    (leaks 0))
  (show -128 -32768 -2147483648 255 65535 4294967295 -1.5))
