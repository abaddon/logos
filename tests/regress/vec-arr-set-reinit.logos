(mod vec-arr-set-reinit)

(test free-then-arr-set-reinitialises-the-element
  (expect (out "0\n1\n9\n")
    (code 0)
    (leaks 0))
  (letmut a
    (arr (vec :i64) 2)
    (make (arr (vec :i64) 2)
      (make (vec :i64))
      (make (vec :i64))))
  (vec-push (arr-get a 0) 5)
  (vec-free (arr-get a 0))
  (letmut v
    (vec :i64)
    (make (vec :i64)))
  (arr-set a 0 v)
  (println (vec-len (arr-get a 0)))
  (vec-push (arr-get a 0) 9)
  (println (vec-len (arr-get a 0)))
  (println (vec-get (arr-get a 0) 0))
  (vec-free (arr-get a 0))
  (vec-free (arr-get a 1)))
