(mod args)

(test args
  (expect (out "true\n")
    (code 0)
    (leaks 0))
  (letmut a (args))
  (println (>= (vec-len a) 1))
  (vec-free a))

(test args-elements
  (expect (out "1\n")
    (code 0)
    (leaks 0))
  (letmut a (args))
  (println (vec-len a))
  (letmut i 1)
  (while (< i (vec-len a))
    (println (vec-get a i))
    (set i (+ i 1)))
  (vec-free a))
