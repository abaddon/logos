(mod shifts_signed)

(fn main :i64 ()
  (let one :i64 1)
  (let wide (shl one 40))
  (println wide)
  (println (shr wide 8))
  (letmut operands
    (vec :i64)
    (make (vec :i64)))
  (vec-push operands 7)
  (vec-push operands 5)
  (vec-push operands 768)
  (vec-push operands 3)
  (println (shl (vec-get operands 0)
             (vec-get operands 1)))
  (println (shr (vec-get operands 2)
             (vec-get operands 3)))
  (vec-free operands)
  (ret 0))
