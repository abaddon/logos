(mod vector_growth)

(fn main :i64 ()
  (letmut values
    (vec :i64)
    (make (vec :i64)))
  (letmut i :i64 0)
  (while (< i 65)
    (vec-push values (+ (* i 3) 1))
    (set i (+ i 1)))
  (println (vec-len values))
  (println (vec-get values 0))
  (println (vec-get values 64))
  (letmut total :i64 0)
  (letmut j :i64 0)
  (while (< j 65)
    (set total (+ total (vec-get values j)))
    (set j (+ j 1)))
  (println total)
  (vec-free values)
  (ret 0))
