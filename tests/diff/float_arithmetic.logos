(mod float_arithmetic)

(fn main :i64 ()
  (let a :f32 1.5)
  (let b :f32 2.25)
  (println (cast :f64 (+ a b)))
  (println (cast :f64 (* a b)))
  (letmut parts
    (vec :f64)
    (make (vec :f64)))
  (vec-push parts 7.5)
  (vec-push parts 2.5)
  (vec-push parts 1.25)
  (println (/ (vec-get parts 0)
             (vec-get parts 1)))
  (println (- (vec-get parts 0)
             (vec-get parts 2)))
  (vec-free parts)
  (ret 0))
