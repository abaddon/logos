(mod vector_growth_repeated)

(fn main :i64 ()
  (letmut values
    (vec :i64)
    (make (vec :i64)))
  (letmut i :i64 0)
  (while (< i 257)
    (vec-push values (% (+ (* i 7) 3) 31))
    (set i (+ i 1)))
  (letmut total :i64 0)
  (letmut j :i64 0)
  (while (< j 257)
    (set total (+ total (vec-get values j)))
    (set j (+ j 1)))
  (println (vec-len values))
  (println (vec-get values 256))
  (println total)
  (vec-free values)
  (ret 0))
