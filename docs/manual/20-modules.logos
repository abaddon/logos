(mod modules)

(use map)

(test map-from-std
  (expect (out "42\n")
    (code 0)
    (leaks 0))
  (letmut keys
    (vec :str)
    (make (vec :str)))
  (letmut vals
    (vec :i64)
    (make (vec :i64)))
  (letmut slots
    (vec :i64)
    (make (vec :i64)))
  (map-init slots 8)
  (map-put keys vals slots "answer" 42)
  (println (map-get keys vals slots "answer"))
  (vec-free keys)
  (vec-free vals)
  (vec-free slots))
